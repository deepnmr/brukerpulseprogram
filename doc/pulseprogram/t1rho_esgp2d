;t1rho_esgp2d
;avance-version (19/02/11)
;sequence for T1rho screening
;water suppression using excitation sculpting with gradients
;using z-filter
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>



define list<pulse> t1rholist=<$VPLIST>

define pulse P_in

define pulse P_SL
  "P_SL=0u"


#   ifdef TEMPCOMP
define pulse vp_max
  "vp_max = 0u"
define pulse P_COMP
  "P_COMP=0u"
#   endif /*TEMPCOMP*/


"p2=p1*2"
"d12=20u"


"TAU=de+p1*2/PI"


"l3=td1"
"l11=0"


"acqt0=0"
baseopt_echo


"P_in = 1000000.0 / (cnst62*4)"
"cnst63= (P_in/p1) * (P_in/p1)"
"plw29=plw1/cnst63"


1 ze

#   ifdef TEMPCOMP

9 20u
  if "t1rholist > vp_max"
     {
     20u
     "vp_max=t1rholist"
     }

  3m t1rholist.inc
  lo to 9 times l3

  3m t1rholist.res
#   endif /*TEMPCOMP*/


2 30m
  d12 pl1:f1 BLKGRAD

  20u
  "P_SL=t1rholist[l11]"

#   ifdef TEMPCOMP
  20u pl29:f1
  "P_COMP=vp_max-P_SL"

  (P_COMP ph1):f1
#   endif /*TEMPCOMP*/


  d1 pl1:f1
  50u UNBLKGRAD

  (p1 ph7 pl1):f1
  (P_SL ph6 pl29):f1
  (p1 ph8 pl1):f1

  p16:gp3
  d16

  p1 ph1

  p16:gp1
  d16 pl0:f1
  (p40:sp10 ph2:r):f1
  4u
  d12 pl1:f1

  p2 ph3

  4u
  p16:gp1
  d16 
  TAU
  p16:gp2
  d16 pl0:f1
  (p40:sp10 ph4:r):f1
  4u
  d12 pl1:f1

  p2 ph5

  4u
  p16:gp2
  d16 

  go=2 ph31
  30m mc #0 to 2
     F1QF(calclc(l11, 1))

  4u BLKGRAD
exit


ph1=0
ph2=0 1
ph3=2 3
ph4=0 0 1 1
ph5=2 2 3 3
ph6=1 1 1 1 3 3 3 3
ph7=0
ph8=2
ph31=0 2 2 0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl29: f1 channel - power level for trim pulse (T1rho filter)
;sp10: f1 channel - shaped pulse 180 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse
;p40: f1 channel - 180 degree shaped pulse (Squa100.1000)   [2 msec]
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                             [20 usec]
;d16: delay for homospoil/gradient recovery
;cnst62: RF field strength for T1rho spinlock (in Hz)
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4
;td1: number of experiments
;FnMODE: QF(no-frequency)


;for z-only gradients:
;gpz1: 31%
;gpz2: 11%
;gpz3: 23%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



;$Id:$
