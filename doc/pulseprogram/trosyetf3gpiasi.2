;trosyetf3gpiasi.2
;avance-version (15/01/28)
;TROSY
;2D H-1/N-15 correlation via TROSY
;   using sensitivity improvement
;   allowing for TROSY and AntiTROSY signal in an IPAP manner
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;selecting different components in F1, 
;   both for the upfield component in F2
;(use parameterset TROSYETF3GPIASI.2)
;
;D. Nietlispach, J. Biomol. NMR 31, 161-166 (2005)
;(D.W. Yang & L.E. Kay, J. Biomol. NMR 13, 3-10 (1999) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d13=4u"
"d26=1s/(cnst4*4)"


"d0=3u"

"in0=inf1/2"


"DELTA1=d13+p16+d16+4u"
"DELTA2=d26-p11-p19-d16-4u"
"DELTA3=d26-p19-d16"
"DELTA4=d26-p19-d16"

#   ifdef LABEL_CN
"DELTA=p8+d0*2"
#   else
"DELTA=d0*2"
#   endif /*LABEL_CN*/


1 ze
2 d1
3 (p1 ph1)
  d26
  (center (p2 ph2) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph7)
  
  4u
  (p11:sp1 ph6:r):f1
  p16:gp1
  d16 pl1:f1

  (p21 ph3):f3
  d0 

#   ifdef LABEL_CN
  (p8:sp13 ph1):f2
#   else
#   endif /*LABEL_CN*/

  d0
  p16:gp2*EA
  d16
  (p22 ph4):f3
  p16:gp2*EA*-1
  d16
  DELTA
  (center (p1 ph1) (p21 ph5):f3 )
  4u
  (p11:sp1 ph8:r):f1
  p19:gp4
  d16 pl1:f1
  DELTA2
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p19:gp4
  d16
  (center (p1 ph9) (p21 ph1):f3 )
  p19:gp5
  d16
  DELTA4
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p19:gp5
  d16
  (center (p1 ph2) (p21 ph2):f3 )
  DELTA1
  (p2 ph1)
  d13
  p16:gp3
  d16
  4u BLKGRAD
  go=2 ph31
  d1 mc #0 to 2 
     F1I(ip5*2 & ip8*2 & ip9*2, 2)
     F1EA(calgrad(EA) & calph(ph5, +180), caldel(d0, +in0) & calph(ph3, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 2 2
ph5=0
ph6=2
ph7=3
ph8=0
ph9=1
ph31=0 2
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree
;sp11: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d13: short delay                                      [4 usec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(NH))
;cnst4: = J(NH)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) = DW(N)
;nd0: 2
;ns: 4 * n
;ds: >= 32
;td1: number of experiments * 2
;FnMODE: echo-antiecho


;use gradient ratio:  gp 1 : gp 2 : gp 3 : gp 4 : gp 5
;                       50 :   80 : 16.2 :   -7 :    5

;for z-only gradients:
;gpz1: 50%
;gpz2: 80%
;gpz3: 16.2%
;gpz4: -7%
;gpz5: 5%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;use AU-program split [2] to split data



