;lc2pg
;avance-version (12/01/11)
;pseudo-2D-sequence for lc-nmr on flow detection
;with power-gated decoupling 
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"


"DELTA=d1-100m"


"acqt0=-p1*2/3.1416"


1 ze
  d11 pl12:f2

#   ifdef WAITFORSTART
  autosuspend
#   endif

2 d11 do:f2
3 d12 pl13:f2 
  d11 cpd2:f2
  DELTA
  4u do:f2
  d12 pl12:f2
  100m cpd2:f2
  p1 ph1
  go=2 ph31
  d11 do:f2 wr #0 if #0 zd
  lo to 3 times td1
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl13: f2 channel - power level for second CPD/BB decoupling
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;ns: 4 * n
;ds: 16
;td1: number of increments along the chromatographic time axis
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


                                          ;preprocessor-flags-start
;WAITFORSTART: Start experiment with option -DWAITFORSTART (eda: ZGOPTNS)
;                 Acquisition waits for 'resume' command for sychronisation
;                 with chromatography
                                          ;preprocessor-flags-end



