;hsqcdietgpiajclrndsp
;avance-version (21/09/15)
;IPAP-HSQMBC-TOCSY
;2D H-1/X correlation via double inept transfer
;for determination of XH long range coupling constants
;   via splitting in F2
;   for magnitude and sign long-range coupling constants
;   with selective proton pulses
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;no decoupling during acquisition
;
;J. Sauri, J.F. Espinosa & T. Parella,
;   Angew. Chem. Int. Ed 51, 3919-3922 (2012)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"cnst30=sfo2/sfo1"


"p2=p1*2"
"d6=1s/(cnst13*2)"
"d11=30m"


"d0=3u"

"in0=inf1/2"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"DELTA=p16+d16+p2+d0*2-4u"
"DELTA1=d6/2-larger(p14,p46)/2-p16-d16-4u"
"DELTA2=p16+d16+de-p1*2/PI+p3+8u"

"TAU=p14"
"TAU1=p3"


"l0=0"


"acqt0=0"
baseopt_echo


#   ifdef CALC_SPOFFS
"spoffs35=bf1*(cnst21/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/


1 ze
2 d11 pl1:f1
3 d1
  50u UNBLKGRAD

  (p1 ph1)
  4u
  p16:gp3
  d16
  DELTA1
  (center (p46:sp35 ph1) (p14:sp3 ph6):f2 )
  4u
  DELTA1
  p16:gp3
  d16 pl1:f1 pl2:f2

#   ifdef TRIMP
  (p28 ph1)
#   endif /* TRIMP */

  (p1 ph2)

  (p3 ph3):f2
  d0
  (p2 ph5)
  d0
  p16:gp1*EA
  d16
  (p24:sp7 ph4):f2
  4u
  DELTA pl2:f2
  (p3 ph4):f2

  p16:gp4
  d16

  if "l0 %2 == 0"
     {
     (p1 ph2):f1
     }
  else
     {
     (p1 ph1):f1
     }

  4u
  p16:gp5
  d16
  DELTA1

  if "l0 %2 == 0"
     {
     (center (p46:sp35 ph1) (p14:sp3 ph1):f2 )
     }
  else
     {
     (center (p46:sp35 ph1) (TAU):f2 )
     }

  4u
  DELTA1 pl1:f1 pl2:f2
  p16:gp5
  d16
  (p1 ph1):f1

  4u pl10:f1
                                                ;begin DIPSI2
4 p6*3.556 ph22
  p6*4.556 ph24
  p6*3.222 ph22
  p6*3.167 ph24
  p6*0.333 ph22
  p6*2.722 ph24
  p6*4.167 ph22
  p6*2.944 ph24
  p6*4.111 ph22

  p6*3.556 ph24
  p6*4.556 ph22
  p6*3.222 ph24
  p6*3.167 ph22
  p6*0.333 ph24
  p6*2.722 ph22
  p6*4.167 ph24
  p6*2.944 ph22
  p6*4.111 ph24

  p6*3.556 ph24
  p6*4.556 ph22
  p6*3.222 ph24
  p6*3.167 ph22
  p6*0.333 ph24
  p6*2.722 ph22
  p6*4.167 ph24
  p6*2.944 ph22
  p6*4.111 ph24

  p6*3.556 ph22
  p6*4.556 ph24
  p6*3.222 ph22
  p6*3.167 ph24
  p6*0.333 ph22
  p6*2.722 ph24
  p6*4.167 ph22
  p6*2.944 ph24
  p6*4.111 ph22
  lo to 4 times l1
                                                ;end DIPSI2

  10u gron0
  (p32:sp29 ph1):f1
  20u groff
  d16 pl1:f1

  (p1 ph1)
  DELTA2
  (p2 ph1):f1
  4u
  p16:gp1*cnst30
  d16

  if "l0 %2 == 0"
     {
     (p3 ph1):f2
     }
  else
     {
     TAU1
     }

  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2
     F1I(iu0, 2)
     F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph3, +180) & calph(ph6, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 2 2
ph5=0
ph6=0
ph22=3
ph24=1
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;sp3: f2 channel - shaped pulse (180degree inversion)
;spnam3: Crp60,0.5,20.1
;sp7: f2 channel - shaped pulse (180degree refocussing)
;spnam7: Crp60comp.4
;sp29: f1 channel - shaped pulse (adiabatic)
;sp35: f1 channel - shaped pulse 180 degree
;p1 : f1 channel - 90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel - 90 degree high power pulse
;p6 : f1 channel - 90 degree low power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;p28: f1 channel - trim pulse
;p32: f1 channel - 180 degree shaped pulse (adiabatic)    [20 msec]
;     smoothed chirp (sweepwidth, 20% smoothing, 10000 points)
;p46: f1 channel - 180 degree shaped pulse                [20-80ms]
;d0 : incremented delay (2D)                              [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d6 : delay for evolution of long range couplings
;d9 : TOCSY mixing time
;d11: delay for disk I/O                                  [30 msec]
;d16: delay for homospoil/gradient recovery
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;cnst13: = J(XH) long range
;cnst21: chemical shift for selective pulse (offset, in ppm)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 2 * n
;ds: >= 8
;td1: number of experiments
;FnMODE: echo-antiecho


;for z-only gradients:
;gpz0: ca. 11%
;gpz1: 80%
;gpz3: 33%
;gpz4: 50%
;gpz5: 17%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100


                                          ;preprocessor-flags-start
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



