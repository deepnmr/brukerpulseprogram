;hcancogp3d
;avance-version (21/09/15)
;(HCaN)CO(N)CaHa
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F2(Ca) -> F3(N) -> F2'(C=O, t1) 
;            -> F3(N) -> F2(Ca, t2) -> F1(Ha,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho-TPPI gradient selection (t2)
;using constant time in t2
;(use parameterset )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d4=1.7m"
"d22=4.5m"
"d23=14.3m"
"d25=16.6m"


"d0=3u"
"d10=d23/2-p14/2-p24/4"
"d29=d23/2-p14/2-p24/4-d21*2"
"d30=d23/2-p14/2-p24/4"

"in0=inf1/2"
"in10=inf2/4"

"in29=in10"
"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA=d0*2+larger(p14,p22)-p14"
"DELTA1=d23-d21*2-p24/2"
"DELTA2=d23-p24/2"
"DELTA4=d21*2-p16-d16"
"DELTA6=d4-p16-d16-8u"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst22)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"
"spoffs9=0"


"o1_F1=bf2*cnst21/1000000"
"o1_F2=bf2*cnst22/1000000"


aqseq 321


1 d11 ze
  d11 pl12:f2
2 d11 do:f2
3 d12 pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1
  50u UNBLKGRAD
  d12 fq=cnst22(bf ppm):f2
  
  (p1 ph1)
  d4 
  (center (p2 ph1) (p14:sp3 ph2):f2 )
  d4
  (p1 ph2)
  
  p16:gp3
  d16 pl19:f1

  (p13:sp2 ph3):f2
  d21*2
  DELTA1 cpds1:f1 ph1
  (center (p24:sp9 ph1):f2 (p22 ph1):f3 )
  DELTA2
  (p13:sp8 ph1):f2 

  4u do:f1
  p16:gp4
  d16 fq=cnst21(bf ppm):f2
  d12 cpds1:f1 ph2

  (p21 ph6):f3
  d25
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d25
  (p21 ph2):f3

  4u do:f1
  p16:gp5
  d16
  d12 cpds1:f1 ph1

  (p13:sp2 ph4):f2
  d0
  (center (p14:sp7 ph1):f2 (p22 ph1):f3 )
  d0
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  (p21 ph2):f3
  d25
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d25
  (p21 ph1):f3

  4u do:f1
  p16:gp6
  d16 fq=cnst22(bf ppm):f2
  d12 cpds1:f1 ph2

  (p13:sp2 ph5):f2
  d30
  (p14:sp5 ph1):f2
  d30
  (center (p24:sp9 ph1):f2 (p22 ph1):f3 )
  d10
  (p14:sp5 ph1):f2
  d29
  DELTA4 do:f1
  p16:gp1*EA
  d16 pl1:f1
  (p13:sp8 ph1):f2

  (p1 ph1)
  d4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  4u
  p16:gp2
  d16
  DELTA6 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d0, +in0)) 
     F2EA(calgrad(EA), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30) & calph(ph5, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph29=0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (off resonance, C=O)
;sp7: f2 channel - shaped pulse 180 degree  (off resonance, Ca)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;     sp8 for time reversed Calpha pulses
;sp9: f2 channel - shaped pulse 180 degree  (on resonance, Ca)
;     sp9 requires higher selectivity - refocussing Calpha only
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (Ca, selective)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(HCa))                                      [1.7 msec]
;d10: incremented delay (F2 in 3D) = d23/2-p14/2-p24/4
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(4J`(HCa)) for CH                              [1.7 msec]
;     1/(6J`(HCa)) for CH and CH2                      [1.2 msec]
;d22: 1/(4J(CaCO))                                     [4.5 msec]
;d23: 1/(4J(NCa)                                       [14.3 msec]
;d25: 1/(4J(NCO)                                       [16.6 msec]
;d29: incremented delay (F2 in 3D) = d23/2-p14/2-p24/4-d21
;d30: decremented delay (F2 in 3D) = d23/2-p14/2-p24/4
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;in0: 1/(2 * SW(C=O)) = DW(C=O)
;nd0: 2
;in10: 1/(4 * SW(Ca)) = (1/2) * DW(Ca)
;nd10: 4
;in29: = in10
;in30: = in10
;ns: 16 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 20.1%
;gpz3: 31%
;gpz4: 23%
;gpz5: 17%
;gpz6: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



