;reset_hsqcetgpsp
;avance-version (20/03/03)
;reset-HSQC
;pseudo 3D H1/C13 correlation via double inept transfer
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using trim pulses in inept transfer
;using shaped pulses for inversion and refocussing on f2 - channel
;C13 dimension in F2, decoupled spectrum in F1
;
;P. Sakhaii, B. Haase & W. Bermel, J. Magn. Reson. 199, 192-198 (2009)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d2=1s/(cnst2*2)"
"d4=1s/(cnst2*4)"
"d11=30m"


"d0=3u"
"d10=3u"

"in0=dw*l31"
"in10=inf2/2"


"DELTA=d10*2+p2+p16+d16-4u"
"DELTA1=d4-larger(p2,p14)/2-4u"
"DELTA2=d4+d0+p16+d16-p1*2/PI"
"DELTA3=d4-p16-d16-d0-de-dw*2*l30-4u"
"DELTA4=d2-larger(p2,p14)/2"


"l29=2*l31*td1"


"acqt0=0"
baseopt_echo


aqseq 312


1 ze
  d11 pl12:f2
2 d11 do:f2
3 d1

  (p1 ph1)
  DELTA1
  4u
  (center (p2 ph1) (p14:sp3 ph6):f2 )
  4u
  DELTA1 pl2:f2 UNBLKGRAD

#   ifdef TRIMP
  p28 ph1
#   endif /* TRIMP */

  (p1 ph2)

  p16:gp3
  d16

  (p3 ph3):f2
  d10
  (p2 ph5)
  d10
  p16:gp1*EA
  d16
  (p24:sp7 ph4):f2
  4u
  DELTA pl2:f2
  (p3 ph4):f2

  p16:gp4
  d16

  (p1 ph1)
  DELTA2
  (p2 ph1)

  d0
  p16:gp5*-1
  d16
  (p1 ph1)
  DELTA4
  4u
  (center (p2 ph2) (p14:sp3 ph1):f2 )
  4u
  DELTA4 pl12:f2
  (p1 ph1)
  d0

  p16:gp2
  d16
  DELTA3
  4u BLKGRAD
  go=2 ph31 cpd2:f2

  d11 do:f2 mc #0 to 2
     F1QF(caldel(d0, +in0))
     F2EA(calgrad(EA), caldel(d10, +in10) & calph(ph3, +180) & calph(ph6, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0
ph31=0 2 0 2 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse 180 degree for inversion
;spnam3: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;sp7: f2 channel - shaped pulse 180 degree for refocussing
;spnam7: Crp60comp.4 (Crp80comp.4)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;p16: homospoil/gradient pulse
;p24: f2 channel - 180 degree shaped pulse for refocussing
;p28: f1 channel - trim pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J)CH
;d4 : 1/(4J)CH
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(CH)
;l29: total number of points in reconstructed FID
;l30: number of complex points at the beginning not to be included
;        in reconstruction
;l31: number of complex points along the acquisition dimension per block
;        block length about 8 to 10ms
;inf2: 1/SW(C) = 2 * DW(C)
;in0: = dw*l31
;in10: 1/(2 * SW(C)) = DW(C)
;nd10: 2
;ns: 1 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: QF in F1
;FnMODE: echo-antiecho in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 31.1%  (20.1 for C-13 + gpz5)
;gpz3: 30%
;gpz4: 50%
;gpz5: 11%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100


                                          ;preprocessor-flags-start
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;use AU-program proc_reset to process data



