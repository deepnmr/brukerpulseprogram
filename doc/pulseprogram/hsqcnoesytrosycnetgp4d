;hsqcnoesytrosycnetgp4d
;avance-version (25/01/20)
;(13C)HSCQC - NOESY - (N15)TROSY
;4D sequence with
;   1H/15N correlation via TROSY
;      using sensitivity improvement
;adjust SPW1 and PHCOR3 to optimize water suppression
;using cnst22 as center of spectrum (1H, F1 dimension)
;using cnst23 as center of spectrum (13C, F2 dimension), but o2p as transmitter frequency
;using semi-constant time evolution in F1
;allows for aliasing of aromatic signals into aliphatic spectral region, while keeping the 
;transmitter frequecy in the center of both regions (o2p, ~75 ppm)
;using shaped pulses for all purposes on 13C
;minimum number of scans is 4, better  suppression of non 15N-bound (e.g.aliphatic) proton 
;   signals is achieved with 8 scans.
;using delayed sampling in F2 and F3 dimensions
;(use parameterset HSQCNOESYTROSYCNETGP4D)
;
;(S. Asami, W. Kallies, J.C. Guenther, M. Stavropoulou, S.J. Glaser & M. Sattler,
;   Angew. Chem. Int. Ed. Engl. 57(44), 14498-14502 (2018) )
;(M. Czisch & R. Boelens, J. Magn. Reson. 134, 158-160 (1998))
;(K. Pervushin, G. Wider & K. Wuethrich, J. Biomol. NMR 12, 345-348 (1998) )
;(A. Meissner, T. Schulte-Herbrueggen, J. Briand & O.W. Sorensen, Mol. Phys. 96,
;   1137-1142 (1998) )
;(J. Weigelt, J. Am. Chem. Soc. 120, 10778-10779 (1998) )
;(M. Rance, J.P. Loria & A.G. Palmer III, J. Magn. Reson. 136, 91-101 (1999) )
;(G. Zhu, X.M. Kong & K.H. Sze, J. Biomol. NMR 13, 77-81 (1999) )

;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

prosol relations=<triple>

#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>

"cnst63=(bf2*cnst23-(o2*1000000))*(inf2/1000000)*360.0"

"p2=p1*2"

"p13=30u"
"spnam2='Ram-COOP1_100.300'"
"spnam8='Ram-COOP2_100.300'"
"if ( (p3*totrot2)/(p13*90.0*integfac2) > 1 ) { spw2 = plw2; p13 = (p3*totrot2)/(90*integfac2); } else { spw2=plw2*pow((p3*totrot2)/(p13*90.0*integfac2),2);}"
"spw8=spw2"
"spoal2=1"
"spoal8=0"
"spoffs2=0"
"spoffs8=0"
"spoffs13=101*bf2/1000000-o2"

"p30=250u"

"d11=30m"
"d4=1s/(cnst2*4)"
"d26=1s/(cnst4*4)"

"in31=inf1/2"
"in32=inf2"
"in33=inf3"

"d31=3u"
"d41=d4-p30-d16-p1+p35/2"
"d51=3u"
"FACTOR2=d41*10000000*2/td1"
"INCR2=FACTOR2/10000000"
"if ( INCR2 > in31 ) { in41 = in31; } else { in41 = INCR2; }"
"if ( INCR2 > in31 ) { in51 = 0; } else { in51=in31-INCR2; }"

"if ( in32/2 >= p13*0.529*2 ) { cnst61=cnst63/(-2); } else { cnst61=cnst63*-1; }"
"if ( in32/2 >= p13*0.529*2 ) { cnst60=0.5; } else { cnst60=1; } "
"d32 = in32*cnst60-(p13*0.529*2)"
"d33=in33/2-p1"

"DELTA1=d4-p16-d16-p35/2-4u"
"DELTA2=d4-p30-d16-p1+p35/2-d51-d31"
"DELTA3=d26-p16-d16-p56/2-4u"
"DELTA4=d26-p11-p30-d16-p57/2-4u"
"DELTA5=d26-p16-d16-larger((p11*2+p2+8u),p57)/2"
"DELTA6=d26-p16-d16-larger((p11*2+p2+8u),p57)/2-4u-de-p1*2/PI"
"DELTA7=d4-p30-d16-d31"
"TAU=d8-p16-d16-p21"

"o1_F1=bf1*cnst20/1000000"
"o1_F2=bf2*cnst23/1000000"

"l0=0"

"acqt0=0"
baseopt_echo

1 ze
  1u ip10+cnst61
2 d11

  d1

  50u UNBLKGRAD pl1:f1 pl3:f3 fq=cnst20 (bf ppm):f1

  (p1 ph1)
  4u
  p16:gp7
  d16
  DELTA1
  (center (p2 ph1):f1 (p35:sp41 ph1):f2)
  DELTA1
  4u
  p16:gp7
  d16
  (p1 ph2)

  4u 
  p16:gp8
  d16 
  (center (p44:sp30 ph1):f1 (p13:sp2 ph8 d32 p13:sp8 ph10):f2)
  4u pl1:f1
  p16:gp9
  d16 
  (p1 ph2):f1
  p30:gp5
  d16 
  (lalign (DELTA2 d31 d51 p2 ph1 d41 p30:gp5 d16):f1 (DELTA7 d31 p35:sp41 ph1):f2)
  p1 ph11

  TAU
  (p21 ph1):f3
  p16:gp6
  d16  fq=0:f1

  (p1 ph1):f1
  4u
  p16:gp1
  d16 
  DELTA3
  (center (p2 ph2):f1 (p56:sp39 ph1):f3) 
  DELTA3
  p16:gp1
  d16
  4u pl3:f3
  (p1 ph4):f1

  p19:gp2
  d16

  if "l0 %2 == 1"
    {
    (p21 ph5):f3
    }
 else
    {
    (p21 ph6):f3
    }

  if "d33+p1 > p8" 
    {
    (center (d33 p1 ph7):f1 (p8:sp13 ph1):f2) 
    }
  else 
    {    
    d33
    (p1 ph7):f1
    }

  4u
  (p11:sp1 ph9:r):f1
  p30:gp3
  d16 pl1:f1
  DELTA4
  (center(p2 ph1):f1 (p57:sp40 ph1):f3)
  DELTA4
  p30:gp3
  d16
  (p11:sp1 ph1:r):f1  
  4u pl1:f1 pl3:f3
  (lalign (p1 ph1):f1 (p21 ph7):f3)
  DELTA5
  p16:gp4
  d16
  (center (p11:sp1 ph3:r 4u pl1 p2 ph1 4u p11:sp1 ph3:r):f1 (p57:sp40 ph1):f3)
  p16:gp4
  d16 pl3:f3
  4u BLKGRAD
  DELTA6
  (p21 ph1):f3
  go=2 ph31 

  d11 mc #0 to 2 
     F1PH(calph(ph11, +90), caldel(d31, +in31) & caldel(d51, +in51) &caldel(d41, -in41))
     F2PH(calph(ph8, +90), caldel(d32, +in32) & calph(ph8, cnst63))
     F3EA(calph(ph7, +180) & calph(ph9, +180) & calclc(l0, 1), caldel(d33, +in33) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=1 2 1 2 3 0 3 0
ph6=1 0 1 0 3 2 3 2
ph7=1
ph8=0 0 2 2
ph9=3
ph10=0 
ph11=0
ph31=1 2 3 0 3 0 1 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse 90 degree  (H2O on resonance)
;sp13: f2 channel - 180 degree shaped pulse for inversion
;sp30: f1 channel - shaped pulse 180 degree for inversion
;sp39: f3 channel - shaped pulse 180 degree for inversion
;sp40: f3 channel - shaped pulse 180 degree for refocussing (Reburp.1000)
;sp41: f2 channel - 180 degree shaped pulse for inversion
;p1: f1 channel -  90 degree high power pulse
;p2: f1 channel - 180 degree high power pulse
;p3: f2 channel -  90 degree high power pulse
;p8: f2 channel - 180 degree shaped pulse (adiabatic)  
;p13: f2 channel -  90 degree shape pulse 
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: homospoil/gradient pulse pulse 2                 [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: homospoil/gradient pulse pulse 3                 [250 usec]
;p35: f2 channel - 180 degree shaped pulse
;p44: f1 channel - 180 degree shape pulse for inversion
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1           
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d8 : NOESY mixing time
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J)NH

;d31: incremented delay (t1) 
;d32: incremented delay (t2)                  
;d33: incremented delay (t3)  
;d41: decremented delay (t1)     
;d51: incremented delay (t1)  

;cnst2: = J(CH) (~150)
;cnst4: = J(NH) (93)
;cnst20: Center of F1 (1H NOESY) dimension (in ppm) [~4]
;cnst23: Center of F2 dimension (13C) (in ppm)
;cnst60: Sampling in F2 is delayed by cnst60 increments
;cnst63: TPPI phase shift to shift center of spectrum relative to 13C carrier
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(N) = 2 * DW(C)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(SW(N)) = 2 * DW(H)
;in32: 1/(SW(N)) = 2 * DW(C)
;in33: 1/(SW(N)) = 2 * DW(N)
;nd31: 2
;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: echo-antiecho in F3

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.32
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100
;gpnam9: SMSQ10.100


;for z-only gradients:
;gpz1: 19%
;gpz2: 47% 
;gpz3: -25% 
;gpz4: 80% 
;gpz5: 30%
;gpz6: 71%
;gpz7: 19%
;gpz8: -25%
;gpz9: 70%


;Processing F2 and F3

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1

;PHC0(F3): 90
;PHC1(F3): -180
;FCOR(F3): 1


