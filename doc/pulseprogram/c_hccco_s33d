  p6*1.767 ph14
  p6*1.822 ph13
  p6*1.067 ph12
  p6*0.511 ph11

  p6*0.511 ph21
  p6*1.067 ph22
  p6*1.822 ph23
  p6*1.767 ph24
  p6*1.444 ph25
  p6*1.767 ph24
  p6*1.822 ph23
  p6*1.067 ph22
  p6*0.511 ph21

  p6*0.511 ph21
  p6*1.067 ph22
  p6*1.822 ph23
