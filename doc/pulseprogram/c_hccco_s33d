  p6*1.767 ph14
  p6*1.444 ph15
  p6*1.767 ph14
  p6*1.822 ph13
  p6*1.067 ph12
  p6*0.511 ph11
  lo to 4 times l1
						;end FLOPSY16

  p16:gp4
  d16 fq=cnst22(bf ppm):f1
  d12 pl12:f2 pl16:f3

  (p11:sp23 ph5)
  d22
  (p12:sp22 ph1)
  4u
  (p25:sp28 ph1)
  d22
  (p12:sp22 ph1)
  4u
  (p11:sp25 ph2)

  p16:gp5
  d16 fq=cnst21(bf ppm):f1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph6)
     }
  else
     {
     (p11:sp23 ph7)
     }

  4u
  (p12:sp27 ph1)
  d22*0.5
  (p12:sp24 ph1)
  4u
  (p12:sp27 ph1)
  d22*0.5 

  (p11:sp25 ph8)
  4u
  (p11:sp23 ph9)

  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 

#   ifdef LABEL_F1
     F1I(iu0 & ip9*2, 2)
#   else
     F2I(iu0 & ip9*2, 2)
#   endif /*LABEL_F1*/

     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28) & calph(ph3, cnst63))
     F2PH(calph(ph4, +90), caldel(d10, +in10))

TAU9
exit


ph1=0
ph2=1
ph3=0 2
ph4=1 1 3 3
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2 
ph6=(8) 1 1 1 1 1 1 1 1
ph7=(8) 1 1 1 1 5 5 5 5
ph8=0 0 0 0 1 1 1 1
ph9=0 0 0 0 1 1 1 1

ph11=(720) 0
ph12=(720) 90
ph13=(720) 135
ph14=(720) 630
ph15=(720) 45

ph21=(720) 360
ph22=(720) 450
ph23=(720) 495
ph24=(720) 270
ph25=(720) 405

ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp22: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;p29: gradient pulse 3                                 [300 usec]
;d0 : incremented delay (F1 in 3D) = d4
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [950 usec]
;d4 : 1/(4J(HCa))                                      [1.8 msec]
;d9 : TOCSY mixing time                                [12 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery            [150 usec]
;d20: decremented delay (F1 in 3D) = d4+p12+d28
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d28: incremented delay (F1 in 3D)                     [3 usec]
;cnst20: H(ali) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;cnst62: offset for Hali region (Hz)
;cnst63: additional phase increment to center Hali region
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;l1: loop for FLOPSY16 cycle: ((p6*188.448) * l1) = mixing time
;inf1: 1/SW(Hali) = 2 * DW(Hali)
;inf2: 1/SW(Cali) = 2 * DW(Cali)
;in0: 1/(2 * SW(Hali)) =  DW(Hali)
;nd0: 2
;in10: 1/(2 * SW(Cali)) =  DW(Cali)
;nd10: 2
;in20: = k * in0
;in28: = (1 - k) * in0
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 16%
;gpz2: 16%
;gpz3: 60%
;gpz4: 50%
;gpz5: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100


