;c_hccco_s33d
;avance-version (21/09/15)
;HCCCO
;3D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps and
;      C-C FLOPSY16 spinlock
;
;      F2(Hali,t1) -> F1(Cali,t2) -> F1(Ca) -> F1(C=O,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using semi-constant time in t1
;using S3E-IPAP scheme for virtual decoupling
;(use parameterset )
;
;B. O'Hare, A.J. Benesi & S.A. Showalter, J. Magn. Reson. 200, 354-358 (2009
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=0.95m"
"d4=1.8m"
"d22=4.5m"


"p29=300u"

"d16=150u"


"d0=d4"
"d10=3u"
"d28=3u"
"d20=d4+p12+d28"

"in0=inf1/2"
"in10=inf2/2"

"FACTOR1=d20*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in28 = 0; } else { in28=in0-INCR1; }"


"DELTA1=d3/2-p29-d16"
"DELTA2=p22+p4+d10*2+4u"


"FACTOR2=(d9/(p6*188.448))"
"l1=FACTOR2"


"l0=1"


"spoffs22=bf1*((cnst21-cnst22)/1000000)"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst23)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs28=0"


"cnst62=-(bf2*cnst20-(o2*1000000))"
"cnst63=(bf2*cnst20-(o2*1000000))*(inf1/1000000)*360.0"


"TAU9=abs(cnst62+cnst63)/100000"


"o1_F1=bf2*cnst20/1000000"
"o1_F2=bf1*cnst23/1000000"


aqseq 321


1 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 fq=cnst23(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph3):f2
  d0
  (p12:sp24 ph1)
  d28
  (p4 ph1):f2
  d20
  (p3 ph2):f2

  p16:gp1
  d16

  (p11:sp23 ph4)
  d10
  (p22 ph1):f3
  4u
  p29:gp2
  d16
  DELTA1
  (p12:sp26 ph1)
  4u
  p29:gp2
  d16
  DELTA1
  (p4 ph1):f2
  d10
  (p12:sp24 ph1)
  DELTA2
  p29:gp2
  d16
  DELTA1
  (p12:sp26 ph1)
  4u
  p29:gp2
  d16
  DELTA1

  (p11:sp25 ph1)

  p16:gp3
  d16 pl10:f1
						;begin FLOPSY16
4 p6*0.511 ph11
  p6*1.067 ph12
  p6*1.822 ph13
  p6*1.767 ph14
  p6*1.444 ph15
  p6*1.767 ph14
  p6*1.822 ph13
