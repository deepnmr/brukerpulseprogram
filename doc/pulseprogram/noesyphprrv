#include <Avance.incl>

define delay d8_orig


"d11=30m"
"d12=20u"
"d13=4u"

"d8_orig=d8"

"in0=inf1"

"d0=in0/2-p1*4/3.1416"


"acqt0=-p1*2/3.1416"


1 ze
2 d11
3 d12 pl9:f1
  "d8=random(d8_orig,cnst8)"
  d1 cw:f1 ph29
  d13 do:f1
  d12 pl1:f1
  p1 ph1
  d0
  p1 ph2
  d12 pl9:f1
  d8 cw:f1
  d13 do:f1
  d12 pl1:f1
  p1 ph3
  go=2 ph31
  d11 mc #0 to 2 F1PH(calph(ph1, +90) & calph(ph29, +90), caldel(d0, +in0))
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p1 : f1 channel -  90 degree high power pulse
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time (cnst8 - random variation)
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;cnst8: random variation of mixing time d8 in %      [5 %]
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


