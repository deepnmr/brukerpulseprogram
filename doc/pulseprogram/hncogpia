;hncogpia
;avance-version (21/09/15)
;HNCO - IPAP
;2D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O,t1) -> F3(N) -> F1(H,t2)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;(use parameterset HNCOGPIA)
;
;M.Ottiger, F. Delaglio & A. Bax, J. Magn. Reson. 131, 373-378 (1998)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.3m"
"d23=13.5m"
"d26=2.5m"


"d0=3u"

"in0=inf1/2"


"DELTA=d0*2+larger(p14,p22)-p14"
"DELTA1=d21*0.5-p16"
"DELTA2=d23-d21*0.5-p2"
"DELTA3=d23-p16-d16"
"DELTA4=d26-p16-p11-8u"

"TAU=p2"


"l0=1"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs8=0"


1 d11 ze
  d11 pl16:f3 
2 d11 do:f3
3 d1 pl1:f1 pl3:f3
  50u UNBLKGRAD
  (p21 ph3):f3
  p16:gp1
  d16

  p1 ph1
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (p1 ph3):f1 

  p16:gp2
  d16

  (p21 ph1):f3
  p16:gp3
  DELTA1

  if "l0 %2 == 1"
     {
     TAU
     }
  else
     {
     (p2 ph1)
     }

  DELTA2
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA3
  p16:gp3
  d16

  if "l0 %2 == 1"
     {
     (p2 ph1) (p21 ph4):f3
     }
  else
     {
     (p2 ph1) (p21 ph5):f3
     }

  p16:gp4
  d16

  (p13:sp2 ph6):f2
  d0
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d0
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  p16:gp5
  d16

  (p21 ph2):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph1):f3

  p16:gp6
  d16

  (p1 ph1) 
  p16:gp7
  DELTA4 pl0:f1
  (p11:sp1 ph7:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph7:r):f1
  p16:gp7
  DELTA4 pl16:f3
  4u BLKGRAD

  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1I(iu0, 2)
     F1PH(calph(ph6, +90), caldel(d0, +in0)) 
exit


ph1=0
ph2=1 
ph3=3 1
ph4=1 1 1 1 3 3 3 3
ph5=0 0 0 0 2 2 2 2
ph6=0 0 2 2
ph7=2
ph31=0 2 2 0 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [2 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.3 msec]
;d23: 1/(4J(NCO)                                       [13.5 msec]
;d26: 1 /(4J'(NH)                                      [2.5 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;l0: flag to switch between antiphase and inphase
;inf1: 1/SW(CO) = 2 * DW(CO)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;ns: 8 * n
;ds: = 32
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6 : gp 7
;                         30 :   80 :    9 :    7 :    5 :   11 :   23

;for z-only gradients:
;gpz1: 30%
;gpz2: 80%
;gpz3: 9%
;gpz4: 7%
;gpz5: 5%
;gpz6: 11%
;gpz7: 23%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100


;use AU-program split [ipap 2] to split data



