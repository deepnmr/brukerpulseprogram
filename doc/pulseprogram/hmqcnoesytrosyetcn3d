;hmqcnoesytrosyetcn3d
;avance-version (22/04/11)
;3D CNH NOESY seqence 
; (13C) HMQC-NOESY-(15N) TROSY sequence for methyl/HN NOEs in large proteins
; optimized for 15N / methyl-1H/13C labeled proteins, preferably deuterated
;
; H(Methyl) -> C(Methyl)(C, t1) -> H(Methyl) -> NOE -> HN -> (N,t2) -> HN(H,t3) 
;
; phase sensitive using Echo/Antiecho gradient selection in TROSY step
;(use parameterset HMQCNOESYTROSYETCN3D)
;
;(T. Schulte-Herbrueggen & O.W. Sorensen, J. Magn. Reson. 144, 
;   123 - 128 (2000))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define list<gradient> EA2 = { 0.8750 1.0000}
define list<gradient> EA4 = { 1.0000 0.6667}
define list<gradient> EA6 = { 0.6595 1.0000}

"p2=p1*2"
"d2=1s/(cnst2*2)"

"d11=30m"
"d12=20u"
"d25=1s/(cnst4*4)"
"d26=1s/(cnst4*4)"

"spoal39=0.5"
"spoal40=0.5"
"spoffs39=0"
"spoffs40=0"


"in0=inf1"
"d0=in0/2-p3*4/PI"

"in10=inf2"
"d10=in10/2"

"DELTA1=d26-p16-d16-p56/2"
"DELTA2=d25-p19-d16-p57/2"
"DELTA3=d26-p11-p16-d16-8u"
"DELTA4=d25-p19-d16-p57/2-p11"
"DELTA8=de+4u"
"DELTA11=d2-p16-d16-p1*2/PI"
"TAU=d8-p3-p16-d16"


"acqt0=0"
baseopt_echo
aqseq 312


1 d11 ze
2 d11
3 d12
  
  d1 pl1:f1 pl2:f2 pl3:f3

  50u UNBLKGRAD fq=cnst49 (bf ppm):f1
  (p21 ph1):f3
  (p3 ph1):f2
  p16:gp10
  d16;
  (p1 ph1):f1
  p16:gp11
  d16;
  (center (p2 ph1):f1 (DELTA11 p3 ph14 d0 p3 ph3 DELTA11):f2 )
  p16:gp11
  d16
  (p1 ph1):f1;

  TAU fq=0:f1
  (p21 ph1):f3

  p16:gp12
  d16 fq=0:f1

  (p1 ph3):f1
  p16:gp1
  d16
  DELTA1
  (center (p2 ph2) (p56:sp39 ph1):f3 )
  DELTA1 pl3:f3
  p16:gp1
  d16
  (p1 ph2):f1
  p19:gp2*EA2
  d16
  (p21 ph5):f3

#   ifdef LABEL_CN

if "d10 > p8"
{
(center (d10)  (p8:sp13 ph1):f2)
} 
else 
{
d10
}

#   else
  d10
#   endif /*LABEL_CN*/


  p19:gp2*-1*EA2
  d16
  DELTA8
  (p1 ph6)
  (p11:sp1 ph10:r):f1
  p19:gp3
  d16 pl1:f1
  DELTA4
  (center (p2 ph2):f1 (p57:sp40 ph2):f3 )
  DELTA2
  p19:gp3
  d16 pl3:f3
  (p1 ph1)
  p19:gp4*EA4
  d16
  DELTA8
  (p21 ph7):f3
  p16:gp5
  d16
  DELTA3 pl0:f1
  (center (p11:sp1 ph4:r 4u 4u pl1 p2 ph2 4u pl0 p11:sp1 ph4:r 4u):f1 (p57:sp40 ph8):f3 )
  DELTA3
  p16:gp5
  d16 pl1:f1 pl3:f3
  (p21 ph9:r):f3
  p19:gp6*EA6
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph14, +90), caldel(d0, +in0))
     F2EA(calgrad(EA2) & calgrad(EA4) & calgrad(EA6) & calph(ph6, +180) &calph(ph10, +180)& calph(ph7, +180), caldel(d10, +in10) & calph(ph5, +180) & calph(ph31, +180))

exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 2 0 2
ph6=3
ph7=0  
ph8=1  
ph9=3  
ph10=1
ph11=0 
ph14=0 0 2 2
ph31=0 2 2 0 

;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)

;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse 
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse (water flipback/watergate)
;p16: homospoil/gradient pulse   [1 msec]
;p19: homospoil/gradient pulse 2  [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p56: f3 channel - 180 degree shaped pulse for inversion (Bip720)
;p57: f3 channel - 180 degree shaped pulse for refocussing (Reburp.1000)

;sp1 : f1 channel - shaped pulse for water flipback (Sinc1.1000)
;sp13: f2 channel - shaped pulse 180 degree (Ca and C=O, adiabatic)
;sp39: f3 channel - 180 degree shaped pulse for inversion (Bip720)
;sp40: f3 channel - 180 degree shaped pulse for refocussing (Reburp.1000)

;d0 : incremented delay (F1)  
;d1 : relaxation delay, 1-5 times T1
;d2: 1/(2J CH)   
;d8: NOESY mixing time                          
;d10 : incremented delay (F2)                [3usec]
;d11: delay for disk I/O                     [30 msec]
;d12: delay for power switching              [20 usec]
;d16: delay for homospoil/gradient recovery  [200 usec]
;d25: 1/(4J'(NH)                             [2.7 msec]
;d26: 1/(4J(NH)                              [2.7 msec]

;cnst2: HC(methyl) coupling constant [in Hz]  [130]
;cnst4: HN coupling constant [in Hz]  [95]
;cnst49: H(methyl) chemical shift (offset, in ppm) [~1 ppm]

;d0 : incremented delay (F1)                   
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) = DW(N)
;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz1: 10%
;gpz2: 80%
;gpz3: 20%
;gpz4: 30%
;gpz5: 15%
;gpz6: 30.13%
;gpz10: 40%
;gpz11: 11%
;gpz12: 27%
;gpz13:  7%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.100
;gpnam10: SMSQ10.100  
;gpnam11: SMSQ10.100
;gpnam12: SMSQ10.100
;gpnam13: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for 13C decoupling in 15N dimension (F2) (only for uniform 13C labeled samples) start experiment with 
;          option -DLABEL_CN (eda: ZGOPTNS), not necessary if only methyl groups are labeled
                                          ;preprocessor-flags-end
										  
;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1


;PHC0(F2): 105
;PHC1(F2): -180
;FCOR(F2): 1

