;udeft
;avance-version (19/01/08)
;UDEFT
;1D sequence using
;   flip back pulse at the end of acquisition to decrease
;      relaxation delay d1 
;   and NOE
;
;M. Piotto, M. Bourdonneau, K. Elbayed, J.-M. Wieruszeski &
;   G. Lippens, Magn. Reson. Chem. 44, 943-947 (2006)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include<Avance.incl>
#include<Delay.incl>


"d11=30m"
"d12=20u"


"TAU=0.0000014"

"DELTA=d1-30m"
"DELTA2=aq+TAU+de"


"acqt0=-p1*2/3.1416"


1 ze
  d20 do:f2
  d12 pl12:f2
  30s cpd2:f2
2 30m pl1:f1
  DELTA 
  p1 ph1
  gosc ph31
  4u
  (p13:sp5 ph2:r):f1
  4u
  DELTA2 pl1:f1
  p1 ph3
  4u
  (p26:sp8 ph4):f1
  4u
  lo to 2 times ns
  30m mc #0 to 2 F0(zd)
  d12 do:f2
exit


ph1=0
ph2=1
ph3=0 
ph4=0 2
ph31=0


;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp5: f1 channel - shaped pulse (180degree)
;spnam5: Crp60comp.4  (Crp80comp.4)
;sp8: f1 channel - shaped pulse (180degree)
;spnam8: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;p1 : f1 channel -  high power pulse
;p13: f1 channel - 180 degree shaped pulse
;     = 2msec for Crp60comp.4 (Crp80comp.4)
;p26: f1 channel - 180 degree shaped pulse
;     = 500us for Crp60,0.5,20.1 (Crp80,0.5,20.1)
;d1 : relaxation delay; 3 to 4s for all molecules
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d20: set to 5 times longest T1                      [200 s]
;ns: 1 * n, total number of scans: NS * TD0
;ds=0
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;aq: acquisition time 360 ms - do not change this value !


;Processing

;ME_mod=LPfc
;NCOFF=4096
;LPBIN= 256k
;LB=2 



