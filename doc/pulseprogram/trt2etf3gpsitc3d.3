;trt2etf3gpsitc3d.3
;avance-version (23/01/25)
;3D H-1/X correlation via TROSY and inept transfer
;   using sensitivity improvement
;for measuring N-15 T2 relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;using H-1 180o pulses rather than cpd decoupling
;as pseudo3D
;with temperature compensation
;(use parameterset TRT2ETF3GPSITC3D.3)
;
;(N.-A. Lakomek, J. Ying & A. Bax, J. Biomol. NMR 53, 209-221 (2013))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<loopcounter> cpmglist=<$VCLIST>

define loopcounter vc_max

define loopcounter COUNTER1
define loopcounter COUNTER2


"p0=p1*7/3"
"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=2.65m"

"d21=450u"
"d31=(p30*8+d21*16)"

"p19=500u"
"p29=250u"


"d10=3u"
"in10=inf2/2"


#   ifdef LABEL_CN
"DELTA1=d16+d10*2+p8-p21*4/PI+p1"
"DELTA2=d16"
#   else
"DELTA1=d16"
"DELTA2=d16+p21*4/PI-d10*2-p1"
#   endif /*LABEL_CN*/

"DELTA3=d26-p11-p16-d16-4u"
"DELTA4=d26-p19-d16-p29/2-d16/2-2u"
"DELTA5=p29+d16+4u+de-p1*2/PI"


"l0=1"
"l3=td1"
"l11=0"
"l31=0"


"spoffs13=0"


aqseq 312


"acqt0=0"
baseopt_echo


1 ze 

9 20u
  if "cpmglist > vc_max"
     {
     20u
     "vc_max=cpmglist"
     }

  3m cpmglist.inc
  lo to 9 times l3

  3m cpmglist.res

2 d11
  (p21 ph1):f3

  20u
  "l31=cpmglist[l11]"
  20u
  "COUNTER1=l31"
  20u
  "COUNTER2=vc_max-l31"
  20u
  "TAU1=(d31/4)*l31-p44/2-2u"

  20u pl1:f1 pl23:f3

8 (d21 p30 ph2 d21*2 p30 ph2 d21*2 p30 ph1 d21*2 p30 ph8 d21):f3
  (d21 p30 ph2 d21*2 p30 ph2 d21*2 p30 ph1 d21*2 p30 ph8 d21):f3
  lo to 8 times COUNTER2

3 d1 pl1:f1 pl3:f3
  50u UNBLKGRAD
  (p21 ph1):f3
  4u
  p16:gp0
  d16

  (p1 ph1)
  d26 gron1
  2u groff
  (center (p2 ph1) (p22 ph1):f3 )
  d26 gron1
  2u groff
  (lalign (p1 ph2) (p21 ph1):f3 )
  d26 gron2
  2u groff
  (center (p2 ph1) (p22 ph1):f3 )
  d26 gron2
  2u groff
  (ralign (p1 ph3) (p21 ph2):f3 )
  p29:gp3
  d16
  (p21 ph4):f3
  2u pl23:f3

exec_on_chan:f3
6 (d21 p30 ph2 d21*2 p30 ph2 d21*2 p30 ph1 d21*2 p30 ph8 d21):f3
  (d21 p30 ph2 d21*2 p30 ph2 d21*2 p30 ph1 d21*2 p30 ph8 d21):f3
  lo to 6 times COUNTER1
exec_wait

exec_on_other
  TAU1
  2u
  (p44:sp30 ph1):f1
  2u
#   ifdef LABEL_CN
  (center (p8:sp13 ph1):f2 (TAU1 gron8*-1 TAU1 gron8))
#   else
  TAU1 gron8*-1
  TAU1 gron8
#   endif /*LABEL_CN*/
  2u groff
  (p44:sp30 ph1):f1
  2u
exec_wait

  2u pl3:f3
  (p21 ph3):f3
  p19:gp9
  d16

  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     2u
     p19:gp4*EA*-1
     DELTA1
     (p22 ph5):f3
     2u
     p19:gp4*EA
     DELTA2 pl1:f1
     }
  else
     {
     (p21 ph6):f3
     2u
     p19:gp4*EA*-1
     DELTA1
     (p22 ph6):f3
     2u
     p19:gp4*EA
     DELTA2 pl1:f1
     }

#   ifdef LABEL_CN
  d10
  (p8:sp13 ph1):f2
  d10
#   else
  d10
  d10
#   endif /*LABEL_CN*/

  (p1 ph7)
  4u
  (p11:sp1 ph9):f1
  p16:gp5
  d16
  DELTA3 pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp5
  d16
  (p11:sp1 ph1):f1
  2u
  2u pl1:f1
  (p1 ph1) 
  (p21 ph7):f3

  4u
  p19:gp6
  d16
  (center (DELTA5 p11:sp1 ph8:r 2u 2u pl1 p2 ph1 4u p11:sp1 ph8:r):f1 (DELTA4 p22 ph1 DELTA4):f3 )
  4u
  p19:gp6
  d16
  (p21 ph1):f3
  p29:gp7
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calgrad(EA) & calph(ph7, +180) & calph(ph9, +180) & calclc(l0, 1), caldel(d10, +in10) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))
  d31
exit 
  

ph1=0
ph2=1
ph3=2
ph4=0 0 0 0 2 2 2 2
ph5=1 0 3 2
ph6=1 2 3 0
ph7=1
ph8=2
ph9=3
ph10=3
ph31=1 2 3 0 3 0 1 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl23: f3 channel - power level for spinlock
;sp1 : f1 channel - shaped pulse 180 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;spnam30: Bip720,50,20.1
;p0 : f1 channel - 210 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                               [1 msec]
;p19: gradient pulse 2                                       [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                       [250 usec]
;p30: f3 channel - 180 degree pulse at pl23
;p44: f1 channel - 180 degree shaped pulse for broadband inversion
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay                                      [3 usec]
;d11: delay for disk I/O                                     [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: echo delay                                             [450 usec]
;d26 : 1/(4J)YH                                              [2.65 msec]
;d31: length of single cpmg loop
;cnst4: = J(YH)
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 16
;td1: number of delays in vc-list
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz0: 23%
;gpz1: 0.5%
;gpz2: 0.3%
;gpz3: 55%
;gpz4: 40%
;gpz5: 11%
;gpz6: 47%
;gpz7: 16.2%
;gpz8: 0.4%
;gpz9: -37%


;use gradient files:
;gpnam0: SMSQ10.100
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.32
;gpnam9: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id: $
