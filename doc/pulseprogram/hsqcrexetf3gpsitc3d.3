;hsqcrexetf3gpsitc3d.2
;avance-version (21/09/15)
;3D H-1/X correlation via double inept transfer
;   using sensitivity improvement
;for measuring N-15 R(exchange) using a CPMG train
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;with 1H cw decoupling during CPMG train
;using f3 - channel
;using flip-back pulse
;as pseudo3D
;using temperature compensation
;using a single cpmg train
;(use parameterset )
;
;B. Jiang, B. Yu, X. Zhang, M. Liu & D. Yang,
;   J. Magn. Reson. 257, 1-7 (2015)
;D.F. Hansen, P. Vallurupalli & L.E. Kay, 
;   J. Phys. Chem. B 112, 5898-5904 (2008) 
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


require "TopSpin 4.0.8"


prosol relations=<triple2>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<delay> RF_field=<$VDLIST>
define delay RF_max

define loopcounter COUNTER0
define loopcounter COUNTER1
define loopcounter COUNTER2
define loopcounter COUNTER3


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"
"d25=2.68m"
"d26=2.25m" 
"d28=5.0m"


"d10=6u"

"in10=inf2/2"


"DELTA2=p16+d16+de-p1*2/PI+8u"
"DELTA4=p21-p1*2/PI+2u"
"DELTA6=d26-p16-d16"
"DELTA7=d25-p16-d16"
"DELTA8=d28-p16-d16"

#   ifdef LABEL_CN
"DELTA1=d25-p16-d16+larger(p2,p8)+d10*2+10u"
#   else
"DELTA1=d25-p16-d16+p2+d10*2+10u"
#   endif /*LABEL_CN*/


"plw33=plw1*pow(cnst9*4*p1*0.000001,2)"
"if (plw33 > 0) {p45=sqrt(plw1/plw33)*p2;} else {p45=0;}"


"DELTA5=p45*4-p1*4/PI"


"spoffs1=0"
"spoffs13=bf2*((cnst21+cnst22)/2000000)-o2"


"l3=td1"
"l11=0"
"l12=0"

"d31=0"

"cnst30=0"
"cnst31=0"


"acqt0=0"
baseopt_echo


aqseq 312


1 ze
  d11 pl16:f3

  "RF_max=0"

9 20u
  if "RF_field > RF_max"
     {
     20u
     "RF_max=RF_field"
     }

  3m RF_field.inc
  lo to 9 times l3

  3m RF_field.res

  d11 fq=cnst18(bf ppm):f1
2 d11 do:f3
3 d12
  d12 pl33:f1

  "d31=RF_field[l11]"

  20u
  "if (d31 == 0) \
     { \
     COUNTER1=0; \
     COUNTER2=0; \
     } \
  else \
     { \
     COUNTER0=(d21*2*d31); \
     d31=COUNTER0/(d21*2); \
     COUNTER1=trunc((COUNTER0/2)); \
     COUNTER2=(COUNTER0%2); \
     }"
  20u
  "if (d31 == 0) \
     { \
     DELTA3=1s; \
     } \
  else \
     { \
     DELTA3=(1 / (d31*4) ) - p25/2000000; \
     cnst30 = 100*((trunc((1000000/(4*p45))/(d31*2))*d31*2)/(1000000/(4*p45))); \
     }"

  if "RF_max > d31"
     {
     20u
     "cnst31=sqrt( (RF_max*RF_max) - (d31*d31) )"
     20u
     "TAU1=(1 / (cnst31*4) ) - p25/2000000"
     20u
     "COUNTER3=d21*cnst31*4"
     }    


  if "abs(RF_max-d31) < 0.1"
     {
     d21*2
     }
  else
     {
     2u pl23:f3
     if "d31 == 0" 
        {
        (p11:sp1 ph2:r):f1
        2u pl33:f1
        2u cpd1:f1 ph1
        }

10   TAU1
     (p25 ph2):f3
     TAU1
     lo to 10 times COUNTER3

     if "d31 == 0" 
        {
        2u do:f1
        (p11:sp1 ph4:r):f1
        }
    }

  d1
  50u UNBLKGRAD
  2u pl1:f1 pl3:f3
  (p21 ph1):f3
  p16:gp0
  d16

  (p11:sp1 ph4:r):f1
  2u pl1:f1

  (p1 ph1)
  p16:gp1
  d16
  DELTA6
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p16:gp1
  d16
  (p1 ph2)

  p16:gp2
  d16 pl1:f1

  (p21 ph1):f3
  p16:gp3
  d16
  DELTA7
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA7
  p16:gp3
  d16
  (p2 ph1) (p21 ph2):f3

  p16:gp4
  d16 fq=cnst19(bf ppm):f1
  DELTA8

  (p1 ph5)
  DELTA5 
  (p1 ph1)
  DELTA4
  (p2 ph5)
  (p21 ph6):f3
  1u pl33:f1 pl23:f3
  1u amp=cnst30:f1

  if "d31 == 0"
     {
     4u
     }
  else
     {
     2u cpd1:f1 ph1
     if "COUNTER0 > 1"
        {
5       DELTA3
        (p25 ph2):f3
        DELTA3
        DELTA3
        (p25 ph2):f3
        DELTA3
        DELTA3
        (p25 ph1):f3
        DELTA3
        DELTA3
        (p25 ph3):f3
        DELTA3
        lo to 5 times COUNTER1

6       DELTA3
        (p25 ph2):f3
        DELTA3
        DELTA3
        (p25 ph2):f3
        DELTA3
        lo to 6 times COUNTER2
        }
     else
        {
        DELTA3
        (p25 ph21):f3
        DELTA3
        DELTA3
        (p25 ph22):f3
        DELTA3
        }
     2u do:f1
     }
  
  2u pl1:f1 pl3:f3 
  (p21 ph1):f3
  (p2 ph8)
  DELTA4 pl3:f3
  (p1 ph1)
  DELTA5
  (p1 ph8)
  4u fq=cnst18(bf ppm):f1

  DELTA8
  p16:gp5
  d16

  (p21 ph9):f3
  d10 gron6
  5u groff
  p16:gp7*EA
  d16
  DELTA7

#   ifdef LABEL_CN
  (center (p2 ph1) (p8:sp13 ph1):f2 )
#   else
  (p2 ph1)
#   endif /*LABEL_CN*/

  d10 gron6*-1
  5u groff
  (p22 ph1):f3
  p16:gp7*-1*EA
  d16
  DELTA1   

  (center (p1 ph3) (p21 ph10):f3 )
  p16:gp8
  d16
  DELTA7
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA7
  p16:gp8
  d16
  (center (p1 ph2) (p21 ph11):f3 )
  p16:gp9
  d16
  DELTA7
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA7
  p16:gp9
  d16
  (p1 ph1)
  DELTA2
  (p2 ph1)
  4u
  p16:gp10
  d16 pl16:f3
  4u  BLKGRAD
  go=2 ph31 cpd3:f3

  d11 do:f3 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calgrad(EA) & calph(ph11, +180), caldel(d10, +in10) & calph(ph9, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=2
ph4=3
ph5=1 1 3 3 
ph6=0 2 
ph7=0 0 2 2 
ph8=3 3 1 1
ph9=1 1 1 1 3 3 3 3 
ph10=0
ph11=1
ph21=1 0
ph22=1 2
ph31=0 2 0 2 2 0 2 0
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl23: f3 channel - power level for spinlock
;pl33: f1 channel - power level for CW decoupling
;sp1 : f1 channel - shaped pulse (H2O on-resonance)
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f3 channel - 180 degree pulse at pl23
;p45: f1 channel - 180 degree pulse at pl33
;d1 : relaxation delay; 1-5 * T1
;d10 : incremented delay                             [6 usec]
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: half the length of mixing time (CPMG time = d21*2)
;d24: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d25: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d26: 1/(4J(YH))
;d28: Equilibration delay                            [5 msec]
;vd : variable field strength, taken from vd-list
;valist: unused (set internally)
;vdlist: variable field strength list in Hz
;cnst4: = J(YH)
;cnst9: 1H CW decoupling field strength [Hz]
;cnst18: H2O chemical shift (offset, in ppm)
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 8 * n
;ds: >= 16
;td1: number of delays in vd-list
;td2: number of experiments in F2
;FnMODE: QF in F1
;FnMODE: echo-antiecho in F2
;cpd1: decoupling sequence during CPMG train: cwp
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence
;cpdprg1: cwp


;for z-only gradients:
;gpz0: 10%
;gpz1: 4%
;gpz2: -40%
;gpz3: -80%
;gpz4: 40%
;gpz5: -4.5%
;gpz6: 0.1%
;gpz7: 80%
;gpz8: 10.0%
;gpz9: -4.0%
;gpz10: 16.2%

;use gradient files:
;gpnam0: SMSQ10.100
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100
;gpnam9: SMSQ10.100
;gpnam10: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;note: the values in the vd-list are interpreted as field-strength in Hz



;$Id: $
