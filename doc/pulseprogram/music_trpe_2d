;music_trpe_2d
;avance-version (21/09/15)
;music: Trp(W)e
;2D sequence with
;   inverse correlation for triple resonance using inept 
;   transfer steps 
;
;      F1(H(Ne)) -> F3(Ne) -> F2(Ce) -> F3(Ne,t1) -> F1(H,t3)
;
;options:
;   no option       NHe(Trp)
;possible breakthrough:
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;using constant time in t1
;water suppression using watergate sequence
;(use parameterset )
;
;M. Schubert, H. Oschkinat & P. Schmieder,
;   J. Magn. Reson. 153, 186-192 (2001)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


;;;untested


prosol relations=<triple2>


#include<Avance.incl>
#include<Grad.incl>
#include<Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d21=5.5m"
"d23=12.4m"
"d26=2.3m"


"d0=d23-p26-d21-4u"
"d20=d23"

"in0=inf1/2"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"DELTA1=d26-p19-d16"
"DELTA2=d23-d21-p26"
"DELTA3=d26-p16-d16-p11-p1*2/3.1416-12u"
"DELTA4=d26-p16-d16-p11-de-12u"


"spoffs2=0"
"spoffs8=0"
"spoffs23=0"


1 ze
  d11 pl16:f3
2 d11 do:f3
3 d11
  d1
  50u UNBLKGRAD
  d12 pl1:f1 pl3:f3

  (p1 ph1):f1
  p19:gp1
  d16
  DELTA1
  (center (p2 ph1):f1 (p22 ph1):f3 )
  DELTA1
  p19:gp1
  d16
  (p1 ph2):f1

  4u
  (p11:sp1 ph1):f1
  4u
  p16:gp2
  d16 pl19:f1

  (p21 ph5):f3
  d21
  (p26 ph2):f1
  DELTA2 cpds1:f1 ph1
  (center (p33:sp23 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph1):f3

  (p13:sp2 ph6):f2
  4u
  (p13:sp8 ph7):f2

  (p21 ph8):f3
  d20
  (center (p33:sp23 ph1):f2 (p22 ph9):f3 )
  d0
  4u do:f1
  (p26 ph4):f1
  d21
  (p21 ph1):f3

  p16:gp3
  d16
  (p11:sp1 ph3):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA3
  (p11:sp1 ph3):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph3):f1
  4u
  DELTA4
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph8, -90), caldel(d0, +in0) & caldel(d20, -in20))
exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=0 0 0 0 2 2 2 2
ph6=0 0 2 2
ph7=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph8=0 2
ph9=0 0 0 0 2 2 2 2 1 1 1 1 3 3 3 3
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp23: f2 channel - shaped pulse 180 degree  (on resonance)

;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0: incremented delay (2D) = d23-p26-d21-4u
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d23
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NC)                                        [12.4 msec]
;d26: 1/(4J(NH)                                        [2.3 msec]
;p33: f2 channel - 180 degree shaped pulse (sp23)
;                      (Q3.1000: 700us at 600.13 MHz)
;cnst21: CO chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;cnst24: Caromatic chemical shift (offset, in ppm)
;o2p: Caromatic chemical shift (cnst24)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) =  DW(N)
;nd0: 2
;in20: = in0
;ns: 8 * n
;ds: = 32
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4
;                          3 :   70 :   40 :   30

;for z-only gradients:
;gpz1: 3%
;gpz2: 70%
;gpz3: 40%
;gpz4: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



