;trhncocacbfpsiwg2h3d
;avance-version (21/09/15)
;TROSY-HNCOCACB
;3D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O) -> F2(Ca -> Cb,t1)
;            -> F2(C=O) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;using semi-constant time in t2
;water suppression using watergate sequence
;using flip-back pulse
;with H-2 decoupling - requires lockswitch unit or BSMS 2H-TX board
;(use parameterset )
;
;M. Salzmann, G. Wider, K. Pervushin, H. Senn & K. Wuethrich,
;   J. Am. Chem. Soc. 121, 844-848 (1999)
;(A. Eletsky, A. Kienhoefer & K. Pervushin,
;   J. Biomol. NMR 20, 188-180 (2001))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p20=p3*2.5"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d22=4m"
"d23=12m"
"d26=1s/(cnst4*4)"

#   ifdef LABEL_CB
"d28=7.2m"
#   else
"d28=3.6m"
#   endif /*LABEL_CB*/

"p29=250u"


"d0=3u"
"d10=3u"
"d29=3u"
"d30=d23-p56/2-p1"

"in0=inf1/2"
"in10=inf2/2"

"FACTOR2=d30*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in10 ) { in30 = in10; } else { in30 = INCR2; }"
"if ( INCR2 > in10 ) { in29 = 0; } else { in29=in10-INCR2; }"


"DELTA1=d26-p11-p19-d16-p56/2-4u"
"DELTA2=d26-p11-p29-d16-p56/2-4u"
"DELTA3=d26-p16-d16-larger((p11*2+p2+8u),p57)/2"
"DELTA4=d26-p16-d16-larger((p11*2+p2+8u),p57)/2-4u-de-p1*2/PI"
"DELTA5=d23-larger(p14,p57)/2-p16-d16-4u"
"DELTA6=d23-p14*2-p21*2/PI-d10-d29-p56/2"
"DELTA7=d22-p14-4u"

"TAU=d0"


"l0=0"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst23)/1000000)"
"spoffs8=0"


"o1_F1=bf2*cnst23/1000000"


"acqt0=0"
baseopt_echo


aqseq 321


1 ze
  d11 LOCKDEC_ON
  50u LOCKH_ON
  d11 H2_PULSE
  d11 pl17:f4

2 d11
3 d11 H2_LOCK
  9m LOCKH_OFF
  d1 pl1:f1 pl3:f3 fq=cnst21(bf ppm):f2
  50u UNBLKGRAD
  d12 H2_PULSE

  (p1 ph1):f1
  4u
  (p11:sp1 ph3:r):f1
  p19:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2):f1 (p56:sp39 ph1):f3) 
  DELTA1
  p19:gp1
  d16
  (p11:sp1 ph4:r):f1
  4u pl1:f1 pl3:f3
  (p1 ph4):f1

  p19:gp2
  d16

  (p21 ph1):f3
  4u
  DELTA5
  p16:gp5
  d16
  (center (p14:sp3 ph1):f2 (p57:sp40 ph1):f3)
  p16:gp5
  d16
  DELTA5
  4u pl3:f3
  (p21 ph2):f3
  (p34 ph2):f4
  2u cpds4:f4 ph1

  (p13:sp2 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA7
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA7
  (p13:sp8 ph2):f2

  4u
  30u fq=cnst23(bf ppm):f2

  (p13:sp2 ph10):f2
  d28
  (p14:sp3 ph1):f2
  d28

  (p13:sp2 ph2):f2
  d0
  (center (p14:sp7 ph1):f2 (p56:sp39):f3)
  d0
  (p14:sp3 ph1):f2
  TAU
  (center (p14:sp7 ph1):f2 (p56:sp39):f3)
  TAU
  (p13:sp2 ph8):f2

  d28
  (p14:sp3 ph1):f2
  d28
  (p13:sp8 ph9):f2

  30u fq=cnst21(bf ppm):f2

  (p13:sp2 ph2):f2
  4u
  (p14:sp5 ph1):f2
  DELTA7
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA7
  (p13:sp8 ph1):f2

  2u do:f4 pl3:f3
  (p34 ph4):f4

  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     }
  else
     {
     (p21 ph6):f3
     }

  d10
  (p14:sp5 ph1):f2
  DELTA6
  (p14:sp3 ph1):f2 
  d29
  (p56:sp39 ph1):f3
  d30

  (p1 ph7):f1
  4u
  (p11:sp1 ph17:r):f1
  p29:gp3
  d16 pl1:f1
  DELTA2
  (center(p2 ph1):f1 (p56:sp39 ph1):f3)
  DELTA2
  p29:gp3
  d16
  (p11:sp1 ph1:r):f1  
  4u pl1:f1 pl3:f3
  (lalign (p1 ph1):f1 (p21 ph7):f3)
  DELTA3
  p16:gp4
  d16
  (center (p11:sp1 ph3:r 4u pl1 p2 ph1 4u p11:sp1 ph3:r):f1 (p57:sp40 ph1):f3)
  p16:gp4
  d16 pl3:f3
  4u BLKGRAMP
  DELTA4
  (p21 ph1):f3
  go=2 ph31 
  d11 mc #0 to 2
     F1PH(calph(ph8, -90) & calph(ph9, -90), caldel(d0, +in0))
     F2EA(calph(ph7, +180) & calph(ph17, +180) & calclc(l0, 1), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))

  d11 H2_LOCK
  d11 LOCKH_OFF
  d11 LOCKDEC_OFF
exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=2 3 2 3 0 1 0 1
ph6=2 1 2 1 0 3 0 3
ph7=3
ph8=1 1 3 3
ph9=0 0 2 2
ph10=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph11=1
ph17=1
ph31=1 2 3 0 3 0 1 2 3 0 1 2 1 2 3 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl17: f4 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                                 [500 usec]
;p20: f2 channel -  225 degree high power pulse (p3*2.5)
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                 [250 usec]
;p34: f4 channel -  90 degree pulse at pl17
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1            (500us at 600.13 MHz)
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.6ms at 600.13 MHz)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa)                                      [4 msec]
;d23: 1/(4J(NCO)                                       [12 msec]
;d26: 1/(4J)NH
;d28: 1/(8J(CaCb)                                      [3.6 msec]
;d29: incremented delay (F2 in 3D)                     [3 usec]
;d30: decremented delay (F2 in 3D) = d23-p56/2-p1
;cnst4: = J(NH)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Cali chemical shift (cnst23)
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Cali)) =  DW(Cali)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in29: = (1 - k) * in10
;in30: = k * in10
;ns: 2 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpd4: decoupling according to sequence defined by cpdprg4
;pcpd4: f4 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 19%
;gpz2: 47%
;gpz3: 65%
;gpz4: 80%
;gpz5: 11%

;use gradient files:
;gpnam1: SMSQ10.50
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



