;
; checked by SEWE 02.08.2011
;
;cp editing experiment by phase inversion
;see: X. Wu and K. W. Zilm, J. Magn. Reson. A 102, 205, (1993).
;written by HF 1.3.2001
;
;Avance III version
;parameters:
;pl1 : X power level
;pl2 : 1H power during CP
;pl12 : 1H power for decoupling
;pl13 : e.g. used in spinal64_13
;p3 : 1H 90 at power level plw2
;p15 : contact time at plw1 (f1) and plw2 (f2)
;p16 : polarization inversion time may be set to about 40u to obtain negative CH2, null CH, and positive C and CH3
;pcpd2 : pulse length in decoupling sequence
;cpdprg2 : cw, spinal64 (at plw12)
;d1 : recycle delay
;zgoptn : -Dlacq, -Dlcp15, or blank to disable protection
;
;
;$CLASS=Solids
;$DIM=1D
;$TYPE=cross polarisation
;$SUBTYPE=editing
;$COMMENT=cp editing experiment by phase inversion and population inversion

prosol relations=<solids_cp>


define pulse pct
"pct=p15/2"
define pulse ppi
"ppi=p16/2"
"acqt0=-1u"

1 ze
2 d1 do:f2
#ifndef lcp15
#include <p15_prot.incl>
			;make sure p15 does not exceed 10 msec 
			;let supervisor change this pulseprogram if 
			;more is needed
#endif

#ifndef lacq		
			;disable protection file for long acquisition change decoupling power !!! or you risk probe damage
			;if you set the label lacq (ZGOPTNS -Dlacq), the protection is disabled

#include <aq_prot.incl>	
			;allows max. 50 msec acquisition time, supervisor
			;may change  to max. 1s at less than 5 % duty cycle
			;and reduced decoupling field
#endif
  (p3 pl12 ph1):f2
  (pct pl1 ph2):f1 (pct ph3):f2
  (pct ph6):f1 (pct ph4):f2
  (ppi ph2):f1 (ppi ph4):f2
  (ppi ph6):f1 (ppi ph3):f2
  1u cpds2:f2		;pl12 is used here
  go=2 ph31
  1m do:f2
  wr #0
HaltAcqu, 1m
exit

ph0= 0
ph1= 1 3
ph2= 0 0 1 1 3 3 2 2
ph6= 2 2 3 3 1 1 0 0
ph3=  0
ph4=  2
ph31= ph1+ph2



