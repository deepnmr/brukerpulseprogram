;hsqcf3gpidphwg
;avance-version (21/09/15)
;IDIS-HSQC
;2D sequence via double inept transfer
;   with isotopical discrimination between 15N{12CO} and 15N{13CO}
;phase sensitive (t1)
;using semi-constant time in t1
;using f3 - channel
;water suppression using watergate sequence
;(use parameterset IDIS-HSQC)
;
;A.P. Golovanov, R.T. Blankley, J.M. Avis & W. Bermel,
;   J. Am. Chem. Soc. 129, 6528-6535 (2007)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d23=16.4m"
"d26=2.3m"


"d28=3u"
"d0=d23-d21-p26-p14-d28-p21*2/3.1416-4u"
"d20=d23-larger(p8,p14)/2"

"in0=inf1/4"

"FACTOR1=d20*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in28 = 0; } else { in28=in0-INCR1; }"


"DELTA1=d23-d21-p26"
"DELTA2=d26-p16-d16-p11-12u"


"TAU=p14"
"TAU2=larger(p8,p14)/2-p14/2"


"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs13=bf2*(cnst26/1000000)-o2"


"l0=0"


1 d11 ze
  d11 pl16:f3 
2 d11 do:f3
3 d1 pl1:f1
  p1 ph1
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph3):f3
  d21 pl19:f1
  (p26 ph2):f1
  4u cpds1:f1 ph1
  d0

  if "l0 %2 == 1"
     {
     (p14:sp3 ph1):f2
     }
  else
     {
     TAU
     }

  d28
  (p22 ph8):f3
  d20

  if "l0 %2 == 1"
     {
     TAU2
     (p14:sp5 ph1):f2
     TAU2
     }
  else
     {
     (p8:sp13 ph1):f2
     }

  d20
  (p22 ph8):f3
  d28

  if "l0 %2 == 1"
     {
     (p14:sp3 ph1):f2
     }
  else
     {
     TAU
     }

  d0
  4u do:f1
  (p26 ph7):f1
  d21
  (p21 ph5):f3

  p16:gp2
  d16 pl0:f1
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp3
  d16
  DELTA2 pl0:f1
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph6):f1
  4u
  DELTA2
  p16:gp3
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 

#if   defined(LABEL_N)
     F0(iu0 & zd)
#endif /*LABEL_N*/
#if   defined(LABEL_NC)
     F0(iu0 & ip31*2 & zd)
#endif /*LABEL_NC*/
#if   !defined(LABEL_N) && !defined(LABEL_NC)
     F1I(iu0, 2)
#endif /*LABEL_N, LABEL_NC*/

     F1PH(calph(ph5, -90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28))
exit


ph1=0
ph2=1 
ph3=0 0 0 0 2 2 2 2
ph5=0 2
ph6=2
ph7=3
ph8=0 0 2 2
ph31=0 2 0 2 2 0 2 0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp13: f2 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0: incremented delay (2D) = d23-d21-p26-p14-d28-p21*2/3.1416-4u
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d23-larger(p8,p14)/2
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NCO)                                       [16.4 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d28: incremented delay (2D)                           [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;o2p: CO chemical shift (cnst21)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(N)) = (1/2) DW(N)
;nd0: 4
;in20: = d20*4/td1 or in0 (without option)
;        d20*2/td1 or in0 (LABEL_N or LABEL_NC)
;in28: = in0 - in20
;ns: 2 * n
;ds: 32
;td0: 1 (without option) or 
;     2 (LABEL_N or LABEL_NC)
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3
;                         50 :   60 :   30

;for z-only gradients:
;gpz1: 50%
;gpz2: 60%
;gpz3: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


;options:
;   without option two interleaved datasets are recorded, which
;      have to be split into one for 15N{12CO} and another for
;      15N{13CO}
;   the options LABEL_N or LABEL_NC will create a single 2D
;      for either 15N{12CO} or 15N{13CO}

                                          ;preprocessor-flags-start
;LABEL_N:   selects 15N{12CO} (eda: ZGOPTNS: -DLABEL_N)
;LABEL_NC:  selects 15N{13CO} (eda: ZGOPTNS: -DLABEL_NC)
                                          ;preprocessor-flags-end



;use AU-program split [ipap 2] to process data 
;   (for interleaved dataset only)



