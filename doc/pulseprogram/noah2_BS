;noah2_BS
;avance-version (19/02/19)
;NOAH-2(BS): HMBC and me-HSQC 
;with adiabatic refocussing and optional multiplicity editing in HSQC
;with two-fold low-pass J-filter to suppress one-bond correlations
;WaveMaker supported
;
;E. Kupce & T.D.W. Claridge, Chem. Commun. 54, 7139 - 7142 (2018)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d2=1s/(cnst2*2)"   ;JCOMP
"d4=1s/(cnst2*4)"
"d6=1s/(cnst13*2)"


"d0=3u" 

"in0=inf1/2"

"l3=td1/4"
 

"DELTA=p16+d16+p2/2+d0-p3*2/PI+4u"  
"DELTA1=d4-p14/2"
"DELTA2=d4+p14/2"
"DELTA3=d2+p3+p2/2"
"DELTA4=DELTA+p3-p2/2"
"DELTA5=DELTA2-p16-d16-p3-de+p1*2/PI-8u"
"DELTA6=DELTA2-p16-d16-de"  
"DELTA11=1s/(2*cnst6)-p16-d16"
"DELTA12=1s/(2*cnst7)-p16-d16"
"DELTA13=d6-p16-d16-4u"


"acqt0=0"
baseopt_echo


1 ze
  30m pl12:f2
2 30m 
3 4m do:f2 
4 50u UNBLKGRAD

  4u pl1:f1
  p16:gp0
  d16
  (p1 ph1)
  4u
  p16:gp0*1.37
  d16
  4u BLKGRAD
  d1 st0

; ZZ-HMBC

  p1 ph1
  DELTA1
  (p14:sp3 ph6):f2 
  (p2 ph1):f1 
  DELTA2 
  p1 ph1
  DELTA1 UNBLKGRAD
  (p14:sp3 ph6):f2 
  (p2 ph1):f1 
  DELTA2 pl2:f2 

  p1 ph1        
  DELTA11
  p16:gp3
  d16
  (p3 ph3):f2 
  DELTA12
  p16:gp4
  d16
  (p3 ph3):f2 
  4u
  p16:gp5
  d16
  DELTA13

  (p3 ph5):f2
  DELTA  
  (p14:sp3 ph6):f2 
  4u
  p16:gp1*EA*0.77  
  d16
  d0 
  (p2 ph4)
  d0
  4u
  p16:gp1*EA*0.77
  d16
  (p14:sp3 ph6):f2 
  DELTA pl2:f2  
  (p3 ph3):f2
  (p2 ph2)    
  4u
  p16:gp2*0.77
  d16
  4u BLKGRAD
  goscnp ph31

  4u pl2:f2
  (p3 ph1):f2
  50u UNBLKGRAD 
  p16:gp0*1.77
  d16
  2m st

; HSQC

  (p1 ph1)
  DELTA1 
  (p14:sp3 ph6):f2 
  (p2 ph1):f1 
  DELTA2 pl2:f2 
  (p1 ph2):f1 
  (p3 ph3):f2
  DELTA  

#ifdef EDIT
  (p31:sp18 ph1):f2 
#else
  (p14:sp3 ph6):f2 
#endif /*EDIT*/

  4u
  p16:gp1*EA
  d16
  d0 
  (p2 ph4)   
  d0
  4u
  p16:gp1*EA
  d16

#ifdef EDIT
  DELTA3  
  (p31:sp18 ph6):f2
  DELTA4   
  (p2 ph2):f1  
  d2 pl2:f2
#else
  (p14:sp3 ph6):f2 
  DELTA pl2:f2
#endif /*EDIT*/

  (p3 ph5):f2
  (p1 ph7):f1    
  DELTA1 
  (p14:sp3 ph6):f2 
  (p2 ph1):f1 
  4u
  p16:gp2
  d16 pl2:f2
  DELTA5 BLKGRAD
  (p3 ph1):f2
  4u pl12:f2
  go=2 ph31 cpd2:f2

  30m wr #0 if #0 zd igrad EA
  4u do:f2

  lo to 3 times 2 

  1m id0
  1m ip3*2  
  1m ip4*2
  1m ip31*2

  lo to 4 times l3  

exit 
  

ph1=0
ph2=1
ph3=0 2 
ph4=0 0 0 0 2 2 2 2 
ph5=0 0 2 2  
ph6=0
ph7=2
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse 180 degree (adiabatic)
;sp18: f2 channel - shaped pulse 180 degree (adiabatic matched sweep)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                         [1 msec]
;p31: f2 channel - 180 degree shaped pulse for adiabatic matched sweep
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J)XH
;d4 : 1/(4J)XH
;d6 : delay for evolution of long range couplings (1/2Jlr)
;d16: delay for homospoil/gradient recovery
;cnst2: = 1J(XH)
;cnst6: = 1J(XH)min
;cnst7: = 1J(XH)max
;cnst13: = nJ(XH) long range
;l3 : loop for 2D experiment = td1/4
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;nbl: 2
;ns: 1 * n
;ds: >= 16
;td1: number of experiments - multiple of NBL
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: 17.13%
;gpz1: 80%
;gpz2: 40.2% for C-13, 16.2% for N-15
;gpz3:  15%
;gpz4: -10%
;gpz5: -5%

;use gradient files:
;gpnam0: SMSQ10.100   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



                                          ;preprocessor-flags-start
;EDIT: for C-13 multiplicity editing start experiment with 
;         option -DEDIT (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;WaveMaker shapes (optional)
;use 'wvm -a' command to create the necessary shape files
;sp18:wvm:wu180Jcomp: wurst-40(280 ppm; Jcomp, L2H)
;sp3:wvm:wu180C13: cawurst-20(60 kHz, 0.5 ms; L2H)
;cpd2:wvm:wudec: cawurst_d-20(220 ppm, 1.4 ms; L2H)


