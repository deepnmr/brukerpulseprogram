;preempgp
;avance-version (20/01/09)
;pulseprogram for preemphasis adjustment
;requires digmod to be analog
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
#include <De.incl>


define list<delay> vd_list=<$VDLIST>


"d11=30m"


define delay dwdel1
define delay dwdel2


"dwdel1=0.25u"
"dwdel2=larger(de1,depa)+dwdel1"


"TAU=aq/8"


1 ze
2 30m

  ACQ_START(ph30,ph31)
  0.05u DWELL_HOLD
  0.1u REC_BLK
  0.1u START_NEXT_SCAN

3 4u BLKGRAD
  d1 pl1:f1
  50u UNBLKGRAD

  p16:gp1
  vd_list

  p0 ph1

  dwdel2
  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  TAU
  0.05u DWELL_HOLD
  0.1u REC_BLK

  d11 vd_list.inc
  lo to 3 times 8

  rcyc=1

  3m wr #0
  d11 BLKGRAD
exit


ph1=0
ph30=0
ph31=0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;p0 : f2 channel -  for any flip angle
;p16: homospoil/gradient pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;vd : variable delay, taken from vd-list
;l4:  (td*decim)/8


