;noediff
;avance-version (13/11/08)
;NOE-difference
;pseudo 2D
;using frequency list to define irradiation frequencies
;using different memory-blocks for on- and off-resonance irradiation
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


define list<frequency> noelist=<$FQ2LIST>


"d11=30m"


"DELTA1=d1-d20"


1 ze
  d11 pl14:f2
  3m noelist:f2 st0
2 6m
3 6m
4 d11
  6m
5 DELTA1
  d20 cw:f2
  4u do:f2
  p1 ph1
  goscnp ph31
  3m noelist.inc
  3m noelist:f2 st
  lo to 3 times nbl
  3m ipp1 ipp31
  3m noelist.res
  lo to 4 times ns
  d11 wr #0 
  3m rppall
  3m zd
  lo to 5 times l4
exit


ph1=0 2 2 0 1 3 3 1 
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl14: f2 channel - power level for cw decoupling
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d20: irradiation time
;l4: l4 = number of averages = (total number of scans) / NS
;ns: 8 * n
;ds: 4
;td1: number of experiments
;NBL: NBL = number of irradiation frequencies

