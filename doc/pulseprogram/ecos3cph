;ecos3cph
;avance-version (12/01/11)
;complementary E.COSY program for KcMAX=3
;   (number of relevant spins = 3)
;phase sensitive
;
;C. Griesinger, O.W. Sorensen & R.R. Ernst, 
;   J. Magn. Reson. 75,474 - 492 (1987)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=



#include <Avance.incl>


"d13=4u"


"in0=inf1"

"d0=in0/2-p1*4/3.1416"


1 ze
2 d1
3 p1 ph1
  d0
  p1 ph2
  d13
  p1 ph3
  go=2 ph31
  d1 mc #0 to 2 F1PH(calph(ph1, +270), caldel(d0, +in0))
exit


ph1=(12) 3 3 3 3 5 5 5 7 11 1 1 1
ph2=(12) 0 0 0 0 2 2 2 4 8 10 10 10
ph3=0
ph31=1 1 1 1 3 3 3 1 1 3 3 3


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d13: short delay                                    [4 usec]
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 12 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



