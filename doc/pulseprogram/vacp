;vacp
;
;TS3 / 08.09.2011
;
;basic cp experiment, contains calculations for various decoupling schemes:
;cw, tppm, xix, amd pidec
;written by STE 11/26/02
;
;
;parameters:
;pl1 : X power level
;sp0 : proton power level during contact
;pl2 : =0W, not used
;pl11 : power level for X pulses
;pl12 : H90 a(and standard dec., if not pl13)
;pl13 : special decoupling power level e.g. spinal64_13
;p1 : X 90 degree pulse
;p3 : H 90 degree pulse
;p15 : contact time
;pcpd2 : pulse length in decoupling sequence TPPM or SPINAL
;d1 : recycle delay
;spnam0 : file name for variable amplitude CP
;cpdprg2 : sequence used for decoupling (tppm15, cw, etc.)
;cnst21 : =0, proton offset
;zgoptns : -Dblew12, -Dxix, -Dpidec, -Dlg
;
;
;$CLASS=Solids
;$DIM=1D
;$TYPE=cross polarisation
;$SUBTYPE=simple 1D
;$COMMENT=basic cp experiment, arbitrary contact and decoupling schemes, optional flipback pulse on X for RF field calibration

prosol relations=<solids_cp>


# ifdef blew12
;pcpd : H 90 at power level pl13 (BLEW12)
;pl13 : used in blew12
# endif /* blew12 */

# ifdef xix
"pcpd=(1s*l31)/cnst31+p29"
;p29 : 5 - 10 us, to avoid exact rotor synchronisation
;l31 : number of rotor cycles for XiX (3)
;cnst31 : spinning frequency
;pl13 : used in xix13
# endif /* xix */

# ifdef pidec
"d30=1s/cnst31-p22"
;p22 : H 180 at power level pl13 (pidec)
;pl13 : used in pidec13
# endif /* pidec */

# ifdef lg
#include <lgcalc.incl>
;p5 : LG 360 degree pulse
;p10 : pulse length for phase modulated pulses (e.g PMLG, DUMBO)
;cnst20 : proton RF field to calculate LG parameters
;cnst22 : +ve Lee-Goldburg offset
;cnst23 : -ve Lee-Goldburg offset
;cnst24 : additional Lee-Goldburg offset
;spnam1 : lgs-1, lgs-4 or pmlg-36, pmlg
;pl13 : used in lgs cpd-program
# endif /* lg */
;cnst11 : to adjust t=0 for acquisition, if digmod = baseopt
"acqt0=0"; for baseopt, can be modiefied for finetuning of t=0 setting

  ze
2 d1 do:f2
  1u fq=cnst21:f2
  (p3 pl12 ph1):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
  (p1 pl11 ph3):f1 (1u cpds2):f2 
  go=2 ph31
  1m do:f2
  wr #0	
exit

ph0= 0
ph1= 1 3
ph2= 0 0 2 2 1 1 3 3
ph3= 1 1 3 3 2 2 0 0
ph10= 0
ph31= 0 2 2 0 1 3 3 1



