;zgf2hfpr
;avance-version (12/01/11)
;1D sequence for H-1 observe with F-19 presaturation on f2
;to be used for H-1/F-19 noe difference
;for QNP-operation (F-19 via X-QNP output of switchbox)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"d11=30m"
"d12=20u"


"acqt0=-p1*2/3.1416"


1 ze
  d11 QNP_X
  d11 pl14:f2
2 30m
  d12 SWITO_F
  4u cw:f2 ph29
  d1
  4u do:f2
  d12 SWITO_H
  p1 ph1
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph29=0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl14: f2 channel - power level for cw decoupling
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for switching                            [20 usec]
;ns: 1 * n, total number of scans: NS * TD0



