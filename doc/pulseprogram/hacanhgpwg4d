;hacanhgpwg4d
;avance-version (21/09/15)
;HACANH
;4D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(Ha,t1) -> F2(Ca,t2) -> F3(N,t3) -> F1(NH,t4)
;
;on/off resonance pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;using semi-constant time in t1
;using semi-constant time in t2
;using semi-constant time in t3
;water suppression using watergate sequence
;(use parameterset )
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d4=1.8m"
"d21=5.5m"
"d23=11m"
"d26=2.7m"
"d27=13.5m"

#   ifdef LABEL_GLY
"d3=4.75m"
#   else
"d3=2.2m"
#   endif /*LABEL_GLY*/


"d32=3u"
"d33=3u"
"d51=3u"
"d52=3u"
"d53=3u"
"d31=d4-p14/2"
"d41=d4+p14/2+d51"
"d42=d27-p14-4u"
"d43=d23-d21-p26-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"
"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"

"FACTOR2=d42*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in32 ) { in42 = in32; } else { in42 = INCR2; }"
"if ( INCR2 > in32 ) { in52 = 0; } else { in52=in32-INCR2; }"

"FACTOR3=d43*10000000*2/td3"
"INCR3=FACTOR3/10000000"

"if ( INCR3 > in33 ) { in43 = in33; } else { in43 = INCR3; }"
"if ( INCR3 > in33 ) { in53 = 0; } else { in53=in33-INCR3; }"


"DELTA1=d27-d32-p14-d52"
"DELTA2=d23-d32"
"DELTA3=d23-d33-p14*2-d53"
"DELTA4=d26-p16-d16-p11-p1*2/PI-12u"
"DELTA5=d26-p16-d16-p11-de-12u"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


"acqt0=0"
baseopt_echo


1 d11 ze
  d11 pl16:f3 
2 d11 do:f3
3 20u pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  50u UNBLKGRAD
  20u pl1:f1 pl3:f3

  (p1 ph3)
  d31
  (p14:sp3 ph1):f2
  d51
  (p2 ph1)
  d41
  (p1 ph2):f1 

  4u
  p16:gp1
  d16 pl19:f1

  (p13:sp2 ph4):f2
  (lalign
   (d3 4u cpds1 ph2):f1
   (d32 p14:sp5 ph1 DELTA1):f2
   (d32 DELTA2 p22 ph1):f3
  )
  d52
  (p14:sp3 ph1):f2
  d42
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u do:f1
  (p26 ph1):f1
  p16:gp2
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph5):f3
  d33
  (p14:sp5 ph1):f2
  DELTA3
  (p14:sp3 ph1):f2
  d53
  (p22 ph1):f3
  d43
  4u do:f1
  (p26 ph7):f1
  d21
  (p21 ph1):f3

  p16:gp3
  d16
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1

  (p1 ph1)
  4u
  p16:gp4
  d16
  DELTA4
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph6):f1
  4u
  DELTA5
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2
     F1PH(calph(ph3, +90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51))
     F2PH(calph(ph4, +90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
     F3PH(calph(ph5, +90), caldel(d33, +in33) & caldel(d43, -in43) & caldel(d53, +in53))
exit


ph1=0
ph2=1 
ph3=0 0 0 0 2 2 2 2
ph4=0 0 2 2
ph5=0 2
ph6=2
ph7=3
ph29=0
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(3J(CH))                                       [2.2 msec or 4.75 msec]
;d4:  1/(4J(CH)                                        [1.8 msec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NCa)                                       [11 msec]
;d26: 1/(4J(NH)                                        [2.7 msec]
;d27: 1/(4J'(NCa)                                      [13.5 msec]
;d31: incremented delay (F1 in 4D) = d4-p14/2
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D)                     [3 usec]
;d41: decremented delay (F1 in 4D) = d4+p14/2+d51
;d42: decremented delay (F2 in 4D) = d27-p14-4u
;d43: decremented delay (F3 in 4D) = d23-d21-p26-4u
;d51: incremented delay (F1 in 4D)                     [3 usec]
;d52: incremented delay (F2 in 4D)                     [3 usec]
;d53: incremented delay (F3 in 4D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ha) = 2 * DW(Ha)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(Ha)) = DW(Ha)
;in32: 1/(2 * SW(Ca)) = DW(Ca)
;in33: 1/(2 * SW(N)) = DW(N)
;in41: = k1 * in31
;in42: = k2 * in32
;in43: = k3 * in33
;in51: = (1 - k1) * in31
;in52: = (1 - k2) * in32
;in53: = (1 - k3) * in33
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_GLY: for Gly signals with same sign as Cb signals start experiment with
;             option -DLABEL_GLY (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



