;hncogphb3d2
;avance-version (21/09/15)
;HNCO - hydrogen bond
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O,t1) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t2
;no H-1 decoupling in t2  and N-15 decoupling t3 
;   to use TROSY effect (no active peak selection in F3)
;(use parameterset HNCOGPHB3D2)
;
;Y.-X. Wang, J. Jacob, F. Cordier, P. Wingfield, S.J. Stahl,
;   S. Lee-Huang, D. Torchia, S. Grzesiek & A. Bax, 
;   J. Biomol. NMR 14, 181-184 (1999)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d13=4u"

"d23=66.6m"
"d25=16.6m"
"d26=2.6m"


"d0=3u"
"d10=3u"
"d30=d23-p16-d16"

"in0=inf1/2"
"in10=inf2/2"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA=d0*2+larger(p14,p22)-p14"
"DELTA1=p16+d16+d13+4u" 
"DELTA3=d23-d10-p14"
"DELTA4=d26-p16-d16"
"DELTA5=d23-d10-p14-d25"

"CEN_CN2=(larger(p14,p22)-p22)/2"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs8=0"
"spoffs15=0"


aqseq 321


1 d11 ze
  d11 pl28:f2 
2 d11 do:f2
3 d1 pl1:f1
  p1 ph1
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  (p21 ph3):f3
  d23

  if "cnst25 == 0"
     {
     (p14:sp3 ph1):f2 (CEN_CN2 p22 ph1 CEN_CN2 d23):f3
     }
  else
     {
     (d25 p14:sp3 ph1):f2 (CEN_CN2 p22 ph1 CEN_CN2 d23):f3
     }
  (p21 ph2):f3

  p16:gp1
  d16

  (p13:sp2 ph4):f2
  d0
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d0
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  p16:gp2
  d16

  (p21 ph2):f3
  d10
  (p14:sp5 ph1):f2
  if "cnst25 == 0"
     {
     (DELTA3 p14:sp3 ph1):f2 (DELTA3 CEN_CN2 p22 ph8 CEN_CN2):f3
     }
  else
     {
     (DELTA5 p14:sp3 ph1):f2 (DELTA3 CEN_CN2 p22 ph8 CEN_CN2):f3
     }
  d30
  p16:gp3*EA
  d16

  (center (p1 ph1) (p21 ph5):f3 )
  p16:gp4
  d16
  DELTA4
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p16:gp4
  d16
  (center (p1 ph2) (p21 ph6):f3 )
  p16:gp5
  d16
  DELTA4
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p16:gp5
  d16
  (p1 ph1)
  DELTA1
  (p2 ph1)
  d13
  p16:gp6
  d16 pl28:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d0, +in0)) 
     F2EA(calgrad(EA) & calph(ph6, +180), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0 2
ph5=0 0 2 2
ph6=3 3 1 1
ph7=3
ph8=0 0 0 0 2 2 2 2
ph31=0 2 2 0 0 2 2 0 2 0 0 2 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl28: f2 channel - power level for selective Ca or CO decoupling
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;sp15: f2 channel - shaped pulse 180 degree for decoupling
;                                           (C=O on resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p31: f2 channel - 180 degree pulse for decoupling sequence
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d13: short delay                                      [4 usec]
;d16: delay for homospoil/gradient recovery
;d23: 1/(1J(NCO)                                       [66.6 msec]
;d25: 1/(4J(NCO)                                       [16.6 msec]
;d26: 1/(4J'(NH)                                       [2.6 msec]
;d30: decremented delay (F2 in 3D) = d23-p16-d16
;cnst21: CO chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;cnst25: = 0 for cross peak experiment
;          1 for reference experiment
;cnst22: Calpha chemical shift (offset, in ppm)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in30: = in10
;ns: 16 * n
;ds: = 32
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpd2: decoupling according to sequence defined by cpdprg2 : mlevsp180.p31


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6
;                         21 :   38 :   80 :   30 :   30 :  8.1

;for z-only gradients:
;gpz1: 21%
;gpz2: 38%
;gpz3: 80%
;gpz4: 30%
;gpz5: 30%
;gpz6: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



