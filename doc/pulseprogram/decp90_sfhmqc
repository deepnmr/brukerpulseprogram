;decp90_sfhmqc
;avance-version (21/11/23)
;calibration of 90 degree pulse on f2 channel based on SOFAST HMQC
;with decoupling during acquisition
;
;P.Schanda and B. Brutscher, J. Am. Chem. Soc. 127, 8014 (2005)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d2=1s/(cnst2*2)"


#   ifdef CALC_SP
"p39=(bwfac23/(cnst55*cnst49*bf1))*1000000"
"spw23=plw1*pow((p1*totrot23)/(p39*90.0*integfac23),2)"
"spoal23=1"

"p40=(bwfac24/(cnst55*cnst50*bf1))*1000000"
"spw24=plw1*pow((p1*totrot24)/(p40*90.0*integfac24),2)"
"spoal24=0.5"
#   endif /*CALC_SP*/


"DELTA1=d2-p16-d16-p39*cnst39"
"DELTA2=p39*cnst39-de-4u"


"spoffs23=bf1*(cnst54/1000000)-o1"
"spoffs24=bf1*(cnst54/1000000)-o1"


1 ze 
  d11 pl12:f2
2 d1 do:f2
3 d12 pl2:f2
  50u UNBLKGRAD

  p16:gp2
  d16

  (p39:sp23 ph1):f1
  p16:gp1
  d16

  (center (p40:sp24 ph2):f1 (DELTA1 p3*2 ph3 3u p3 ph4 DELTA1):f2 )

  DELTA2
  p16:gp1
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d1 do:f2 mc #0 to 2 F0(zd) 
exit 
  

ph1=0 
ph2=0 
ph3=0 2
ph4=0 0 2 2
ph31=0 2 2 0


;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp23: f1 channel - shaped pulse 120 degree (Pc9_4_120.1000)
;sp24: f1 channel - shaped pulse 180 degree (Rsnob.1000)
;p3: f2 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p39: f1 channel - 120 degree shaped pulse for excitation
;                      Pc9_4_120.1000 (120o)    (2.4ms at 600.13 MHz)
;p40: f1 channel - 180 degree shaped pulse for refocussing
;                      Rsnob.1000               (0.8ms at 600.13 MHz)
;d1 : relaxation delay
;d2 : 1/(2J)CH
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(CH)
;cnst39: compensation of chemical shift evolution during p39
;           Pc9_4_120.1000: 0.529
;cnst49: scaling factor for p41 to compensate for transition region
;           Pc9_4_120.1000: 1.074
;cnst50: scaling factor for p41 to compensate for transition region
;           Rsnob.1000: 1.000
;cnst54: H(C) chemical shift (offset, in ppm)
;cnst55: H(C) bandwidth (in ppm)
;ns: 4 * n
;ds: 16
;aq: <= 50 msec
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 11%
;gpz2:  7%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54 and cnst55
;             option -DCALC_SP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



