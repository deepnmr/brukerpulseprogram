;roesyetgp.2
;avance-version (12/01/11)
;2D ROESY with cw spinlock for mixing
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;spinlock using 180x 180-x pulses
;
;A. Bax & D.G. Davis, J. Magn. Reson 63, 207-213 (1985)
;T.-L. Hwang & A.J. Shaka, J. Am. Chem. Soc. 114, 3157-3159 (1992)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d11=30m"


"in0=inf1"

"d0=3u"


"DELTA=p16+d16+d0"
"DELTA1=p16+d16+8u"


"l4=p15/(p25*2)"


1 ze
2 d11
3 d1 pl1:f1
  50u UNBLKGRAD
  p1 ph1
  DELTA
  p2 ph2
  d0
  p16:gp1*EA
  d16 pl27:f1
4 p25 ph3
  p25 ph4
  lo to 4 times l4
  DELTA1 pl1:f1
  p2 ph2
  4u
  p16:gp2
  d16
  4u BLKGRAD
  go=2 ph31
  d11 mc #0 to 2 F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph1, +180) & calph(ph31, +180))
exit


ph1=0 2
ph2=0
ph3=0 0 2 2
ph4=2 2 0 0
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;pl27: f1 channel - power level for pulsed ROESY-spinlock
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p15: f1 channel - pulse for ROESY spinlock
;p16: homospoil/gradient pulse
;p25: f1 channel - 180 degree pulse at pl27
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;l4: loop for spinlock = p15 / p25*2
;in0: 1/(1 * SW) = 2 * DW
;inf1: 1/SW = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho


;use gradient ratio:	gp 1 : gp 2
; 		          30 :   30

;for z-only gradients:
;gpz1: 30%
;gpz2: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



;$Id:$
