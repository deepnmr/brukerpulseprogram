;cosygpphzfzs
;avance-version (12/01/11)
;2D homonuclear shift correlation
;phase sensitive
;
;M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>


define pulse P_beta
define pulse P_beta2

"P_beta=p1*2/9"
"P_beta2=p1*11/9"


"d11=30m"

"p31=5m"


"in0=inf1"

"d0=in0/2-p1*2/3.1416-P_beta2*2/3.1416"


1 ze
2 d11 pl10:f1
  p17 ph2
  p17*2 ph3
  d1 pl1:f1
3 p1 ph1
  d0
  P_beta2 ph2
  50u UNBLKGRAD
  10u gron0
  (p32:sp29 ph2):f1
  20u groff
  p31:gp1
  d16 pl1:f1
  4u BLKGRAD
  P_beta ph2
  go=2 ph31
  d11 mc #0 to 2 F1PH(calph(ph1, +90), caldel(d0, +in0))
exit


ph1=0 2
ph2=0
ph3=1
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;sp29: f1 channel - shaped pulse (adiabatic)
;p0 : f1 channel -  20 to 90 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p17: f1 channel - trim pulse                               [2.5 msec]
;p31: gradient pulse 5                                      [5 msec]
;p32: f1 channel - 180 degree shaped pulse (adiabatic)      [20 msec]
;     smoothed chirp (sweepwidth, 20% smoothing, 10000 points)
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                                    [30 msec]
;d16: delay for homospoil/gradient recovery
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEC


;use gradient ratio:    gp 0 : gp 1
;                     ca. 10 :   40

;for z-only gradients:
;gpz0: ca. 10%
;gpz1: 40%

;use gradient files:
;gpnam1: SMSQ10.100



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



;for sweepwidth of adiabatic shape and adjusting gpz0
;   see supplementary material of M.J. Thrippleton & J. Keeler, 
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)



