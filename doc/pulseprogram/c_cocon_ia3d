;c_cocon_ia3d
;avance-version (21/09/15)
;COCON
;3D sequence with
;   homonuclear Hartman-Hahn transfer using MOCCA-XY16
;      sequence for mixing
;on/off resonance 13C pulses using hard and shaped pulses
;phase sensitive (t1)
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;I.C. Felli, R. Pierattelli, S.J. Glaser & B. Luy, 
;   J. Biomol. NMR 43, 187-196 (2009)
;W. Bermel, I. Bertini, I.C. Felli, Y.-M. Lee, C. Luchinat & R. Pierattelli,
;   J. Am. Chem. Soc. 128, 3918-3919 
;(S. Balayssac, B. Jimenez & M. Piccioli,
;   J. Magn. Reson. 182, 325-329 (2006))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p22=p21*2"
"d11=30m"
"d12=20u"

"d22=4.5m"
"d23=15.0m"

"d21=300u"


"d0=3u"
"d10=3u"

"in0=inf1/2"
"in10=inf2/2"


"TAU=d21/2"

"FACTOR1=(d9/((d21+p14)*16))"
"l1=FACTOR1*16"

"d31=(d21+p14)*l1"


"DELTA=d0*2"
"DELTA1=d10*2+p8"
"DELTA2=d23/2-p12/2"
"DELTA3=d23-d22-p12"


"l0=0"


"spoffs13=bf1*((cnst21/2+cnst22/2)/1000000)-o1"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*(cnst22/1000000)-o1"


aqseq 321


1 ze 
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 pl1:f1
  20u rpp11
  50u UNBLKGRAD
  d12 cpd2:f2 cpd3:f3

  (p11:sp23 ph3)
  d0
  (p12:sp26 ph1)
  d0
  4u
  (p12:sp24 ph1)
  DELTA
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph4)

  4u do:f2 do:f3
  p16:gp1
  d16 pl20:f1

						;begin MOCCA-XY16
4 TAU
  (p14 ph11)
  TAU ipp11
  lo to 4 times l1
						;end MOCCA-XY16

  p16:gp2
  d16 pl3:f3
  20u cpd2:f2

  (p11:sp23 ph1)
  d23
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d23
  (p11:sp25 ph2)

  4u do:f2
  p16:gp3
  d16
  20u cpd2:f2

  (p21 ph5):f3
  d10
  (p8:sp13 ph6)
  d10
  (p22 ph1):f3
  DELTA1
  (p21 ph1):f3

  if "l0 %2 == 0"
     {
     (p11:sp23 ph1)
     DELTA2
     (p12:sp26 ph1)
     DELTA2
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA2
     (p12:sp26 ph1)
     DELTA2 pl16:f3
     }
  else
     {
     (p11:sp23 ph7)
     d22
     (p12:sp26 ph1)
     DELTA3
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA2
     DELTA2 pl16:f3
     (p12:sp26 ph1)
     }

  4u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 

#   ifdef LABEL_F1
     F1I(iu0, 2)
#   else
     F2I(iu0, 2)
#   endif /*LABEL_F1*/

     F1PH(calph(ph3, +90), caldel(d0, +in0))
     F2PH(calph(ph5, +90), caldel(d10, +in10))

  d31
exit 


ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2 
ph7=3
ph11=0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;pl20: f1 channel - power level for TOCSY (high sel.)
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;p8 : f1 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p14: f1 channel - 180 degree low power pulse at pl20
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: delay for MOCCA sequence                         [300 usec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCO))                                      [15.0 msec]
;d31: total mixing time as executed
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;l1: loop for MOCCA-XY16 cycle: ((TAU*2+p14)*16 * l1) = mixing time
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in10: 1/(2 * SW(N)) =  DW(N)
;nd10: 2
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 70%
;gpz3: 50%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;use AU-program splitcomb [ipap 2] to process data



