;qcpmg (TopSpin 4.0)
;avance-version (20/11/23)
;
; TS4 / 2018/01/26
;
; HK 11/26/2024 
;

;
;$CLASS=Solids
;$DIM=1D
;$TYPE=half integer quadrupoles
;$SUBTYPE=simple 1D
;$COMMENT=QCPMG sequence, synchronised to spinning frequency, number of echoes calculated from aq

prosol relations=<solids_ICON_QN>

#include <Avance.incl>
#include <De.incl>

;for digmod=baseopt
"acqt0=0"

define delay echo1
define delay echo2
define delay dead
define delay rest
define delay data 
define loopcounter echoes

"data=d6"
"d3=p9"
"p2=p1*2"
#ifdef rot
"d31=1s/cnst31"
"l3=round((data+p9)/d31+0.5)"
"echo1=d31*l3-3*p1/2-dw-d3"
"echo2=l3*d31-p1"

#else 
"echo1=1u"
"echo2=d6+p9"
#endif 
"dead=echo2-data" 
"echoes=(aq-data)/(2*data+2*dead+p2)-0.5"
"rest=aq-echoes*(2*data+2*dead+p2)-data"

#ifdef dec
#include <Decoup_Solids.incl>
#endif

baseopt_echo

1 ze

Start, 10m

 d1
   ACQ_START(ph30,ph31)
  1u REC_BLK
#ifdef dec 
  (p1 pl1 ph1):f1 (1u cpds2):f2
#else
(p1 pl1 ph1):f1 
#endif
  echo1
  0.025u
  d3
  dw
  (p2 ph2):f1
  dw 
  echo1
  d3 
  0.025u START_NEXT_SCAN
3 data REC_UNBLK
  dead REC_BLK
  (p2 pl1 ph3):f1
  dead
  data REC_UNBLK
  lo to 3 times echoes
  data
  rest REC_BLK
#ifdef dec
  1u do:f2
#else
 1u
#endif
  rcyc=Start 

 
  10m mc #0 to Start F0(zd)
exit

ph0=0
ph1=0 2
ph2=1 1 3 3
ph3=1 1 1 1 3 3 3 3
ph30=0
ph31=2 0

;
;parameters:
;pl1 : RF power level
;pl11 : =pl1 usually, =120 dB if 180s are not desired
;p1 : 90 degree pulse
;p2 : 180 degree pulse
;p9 : time to allow pulse ringdown, 10 to 100 us
;ns : 16 * n
;d1 : recycle delay
;d6 : enter expected rise/fall time of half echo
;l22 : # of echos to be acquired
;cnst1 : set td to number of acquired complex data points
;cnst31 : MAS frequency  if ZGOPTNS= -Drot
;ZGOPTNS : -Drot for MAS synchronization
;

;$Id:$
