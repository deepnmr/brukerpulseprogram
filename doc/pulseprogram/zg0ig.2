;zg0ig.2
;avance-version (19/01/31)
;1D sequence with inverse gated decoupling
;using p0 for any flip angle
;for MPF decoupling
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"d11=30m"


#   ifdef ERNSTANG
"cnst18=DEG*(acos(1*(exp(-(d1+aq)/cnst10))))"
#   endif /* ERNSTANG */  

#if   defined(CALC_P0) || defined(ERNSTANG)
"p0=p1*cnst18/90.0"
#   endif /* CALC_P0, ERNSTANG */  


"acqt0=-tan((p0/p1)*(PI/4))*p1*2/PI"


1 ze
  d11 pl37:f2
2 30m do:f2
  d1
  p0 ph1
  go=2 ph31 cpd2:f2
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl37: f2 channel - power level for CPD/BB decoupling (for mpf decoupling)
;p0 : for any flip angle
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;cnst10: estimated or measured T1 of sample
;cnst18: flip angle in degree
;ns: 1 * n, total number of scans: NS * TD0
;cpd2: decoupling according to sequence defined by cpdprg2: mpf9.p61
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence for mpf pulse
;cpdprg2: mpf9.p61



                                          ;preprocessor-flags-start
;ERNSTANG: to use the ernst-angle, enter T1 as cnst10 
;             option -DERNSTANG (eda: ZGOPTNS) 
;CALC_P0: to run the experiment with a defined flip angle (defined as cnst18)
;            option -DCALC_P0 (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



