;hncocacbgpwg5d.2
;avance-version (21/09/15)
;HNCOCACB
;5D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N,t1) -> F2(C=O,t2) -> F2(Ca -> Cb,t3, -> Ca,t4)
;            -> F2(C=O) -> F3(N) -> F1(H,t5)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;phase sensitive (t4)
;using semi-constant time in t1
;using semi-constant time in t2
;using constant time in t4
;water suppression using watergate sequence
;(use parameterset )
;
;(T. Yamazaki, W. Lee, C.H. Arrowsmith, D.R. Muhandiram & L.E. Kay,
;   J. Am. Chem. Soc. 116, 11655-11666 (1994))
;
;$CLASS=HighRes
;$DIM=5D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d22=4m"
"d23=12.4m"
"d26=2.3m"
"d28=7.2m"

#   ifdef LABEL_GLY
"d29=6.8m"
#   else
#   endif /*LABEL_GLY*/


"d31=3u"
"d32=3u"
"d33=3u"
"d34=3u"
"d51=3u"
"d52=3u"
"d41=d23-d21-p26"
"d42=d22-4u"
"d44=d28-p14-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"
"in34=inf4/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"
"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"

"FACTOR2=d42*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in32 ) { in42 = in32; } else { in42 = INCR2; }"
"if ( INCR2 > in32 ) { in52 = 0; } else { in52=in32-INCR2; }"

"in44=in34"

"td4=tdmax(td4,d44*2,in44)"


"DELTA1=d23-d21-p26-4u"
"DELTA2=d22-p14-4u"
"DELTA3=d33*2+larger(p14,p22)-p14"
"DELTA4=d28-d34-larger(p14,p22)"
"DELTA5=d22-d32-p22-d52"
"DELTA6=d23-d31-p14*2-d51"
"DELTA7=d26-p16-d16-p11-12u"

#   ifdef LABEL_GLY
"DELTA8=d28-d29-p26*2-4u"
#   else
#   endif /*LABEL_GLY*/


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst23)/1000000)"
"spoffs8=0"


"o1_F2=bf2*cnst21/1000000"
"o1_F3=bf2*cnst23/1000000"
"o1_F4=bf2*cnst23/1000000"


1 d11 ze
  d11 pl16:f3 
2 d11 do:f3
3 d1 pl1:f1 fq=cnst21(bf ppm):f2
  (p1 ph1)
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  4u
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph5):f3
  d21 pl19:f1
  (p26 ph2):f1
  d41 cpds1:f1 ph1
  (p22 ph1):f3
  d51
  (p14:sp3 ph1):f2
  DELTA6
  (p14:sp5 ph1):f2
  d31
  (p21 ph1):f3

  4u
  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp5
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p13:sp2 ph3):f2
  d32
  (p22 ph1):f3
  DELTA5
  (p14:sp5 ph1):f2
  d52
  (p14:sp3 ph1):f2
  d42
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2

  4u
  30u fq=cnst23(bf ppm):f2

  (p13:sp2 ph4):f2

#   ifdef LABEL_GLY
  4u do:f1
  (p26 ph7):f1
  d29
  (p26 ph2):f1
  DELTA8 cpds1:f1 ph1
#   else
  d28
#   endif /*LABEL_GLY*/

  (p14:sp3 ph1):f2
  d28
  (p13:sp8 ph2):f2

  d33
  (center (p14:sp7 ph1):f2 (p22 ph8):f3 )
  d33
  4u
  (p14:sp3 ph1):f2
  DELTA3
  (p14:sp7 ph1):f2
  4u

  (p13:sp2 ph9):f2
  d34
  (center (p14:sp7 ph1):f2 (p22 ph8):f3 )
  DELTA4
  (p14:sp3 ph10):f2
  d44
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph11):f2

  4u
  30u fq=cnst21(bf ppm):f2

  (p13:sp2 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA2
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA2
  (p13:sp8 ph2):f2

  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph1):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph8):f3 )
  DELTA1
  4u do:f1
  (p26 ph7):f1
  d21
  (p21 ph1):f3

  p16:gp3
  d16
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA7
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph6):f1
  4u
  DELTA7
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph5, -90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51))
     F2PH(calph(ph3, +90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
     F3PH(calph(ph9, +90) & calph(ph10, +90) & calph(ph11, +90), caldel(d33, +in33))
     F4PH(calph(ph11, +90), caldel(d34, +in34) & caldel(d44, -in44))
exit


ph1=0
ph2=1 
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0
ph5=0 0 2 2
ph6=2
ph7=3
ph8=0 0 2 2
ph9=3 1
ph10=0
ph11=0 2 0 2 2 0 2 0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: 1/(4J(COCa)                                      [4 msec]
;d23: 1/(4J(NCO)                                       [12.4 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d28: 1/(4J(CaCb)                                      [7.2 msec]
;d29: 1/(8J(CaHa))                                     [6.8 msec]
;d31: incremented delay (F1 in 5D)                     [3 usec]
;d32: incremented delay (F2 in 5D)                     [3 usec]
;d33: incremented delay (F3 in 5D)                     [3 usec]
;d34: incremented delay (F4 in 5D)                     [3 usec]
;d41: decremented delay (F1 in 5D) = d23-d21-p26
;d42: decremented delay (F2 in 5D) = d22-4u
;d44: decremented delay (F4 in 5D) = d28-p14-4u
;d51: incremented delay (F1 in 5D)                     [3 usec]
;d52: incremented delay (F2 in 5D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(N) = 2 * DW(N)
;inf2: 1/SW(CO) = 2 * DW(CO)
;inf3: 1/SW(Cb) = 2 * DW(Cb)
;inf4: 1/SW(Ca) = 2 * DW(Ca)
;in31: 1/(2 * SW(N)) = DW(N)
;in32: 1/(2 * SW(CO)) = DW(CO)
;in33: 1/(2 * SW(Cb)) = DW(Cb)
;in34: 1/(2 * SW(Ca)) = DW(Ca)
;in41: = k1 * in31
;in42: = k2 * in32
;in44: = in34
;in51: = (1 - k1) * in31
;in52: = (1 - k2) * in32
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;td4: number of experiments in F4       td4 max = 2 * d44 / in44
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;FnMODE: States-TPPI (or TPPI) in F4
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%
;gpz5: 20%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_GLY: for Gly signals with same sign as Cb signals start experiment with
;             option -DLABEL_GLY (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id: $
