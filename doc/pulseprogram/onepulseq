;onepulseq
;
;TS3 / 05.07.2011
;
;
;single pulse excitation, acquisition without decoupling
;uses parameters suitable for MQMAS and STMAS 
;
;
;Avance III version
;parameters:
;pl1 : =0W, not used here
;pl21 : power level for excitation pulse
;p3 : excitation pulse length
;d1 : recycle delay
;
;
;$CLASS=Solids
;$DIM=1D
;$TYPE=direct excitation
;$SUBTYPE=simple 1D
;$COMMENT=single pulse excitation, acquisition without decoupling, parameters suitable for MQMAS

prosol relations=<solids_default>

"acqt0=-p3/2"

1 ze
2 d1
  (p3 pl21 ph1):f1
  go=2 ph31
  wr #0
exit

ph1= 0 2 1 3
ph31=0 2 1 3



