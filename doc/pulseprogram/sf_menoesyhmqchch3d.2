;sf_menoesyhmqchch3d.2
;avance-version (22/04/22)
;3D SOFAST NOESY HMQC (HCH)
;
;    H(all),t1 -> NOE -> H(methyl) -> C(methyl),t2 ->  H(methyl), t3
;
;using methyl selective 1H pulses
;optmized for large deuterated proteins with methyl group selective 1H/13C-labelling
;(use parameterset SF_MENOESYHMQCHCH3D.2)
;
;P. Rossi, Y. Xia, N. Khanra & G. Veglia & G. Kalodimos,
;  J. Biomol. NMR 66, 259 (2016)
;P.Schanda and B. Brutscher, J. Am. Chem. Soc. 127, 8014 (2005)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d2=1s/(cnst2*2)"

"p2=2*p1"
#   ifdef CALC_SP

;cnst49/52: scaling factors for bandwidth, used in calculation of shaped pulses in orignal
;publication (cnst49 for Pc9_4_90.1000: 1.172, cnst52 for Reburp.1000: 1.426),
;set to 1.0 in case other shapes are used:
"cnst49=1.172"
"cnst52=1.426"

"p39=(bwfac23/(cnst55*cnst49*bf1))*1000000"
"spw23=plw1/(((p39*90.0)/(p1*cnst10))*((p39*90.0)/(p1*cnst10))*(integfac23*integfac23))"
"spoal23=1"

"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1/(((p42*90.0)/(p1*totrot26))*((p42*90.0)/(p1*totrot26))*(integfac26*integfac26))"
"spoal26=0.5"

"p43=(bwfac28/(cnst55*cnst53*bf1))*1000000"
"spw28=plw1/(((p43*90.0)/(p1*totrot28))*((p43*90.0)/(p1*totrot28))*(integfac28*integfac28))"
"spw29=plw1/(((p43*90.0)/(p1*totrot29))*((p43*90.0)/(p1*totrot29))*(integfac29*integfac29))"
"spoal28=1"
"spoal29=0"
#   endif /*CALC_SP*/


"in0=inf1"
"in10=inf2"

"d0=in0/2-4*p1/PI"
"d10=in10/2-p3*4/PI"


"DELTA1=p35/2-p1-d0/2"
"DELTA2=d2-p16-d16-p39*cnst39"
"DELTA3=p39*cnst39-de-4u"

"TAU=d8-p3-p16-d16-54u-DELTA1-p39*(1-cnst39)"

"spoffs23=bf1*(cnst54/1000000)-o1"
"spoffs25=bf1*(cnst54/1000000)-o1"
"spoffs26=bf1*(cnst54/1000000)-o1"
"spoffs27=bf1*(cnst54/1000000)-o1"
"spoffs28=bf1*(cnst54/1000000)-o1"
"spoffs29=bf1*(cnst54/1000000)-o1"
"spoffs41=bf2*(cnst56/1000000)-o2"


"acqt0=0"
baseopt_echo

aqseq 321

1 ze 
  d11 pl12:f2 pl3:f3
2 d1 do:f2
3 d12 pl2:f2 pl1:f1
  50u UNBLKGRAD
  (p3 ph1):f2
  p16:gp0
  d16

  (center (DELTA1 p1 ph3 d0 p1 ph1 DELTA1):f1  (p35:sp41 ph1):f2 (p22 ph1):f3)

  4u BLKGRAD
  TAU
  50u UNBLKGRAD pl2:f2 
  (p3 ph1):f2
  p16:gp1
  d16

  (p39:sp23 ph1):f1
  p16:gp3
  d16
  (center (p42:sp26 ph7):f1 (DELTA2 p3 ph4 d10 p3 ph1 DELTA2):f2 )
  DELTA3
  p16:gp3
  d16 pl12:f2
  4u BLKGRAD

  go=2 ph31 cpd2:f2 
  d1 do:f2 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0))
     F2PH(calph(ph4, +90), caldel(d10, +in10))
exit 
  

ph1=0 
ph2=0 
ph3=0 2 0 2
ph4=0 0 2 2
ph5=0 0 0 0 
ph6=0 0 0 0 
ph7=0 0 0 0 1 1 1 1 
ph31=0 2 2 0 2 0 0 2

;pl1 : f1 channel - power level for pulse
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for decoupling (high power = 4 * plw14)
;pl14: f2 channel - power level for decoupling (low power)
;
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp23: f1 channel - shaped pulse 90 degree (Pc9_4_90.1000)
;spnam23: f1 channel - shaped pulse 90 degree (Pc9_4_90.1000)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;spnam26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp41: f2 channel - shaped pulse 180 pulse   (Bip720)
;spnam41: f2 channel - shaped pulse 180 pulse   (Bip720)
;
;p1 : f1 channel -  90 degree high power pulse 
;p3 : f2 channel -  90 degree high power pulse 
;p16: homospoil/gradient pulse                       [1 msec]
;p22: f3 channel - 180 degree high power pulse
;p35: f2 channel - 180 degree shaped pulse for decoupling during t1 (Bip720)
;p39: f1 channel - 90 degree shaped pulse for excitation (Pc9_4_90.1000) 
;p42: f1 channel - 180 degree shaped pulse for refocussing (Reburp.1000)
;p61: f2 channel -  90 degree pulse at pl14 (low power decoupling)

;d0 : incremented delay (2D) = in0/2-p3*4/3.1415
;d1 : relaxation delay
;d2 : 1/(2J)CH
;d8 : NOESY mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery

;cnst2: = J(CH) in Hz [130]
;cnst10: Excitation flip angle                 [90 - 110 deg.]
;cnst39: compensation of chemical shift evolution during PC9 pulse [~0.52] 
;        optimize for 0 first order phase in F3
;cnst49: scaling factor for Pc9 bandwidth (Pc9_4_90.1000: 1.172)
;cnst52: scaling factor for Reburp bandwidth (Reburp.1000: 1.426)
;  

;cnst54: H(Methyl) chemical shift (offset, in ppm) [~1]
;cnst55: H(Methyl) bandwidth (in ppm) [~4]
;cnst56: offset for 13C decoupling during t1 (in ppm), set to 15 (only methyls) or 70 (all)
;inf1: 1/SW(C) = 2 * DW(C)
;in0: 1/SW(C) = 2 * DW(C)
;nd0: 1
;inf2: 1/SW(C) = 2 * DW(C)
;in10: 1/SW(C) = 2 * DW(C)
;nd10: 1
;ns: 4 * n
;ds: >=64
;aq: <= 50 msec
;td1: number of experiments
;FnMODE: States-TPPI in F1
;FnMODE: States-TPPI in F2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;cpdprg2: bilevel decoupling (bi_garp4_2plcp.p61)


;for z-only gradients:
;gpz0: 40%
;gpz1: 11%
;gpz2: 27%
;gpz3:  7%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam0: SMSQ10.100


                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54 and cnst55 use
;             option -DCALC_SP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1



