;sfhmqcf3gpphiasi
;avance-version (21/09/15)
;SOFAST HMQC
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;phase sensitive
;with decoupling during acquisition
;sensitivity improved
;(use parameterset SFHMQCF3GPPHIASI)
;
;T. Kern, P.Schanda & B. Brutscher, J. Magn. Reson. 190, 333-338 (2008)
;(P.Schanda and B. Brutscher, J. Am. Chem. Soc. 127, 8014 (2005))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d12=20u"
"d26=1s/(cnst4*4)"


#   ifdef CALC_SP
"p39=(bwfac23/(cnst55*cnst49*bf1))*1000000"
"spw23=plw1*pow((p1*totrot23)/(p39*90.0*integfac23),2)"
"spoal23=1"

"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1*pow((p1*totrot26)/(p42*90.0*integfac26),2)"
"spoal26=0.5"
#   endif /*CALC_SP*/


"in0=inf1"

"d0=in0/2-p21*4/PI"


"DELTA1=d26-p39*cnst39-p42*cnst42"
"DELTA2=p19+d16"
"DELTA3=d26-p19-d16-p42*cnst42"
"DELTA4=d26-p19-d16-p21-p42*cnst42-de-4u"


"spoffs23=bf1*(cnst54/1000000)-o1"
"spoffs26=bf1*(cnst54/1000000)-o1"


"l0=0"


"acqt0=0"
baseopt_echo


1 ze 
2 d1
3 d12
  50u UNBLKGRAD

  20u
  "cnst31=(l0%2)*90"

  3m ip2+cnst31

  p16:gp2
  d16

  (p39:sp23 ph1):f1
  DELTA1
  (center (p42:sp26 ph1):f1 (p22 ph1):f3 )
  DELTA2

#   ifdef LABEL_CN
  (center (p42:sp26 ph1):f1 (p8:sp13 ph1):f2 (DELTA3 p21 ph2 d0 p21 ph3 DELTA3):f3 )
#   else
  (center (p42:sp26 ph1):f1 (DELTA3 p21 ph2 d0 p21 ph3 DELTA3):f3 )
#   endif /*LABEL_CN*/

  p19:gp1
  d16
  (center (p42:sp26 ph1):f1 (p22 ph1):f3 )
  p19:gp1
  d16
  DELTA4 
  4u BLKGRAD
  (p21 ph4):f3
  go=2 ph31
  d1 mc #0 to 2 
     F1I(iu0, 2)
     F1EA(calph(ph4, +180), caldel(d0, +in0))
exit 
  

ph1=0 
ph2=0 2
ph3=0
ph4=1
ph31=0 2


;pl3 : f3 channel - power level for pulse (default)
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp23: f1 channel - shaped pulse 120 degree 
;                   (Pc9_4_120.1000 or Q5.1000)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                       [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p39: f1 channel - 120 degree shaped pulse for excitation
;                      Pc9_4_120.1000 (120o)    (2.4ms at 600.13 MHz)
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000              (1.4ms at 600.13 MHz)
;d0 : incremented delay (2D) = in0/2-p21*4/PI
;d1 : relaxation delay
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d26 : 1/(4J)NH
;cnst4: = J(NH)
;cnst39: compensation of chemical shift evolution during p39
;           Pc9_4_120.1000: 0.529
;           Q5.1000: -0.07
;cnst42: compensation of chemical shift evolution during p42
;           Reburp.1000: 0.5
;cnst49: scaling factor for p39 to compensate for transition region
;           Pc9_4_120.1000: 1.074
;cnst52: scaling factor for p42 to compensate for transition region
;           Reburp.1000: 1.426
;cnst54: H(N) chemical shift (offset, in ppm)
;cnst55: H(N) bandwidth (in ppm)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/ SW(N) = 2 * DW(N)
;nd0: 1
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho


;for z-only gradients:
;gpz1: 22%
;gpz2:  7%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54 and cnst55
;             option -DCALC_SP (eda: ZGOPTNS)
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;Processing

;use AU-program splitcomb [sf_si] to process data

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



