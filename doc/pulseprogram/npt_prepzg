;$Id:$
;1D sequence for 2D dataset
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"acqt0=-p1*2/3.1416"

1 ze
2 30m
  d1
  p1 ph1
  go=2 ph31
  30m mc #0 to 2 F1QF()
exit

ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;NS: 1 * n, total number of scans: NS * TD0
