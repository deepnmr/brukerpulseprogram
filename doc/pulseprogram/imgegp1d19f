;imgegp1d19f
;avance-version (12/01/11)
;1D Gradient Echo for gradshim-procedure
;using 19F lockswitch unit 
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include<Avance.incl>
#include<Grad.incl>
#include<De.incl>
#include<Sysconf.incl>



"d11=30m"
"d12=20u"


1 ze
  d11 FLOCKDEC_ON
  d11 UNBLKGRAMP
  d11 F19_PULSE
2 d1 
  4u reset:f1
  d12 reset:F
  (p1*0.15 ph1):F
  d27 gron1
  5u groff
  d15
  d21 gron2
  ACQ_START(ph30,ph31)
  aq DWELL_GEN:f1
  5u groff
  rcyc=2
  400m wr #0
  d11 F19_LOCK
  d11 BLKGRAMP
  d11 FLOCKDEC_OFF
exit


ph1=0 2 1 3
ph30=0
ph31=0 2 1 3


;pl_ : f_ channel - power level for pulse (default)
;p1 : f_ channel -  90 degree high power pulse
;d1 : relaxation delay
;d11: delay for disk I/O                             [30 msec]
;d15: echo time
;d21: gradient stabilisation delay
;d27: length of dephasing gradient (phase encode time)
;ns: 1 * n
;ds: 0


;define channel number in Sysconf.incl (default is f1)



