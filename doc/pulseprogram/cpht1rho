;cpht1rho
;
;TS 4 / 2020/11/02
;
;checked by GALT November 2, 2020
;
;proton T1rho experiment, X detected via cross polarisation
;uses mc syntax
;uses VPLIST for spinlock pulse width
;
;Avance Neo version
;parameters:
;pl1 : f1 power level for contact
;pl2 : = 0 W, not used
;sp0 : f2 contact power level
;pl12 : power level for f2 90 and standard proton decoupling 
;pl13 : special decoupling power e.g. used in spinal64_13
;pl14 : f2 power level for T1rho spin lock
;p3 : f2 90 degree pulse
;p4 : f2 180 degree pulse
;p15 : contact time
;pcpd2 : pulse length in decoupling sequence
;d1 : recycle delay
;vplist : list containing spin lock pulse durations
;spnam0 : file name for variable amplitude CP
;cpdprg2 : sequence used for decoupling (e.g. spinal64)
;FnMODE: QF
;ZGOPTNS : -Dlacq and/or -Dlcp15 to switch off protection against long decoupling or long contact, resp.
;
;
;$CLASS=Solids
;$DIM=pseudo 2D
;$TYPE=cross polarisation
;$SUBTYPE=T1/T2
;$COMMENT=proton T1rho experiment with X detection via cp

prosol relations=<solids_cp>

define list<pulse> vp_list = <$VPLIST>


"acqt0=0"

1 ze
2 10m do:f2
  d1
#ifndef lcp15
#include <p15_prot.incl>
			;make sure p15 does not exceed 10 msec 
			;let supervisor change this pulseprogram if 
			;more is needed
#endif

#ifndef lacq		
			;disable protection file for long acquisition change decoupling power !!! or you risk probe damage
			;if you set the label lacq (ZGOPTNS -Dlacq), the protection is disabled
#include <aq_prot.incl>	
			;allows max. 50 msec acquisition time, supervisor
			;may change  to max. 1s at less than 5 % duty cycle
			;and reduced decoupling field
#endif
  (p3 pl12 ph1):f2
  (vp_list pl14 ph10):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
  1u cpds2:f2
  go=2 ph31 finally do:f2
  1m
  10m mc #0 to 2 F1QF(vp_list.inc)
HaltAcqu, 1m
exit

ph0= 0
ph1= 1 3
ph2= 0 0 2 2 1 1 3 3
ph10= 0
ph31= 0 2 2 0 1 3 3 1



