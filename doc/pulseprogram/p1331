;p1331
;avance-version (12/01/11)
;water suppression using 1-3-3-1 pulse sequence
;
;P.J. Hore, J. Magn. Reson. 54, 539 (1983)
;                           55, 283 (1983)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


1 ze
2 30m
  d1
  p1*0.125 ph1
  d19
  p1*0.375 ph2
  d19
  p1*0.375 ph1
  d19
  p1*0.125 ph2
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph2=2 0 0 2 3 1 1 3
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d19: delay for binomial water suppression
;     d19 = (1/d), d = distance of next null (in Hz)
;ns: 1 * n, total number of scans: NS * TD0



