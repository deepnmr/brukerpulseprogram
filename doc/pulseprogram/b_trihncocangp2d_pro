;b_trihncocangp2d_pro
;avance-version (21/09/15)
;best-TROSY-HN(CO)CA
;selecting for NH groups of amino acids with Pro in +1 position
;2D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O) -> F2(Ca, Pro N)
;            -> F2(C=O) -> F3(N,t1) -> F1(H,t2)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;using shaped pulses for inversion and refocussing on f3
;phase sensitive using Echo/Antiecho (t1)
;using semi constant time in t1
;(use parameterset )
;
;Z. Solyom, M. Schwarten, L. Geist, R. Konrat D. Willbold &
;   Bernhard Brutscher, J. Biomol. NMR 55, 311-321 (2013)
;A. Favier & B. Brutscher, J. Biomol. NMR 49, 9-15 (2011)
;(E. Lescop, P. Schanda & B. Brutscher,
;   J. Magn. Reson.  187 163-169 (2007))
;(T. Schulte-Herbrueggen & O.W. Sorensen, J. Magn. Reson. 144, 
;   123 - 128 (2000))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA3 = { 1.0000 0.8750 }
define list<gradient> EA5 = { 0.6667 1.0000 }
define list<gradient> EA7 = { 1.0000 0.6595 }


"d11=30m"
"d12=20u"

"d22=4.5m"
"d23=17.5m"
"d24=28m"
"d25=2.75m"
"d26=2.75m"
"d27=0.5m"

"p29=250"


#   ifdef CALC_SP
"p41=(bwfac25/(cnst55*cnst51*bf1))*1000000"
"spw25=plw1*pow((p1*totrot25)/(p41*90.0*integfac25),2)"
"spw27=plw1*pow((p1*totrot27)/(p41*90.0*integfac27),2)"
"spoal25=1"
"spoal27=0"

"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1*pow((p1*totrot26)/(p42*90.0*integfac26),2)"
"spoal26=0.5"

"p43=(bwfac28/(cnst55*cnst53*bf1))*1000000"
"spw28=plw1*pow((p1*totrot28)/(p43*90.0*integfac28),2)"
"spw29=plw1*pow((p1*totrot29)/(p43*90.0*integfac29),2)"
"spoal28=1"
"spoal29=0"
#   endif /*CALC_SP*/


"d28=3u"
"d0=d23-d27-p14+p21*4/PI"
"d20=d23+p14+d28"

"in0=inf1/2"

"FACTOR1=d20*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in28 = 0; } else { in28=in0-INCR1; }"


"DELTA=d24-larger(p14,p59)/2-p16-d16"
"DELTA1=d25-p29-d16-larger(p42,p56)/2-p41*cnst41"
"DELTA3=d23-d27-p14+p21*4/PI"
"DELTA6=d25-p29-d16-larger(p42,p57)/2-p43*cnst43"
"DELTA7=d26-p16-d16-larger(p42,p57)/2"
"DELTA8=de+4u"
"DELTA11=d23"

"TAU=p59"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst22)/1000000)"
"spoffs8=0"

"spoffs25=bf1*(cnst54/1000000)-o1"
"spoffs26=bf1*(cnst54/1000000)-o1"
"spoffs27=bf1*(cnst54/1000000)-o1"
"spoffs28=bf1*(cnst54/1000000)-o1"
"spoffs29=bf1*(cnst54/1000000)-o1"

"spoffs39=0"
"spoffs40=0"
"spoffs46=bf3*(cnst48/1000000)-o3"


"acqt0=0"
baseopt_echo


1 d11 ze
2 d11
3 d12
  
  (p56:sp39 ph1):f3
  30u fq=cnst21(bf ppm):f2
  d1 pl1:f1
  50u UNBLKGRAD

  (p41:sp25 ph1)
  p29:gp1
  d16
  DELTA1
  (center (p42:sp26 ph1) (p56:sp39 ph1):f3 )
  DELTA1
  p29:gp1
  d16
  (p41:sp27 ph2):f1

  p16:gp2
  d16 pl3:f3

  (p21 ph9):f3
  DELTA11
  (center (p14:sp5 ph1):f2 (p56:sp39 ph1):f3 )
  d27
  (p14:sp3 ph1):f2
  DELTA3

  (p13:sp2 ph10):f2
  d22
  (p14:sp5 ph1):f2
  4u  
  (center (p14:sp3 ph1):f2 (p56:sp39 ph1):f3 )
  d22
  (p14:sp5 ph1):f2
  4u pl3:f3 
  (p13:sp8 ph2):f2
  (p21 ph2):f3

  4u
  30u fq=cnst22(bf ppm):f2

  (p13:sp2 ph8):f2
  DELTA
  p16:gp8
  d16

  if "nsdone %2 == 0"
     {
     (center (p24:sp9 ph1):f2 (p59:sp46 ph1):f3 )
     }
  else
     {
     (center (p24:sp9 ph1):f2 (TAU):f3 )
     }

  p16:gp8
  d16
  DELTA pl3:f3
  (p13:sp8 ph1):f2

  4u
  30u fq=cnst21(bf ppm):f2

  (p21 ph5):f3
  (p13:sp2 ph2):f2
  4u  
  (p14:sp5 ph1):f2
  d22
  (center (p14:sp3 ph1):f2 (p56:sp39 ph1):f3 )
  4u  
  (p14:sp5 ph1):f2
  d22
  (p13:sp8 ph1):f2

  d0
  (p14:sp3 ph1):f2
  d27
  (p14:sp5 ph1):f2
  d28
  (p56:sp39 ph1):f3
  d20
  p16:gp3*EA3
  d16
  DELTA8
  
  (p43:sp29 ph6)
  p29:gp4
  d16
  DELTA6
  (center (p42:sp26 ph1) (p57:sp40 ph1):f3 )
  DELTA6
  p29:gp4
  d16
  (p43:sp28 ph1)

  p16:gp5*EA5
  d16 pl3:f3
  DELTA8

  (p21 ph2):f3
  p16:gp6
  d16
  DELTA7
  (center (p42:sp26 ph1) (p57:sp40 ph1):f3 )
  DELTA7
  p16:gp6
  d16 pl3:f3
  (p21 ph7):f3

  p16:gp7*EA7
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2
     F1EA(calgrad(EA3) & calgrad(EA5) & calgrad(EA7) & calph(ph6, +180) & calph(ph7, +180), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28) & calph(ph5, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=1 1 3 3
ph6=3
ph7=2
ph8=0 
ph9=0 0 0 0 2 2 2 2
ph10=2 2 2 2 2 2 2 2 0 0 0 0 0 0 0 0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp9: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;     sp9 requires higher selectivity - refocussing Calpha only
;sp25: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp27: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;                   for time reversed pulse
;sp28: f1 channel - shaped pulse  90 degree (Eburp2.1000)
;sp29: f1 channel - shaped pulse  90 degree (Eburp2tr.1000)
;                   for time reversed pulse
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;sp46: f3 channel - shaped pulse 180 degree (Reburp.1000, N, selective for Pro)
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (Ca, selective)
;p29: gradient pulse 3                                 [250 usec]
;p41: f1 channel -  90 degree shaped pulse for excitation
;                      Pc9_4_90.1000             (2.2ms at 600.13 MHz)
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.4ms at 600.13 MHz)
;p43: f1 channel -  90 degree shaped pulse for excitation
;                      Eburp2.1000/Eburp2tr.1000 (1.7ms at 600.13 MHz)
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1            (500us at 600.13 MHz)
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.6ms at 600.13 MHz)
;p59: f3 channel - 180 degree shaped pulse (N, selective for Pro)
;d0 : incremented delay = d23-d27-p14+p21*4/PI
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay = d23+p14+d2
;d22: 1/(4J(CaCO)                                      [4.5 msec]
;d23: 1/(4J(NCO)                                       [17.5 msec]
;d24: 1/(2J(NCa)                                       [28 msec]
;d25: 1/(4J'(NH)                                       [2.75 msec]
;d26: 1/(4J(NH)                                        [2.75 msec]
;d27: compensation delay                               [0.5 msec]
;d28: incremented delay                                [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst41: compensation of chemical shift evolution during p41
;           Pc9_4_90.1000: 0.529
;cnst43: compensation of chemical shift evolution during p43
;           Eburp2.1000: 0.69
;cnst48: N(Pro) chemical shift (offset, in ppm)        [134.0 ppm]
;cnst51: scaling factor for p41 to compensate for transition region
;           Pc9_4_90.1000: 1.172
;cnst52: scaling factor for p42 to compensate for transition region
;           Reburp.1000: 1.426
;cnst53: scaling factor for p43 to compensate for transition region
;           Eburp2.1000: 1.000
;cnst54: H(N) chemical shift (offset, in ppm)
;cnst55: H(N) bandwidth (in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) = DW(N)
;nd0: 2
;in20: = k1 * in0
;in28: = (1 - k1) * in0
;ns: 4 * n
;ds: >= 16
;td1: number of experiments in F1
;FnMODE: echo-antiecho (or TPPI) in F1


;for z-only gradients:
;gpz1: 2%
;gpz2: 21%
;gpz3: -80%
;gpz4: 5%
;gpz5: 30%
;gpz6: 45%
;gpz7: 30.13%
;gpz8: 13%

;use gradient files:
;gpnam1: SMSQ10.32
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.32
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



