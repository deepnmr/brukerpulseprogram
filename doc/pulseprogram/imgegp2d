;imgegp2d
;avance-version (12/01/11)
;pseudo-2D Gradient Echo
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include<Avance.incl>
#include <Delay.incl>
#include<Grad.incl>
#include<De.incl>


"d11=30m"


"DELTA=d20-((d1+aq+d27+d15+d21+10u)*(ns+ds))-30m"


1 ze
  d11 UNBLKGRAD			
2 DELTA
3 d1
  p0:f1 ph1
  d27 gron1
  5u groff
  d15
  d21 gron2
  ACQ_START(ph30,ph31)
  aq DWELL_GEN:f1
  5u groff
  rcyc=3
  30m wr #0 if #0 ze
  lo to 2 times td1
  d11 BLKGRAD
exit


ph1=0
ph30=0
ph31=0


;pl1 : f1 channel - power level for pulse (default)
;p0 : f1 channel -  small flip angle                   [2 usec]
;d1 : relaxation delay
;d11: delay for disk I/O                               [30 msec]
;d15: echo time                                        [5 msec]
;d20: delay between start of different 1D spectra
;d21: gradient stabilisation delay                     [250 usec]
;d27: length of dephasing gradient (phase encode time) [2 msec]
;ns: 1 * n
;ds: 0
;td1: number of experiments


;use gradient ratio:    gp 1 : gp 2
;                       3.11 : -6.74

;for z-only gradients:
;gpz1: 3.11%
;gpz2: -6.74%



