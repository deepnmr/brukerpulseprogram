;trt2etf3gpsi
;avance-version (12/01/11)
;2D H-1/X correlation via TROSY and inept transfer
;   using sensitivity improvement
;for measuring N-15 T2 relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;using flip-back pulse
;with C-13 decoupling in t1
;(use parameterset TRT2ETF3GPSI)
;
;G. Zhu, Y. Xia, L.K. Nicholson & K.H. Sze,
;   J. Magn. Reson. 143, 423-426 (2000)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"
"d25=1s/(cnst4*cnst12)"
"d26=1s/(cnst4*4)"


"d21=450u"


"d0=3u"

"in0=inf1/2"


"DELTA1=d26-p16-d16"
"DELTA3=d25-p16-d16"
"DELTA4=d21-p2/2"
"DELTA5=d26-p1-p11-p19-d16-4u"
"DELTA7=d26-p11-p19-d16-12u"
"DELTA8=d26-p11-p19-d16-p21-12u"

#   ifdef LABEL_CN
"DELTA=d0*2+p8"
"DELTA2=d25-p16-d16"
"DELTA6=d26-p11-p19-d16-8u"
#   else
"DELTA2=d25-p16-d16-p21*2/3.1416"
"DELTA6=d26+d0*2-p11-p19-d16-8u-p21*2/3.1416"
#   endif /*LABEL_CN*/


"COUNTER=l5*4"


"l0=1"
"l4=d20/(p30*16+d21*32)"


"d31=(p30*16+d21*32)*l4"


1 ze
2 d11
3 d12 pl23:f3

4 d21
  (p30 ph1 d21*2 p30 ph1 d21*2 p30 ph1 d21*2 p30 ph1):f3
  d21
  lo to 4 times COUNTER

  d1 pl3:f3
  50u UNBLKGRAD
  (p21 ph1):f3
  p16:gp1
  d16

  (p1 ph1)
  p16:gp2
  d16
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1
  p16:gp2
  d16
  (p1 ph2)

  4u pl0:f1
  (p11:sp1 ph8:r):f1
  4u
  p16:gp3
  d16 pl1:f1

  if "l0 %2 == 1"
     {
     (p21 ph3):f3
     }
  else
     {
     (p21 ph4):f3
     }

  p16:gp4
  d16
  DELTA2 
  (center (p2 ph1) (p22 ph5):f3 )
  DELTA3
  p16:gp4
  d16 pl23:f3

  if "l0 %2 == 1"
     {
5    d21
     (p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3):f3
     DELTA4
     (p2 ph1)
     DELTA4
     (p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3):f3
     d21*2
     (p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3):f3
     DELTA4
     (p2 ph8)
     DELTA4
     (p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3 d21*2 p30 ph3):f3
     d21
     lo to 5 times l4
     }
  else
     {
6    d21
     (p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4):f3
     DELTA4
     (p2 ph1)
     DELTA4
     (p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4):f3
     d21*2
     (p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4):f3
     DELTA4
     (p2 ph8)
     DELTA4
     (p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4 d21*2 p30 ph4):f3
     d21
     lo to 6 times l4
     }

#   ifdef LABEL_CN
  DELTA pl3:f3
  (p22 ph5):f3
  d0
  (p8:sp13 ph1):f2
  d0
#   else
  d0
  d0
#   endif /*LABEL_CN*/

  (p1 ph6)
  4u pl0:f1
  (p11:sp1 ph6):f1
  p19:gp5
  d16
  DELTA5 pl1:f1 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p19:gp5
  d16 pl0:f1
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1

  (center (p1 ph1) (p21 ph2):f3 )

  4u
  p19:gp6
  d16
  DELTA7 pl0:f1
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph8:r):f1
  DELTA8
  p19:gp6
  d16 pl1:f1
  4u
  4u BLKGRAD
  (p21 ph7):f3

  go=2 ph31
  d11 mc #0 to 2 
     F1EA(calph(ph6, +180) & calph(ph7, +180) & calclc(l0, 1), caldel(d0, +in0) & calph(ph3, +180) & calph(ph4, +180) & calph(ph5, +180) & calph(ph31, +180))
  d31
exit
   

ph0=0 
ph1=0 
ph2=1
#   ifdef LABEL_CN
ph3=1 3 2 0
ph4=3 1 2 0
#   else
ph3=3 1 2 0
ph4=1 3 2 0
#   endif /*LABEL_CN*/
ph5=1 1 3 3
ph6=1
ph7=0
ph8=2
ph31=0 2 3 1
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl23: f3 channel - power level for TOCSY-spinlock
;sp1: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: f3 channel - 180 degree pulse at pl23
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: echo delay                                     [450 usec]
;d25: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d26: 1/(4J(YH))
;d31: T2 delay as executed
;cnst4: = J(YH)
;cnst12: for multiplicity selection = 4 for NH, 8 for all multiplicities
;l4: loop for T2 delay
;l5: loop for compensation of heating effects = l4(max) - l4(current)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 4 * n
;ds: >= 32
;td1: number of experiments
;FnMODE: echo-antiecho


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6
;                         30 :    3 :   50 :    5 :   10 :   25

;for z-only gradients:
;gpz1: 30%
;gpz2: 3%
;gpz3: 50%
;gpz4: 5%
;gpz5: 10%
;gpz6: 25%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.50
;gpnam6: SMSQ10.50


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id:$
