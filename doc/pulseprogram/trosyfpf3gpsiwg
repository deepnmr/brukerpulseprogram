;trosyfpf3gpphsiwg
;avance-version (18/12/04)
;2D H-1/X correlation via TROSY
;   using sensitivity improvement
;phase sensitive using Echo/Antiecho method
;using f3 - channel
;water suppression using watergate sequence
;(use parameterset TROSYFPF3GPPHSIWG)
;
;M. Czisch & R. Boelens, J. Magn. Reson. 134, 158-160 (1998)
;K. Pervushin, G. Wider & K. Wuethrich, J. Biomol. NMR 12,
;   345-348 (1998)
;A. Meissner, T. Schulte-Herbrueggen, J. Briand & O.W. Sorensen, Mol. Phys. 96,
;   1137-1142 (1998)
;J. Weigelt, J. Am. Chem. Soc. 120, 10778-10779 (1998)
;M. Rance, J.P. Loria & A.G. Palmer III, J. Magn. Reson. 136, 91-101 (1999)
;G. Zhu, X.M. Kong & K.H. Sze, J. Biomol. NMR 13, 77-81 (1999)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d26=1s/(cnst4*4)"

"p29=250u"


"in0=inf1"

"d0=in0/2-p21*2/PI"


"l0=0"


"DELTA1=d26-p11-p19-d16-p56/2-4u"
"DELTA2=d26-p11-p29-d16-p57/2-4u"
"DELTA3=d26-p16-d16-larger((p11*2+p2+8u),p57)/2"
"DELTA4=d26-p16-d16-larger((p11*2+p2+8u),p57)/2-4u-de-p1*2/PI"


"acqt0=0"
baseopt_echo


1 ze
2 d11
  d1 pl1:f1 pl3:f3 
  50u UNBLKGRAD

  (p1 ph1):f1
  4u
  (p11:sp1 ph3:r):f1
  p19:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2):f1 (p56:sp39 ph1):f3) 
  DELTA1
  p19:gp1
  d16
  (p11:sp1 ph4:r):f1
  4u pl1:f1 pl3:f3
  (p1 ph4):f1

  p19:gp2
  d16

#   ifdef LABEL_CN

  "TAU=larger((d0/2-p35/2),0)"

  if "l0 %2 == 1"
     {
     (ralign (p35:sp41 ph1 TAU):f2 (p21 ph5 d0):f3)
     }
  else
     {
     (ralign (p35:sp41 ph1 TAU):f2 (p21 ph6 d0):f3)
     }

#   else

  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     d0
     }
  else
     {
     (p21 ph6):f3
     d0
     }

#   endif /*LABEL_CN*/

  (p1 ph7):f1
  4u
  (p11:sp1 ph17:r):f1
  p29:gp3
  d16 pl1:f1
  DELTA2
  (center(p2 ph1):f1 (p57:sp40 ph1):f3)
  DELTA2
  p29:gp3
  d16
  (p11:sp1 ph1:r):f1  
  4u pl1:f1 pl3:f3
  (lalign (p1 ph1):f1 (p21 ph7):f3)
  DELTA3
  p16:gp4
  d16
  (center (p11:sp1 ph3:r 4u pl1 p2 ph1 4u p11:sp1 ph3:r):f1 (p57:sp40 ph1):f3)
  p16:gp4
  d16 pl3:f3
  4u BLKGRAD
  DELTA4
  (p21 ph1):f3
  go=2 ph31 
  d11 mc #0 to 2 
     F1EA(calph(ph7, +180) & calph(ph17, +180) & calclc(l0, 1), caldel(d0, +in0) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=1 2 3 0
ph6=1 0 3 2
ph7=1
ph17=3
ph31=1 2 3 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;sp41: f2 channel - shaped pulse 180 degree (Bip720,100,10.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                                 [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                 [250 usec]
;p35: f2 channel - 180 degree shaped pulse
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1            (500us at 600.13 MHz)
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.6ms at 600.13 MHz)
;d0 : incremented delay (2D) = in0/2-p21*2/PI
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J)YH
;cnst4: = J(YH)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 2 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: echo-antiecho


;for z-only gradients:
;gpz1: 19%
;gpz2: 47%
;gpz3: 65%
;gpz4: 80%

;use gradient files:
;gpnam1: SMSQ10.50
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1


