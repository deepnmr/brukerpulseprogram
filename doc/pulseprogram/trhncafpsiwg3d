;trhncafpsiwg3d
;avance-version (21/09/15)
;TROSY-HNCA
;3D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N) -> F2(Ca,t1) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;using semi-constant time in t2
;water suppression using watergate sequence
;using flip-back pulse
;(use parameterset )
;
;M. Salzmann, K. Pervushin, G. Wider, H. Senn & K. Wuethrich, Proc.
;   Natl. Acad. Sci. USA 95, 13585-13590 (1998)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p20=p3*2.5"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d23=12m"
"d26=1s/(cnst4*4)"

"p29=250u"


"d0=3u"
"d10=3u"
"d29=3u"
"d30=d23-p56/2-p1"

"in0=inf1/4"
"in10=inf2/2"

"FACTOR2=d30*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in10 ) { in30 = in10; } else { in30 = INCR2; }"
"if ( INCR2 > in10 ) { in29 = 0; } else { in29=in10-INCR2; }"


"DELTA1=d26-p11-p19-d16-p56/2-4u"
"DELTA2=d26-p11-p29-d16-p56/2-4u"
"DELTA3=d26-p16-d16-larger((p11*2+p2+8u),p57)/2"
"DELTA4=d26-p16-d16-larger((p11*2+p2+8u),p57)/2-4u-de-p1*2/PI"
"DELTA5=d23-larger(p14,p57)/2-p16-d16-4u"
"DELTA6=d23-p14*2-p21*2/PI-d10-d29-p56/2"

"TAU=d0*2+p44"


"l0=0"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


"acqt0=0"
baseopt_echo


aqseq 321


1 ze
2 d11
3 d11
  d1 pl1:f1 pl3:f3
  50u UNBLKGRAD

  (p1 ph1):f1
  4u
  (p11:sp1 ph3:r):f1
  p19:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2):f1 (p56:sp39 ph1):f3) 
  DELTA1
  p19:gp1
  d16
  (p11:sp1 ph4:r):f1
  4u pl1:f1 pl3:f3
  (p1 ph4):f1

  p19:gp2
  d16

  (p21 ph1):f3
  4u
  DELTA5
  p16:gp5
  d16
  (center (p14:sp3 ph1):f2 (p57:sp40 ph1):f3)
  p16:gp5
  d16
  DELTA5
  4u pl3:f3
  (p21 ph2):f3
  (p13:sp2 ph8):f2
  d0
  (p44:sp30 ph1):f1
  d0
  (center (p14:sp5 ph1):f2 (p56:sp39):f3)
  d0
  (p44:sp30 ph1):f1
  d0
  (p14:sp3 ph1):f2
  TAU pl1:f1
  (center (p14:sp5 ph1):f2 (p56:sp39):f3)
  TAU
  (p13:sp8 ph9):f2

  if "l0 %2 == 1"
     {
     (p21 pl3 ph5):f3
     } 
  else
     {
     (p21 pl3 ph6):f3
     }

  d10
  (p14:sp5 ph1):f2
  DELTA6
  (p14:sp3 ph1):f2 
  d29
  (p56:sp39 ph1):f3
  d30

  (p1 ph7):f1
  4u
  (p11:sp1 ph17:r):f1
  p29:gp3
  d16 pl1:f1
  DELTA2
  (center(p2 ph1):f1 (p56:sp39 ph1):f3)
  DELTA2
  p29:gp3
  d16
  (p11:sp1 ph1:r):f1  
  4u pl1:f1 pl3:f3
  (p1 ph1):f1

  (p21 ph7):f3
  DELTA3
  p16:gp4
  d16
  (center (p11:sp1 ph3:r 4u pl1 p2 ph1 4u p11:sp1 ph3:r):f1 (p57:sp40 ph1):f3)
  p16:gp4
  d16 pl3:f3
  4u BLKGRAD
  DELTA4
  (p21 ph1):f3
  go=2 ph31 
  d11 mc #0 to 2
     F1PH(calph(ph9, +90), caldel(d0, +in0))
     F2EA(calph(ph7, +180) & calph(ph17, +180) & calclc(l0, 1), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))

exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=2 3 2 3 0 1 0 1
ph6=2 1 2 1 0 3 0 3
ph7=3
ph8=0 0 2 2
ph9=0
ph17=1
ph31=1 2 3 0 3 0 1 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                                 [500 usec]
;p20: f2 channel -  225 degree high power pulse (p3*2.5)
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                 [250 usec]
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1            (500us at 600.13 MHz)
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.6ms at 600.13 MHz)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d23: 1/(4J(NCa)                                       [12 msec]
;d26: 1/(4J)NH
;d29: incremented delay (F2 in 3D)                     [3 usec]
;d30: decremented delay (F2 in 3D) = d23-p56/2-p1
;cnst4: = J(NH)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(Ca)) =  (1/2) DW(Ca)
;nd0: 4
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in29: = (1 - k) * in10
;in30: = k * in10
;ns: 2 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz1: 19%
;gpz2: 47%
;gpz3: 65%
;gpz4: 80%
;gpz5: 11%

;use gradient files:
;gpnam1: SMSQ10.50
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



