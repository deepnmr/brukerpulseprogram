;noesymlevpr3d
;avance-version (12/01/11)
;3D sequence with
;   homonuclear correlation via dipolar coupling 
;   dipolar coupling may be due to noe or chemical exchange.
;   homonuclear Hartman-Hahn transfer using MLEV17 sequence
;      for mixing
;   using two power levels for excitation and spinlock
;phase sensitive (t1 and t2)
;with presaturation during relaxation delay and mixing time
;
;A. Bax & D.G. Davis, J. Magn. Reson. 65, 355-360 (1985)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


"p5=p6*.667"
"p7=p6*2"
"d11=30m"
"d12=20u"
"d13=4u"


"in0=inf1"
"in10=inf2"

"d0=in0/2-p1*4/3.1416"
"d10=in10/2-p1*2/3.1416-4u"


"SCALEF=p7*2/p5"
"FACTOR1=((d9-p17)/(p6*64+p5))/SCALEF"
"l1=FACTOR1*SCALEF"


aqseq 312


1 d11 ze
2 d11
3 d12 pl9:f1
  d1 cw:f1 ph29
  d13 do:f1
  d12 pl1:f1
  p1 ph1
  d0
  p1 ph2
  d12 pl9:f1
  d8 cw:f1
  d13 do:f1
  d12 pl1:f1
  p1 ph3
  d10
  4u pl10:f1
  (p17 ph26)
						;begin MLEV17
5 (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p5 ph23)
  lo to 5 times l1 
						;end MLEV17
  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph1, +90) & calph(ph29, +90), caldel(d0, +in0)) 
     F2PH(calph(ph3, +90), caldel(d10, +in10))
exit 
  

ph1=0 2
ph2=0 0 0 0 2 2 2 2
ph3=0 0 2 2
ph22=3
ph23=0
ph24=1
ph25=2
ph26=0
ph29=0
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl10: f1 channel - power level for TOCSY-spinlock
;p1 : f1 channel -  90 degree high power pulse
;p5 : f1 channel -  60 degree low power pulse
;p6 : f1 channel -  90 degree low power pulse
;p7 : f1 channel - 180 degree low power pulse
;p17: f1 channel - trim pulse                        [2.5 msec]
;d0 : incremented delay (F1 in 3D)
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d9 : TOCSY mixing time
;d10: incremented delay (F2 in 3D)
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;l1: loop for MLEV cycle: (((p6*64) + p5 ) * l1) + (p17) = mixing time
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(H) = 2 * DW(H)
;in0: 1/(1 * SW(H)) = 2 * DW(H)
;nd0: 1
;in10: 1/(1 * SW(H)) = 2 * DW(H)
;nd10: 1
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2

;for older datasets use AQORDER : 3 - 1 - 2


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1



