;c_hncacon_iare5d
;avance-version (21/09/15)
;HNCACON
;5D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F2(H,t1) -> F3(N,t2) -> F1(Ca,t3) -> F1(C=O)
;               -> F3(N,t4) -> F1(C=O,t5)
;
;on resonance Ca pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;phase sensitive (t4)
;using semi-constant time in t1
;using constant time in t2
;using constant time in t3
;relaxation optimised (H-flip)
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;W. Bermel,  I. Bertini, I.C. Felli, L. Gonnelli, W. Kozminski, A. Piai,
;   R. Pierattelli & J. Stanek, J. Biomol. NMR 53, 293-301 (2012)
;
;$CLASS=HighRes
;$DIM=5D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d22=4.5m"
"d23=12.5m"
"d25=2.75m"
"d26=2.3m"
"d27=16.0m"


"d51=3u"
"d33=3u"
"d34=3u"
"d31=d26"
"d32=d23/2-larger(p4,p12)/2"
"d41=d26+p22+d51"
"d42=d23/2-larger(p4,p12)/2"
"d43=d23-p12-4u"
"d52=d23/2-larger(p4,p12)/2-p3-p21"

"in31=inf1/2"
"in32=inf2/4"
"in33=inf3/2"
"in34=inf4/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"
"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"

"in42=in32"
"in43=in33"
"in52=in32"

"td2=tdmax(td2,d42*2,in42)"
"td3=tdmax(td3,d43*2,in43)"


"DELTA=d34*2+larger(p4,p8)"
"DELTA2=d27/2-p12/2"
"DELTA3=d27-d22-p12"
"DELTA5=d25-p21/2"
"DELTA6=d25+p21/2"
"DELTA7=d23-d22-p12"
"DELTA8=d23-p12-4u"

"TAU1=d22-d33-p4"
"TAU2=d23-d22-p12"


"l0=1"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs28=0"


"cnst62=-(bf2*cnst19-(o2*1000000))"
"cnst63=(bf2*cnst19-(o2*1000000))*(inf1/1000000)*360.0"


"TAU9=abs(cnst62+cnst63)/100000"


"o1_F1=bf2*cnst19/1000000"
"o1_F3=bf1*cnst22/1000000"


1 d11 ze
  d11 pl16:f3
2 d11 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph8):f2
  d31
  (p22 ph1):f3
  d51
  (p4 ph1):f2
  d41
  (p3 ph2):f2

  (p21 ph3):f3
  DELTA5
  (center (p4 ph2):f2 (p22 ph1):f3 )
  DELTA6
  (p3 ph1):f2
  d52
  (center (p12:sp26 ph1) (p4 ph1):f2 )
  d32
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d42
  (center (p12:sp26 ph1) (p4 ph1):f2 )
  d42
  (p21 ph1):f3

  p16:gp1
  d16

  (p11:sp23 ph4) 
  d33
  (p4 ph1):f2
  TAU1
  (p12:sp26 ph1)
  TAU2
  (center (p25:sp28 ph1) (p22 ph1):f3 )
  d43
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph1)

  p16:gp2
  d16 fq=cnst21(bf ppm):f1

  (p11:sp23 ph1)
  d22
  (p12:sp27 ph1)
  DELTA7
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  DELTA8
  (p12:sp27 ph1)
  4u
  (p11:sp25 ph1)

  p16:gp3
  d16
  (p4 ph1):f2

  (p21 ph5):f3
  d34
  (center (p8:sp13 ph1) (p4 ph1):f2 )
  d34
  (p22 ph1):f3
  DELTA
  (p21 ph1):f3

  p16:gp4
  d16

  if "l0 %2 == 1"
     {
     (p11:sp23 ph6)
     DELTA2
     (p12:sp27 ph1)
     DELTA2
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA2
     (p12:sp27 ph1)
     DELTA2 pl16:f3
     }
  else
     {
     (p11:sp23 ph7)
     d22
     (p12:sp27 ph1)
     DELTA3
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA2
     DELTA2 pl16:f3
     (p12:sp27 ph1)
     }
  
  4u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2

#   ifdef LABEL_F1
  F1I(iu0, 2)
#   else

#   ifdef LABEL_F2
  F2I(iu0, 2)
#   else

#   ifdef LABEL_F3
  F3I(iu0, 2)
#   else
  F4I(iu0, 2)
#   endif /*LABEL_F3*/

#   endif /*LABEL_F2*/

#   endif /*LABEL_F1*/

  F1PH(calph(ph8, +90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51) & calph(ph8, cnst63))
  F2PH(calph(ph3, -90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
  F3PH(calph(ph4, +90), caldel(d33, +in33) & caldel(d43, -in43))
  F4PH(calph(ph5, +90), caldel(d34, +in34))

TAU9
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0
ph7=3
ph8=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NC))                                       [12.5 msec]
;d25: 1/(4J(NH)                                        [2.75 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d27: 1/(4J(NCO))                                      [16.0 msec]
;d31: incremented delay (F1 in 5D) = d26
;d32: incremented delay (F2 in 5D) = d23/2-larger(p4,p12)/2
;d33: incremented delay (F3 in 5D)                     [3 usec]
;d34: incremented delay (F4 in 5D)                     [3 usec]
;d41: decremented delay (F1 in 5D) = d26+p22+d51
;d42: decremented delay (F2 in 5D) = d23/2-larger(p4,p12)/2
;d43: decremented delay (F3 in 5D) = d23-p12-4u
;d51: incremented delay (F1 in 5D)                     [3 usec]
;d52: incremented delay (F2 in 5D) = d23/2-larger(p4,p12)/2-p3-p21
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst62: offset for H(N) region (Hz)
;cnst63: additional phase increment to center H(N) region
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(Ha) = 2 * DW(Ha)
;inf2: 1/SW(N) = 2 * DW(N)
;inf3: 1/SW(Ca) = 2 * DW(Ca)
;inf4: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(H(N))) =  DW(H(N))
;nd31: 2
;in32: 1/(2 * SW(N)) =  DW(N)
;nd32: 4
;in33: 1/(2 * SW(Ca)) =  DW(Ca)
;nd33: 2
;in34: 1/(2 * SW(N)) =  DW(N)
;nd34: 2
;in41: = k1 * in31
;in42: = in32
;in43: = in33
;in51: = (1 - k1) * in31
;in52: = in32
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;td4: number of experiments in F4
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;FnMODE: States-TPPI (or TPPI) in F4
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 60%
;gpz2: 50%
;gpz3: 19%
;gpz4: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



                                           ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
;LABEL_F2: to do ipap in F2 start experiment with
;             option -DLABEL_F2 (eda: ZGOPTNS)
;LABEL_F3: to do ipap in F3 start experiment with
;             option -DLABEL_F3 (eda: ZGOPTNS)
                                           ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] to process data



