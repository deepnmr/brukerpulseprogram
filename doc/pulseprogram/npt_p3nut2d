;$Id:$
;pulse program for pulse nutation on f2 channel
;using inverse method decp90
;$CLASS=HighRes HWT
;$DIM=2D
;$HIDE=y

#include <Avance.incl>

"d2=1s/(cnst2*2)"

"d12=20u"
"inf1=inp3"

1 ze
2 d1
3 p1 ph1
  d2
  p3:f2 ph2
  go=2 ph31
  d12 ipu3
  d1 mc #0 to 2 F1QF()
exit

ph1=0 2 2 0 1 3 3 1
ph2=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(XH))
;cnst2: = J(XH)
;nd0: 1
;NS: 1
;DS: 4
;td1: number of experiments
;FnMODE: QF
