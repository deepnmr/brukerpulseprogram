;zgcxgesgp
;avance-version (12/01/11)
;1D CLEANEX-PM
;water suppression using excitation sculpting with gradients
;
;T.L. Hwang, S. Mori, A.J. Shaka & P.C.M. van Zijl,
;   J.Am. Chem. Soc. 119, 6203-6204 (1997)
;T.-L. Hwang & A.J. Shaka, J. Magn. Reson.,
;   Series A 112 275-279 (1995)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple2>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d12=20u"


"DELTA=p15+de+p1*2/3.1416+18u"


"l1=(d29/(p10*8.11))"
"d31=p10*8.11*l1"


"acqt0=0"
baseopt_echo


1 ze
2 30m
  d1
  50u UNBLKGRAD
  p1 ph1

  6u
  p16:gp1
  d16 pl0:f1
  (p7:sp21 ph2:r):f1
  p16:gp1
  d16 pl27:f1
  6u gron0
                                                 ;begin CLEANEX_PM
4 (p10*1.500 ph21)
  (p10*1.333 ph23)
  (p10*1.222 ph21)
  (p10*1.222 ph23)
  (p10*1.333 ph21)
  (p10*1.500 ph23)
  lo to 4 times l1
                                                 ;end CLEANEX_PM
  10u groff
  4u pl0:f1
  (p15:sp22 ph3:r):f1
  4u
  
  p16:gp2
  d16 pl0:f1
  (p12:sp1 ph4:r):f1
  4u
  d12 pl1:f1

  p2 ph5

  4u
  p16:gp2
  d16 
  DELTA
  p16:gp3
  d16 pl0:f1
  (p12:sp1 ph6:r):f1
  4u
  d12 pl1:f1

  p2 ph7

  p16:gp3
  d16
  4u BLKGRAD

  go=2 ph31
  30m mc #0 to 2 F0(zd)
  d31
exit


ph1=0
ph2=0 1 0 1 0 1 0 1 2 3 2 3 2 3 2 3
ph3=0 2
ph4=0 0 1 1
ph5=2 2 3 3
ph6=0 0 0 0 1 1 1 1
ph7=2 2 2 2 3 3 3 3
ph21=0
ph23=2
ph31=0 2 2 0 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl27: f1 channel - power level for CLEANEX spinlock
;sp1 : f1 channel - shaped pulse 180 degree
;sp21: f1 channel - shaped pulse 180 degree (H2O on resonance)
;sp22: f1 channel - shaped pulse  90 degree (H2O on resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p7 : f1 channel - 180 degree shaped pulse (H2O on resonance)  [7.5 ms]
;p10: f1 channel -  90 degree low power pulse (CLEANEX spinlock)
;p12: f1 channel - 180 degree shaped pulse (Squa100.1000)   [2 msec]
;p15: f1 channel -  90 degree shaped pulse (H2O on resonance)  [5 ms]
;p16: homospoil/gradient pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                             [20 usec]
;d16: delay for homospoil/gradient recovery
;d29: mixing time for CLEANEX spinlock
;d31: length of CLEANEX spinlock as used
;l1: loop for CLEANEX spinlock: (p10 * 8.11 * l1) = mixing time
;ns: 16 * n, total number of scans: NS * TD0
;ds: 4


;use gradient ratio:    gp 0 : gp 1 : gp 2 : gp 3
;                        0.2 :   40 :   31 :   11

;for z-only gradients:
;gpz0: 0.2%
;gpz1: 40%
;gpz2: 31%
;gpz3: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



;$Id:$
