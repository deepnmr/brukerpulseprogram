;trhncacoetgp4d
;avance-version (21/09/15)
;TROSY-HNCACO
;4D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N) -> F2(Ca) -> F2(C=O,t1)
;            -> F2(Ca,t2) -> F3(N,t3) -> F1(H,t4)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive using Echo/Antiecho gradient selection (t3)
;using semi-constant time in t2
;using constant time in t3
;with H-1 180degree pulses in t1
;uncompensated version d25=d26
;(use parameterset )
;
;(T. Schulte-Herbrueggen & O.W. Sorensen, J. Magn. Reson. 144, 
;   123 - 128 (2000))
;(A. Eletsky, A. Kienhoefer & K. Pervushin,
;   J. Biomol. NMR 20, 188-180 (2001))
;(M. Salzmann, G. Wider, K. Pervushin, H. Senn & K. Wuethrich,
;   J. Am. Chem. Soc. 121, 844-848 (1999))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA3 = { 0.8750 1.0000}
define list<gradient> EA5 = { 1.0000 0.6667}
define list<gradient> EA7 = { 0.6595 1.0000}


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d22=4m"
"d23=12m"
"d25=2.3m"
"d26=2.3m"


"d31=3u"
"d32=3u"
"d33=3u"
"d52=3u"
"d42=d22+d52-p16-d16"
"d43=d23/2-d25/2-p14/2-p16/2-d16/2-2u"

"in31=inf1/4"
"in32=inf2/2"
"in33=inf3/4"

"FACTOR2=d42*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in32 ) { in42 = in32; } else { in42 = INCR2; }"
"if ( INCR2 > in32 ) { in52 = 0; } else { in52=in32-INCR2; }"

"in43=in33"

"td3=tdmax(td3,d43*2,in43)"


"DELTA=d31*4+p2*2+larger(p14,p22)-p14-4u"
"DELTA1=d26-p16-d16"
"DELTA2=d23-p16-d16"
"DELTA3=d22-p14-p16-d16-4u"
"DELTA4=d23/2-d25/2-p14/2-d33+p21*2/3.1416"
"DELTA5=d23/2-d25/2-p14/2-d33-p16-d16-p11+p21*2/3.1416-8u"
"DELTA6=d25-p16-d16"
"DELTA7=d26-p11-p16-d16-8u"
"DELTA8=d22-d32-larger(p2,p22)-p16-d16+4u"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst22)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"
"spoffs9=0"


"o1_F1=bf2*cnst21/1000000"
"o1_F2=bf2*cnst22/1000000"


1 d11 ze
2 d11
3 d1 pl1:f1 fq=cnst22(bf ppm):f2
  50u UNBLKGRAD

  4u pl0:f1
  (p11:sp1 ph2:r):f1
  4u
  4u pl1:f1

  (p1 ph3):f1
  p16:gp1
  d16
  DELTA1
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA1
  p16:gp1
  d16
  (p1 ph2):f1 

  (p21 ph1):f3
  p16:gp2
  d16
  DELTA2
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA2
  p16:gp2
  d16
  (p21 ph2):f3

  (p13:sp2 ph1):f2
  4u
  (p14:sp5 ph1):f2
  p16:gp1
  d16
  DELTA3
  (p24:sp9 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA3
  p16:gp1
  d16
  (p13:sp8 ph2):f2

  4u
  30u fq=cnst21(bf ppm):f2

  (p13:sp2 ph7):f2
  d31
  (p2 ph1):f1 
  d31
  (center (p14:sp7 ph1):f2 (p22 ph1):f3 )
  d31
  (p2 ph3):f1 
  d31
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u
  30u fq=cnst22(bf ppm):f2

  (p2 ph3)
  (p13:sp2 ph6):f2
  d32
  (center (p2 ph1) (p22 ph1):f3 )
  p16:gp1
  d16
  DELTA8
  (p14:sp5 ph1):f2
  d52
  (p24:sp9 ph1):f2
  d42
  p16:gp1
  d16
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2

  (p21 ph5):f3
  d43
  (p14:sp5 ph1):f2
  d43
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA4
  d33
  (p14:sp5 ph1):f2
  d33
  DELTA5
  p16:gp3*EA3
  d16 pl0:f1
  (p11:sp1 ph3:r):f1
  4u
  4u pl1:f1

  (p1 ph8)
  p16:gp4
  d16
  DELTA6
  (center (p2 ph2) (p14:sp3 ph1):f2 (p22 ph2):f3 )
  DELTA6
  p16:gp4
  d16
  (p1 ph1) 

  p16:gp5*EA5
  d16
  4u

  (p21 ph1):f3
  p16:gp6
  d16
  DELTA7 pl0:f1
  (p11:sp1 ph4:r):f1
  4u
  4u pl1:f1
  (center (p2 ph2) (p22 ph2):f3 )
  4u pl0:f1
  (p11:sp1 ph4:r):f1
  4u
  DELTA7
  p16:gp6
  d16 pl1:f1
  (p21 ph9:r):f3

  p16:gp7*EA7
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph7, +90), caldel(d31, +in31))
     F2PH(calph(ph6, +90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
     F3EA(calgrad(EA3) & calgrad(EA5) & calgrad(EA7) & calph(ph8, +180) & calph(ph9, +180), caldel(d33, +in33) & caldel(d43, -in43) & calph(ph5, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 2
ph6=0 0 0 0 2 2 2 2
ph7=0 0 2 2
ph8=3
ph9=3
ph31=0 2 2 0 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp9: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;        sp9 requires higher selectivity than sp3
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (sp9)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(CaCO)                                      [4 msec]
;d23: 1/(4J(NCa)                                       [12 msec]
;d25: 1/(4J'(NH)                                       [2.3 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d31: incremented delay (F1 in 3D)                     [3 usec]
;d32: incremented delay (F2 in 3D)                     [3 usec]
;d33: incremented delay (F3 in 3D)                     [3 usec]
;d42: decremented delay (F2 in 3D) = d22+d52-p16-d16
;d43: decremented delay (F3 in 3D) = d23/2-d25/2-p14/2-p16/2-d16/2-2u
;d52: incremented delay (F2 in 3D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(4 * SW(CO)) = (1/2) DW(CO)
;in32: 1/(2 * SW(Ca)) = DW(Ca)
;in33: 1/(4 * SW(N)) = (1/2) DW(N)
;in42: = k2 * in32
;in43: = in33
;in52: = (1 - k2) * in32
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: echo-antiecho in F3


;for z-only gradients:
;gpz1: 30%
;gpz2: 18%
;gpz3: 44%
;gpz4: 53%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100


;for z-only gradients:
;gpz1: 2%
;gpz2: 2%
;gpz3: -80%
;gpz4: 2%
;gpz5: 30%
;gpz6: 45%
;gpz7: 30.13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100



