;zgcpdcps
;avance-version (12/01/11)
;1D sequence with presaturation
;using shaped pulse for off-resonance presaturation
;with optional decoupling on f2
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>

"d11 = 30m"
"d12 = 20u"
"l6 = d1/p18"

"acqt0 = -p1*2/3.1416"


1 ze
#   ifdef FLAG_13C
  d12 pl21:f2
2 d11 cpd2:f2
#   else
  d12 
2 d11 
#   endif
3 p18:sp6:f1 ph29
  4u
  lo to 3 times l6
  d12 pl1:f1 
  p1 ph1
  4u
  p1 ph2
  4u
  p1 ph3
  4u
  p1 ph4
  go=2 ph31
  d11 mc #0 to 2 F0(zd)

  4u do:f2
exit


ph1=1 3 3 1 2 0 0 2
ph2=2 0 2 0 3 1 3 1
ph3=3 1 1 3 0 2 2 0
ph4=0 2 0 2 1 3 1 3
ph29=0
ph31=0 2 0 2 1 3 1 3


;pl1 : f1 channel - power level for pulse (default)
;sp6: f1 channel - shaped pulse for presaturation
;p1 : f1 channel -  90 degree high power pulse
;p18: f1 channel - presaturation using shaped pulse
;d11: delay for disk I/O
;d12: delay for power switching                      [20 usec]
;l6: p18 * l6 = total duration of presaturation
;ns: 1 * n, total number of scans: NS * TD0



                                          ;preprocessor-flags-start
;FLAG_13C: for 13c decoupling
;             option -DFLAG_13C: (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


