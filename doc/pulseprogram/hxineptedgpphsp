;hxineptedgpphsp
;avance-version (21/09/15)
;2D heteronuclear shift correlation
;with refocussing of chem. shifts
;XH, XH3 positive, XH2 negative
;phase sensitive
;
;A. Bax & G.A. Morris, J. Magn. Reson. 42, 501 (1981)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p4=p3*2"
"d3=3s/(cnst2*8)"
"d4=1s/(cnst2*4)"
"d11=30m"


"d0=3u"

"in0=inf1/2"


"DELTA1=d4-d0-p26/2"
"DELTA2=d4+d0+p26/2"
"DELTA3=d3-p4/2"
"DELTA4=de+p1*2/PI"
"DELTA5=d3+p4/2-4u"


"spoffs60=bf1*(cnst60/1000000)-o1"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl12:f2
2 d11 do:f2 
3 d1
  20u pl2:f2
  50u UNBLKGRAD

  p16:gp1
  d16

  (p3 ph3):f2
  DELTA1
  d0
  (p26:sp8 ph4)
  d0
  (p4 ph1):f2
  DELTA2 pl1:f1
  (p3 ph2):f2 

  p16:gp2
  d16
  
  (p1 ph1)
  DELTA3
  (p52:sp46 ph1)
  (p4 ph1):f2
  DELTA4
  DELTA5 pl12:f2
  4u BLKGRAD
  (p52:sp46 ph1)

  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 2 2
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp8: f1 channel - shaped pulse (180degree)
;spnam8: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;sp46: f1 channel - shaped pulse 180 degree (adiabatic matched sweep)
;spnam60: Crp60_xfilt.2
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p26: f1 channel - 180 degree shaped pulse
;p52: f1 channel - 180 degree shaped pulse for adiabatic matched sweep
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d3 : 3/(8J(XH))  XH, XH3 positive, XH2 negative
;d4 : 1/(4J(XH))
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(XH)
;cnst60: C chemical shift (offset, in ppm)            [75 ppm]
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/(2 * SW(H)) = DW(H)
;nd0: 2
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50% 
;gpz2: 30% 

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


;for matched sweep use 
;   low to high field sweep, 
;   carrier shifted to center of spectrum (75 ppm) via spoffs60
;   d4 = 1/(4*J(CH) center of spectrum [1.696 ms])
;   cnst2 = 147.4Hz


