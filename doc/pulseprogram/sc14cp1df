;sc14cp1df
;avance-version (21/02/18)
;
;1D DQ excitation squence SC14 with cross polarization 
;for setup of 2D INADEQUATE type experiments 
;for yield measurements
;
;corresponding 2D sequence sc14cp2daswf for inadequate experiments
;modified by HF 09.05.2008 for floating point phases
;revised by GALT August 12, 2011
;
;references:
;A. Brinkmann, M. Eden, and M. H. Levitt: 
; Sychronous helical pulse squences in magic-angle spinning NMR.
; Double-Quantum recoupling of multiple-spin systems.
; J. Chem. Phys. 112, 8539-8554 (2000)
;
;phase cycling: 	4 (double quantum filter + read pulse phase cycling) 
;								* 4 (read pulse 90 degree phase shift) 
;								* 2 (1H (f2) spin temperature inversion)
; full phase cycle: ns=32
; ns=16 should give resonably clean spectra
; for ns=4 or ns=8 some artefacts may occur 
; (most of these are suppressed by the read pulse cycling)
;
;DQ exciation and reconversion times may be set independently by l0 and l1, respectively. 
;To insure equal durations set zgoptns=-Dfixed
;
;Avance III version
;parameters:
;d1 : recycle delay
;pl11 : power level for SC14 recouping sequence B1=3.5*cnst31 in Hz
;pl1 : power level for HH match f1
;pl2 : = 0 W (not used)
;pl12 : power level for standard 1H excitation and decoupling
;pl13 : power level for special decoupling, e. g. cwlg
;sp0 : power level for HH match f2
;p1 : excitation pulse f1 at plw1
;p3 : excitation pulse f2 at plw12
;p15 : contact time
;pcpd1 : pulse width in decoupling sequence
;pcpd2 : pulse width in decoupling sequence
;spnam0 : for CP on 1H e.g. ramp.64 
;cpdprg1: decoupling f2 during SC14, e.g. cwlg
;cpdprg2: decoupling f2, e.g. spinal64, tppm15, or cw
;cnst10 : =-180*cnst31*d0, recalculated during acquisition
;cnst20 : proton RF field to calculate LG parameters
;cnst21 : =0, proton offset
;cnst22 : +ve Lee-Goldburg offset
;cnst23 : -ve Lee-Goldburg offset
;cnst24 : additional Lee-Goldburg offset
;cnst31 : spinning frequency
;l0 : number of composite SC14 cycles for excitation (usually a multiple of 7)
;l1 : number of composite SC14 cycles for reconversion (usually a multiple of 7)
;zgoptns : blank or =fixed (l1=l0)
;
;
;$CLASS=Solids
;$DIM=1D
;$TYPE=cross polarisation
;$SUBTYPE=homonuclear correlation
;$COMMENT=DQ excitation sequence SC14, cp for excitation

prosol relations=<solids_cp>


#include <lgcalc.incl>

define pulse pul180
"pul180=((1.0s/cnst31)/7)"
"d31=1.0s/cnst31"

;for identical excitation and reconversion blocks
#ifdef fixed
"l1=l0"
#endif

;for protection against excessively long recoupling pulses
define delay excite
"excite=2.0*l0*pul180"
define delay reconv
"reconv=2.0*l1*pul180"
define delay recoup
"recoup=excite+reconv"

;for digmod=baseopt
"acqt0=(-2.0*p1)/3.14159"

#include <rot_prot.incl>
			;requires cnst31 to be set to 1000 Hz or larger
1 ze
  d31			;to show d31 in ased
2 d1 do:f2
#include <p15_prot.incl>	
			;make sure p15 does not exceed 10 msec	
			;let supervisor change this pulseprogram if 
			;more is needed
#include <aq_prot.incl>
			;allows max. 50 msec acquisition time, supervisor
			;may change  to max. 1s at less than 5 % duty cycle
			;and reduced decoupling field
#include <recoup_prot.incl>
			;allows max. 10 ms of total (excitation and reconversion) recoupling time
  1m rpp11
  1m rpp12
  1m rpp13
  1m rpp14
  1u fq=cnst22:f2		;to show cnst21 and cnst23 in ased
  1u fq=cnst23:f2
  1u fq=cnst21:f2
  (p3 pl12 ph1):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
  (p1 ph3):f1 (1u cpds1):f2									;f1 flip back pulse
3 pul180:f1 ph11 pl11:f1 ipp11 ipp13 ipp14	;SC14 exitation pulse at pl11
  pul180:f1 ph12  ipp12
  lo to 3 times l0
4 pul180:f1 ph13	ipp13											;SC14 revonversion pulse at pl11
  pul180:f1 ph14 ipp14
  lo to 4 times l1
  (p1 pl1 ph5):f1 (1u cpds2):f2							;f1 read pulse
  gosc ph31 		;start ADC with ph31 signal routing
  1m do:f2
  1m ip13				;DQ filter
  1m ip14
  lo to 2 times ns
  100m wr #0
HaltAcqu, 1m
exit
ph0= 0 
ph1= {1}*16 {3}*16
ph2= 0
ph3= {3}*16 {1}*16
ph5= 1 2 3 0 2 3 0 1
     3 0 1 2 0 1 2 3
ph10=0


