;lc2pnf2
;avance-version (12/01/11)
;pseudo-2D-sequence for lc-nmr on flow detection
;with double presaturation during relaxation delay and mixing time
;presaturation using f1 and f2 - channel
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>


"d11=30m"
"d12=20u"
"d13=4u"


"acqt0=-p1*2/3.1416"


1 ze

#   ifdef WAITFORSTART
  autosuspend
#   endif

  d12 pl21:f2
2 d11
3 d12 pl9:f1
  d1 cw:f1 ph29 cw:f2 ph29
  d13 do:f1 do:f2
  d12 pl1:f1
  p1 ph1
  d13
  p1 ph2
  d12 pl9:f1
  d8 cw:f1 cw:f2
  d13 do:f1 do:f2
  d12 pl1:f1
  p1 ph3
  go=2 ph31
  d11 wr #0 if #0 zd 
  lo to 3 times td1
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl21: f2 channel - power level for presaturation
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1                      [ca. 1-2sec]
;d8 : mixing time                                     [ca. 80 msec]
;d11: delay for disk I/O                              [30 msec]
;d12: delay for power switching                       [20 usec]
;d13: short delay                                     [4 usec]
;ns: 8 * n
;ds: 16
;td1: number of increments along the chromatographic time axis


                                          ;preprocessor-flags-start
;WAITFORSTART: Start experiment with option -DWAITFORSTART (eda: ZGOPTNS)
;                 Acquisition waits for 'resume' command for sychronisation
;                 with chromatography
                                          ;preprocessor-flags-end



