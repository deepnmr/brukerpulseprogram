;noesyhsqcgpsm3d.3
;avance-version (21/09/15)
;NOESY-HSQC
;3D sequence with
;   homonuclear correlation via dipolar coupling 
;   dipolar coupling may be due to noe or chemical exchange.
;   H-1/X correlation via double inept transfer
;   simultaneous evolution of C-13 and N-15 chemical shift in t2
;phase sensitive (t1)
;phase sensitive (t2)
;with decoupling during acquisition
;using shaped pulses for inversion on f2 - channel
;using trim pulse
;using delayed sampling
;(use parameterset NOESYHSQCGPSM3D.3)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"p22=p21*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d12=20u"
"d26=1s/(cnst4*4)"

"p28=1m"

"p16=1m"
"p19=800u"


"in0 = inf1"
"in10 = inf2"
"in29 = 1s/(cnst29*bf3)"

"d0 = in0/2-p1*4/PI"
"d10 = in10/2-p3*4/PI"
"d29 = in29/2 -p21*4/PI"


"DELTA1=d4-p16-d16-p35/2-4u"
"DELTA2=d26-d4"
"DELTA3=d4-p19-d16-p35/2-p1*2/PI-4u"
"DELTA4=d4-p19-d16-p35/2-8u"


"TAU1=larger(p35,p22)/2-p1-d0/2"
"TAU=d8-p16-d16-TAU1"
"TAU2=(p35-p2)/2"
"TAU3=(p35-p22)/2"


"spoffs13=0"
"acqt0 = 0"


aqseq 321


1 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
  4u BLKGRAD
3 d12 pl9:f1
  d1 cw:f1
  4u do:f1
  d12 pl1:f1 pl2:f2 pl3:f3
  50u UNBLKGRAD
 
  (p21 ph1):f3 
  (p3 ph1):f2
  
  p16:gp3
  d16

  (center (TAU1 p1 ph7 d0 p1 ph8 TAU1):f1 (p35:sp41 ph1):f2 (p22 ph1):f3 )

  TAU  
  p16:gp3
  d16 

  (p1 ph5)
  4u
  p16:gp1
  d16
  DELTA1
  (lalign
   (DELTA2 TAU2 p2 ph1 TAU2)
   (p35:sp41 ph1):f2
   (DELTA2 TAU3 p22 ph1 TAU3):f3
  )
  DELTA2
  DELTA1
  4u
  p16:gp1
  d16
  (p1 ph2)

  4u pl2:f2 
  p16:gp4
  d16 

  (center 
   (p44:sp30 ph1):f1
   (p3 ph4 d10 p3 ph1):f2
   (p21 ph4 d29 p21 ph1):f3
  )

  4u pl1:f1
  p19:gp3
  d16 

  (p1 ph2)
  4u 
  p19:gp2
  d16 
  DELTA3
  (lalign
   (DELTA2 TAU2 p2 ph1 TAU2):f1
   (p35:sp41 ph1):f2
   (DELTA2 TAU3 p22 ph1 TAU3):f3
  )
  DELTA2
  DELTA4
  4u
  p19:gp2
  d16 pl12:f2 pl16:f3
  (p28 ph2)

  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph8, -90), caldel(d0, +in0)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10) & caldel(d29, +in29))
exit
   

ph1 = 0 
ph2 = 1
ph3 = 2
ph4 = 0 2
ph5 = 0 0 2 2 
ph6 = 1
ph7 = 0 0 0 0 2 2 2 2
ph8 = 0
ph31 = 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl9: f1 channel - power level for cw 
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp41: f2 channel - shaped pulse 180 degree (Bip720,100,10.1)
;spnam41: Bip720,100,10.1
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [800 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p28: f1 channel - trim pulse                        [1 msec]
;p35: f2 channel - 180 degree shaped pulse
;d0 : incremented delay (F1 in 3D) = in0/2-p1*4/PI
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d8 : mixing time
;d10: incremented delay (F2 in 3D) = in10/2-p3*4/PI
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(NH))
;d29: incremented delay (F2 in 3D) = in29/2 -p21*4/PI
;cnst2: = J(CH)
;cnst4: = J(NH)
;cnst29: SW(N) in ppm
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(X) = 2 * DW(X)
;in0: 1/SW(H) = 2 * DW(H)
;in10: 1/SW(C) = 2 * DW(C)
;in29: 1/SW(N) = 2 * DW(N)
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 19%
;gpz2: 30%
;gpz3: 65%
;gpz4: -25%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1



