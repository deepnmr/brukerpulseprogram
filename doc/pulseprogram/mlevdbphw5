;mlevdbphw5
;avance-version (20/07/28)
;MLEV-WaterControl
;homonuclear Hartman-Hahn transfer using MLEV17 sequence
;   for mixing
;using two power levels for excitation and spinlock
;phase sensitive
;water suppression using watercontrol W5 pulse sequence with gradients
;using double echo
;
;J. Chen, A.M. Torres, G. Zheng & W.S. Price  
;   J. Biomol. NMR 74, 333-340 (2020)
;A.M. Torres, G. Zheng & W.S. Price, J. Biomol. NMR 67, 233-241 (2017)
;A. Bax & D.G. Davis, J. Magn. Reson. 65, 355-360 (1985)
;M. Liu, X. Mao, C. He, H. Huang, J.K. Nicholson & J.C. Lindon,
;   J. Magn. Reson. 132, 125 - 129 (1998)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p5=p6*.667"
"p7=p6*2"
"d12=20u"

"p30=3m"


"in0=inf1"

"d0=in0/2-p1*2/PI-4u"


"DELTA=50u+p1*2/PI-de"


"d25=d15-p1*2-p16*2-p30-d16*3-p27*5.95-d19*18-150u-DELTA"


"SCALEF=p7*2/p5"
"FACTOR1=((d9-p17*2)/(p6*64+p5))/SCALEF"
"l1=FACTOR1*SCALEF"


"acqt0=0"
baseopt_echo


1 ze 
2 d1
  "d25=d15-p1*2-p16*2-p30-d16*3-p27*5.95-d19*18-150u-DELTA" 
3 d12 pl1:f1

  p1 ph1
  d0
  4u pl10:f1
  (p17 ph26)
						;begin MLEV17
4 (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p5 ph23)
  lo to 4 times l1 
						;end MLEV17
  (p17 ph26) 

  50u pl18:f1 UNBLKGRAD
  p16:gp1
  d16
  p27*0.087 ph2
  d19*2
  p27*0.206 ph2
  d19*2
  p27*0.413 ph2
  d19*2
  p27*0.778 ph2
  d19*2
  p27*1.491 ph2
  d19*2
  p27*1.491 ph3
  d19*2
  p27*0.778 ph3
  d19*2
  p27*0.413 ph3
  d19*2
  p27*0.206 ph3
  d19*2
  p27*0.087 ph3

  p16:gp2
  d16 pl1:f1
  50u

  p1 ph4

  50u
  p30:gp3
  d16
  50u BLKGRAD

  d25

  p1 ph5

  50u UNBLKGRAD

  p16:gp1
  d16 pl18:f1

  p27*0.087 ph6
  d19*2
  p27*0.206 ph6
  d19*2
  p27*0.413 ph6
  d19*2
  p27*0.778 ph6
  d19*2
  p27*1.491 ph6
  d19*2
  p27*1.491 ph7
  d19*2
  p27*0.778 ph7
  d19*2
  p27*0.413 ph7
  d19*2
  p27*0.206 ph7
  d19*2
  p27*0.087 ph7
  p16:gp2
  d16

  DELTA BLKGRAD

  go=2 ph31
  d1 mc #0 to 2 F1PH(calph(ph1, +90), caldel(d0, +in0))
  d15
exit

  
ph1=1 3
ph2=0 0 2 2
ph3=2 2 0 0
ph4=1
ph5=3
ph6=0 0 0 0 2 2 2 2
ph7=2 2 2 2 0 0 0 0
ph22=3
ph23=0
ph24=1
ph25=2
ph26=0
ph31=1 3


;pl1 : f1 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl18: f1 channel - power level for W5-pulse (watergate)
;p1 : f1 channel -  90 degree high power pulse
;p5 : f1 channel -  60 degree low power pulse
;p6 : f1 channel -  90 degree low power pulse
;p7 : f1 channel - 180 degree low power pulse
;p16: homospoil/gradient pulse
;p17: f1 channel -  trim pulse                             [2.5 msec]
;p27: f1 channel -  90 degree pulse at pl18
;p30: crusher gradient                                     [3 msec]
;d0 : incremented delay (2D) : in0/2-p1*2/PI-4u
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d12: delay for power switching                            [20 usec]
;d15: diffusion time for WaterControl (BigDelta)           [15-50 m] 
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;l1: loop for MLEV cycle: (((p6*64) + p5) * l1) + (p17*2) = mixing time
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 2 * n
;ds: 32
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;for z-only gradients:
;gpz1: 97%
;gpz2: 97%
;gpz3: 73.13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



