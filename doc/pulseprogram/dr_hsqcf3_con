;dr_hsqcf3_con
;avance-version (21/09/15)
;parent dataset:
;HSQC
;2D sequence with
;
;      F1(H) -> F3(N,t1) -> F2(H,t2)
;
;water suppression using watergate sequence
;
;child dataset:
;HNCO
;2D sequence with
;
;      F1(H) -> F3(N,t1) -> F2(C=O,t2)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;using semi-constant time in t1
;
;
;E. Kupce & L.E. Kay, J. Biomol. NMR 54, 1-7 (2012)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
#include <De.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"

"d21=5.5m"
"d22=4.5m"
"d23=15m"
"d25=2.72m"
"d27=12.4m"


"d29=3u"
"d0=d23/2-p14/2"
"d28=d23/2-p14/2-p26-d21-4u"
"d20=d23/2+p14/2+d29"

"in0=inf1/4"

"FACTOR1=d20*10000000*4/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20=in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in29= 0; } else { in29=in0-INCR1; }"

"in28=in0"


"DELTA1=d27-p14-4u"
"DELTA2=d27-d22-p14-4u"
"DELTA3=d26-p16-d16-p11-12u"
"DELTA4=d26-p16-d16-p11-p13-12u"


"l0=1"

"l3=td1/4"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs8=0"


1 d11 ze1
  d11 ze2
  d11 pl16:f3 
2 12m do:f3
3 3m
4 12m
5 3m
  d1 pl1:f1

  (p1 ph1):f1
  d26 pl3:f3
  (center (p2 ph1):f1 (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  4u
  (p11:sp1 ph1):f1
  4u
  p16:gp1
  d16

  (p21 ph3):f3
  d21 pl19:f1
  (p26 ph2):f1
  4u cpds1:f1 ph1
  d28
  (p14:sp5 ph1):f2
  d0
  (p14:sp3 ph1):f2
  d29
  (p14:sp5 ph1):f2
  d29
  (p22 ph8):f3
  d20
  (p14:sp5 ph1):f2
  d20
  (p21 ph2):f3

  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2
  d16 pl1:f1

  (p13:sp2 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA1
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA2

  if "l0 %2 == 1"
     {
     d22
     (p14:sp5 ph1):f2
     4u
     (p13:sp8 ph2):f2
     }
  else
     {
     (p14:sp5 ph1):f2
     d22
     4u
     (p13:sp8 ph6):f2
     }

  p16:gp3
  d16

  (p21 ph1):f3
  d25
  (center (p2 ph1):f1 (p22 ph1):f3 )
  d25
  (p21 ph2):f3

  p16:gp4
  d16
  (p11:sp1 ph1):f1
  4u
  4u pl1:f1

  (p1 ph1):f1 
  4u
  p16:gp5
  d16
  DELTA3
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1):f1 (p22 ph1):f3 )
  4u
  (p11:sp1 ph6):f1
  DELTA4
  p16:gp5
  d16 pl16:f3
  4u BLKGRAD
  4u cpd3:f3
  (p13:sp2 ph1):f2

  ACQ_START1(ph30,ph31) ACQ_START2(ph30,ph31)
  0.1u DWELL_GEN1 DWELL_GEN2
  (aq1) (aq2)  
  eoscnp2			                	
  rcyc=2

  3m do:f3
  3m wr1 #0 if1 #0 zd1
  3m wr2 #1 if2 #1 zd2
  3m iu0
  lo to 3 times 2
  3m ip3
  lo to 4 times 2
  3m id0
  3m dd20
  3m id28
  3m id29
  lo to 5 times l3
exit


ph1=0
ph2=1 
ph3=0 2
ph6=2
ph7=3
ph8=0 0 2 2
ph30=0
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (2D) = d23/2-p14/2
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d23/2+p14/2+d29
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: 1/(2J'(CaCO)                                     [4.5 msec]
;d23: 1/(4J(NCO)                                       [15 msec]
;d25: 1/(4J(NH)                                        [2.72 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d27: 1/(4J'(NCO)                                      [12.4 msec]
;d28: incremented delay (2D) = d23/2-p14/2-p26-d21-4u
;d29: incremented delay (2D)                           [3 sec]
;cnst4: = J(NH)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;l3 : loop for 2D experiment = td1/4
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(N)) = (1/2) DW(N)
;in20: = k1 * in0
;in28: = in0
;in29: = (1 - k1) * in0
;ns: 4 * n
;ds: >= 16
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 50%
;gpz3: 40%
;gpz4: 70%
;gpz5: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



;Processing:
;1H,15N HSQC, parent dataset: 
;   use AU program split [ipap 2]. The first of resulting datasets contans the final ser file
;   which is then processed as usual.
;
;HNCO, child dataset:
;   use AU-program splitcomb [ipap 2] to process data.



