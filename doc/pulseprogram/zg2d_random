#include <Avance.incl>
#include <Delay.incl>


define delay RANDOMDELAY


"DELTA=d20-(20u+d21+p1+aq)"


"ns=1"


"acqt0=-p1*2/3.1416"


1 ze
2 DELTA
3 20u

  "RANDOMDELAY=random(d21,100)"

  RANDOMDELAY
  p1 ph1
  go=2 ph31
  DELTA wr #0 if #0 zd
  lo to 3 times td1
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1: f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;d20: total recycle delay incl. aq
;ns: 1
;v9 : 100 % 
;d21: randomized delay [0..2*d21]
;td1: number of experiments



