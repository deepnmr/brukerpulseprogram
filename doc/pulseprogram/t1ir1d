;t1ir1d
;avance-version (07/04/03)
;T1 measurement using inversion recovery
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"p2=p1*2"


"acqt0=-p1*2/3.1416"


1 ze
2 30m
  d1
  p2 ph1
  d7
  p1 ph2
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit 


ph1=0 2
ph2=0 0 2 2 1 1 3 3 
ph31=0 0 2 2 1 1 3 3 


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;d1 :relaxation delay; 1-5 * T1
;d7 : delay for inversion recovery
;ns :8 * n, total number of scans: NS * TD0
;ds :4 



