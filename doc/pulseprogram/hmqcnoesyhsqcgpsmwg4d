;hmqcnoesyhsqcgpsmwg4d
;avance-version (15/02/27)
;HMQC-NOESY-HSQC
;4D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange
;   H-1/X correlation via double inept transfer
;simultaneous evolution of C-13 and N-15 chemical shift in t1 and t3
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;using constant time in t1
;with decoupling during acquisition - using f2 and f3
;using shaped pulses for inversion on f2 - channel
;water suppression using watergate sequence
;
;Y. Xu, D. Long & D. Yang, J. Am. Chem. Soc. 129, 7722 (2007)
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d4=1.7m"
"d26=2.2m"

"p29=300u"


"in31=inf1/4"
"in32=inf2/2"
"in33=inf3/2"

"in41=in31"
"in52=in30/2-in32"
"in53=in30/2-in33"

"d31=3u"
"d33=3u"
"d53=3u"
"d32=in32/2-p3*2/PI-p2/2"
"d41=d26-p29-d16"
"d52=in52/2-p21*2/PI-p3-d32-p2/2"

"td1=tdmax(td1,d41*2,in41)"


"DELTA1=d4-d31-p8/2-p29-d16"
"DELTA2=d26-d4-p8/2"
"DELTA3=d4-p8/2-p16-d16"
"DELTA4=d26-p16-d16"
"DELTA5=d33*4+d53*2+p2*2+p3*2+p4"
"DELTA6=d33*2+p2"
"DELTA7=d26-p16-d16+larger(p2,p22)/2-p2/2-p1*2/PI-4u"
"DELTA8=d26-p16-d16+larger(p2,p22)/2-p2/2-de-8u"


"TAU=d8-d26*2-p21-p16-d16"
"TAU1=d26*2-d4*2-p3"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl1:f1 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1
  d12 pl1:f1 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p1 ph3)
  p29:gp1
  d16
  DELTA1
  d31
  (p8:sp13 ph1):f2
  DELTA2
  (center (p2 ph11) (p22 ph1):f3 )
  p29:gp2
  d16 pl2:f2
  d41

  (p21 ph5):f3
  (p3 ph4):f2 
  d32
  (p2 ph11) 
  d32
  (p3 ph1):f2
  (p21 ph1):f3

  p29:gp3
  d16
  DELTA1
  d31
  (p8:sp13 ph1):f2
  DELTA2
  (center (p2 ph11) (p22 ph1):f3 )
  p29:gp4
  d16 pl2:f2
  d41
  (p1 ph6)

  d4*2
  (p3 ph1):f2
  TAU1
  (p21 ph1):f3
  TAU
  p16:gp5
  d16

  (p1 ph1)
  p16:gp1
  d16
  DELTA3
  (p8:sp13 ph1):f2
  DELTA2
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p16:gp1
  d16 pl2:f2
  (p1 ph2)

  (p11:sp1 ph1):f1
  p16:gp6
  d16 pl1:f1

  (p21 ph7):f3
  DELTA5
  (p22 ph9):f3
  d53 
  (p3 ph8):f2
  DELTA6
  (p4 ph9):f2
  d33 
  (p2 ph1)
  d33 
  (p3 ph1):f2
  d53 
  (p21 ph1):f3

  p16:gp7
  d16
  (p11:sp1 ph1):f1
  2u
  2u pl1:f1

  (p1 ph1)
  p16:gp8
  d16

  (
  refalign (DELTA7 p11:sp1 ph10 2u 2u pl1 p2 ph1 4u p11:sp1 ph10 DELTA8):f1
  lalign (DELTA3 p8:sp13 ph1):f2
  lalign (DELTA4 p22 ph1):f3
  )

  p16:gp8
  d16 pl12:f2 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 

#   ifdef LABEL_F1
     F1I(ip4*2, 2, ip7*2, 2)
#   else

#   ifdef LABEL_F2
     F2I(ip4*2, 2, ip7*2, 2)
#   else
     F3I(ip4*2, 2, ip7*2, 2)
#   endif /*LABEL_F2*/

#   endif /*LABEL_F1*/

     F1PH(calph(ph3, +90), caldel(d31, +in31) & caldel(d41, -in41))
     F2PH(calph(ph4, +90) & calph(ph5, +90), caldel(d32, +in32) & caldel(d52, +in52))
     F3PH(calph(ph7, +90) & calph(ph8, +90) & calph(ph9, +90), caldel(d33, +in33) & caldel(d53, +in53))
exit
   

ph1=0 
ph2=1
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0 2
ph5=2 0
ph6=(8) 1
ph7=0 0 2 2
ph8=0 0 2 2
ph9=1
ph10=2
ph11=0 0 0 0 1 1 1 1
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0
  

;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp13: f2 channel - shaped pulse 180 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                 [300 usec]
;d1 : relaxation delay; 1-5 * T1
;d4:  1/(4J(CH)                                        [1.7 msec]
;d8 : mixing time
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J'(NH)                                       [2.2 msec]
;d31: incremented delay (F1 in 4D)                     [3 usec]
;d32: incremented delay (F2 in 4D) = in32/2-p3*2/PI-p2/2
;d33: incremented delay (F3 in 4D)                     [3 usec]
;d41: decremented delay (F1 in 3D) = d26-p29-d16
;d52: incremented delay (F2 in 3D) = in52/2-p21*2/PI-p3-d32-p2/2
;d53: incremented delay (F3 in 3D)                     [3 usec]
;inf1: 1/SW(C) = 2 * DW(C)
;inf2: 1/SW(H) = 2 * DW(H)
;inf3: 1/SW(C) = 2 * DW(C)
;in30: 1/SW(N) = 2 * DW(N)
;in31: 1/(4 * SW(C)) = (1/2) DW(C)
;in32: 1/(2 * SW(H)) = DW(H)
;in33: 1/(2 * SW(C)) = DW(C)
;in41: = in31
;in52: = in30/2-in32
;in53: = in30/2-in33
;ns: 16 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 4%
;gpz2: 7%
;gpz3: 13%
;gpz4: 10%
;gpz5: 80%
;gpz6: 75%
;gpz7: 23%
;gpz8: 30%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_F1: to run with phase changes for separation of C/N bound protons
;             along the F1 dimension start experiment with 
;             option -DLABEL_F1: (eda: ZGOPTNS)
;LABEL_F2: to run with phase changes for separation of C/N bound protons
;             along the F2 dimension start experiment with 
;             option -DLABEL_F2: (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;Processing

;PHC0(F1): -45.0
;PHC0(F2): 90.0
;PHC1(F2): -180.0
;FCOR(F2): 1

