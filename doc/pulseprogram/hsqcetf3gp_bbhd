;hsqcetf3gp_bbhd
;avance-version (20/03/03)
;reset-HSQC
;2D H-1/X correlation via double inept transfer
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using trim pulses in inept transfer
;using f3 - channel
;using 1H broadband homodecoupling during acquisition with [BIRD]d element
;NH2 groups may be left as doubletts with 2J(HH) spliting
;
;L. Paudel, R.W. Adams, P. Kiraly, J.A. Aguilar, M. Foroozandeh,
;   M.J. Cliff, M. Nilsson, P. Sandor, J.P. Waltho & G.A. Morris,
;   Angew. Chem. 125, 11830-11833 (2013)
;(P. Sakhaii, B. Haase & W. Bermel, J. Magn. Reson. 199, 192-198 (2009))
;Davis et al., J. Magn. Reson. 98, 207 - (1992)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
#include <De.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d21=1s/(cnst4*2)"
"d26=1s/(cnst4*4)"

"p29=300u"


"d0=3u"

"in0=inf1/2"


"d62=aq/l0"
"d63=d62/2"


"l1=l0-1"


"DELTA1=d26-p16-d16+p1*2/PI-de-12u"
"DELTA2=d21-larger(p2,p22)/2"

#   ifdef LABEL_CN
"DELTA=p16+d16+larger(p2,p14)+d0*2"
#   else
"DELTA=p16+d16+p2+d0*2"
#   endif /*LABEL_CN*/

"TAU=p22"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl16:f3
2 d11 do:f3
  4u BLKGRAD
  4u pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  4u pl1:f1 pl3:f3
  50u UNBLKGRAD

3 (p1 ph1)
  d26
  (center (p2 ph1) (p22 ph6):f3 )
  d26

#   ifdef TRIMP
  p28 ph1
#   endif /* TRIMP */

  (p1 ph2)

  4u
  p16:gp5
  d16

  (p21 ph3):f3
  d0 

#   ifdef LABEL_CN
  (center (p2 ph5) (p14:sp3 ph1):f2 )
#   else
  (p2 ph5)
#   endif /*LABEL_CN*/

  d0
  p16:gp1*EA
  d16
  (p22 ph4):f3
  DELTA
  (ralign (p1 ph1) (p21 ph4):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  p16:gp2
  d16
  DELTA1 pl16:f3

  4u
  4u cpd3:f3
  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d63
  0.05u DWELL_HOLD
  0.1u REC_BLK

  10u do:f3
  p29:gp3
  d16 pl3:f3
  TAU
  (p1 ph1)
  DELTA2
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA2
  (p1 ph7)
  (p22 ph1):f3
  p29:gp3
  d16 pl16:f3
  20u
  p29:gp4
  d16
  4u
  (p2 ph1)
  4u
  p29:gp4
  d16
  10u cpd3:f3

4 0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK
  
  10u do:f3
  p29:gp3
  d16 pl3:f3
  TAU
  (p1 ph1)
  DELTA2
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA2
  (p1 ph7)
  (p22 ph1):f3
  p29:gp3
  d16 pl16:f3
  20u
  p29:gp4
  d16
  4u
  (p2 ph1)
  4u
  p29:gp4
  d16
  10u cpd3:f3

  lo to 4 times l1

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62*2
  0.05u DWELL_HOLD
  0.1u REC_BLK

  rcyc=2

  d11 do:f3 mc #0 to 2 
     F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph3, +180) & calph(ph6, +180) & calph(ph31, +180))

  4u BLKGRAD
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0
ph7=2
ph29=0
ph30=0
ph31=0 2 0 2 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp3: f2 channel - shaped pulse 180 degree for inversion
;spnam3: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p28: f1 channel - trim pulse
;p29: gradient pulse 3                                    [300 usec]
;d0 : incremented delay (2D)                              [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                                  [30 msec]
;d16: delay for homospoil/gradient recovery
;d21 : 1/(2J(YH))
;d26 : 1/(4J(YH))
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;cnst4: = J(YH)
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 1 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 8.1% for N-15
;gpz3: 3%
;gpz4: 5%
;gpz5: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



