;jresgpphes
;homonuclear J-resolved 2D correlation
;phase sensitive
;with excitation sculpting for solvent suppression

;A.J. Pell & J. Keeler, J. Magn. Reson. 189, 293-299 (2007)
;Foroozandeh M., Morris G.A. & Nilsson M., Chem.Eur.J. 24, 13988-14000 (2018)
;T.-L. Hwang & A.J. Shaka, J. Magn. Reson., Series A 112 275-279 (1995)

;$CLASS=HighRes
;$DIM=2D
;$TYPE=J-resolved
;$SUBTYPE=Phase-sensitive
;$COMMENT=Phase-sensitive J-resolved experiment with excitation sculpting


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


prosol relations=<triple>

define delay BETA
define delay SWi
define pulse P_in

"d11=30m"
"d12=20u"

"in0=inf1/2"

"d0=3u"
"p49=30ms"

"TAU1=p1*2/PI+4u"
"TAU2=d16+de"

"cnst62=(cnst61/360)*sqrt((2*cnst60)/(p49/2000000))"
"P_in = 1000000.0 / (cnst62*4)"
"BETA = cnst62 / (2.27 * 2) "
"cnst63= (P_in/p1) * (P_in/p1)"
"spw37=plw1/cnst63"

"l0=0"

"acqt0=0"
baseopt_echo


1 ze
2 30m
  d1 pl1:f1 BLKGRAD
  2u
  2u pl1:f1
  (p1 ph1)
  
  50u UNBLKGRAD
  p16:gp1
  d16 pl0:f1
  (p12:sp1 ph2:r):f1
  4u
  d12 pl1:f1

  (p2 ph3)

  4u
  p16:gp1
  d16 
  TAU
  p16:gp2
  d16 pl0:f1
  (p12:sp1 ph4:r):f1
  4u
  d12 pl1:f1

  (p2 ph5)

  4u
  p16:gp2
  d16
  
  if "l0 %2 == 0"
  {
   4u
   p16:gp3
   d16 pl0:f1
   (p49:sp37 ph7):f1 (p49:gp0)
   p16:gp3
   d16 pl1:f1
   d16
   TAU1
   p16:gp1
   d16 pl0:f1
   (p44:sp30 ph1)
   p16:gp1
   d16 pl1:f1
   TAU2

   d0
   p16:gp2
   d16 pl0:f1
   (p44:sp30 ph1)
   p16:gp2
   d16 pl1:f1
   d0

  }
  else
  {
   4u
   p16:gp1
   d16 pl0:f1
   (p44:sp30 ph1)
   p16:gp1
   d16 pl1:f1
   TAU1

   d0
   p16:gp2
   d16 pl0:f1
   (p44:sp30 ph1)
   p16:gp2
   d16 pl1:f1

   d0

   TAU2
   p16:gp3
   d16 pl0:f1
   (p49:sp37 ph7):f1 (p49:gp0)
   p16:gp3
   d16 pl1:f1
   d16
  }

  4u  BLKGRAD
  go=2 ph31
  d11 mc #0 to 2 
  F1EA(calclc(l0, 1), caldel(d0, +in0))
exit

ph1=0
ph2=0 1
ph3=2 3
ph4=0 0 1 1
ph5=2 2 3 3
ph7= 0 0 0 0 1 1 1 1 
ph31=0 2 2 0 2 0 0 2




;pl1 : f1 channel - power level for pulse (default)
;sp1 : f1 channel - shaped pulse 180 degree (Sinc.1000)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp34: f1 channel - shaped pulse 180 degree (Rsnob.1000)
;sp37: f1 channel - shaped pulse 180 degree for psyche element (Crp_psyche.20)
;p1 : f1 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;p49: f1 channel - 180 degree shaped pulse for psyche element  [30 msec]
;                      Crp_psyche.20
;p12: f1 channel - 180 degree shaped pulse (Squa100.1000)   [2 msec]
;cnst60: sweepwidth of single chirp element in Crp_psyche.20   [10000 Hz]
;cnst61: desired flip angle (ca. 20 degree)
;cnst62: gammaB1/2PI value for p49:sp37 (in Hz)
;cnst63: scaling factor for power (sp37)
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;inf1: 1/w, w = max. width of multiplet
;in0: 1/(2 * w), w = max. width of multiplet
;nd0: 2
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho

;for z-only gradients:
;gpz0: 2%
;gpz1: 17%
;gpz2: 19%
;gpz3: 23%

;use gradient files:
;gpnam0: RECT.1
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100

