;hmbcetgpl2ndsm
;avance-version (12/01/11)
;HMBC
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;   simultaneous evolution of C-13 and N-15 chemical shift in t1
;   different number of increments for C-13 and N-15
;phase sensitive using Echo/Antiecho gradient selection
;with two-fold low-pass J-filter to suppress one-bond correlations
;no decoupling during acquisition
;
;M. Perez-Trujillo, P. Nolis, W. Bermel & T. Parella,
;   Magn. Reson. Chem. 45, 325-9 (2007)
;(D.O. Cicero, G. Barbato & R. Bazzo, J. Magn. Reson. 148, 
;   209-213 (2001))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"cnst27=(-sfo2-sfo3*2+sfo2*sfo3/sfo1)/(-sfo2*2-sfo2*sfo3*2/sfo1)"
"cnst28=(+sfo2-sfo3*2+sfo2*sfo3/sfo1)/(+sfo2+sfo3*2+sfo2*sfo3/sfo1)"
"cnst29=(+sfo2-sfo3*2-sfo2*sfo3/sfo1)/(+sfo2*2+sfo2*sfo3*2/sfo1)"
"cnst30=(-sfo2*2+sfo2*sfo3*2/sfo1)/(+sfo2+sfo3*2+sfo2*sfo3/sfo1)"

define list<gradient> EA1 = { 1.000 cnst27}
define list<gradient> EA2 = { cnst28 cnst29}
define list<gradient> EA3 = { cnst30 -1.000}

"cnst26=cnst27+cnst28+cnst29+cnst30"


"p2=p1*2"
"p22=p21*2"
"d6=1s/(cnst13*2)"
"d11=30m"


"in31=inf1/2"

"in0=in31*l13"
"in28=(in20/2-in31*l13)/2"
"in29=in31/2"
"in30=in31"

"d0=3u"
"d28=3u"
"d29=((l13-1)*in31/2)+3u"
"d30=3u"



"DELTA1=1s/(2 * cnst6)-p16-d16"
"DELTA2=1s/(2 * cnst7)-p16-d16"
"DELTA3=d6-p16-d16-4u"
"DELTA4=p2+d0*2+d30*2"
"DELTA5=p3*2+d28*4+d29*4+p14*2+p2*2+d0*4+d30*4+p24+p16+d16"


"l0=0"
"l10=0"


1 ze 
2 d11
3 d1

  20u
  "d29=(((l13-1)-(l10%l13))*in31/2)+3u"
  20u
  "d30=((l10%l13)*in31)+3u"
  20u
  "cnst29=(l0%2)*180"
  20u
  "cnst30=(l10%2)*180"
  20u
  "cnst31=cnst29+cnst30"

  3m ip4+cnst30
  3m ip5+cnst31
  3m ip31+cnst30

  p1 ph1
  DELTA1 UNBLKGRAD
  p16:gp3
  d16 pl2:f2
  (p3 ph3):f2
  DELTA2
  p16:gp4
  d16
  (p3 ph3):f2
  4u
  p16:gp5
  d16
  DELTA3

  (p21 ph5):f3
  d28
  d29
  (p14:sp3 ph1):f2
  d29
  d28 pl2:f2

  (p3 ph4):f2
  d30
  d0
  p2 ph2
  d0
  d30
  p16:gp1*EA1
  d16
  (p24:sp7 ph6):f2
  p16:gp1*EA2
  d16 pl2:f2
  DELTA4
  (p3 ph6):f2

  d28
  d29
  (p14:sp3 ph1):f2
  d29
  d28
  (p22 ph7):f3
  p16:gp1*EA3
  d16
  DELTA5
  (p21 ph7):f3

  4u BLKGRAD
  go=2 ph31
  d11 mc #0 to 2 
      F1I(iu0, 2, iu10, l13)
      F1EA(calgrad(EA1) & calgrad(EA2) & calgrad(EA3), caldel(d0, +in0) & caldel(d28, +in28))

exit 
  

ph1=0
ph2=0 0 0 0 2 2 2 2
ph3=0 0 2 2
ph4=0 2
ph5=0 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph7=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 0 2 0 2 0 2 2 0 2 0 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;sp3: f2 channel - shaped pulse 180 degree
;spnam3: Crp60,0.5,20.1
;sp7: f2 channel - shaped pulse (180degree refocussing)
;spnam7: Crp60comp.4
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d6 : delay for evolution of long range couplings (1/2Jlr)
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d28: incremented delay (2D)                           [3 usec]
;d29: calculated delay (2D) = (((l13-1)-(l0%l13))*in31/2)+3u
;d30: calculated delay (2D) = ((l0%l13)*in31)+3u
;cnst6: = 1J(XH)min
;cnst7: = 1J(XH)max
;cnst13: = J(XH) long range
;l13: ratio of number of experiments (C-13/N-15)       [4]
;inf1: 1/SW(C) = 2 * DW(C)
;in0 : 1/(2 * SW(C)) * l13 = in31*l13
;in20: 1/SW(N) = 2 * DW(N)
;in28: 1/(4 * SW(N)) - ( 1/(4 * SW(C)) * l13 ) = (in20/2-in31*l13)/2
;in29: = in31/2
;in30: = in31
;in31: 1/(2 * SW(C)) = DW(C) = inf1/2
;nd31: 2
;ns: 2 * n
;ds: 16
;td1: total number of experiments (for C-13)
;        number of experiments (for N-15): td1/l13
;FnMODE: echo-antiecho


;for z-only gradients:
;gpz1: 80%
;gpz3: 15%
;gpz4: -10%
;gpz5: -5%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



;Processing


;PH_mod(F1): pk (or no)

;use AU-program splitsm to process data followed by xfb and xf2m



