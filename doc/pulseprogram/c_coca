;c_coca
;avance-version (21/09/15)
;COCa
;2D sequence with
;   13C detected correlation for triple resonance using
;      inept transfer step
;
;      F1(C=O,t1) -> F1(Ca,t2)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using semi-constant time in t1
;detecting antiphase signal
;(use parameterset C_COCA)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"d11=30m"
"d12=20u"

"d22=4.5m"


"d0=d22"
"d20=3u"
"d28=d22+d20-4u"

"in0=inf1/2"

"FACTOR1=d28*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = 0; } else { in20=in0-INCR1; }"
"if ( INCR1 > in0 ) { in28 = in0; } else { in28 = INCR1; }"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst22-cnst21)/1000000)"


"o1_F1=bf1*cnst21/1000000"


1 ze 
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 fq=cnst21(bf ppm):f1
  d12 cpd2:f2 cpd3:f3
  50u UNBLKGRAD

  (p11:sp23 ph3)
  d0
  (p12:sp26 ph1)
  d20
  (p12:sp24 ph4)
  d28
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph2)

  p16:gp1
  d16 fq=cnst22(bf ppm):f1

  (p11:sp23 ph5)
  4u BLKGRAD

  go=2 ph31
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, +in20) & caldel(d28, -in28))
exit 

  
ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 1 1 1 1 
ph5=0 0 2 2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;d0 : incremented delay (F1 in 2D) = d22
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: incremented delay (F1 in 2D)                     [3 usec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d28: decremented delay (F1 in 2D) = d22+d20-4u
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: Calpha chemical shift (cnst22)
;inf1: 1/SW(CO) = 2 * DW(CO)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in20: = in0 - in28
;in28: = (d28 *2 / td1) or in0
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1
;                         50

;for z-only gradients:
;gpz1: 50%

;use gradient files:
;gpnam1: SMSQ10.100



;use AU-program combap to process data



