;reset_happy_festa

;heteronuclear 1D spin echo with gradients
;using selective refocussing with a shaped pulse
;uses spherical randomization prior to d1
;evolving heteronuclear coupling to antiphase
;using DIPSI2 sequence for mixing
;with option for zero quantum suppression
;uses PSYCHE for interferogram pure shift

; G. Dal Poggetto, J. V. Soares & C. F. Tormena, Anal. Chem. 2020, 92, 20, 1404714053

 
; ZGOPTNS:
; -DZQF : uses Thrippleton-Keeler's zero-quantum suppresion filter
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=Homodecoupling
;$SUBTYPE=Reset
;$COMMENT=19F to 1H selective TOCSY experiment combined with PSYCHE homodecoupling, use AU-program proc_reset or xaua to process data
				 	 ;run wvm -q before zg or launch with xaua

#include <De.incl>
#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define delay BETA
define delay SWi
define pulse P_in


create_shape(sp12, rsnob, name= sel180_1H, stepSize= 10.0 us, bandwidth= $cnst12 Hz, offset= $cnst16 ppm)
create_shape(sp24, iburp2, name= sel180_19F_1, stepSize= 10.0 us, bandwidth= $cnst14 Hz, offset= $cnst15 ppm)
create_shape(sp25, iburp2, name= sel180_19F_2, stepSize= 10.0 us, bandwidth= $cnst14 Hz, offset= $cnst15 ppm, timeReversal=true)
"d11=30m+1s/(cnst12)-1s/(cnst12)"
"d11=30m+1s/(cnst14)-1s/(cnst14)"
"d11=30m+1s/(cnst15)-1s/(cnst15)"
"d11=30m+1s/(cnst16)-1s/(cnst16)"

"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"

define delay tauJ
define delay tau

"l31=d24/(2*dw)" 
"in0=dw*l31"
"d0=0"
"p11=p40"
"tauJ=in0/2-p16-d16-50u"
"tau=dw*2*l30"
"DELTA=d24*td1"

"cnst62=(cnst61/360)*sqrt((2*cnst60)/(p45/2000000))"
"P_in = 1000000.0 / (cnst62*4)"
"BETA = cnst62 / (2.27 * 2) "
"cnst63= (P_in/p1) * (P_in/p1)"
"spw37=plw1/cnst63"

"d4=(1s*(0.5)/(cnst2*cnst3))" 
"DELTA=d4*0.5"
"spoal12=0.5" 
"spoal14=1"
"spoal15=0"
"d11=30m"
"d12=20u"
"p2=2*p1"
"p4=2*p3"
"p8=1m"
"p18=1m"
"acqt0 = 0"
baseopt_echo

1 ze
  d11
  d11 pl2:f2

2 d11
  d12 
  d12 pl1:f1
  10u UNBLKGRAD
  p8 ph21
  p8 ph22
  p16:gp8*-1
  d16 BLKGRAD
  50u LOCKH_OFF
  d1 
  50u LOCKH_ON
  10u UNBLKGRAMP

3 (p1 ph1):f1
  10u 
  10u pl0:f2
  p14:sp24:f2 ph2
  10u 
  10u pl0:f1
  DELTA
  p16:gp1
  d16
  p12:sp12:f1 ph3
  p16:gp1
  d16 
  10u 
  10u pl0:f2
  p14:sp25:f2 ph2
  10u 
  10u pl1:f1
  DELTA
  (p1 ph4):f1
  
# ifdef ZQF

   10u pl0:f1 
   10u gron0

   (p32:sp29 ph5):f1
   20u groff
   
# endif /*ZQF*/

  100u pl10:f1
  
               ;begin DIPSI2
4 p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
 
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25
  p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
 lo to 4 times l1
               ;end DIPSI2
			   
  p16:gp2*-1
  
# ifdef ZQF

   d16 pl0:f1 
   10u gron10*1.33
   (p32*0.75:sp29 ph5):f1
    20u groff 
	
# endif /*ZQF*/

  100u pl1:f1 
  200u
  (p1 ph6):f1
  
5 d0
  tauJ
  50u
  p16:gp3
  d16
  (p2 ph7):f1
  50u
  p16:gp3
  d16
  tauJ
  tau
  50u
  p16:gp4
  d16
  10u pl0:f1
  d16
  (center (p45:sp37 ph8):f1 (p45:gp11)) ;PSYCHE element
  d16
  10u pl1:f1
  p16:gp4
  d16
  50u BLKGRAMP
  d0
  
  go=2 ph31
  d11 mc #0 to 2
  F1QF(id0)
  DELTA
  50u LOCKH_OFF
exit

