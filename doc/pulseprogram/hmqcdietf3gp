;hmqcdietf3gp
;avance-version (12/01/11)
;HMQC-TOCSY
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;using DIPSI2 sequence for homonuclear Hartman-Hahn mixing
;phase sensitive using Echo/Antiecho gradient selection
;with decoupling during acquisition
;using f3 - channel
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d21=1s/(cnst4*2)"


"d0=3u"

"in0=inf1/2"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"DELTA1=p16+d16+8u"

#   ifdef LABEL_CN
"DELTA=d16+larger(p2,p14)/2+d0-p21*2/3.1416-4u"
#   else
"DELTA=d16+p2/2+d0-p21*2/3.1416-4u"
#   endif /*LABEL_CN*/


1 ze 

#   ifdef LABEL_CN
2 d1 do:f2 do:f3
  10u pl2:f2 pl3:f3
#   else
2 d1 do:f3
  10u pl3:f3
#   endif /*LABEL_CN*/

3 p1 ph1
  d21 UNBLKGRAD
  (p21 ph3):f3
  4u
  p16:gp1*-1*EA
  DELTA
  (p22 ph3):f3
  d0
  p16:gp1*EA
  d16

#   ifdef LABEL_CN
  (center (p2 ph2) (p14:sp3 ph1):f2 )
#   else
  (p2 ph2)
#   endif /*LABEL_CN*/

  p16:gp1*EA
  d16
  d0
  (p22 ph4):f3
  4u
  p16:gp1*-1*EA
  DELTA
  (p21 ph4):f3
  d21
  (p1 ph1)
  d20 pl10:f1

						;begin DIPSI2
4 p6*3.556 ph22
  p6*4.556 ph24
  p6*3.222 ph22
  p6*3.167 ph24
  p6*0.333 ph22
  p6*2.722 ph24
  p6*4.167 ph22
  p6*2.944 ph24
  p6*4.111 ph22
  
  p6*3.556 ph24
  p6*4.556 ph22
  p6*3.222 ph24
  p6*3.167 ph22
  p6*0.333 ph24
  p6*2.722 ph22
  p6*4.167 ph24
  p6*2.944 ph22
  p6*4.111 ph24

  p6*3.556 ph24
  p6*4.556 ph22
  p6*3.222 ph24
  p6*3.167 ph22
  p6*0.333 ph24
  p6*2.722 ph22
  p6*4.167 ph24
  p6*2.944 ph22
  p6*4.111 ph24

  p6*3.556 ph22
  p6*4.556 ph24
  p6*3.222 ph22
  p6*3.167 ph24
  p6*0.333 ph22
  p6*2.722 ph24
  p6*4.167 ph22
  p6*2.944 ph24
  p6*4.111 ph22
  lo to 4 times l1
						;end DIPSI2

  d20 pl1:f1
  (p1 ph1)
  DELTA1
  (p2 ph5)
  4u
  p16:gp2

#   ifdef LABEL_CN
  d16 pl12:f2 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3 
  d1 do:f2 do:f3 mc #0 to 2 
#   else
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d1 do:f3 mc #0 to 2 
#   endif /*LABEL_CN*/

     F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph3, +180) & calph(ph31, +180))
exit 
  

ph1=0
ph2=0 0 2 2
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=1
ph22=3
ph24=1
ph31=0 2 0 2 2 0 2 0



;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D)                  [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: z-filter delay                                   [10 usec]
;d21: 1/(2J(YH))
;cnst4: = J(YH)
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2
;                         80 : 32.4

;for z-only gradients:
;gpz1: 80%
;gpz2: 32.4%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



