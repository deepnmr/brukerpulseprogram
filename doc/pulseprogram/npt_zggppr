;$Id:$
;1D sequence with f1 presaturation and spoil gradient for residual water
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>
#include <Grad.incl>

"d12=20u"

1 ze
2 30m
  50u BLKGRAD
  d12 pl9:f1
  d1 cw:f1 ph29
  50u UNBLKGRAD
  4u do:f1
  p16:gp1
  d16 pl1:f1
  p1 ph1
  go=2 ph31
  50u BLKGRAD
  30m mc #0 to 2 F0(zd)
exit

ph1=0 2 2 0 1 3 3 1
ph29=0
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p1 : f1 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse
;d1 : relaxation delay; 1-5 * T1
;d16: delay for homospoil/gradient recovery
;NS: 1 * n, total number of scans: NS * TD0
;DS: 2,4
;use gradient ratio:    gp 1
;                          3

;for z-only gradients:
;gpz1: 3-5%

;use gradient files:
;gpnam1: SINE.100
