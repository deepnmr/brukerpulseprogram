;hacancocahgp3d
;avance-version (21/09/15)
;(HCa)NCO(Ca)H
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F2(Ca) -> F3(N,t2) -> F2(C=O,t1)
;            -> F2(Ca) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;using constant time in t1 and t2
;(use parameterset )
;
;S. Maentylahti, M. Hellman & P. Permi,
;   J. Biomol. NMR 49, 99-109 (2011)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d4=1.7m"
"d24=14m"
"d28=3.6m"

#   ifdef LABEL_NOGLY
"d3=3.4m"
#   else
"d3=2.2m"
#   endif /*LABEL_NOGLY*/

#   ifdef LABEL_ALL
"d23=13.5m"
"d27=14.0m"
#   else
"d23=16.6m"
"d27=25m"
#   endif /*LABEL_ALL*/


"d0=3u"
"d10=d23"
"d20=d23-p14-4u"
"d30=d27"

"in0=inf1/2"
"in10=inf2/2"

"in20=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=p16+d16+8u" 
"DELTA2=d24-d3-p26*2"
"DELTA3=d23-d0-p14"
"DELTA4=d27-d10-p14"
"DELTA5=d28-d3-p26-4u"
"DELTA6=d3-p16-d16"
"DELTA7=d4-p19-d16"

"TAU=p13-p1"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst22)/1000000)"
"spoffs8=0"


"o1_F1=bf2*cnst21/1000000"


aqseq 321


1 d11 ze
  d11 pl14:f2 pl3:f3
2 d11 do:f2
3 d1 pl1:f1 fq=cnst22(bf ppm):f2

  (p1 ph1)
  d4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  d4 UNBLKGRAD
  (p1 ph2):f1 

  p16:gp8
  d16

  (p13:sp2 ph5):f2
  d3 pl19:f1
  (p26 ph1):f1
  (p26 ph2):f1
  DELTA2 cpds1:f1 ph1
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d24
  (p13:sp8 ph1):f2

  4u do:f1
  (p26 ph4):f1

  p16:gp3
  d16 fq=cnst21(bf ppm):f2

  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p21 ph7):f3
  d10
  (p14:sp3 ph1):f2
  DELTA4
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d30
  (p21 ph2):f3

  4u do:f1
  (p26 ph4):f1

  p16:gp4
  d16

  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p13:sp2 ph6):f2
  d0
  (p14:sp5 ph1):f2
  DELTA3
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d20
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2

  4u do:f1
  (p26 ph4):f1

  p16:gp5
  d16 fq=cnst22(bf ppm):f2

  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p13:sp2 ph1):f2
  4u
  (p14:sp7 ph1):f2
  d28
  (p14:sp3 ph1):f2
  4u
  (p14:sp7 ph1):f2
  DELTA5
  4u do:f1
  (p26 ph4):f1
  DELTA6
  p16:gp1
  d16 pl1:f1

  (ralign (p1 ph1) (p13:sp8 ph8):f2 )
  p19:gp6
  d16
  DELTA7
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA7
  p19:gp6
  d16
  (lalign (p1 ph2) (p13:sp2 ph9):f2 )
  p19:gp7
  d16
  DELTA7
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA7
  p19:gp7
  d16
  TAU
  (p1 ph1)
  DELTA1
  (p2 ph1)
  4u
  p16:gp2
  d16 pl14:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph6, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2PH(calph(ph7, +90), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 2 2 2 2
ph6=0 2
ph7=0 0 2 2
ph8=0
ph9=3
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl14: f2 channel - power level for low power decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(3J(CH))                                       [2.2 msec]
;     or 1/(2J(CH))                                    [3.4 msec]
;d4 : 1/(4J(CH))                                       [1.7 msec]
;d10: incremented delay (F2 in 3D) =  d23
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d23-p14-4u
;d23: 1/(4J(NCO))                                      [13.5 msec]
;     or 1/(4J'(NCO))                                  [16.6 msec]
;d24: 1/(4J(NCa))                                      [14.0 msec]
;d27: 1/(4J(NC))                                       [14.0 msec]
;     or 1/(4J'(NC))                                   [25.0 msec]
;d28: 1/(4J(COCa))                                     [3.6 msec]
;d30: decremented delay (F2 in 3D) = d27
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = in0
;in30: = in10
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 20.1%
;gpz3: 40%
;gpz4: 40%
;gpz5: 40%
;gpz6: 5%
;gpz7: 2%
;gpz8: 40%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_ALL: for intra and sequential cross peaks start experiment with
;              option -DLABEL_ALL (eda: ZGOPTNS)
;LABEL_NOGLY: for spectrum without Gly cross peaks start experiment with
;              option -DLABEL_NOGLY (eda: ZGOPTNS)
                                          ;preprocessor-flags-end

