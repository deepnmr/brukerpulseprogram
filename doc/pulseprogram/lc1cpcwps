;lc1cpcwps
;avance-version (12/01/11)
;1D sequence with presaturation
;using shaped pulse for off-resonance presaturation
;with cw-decoupling on f2 - channel during acquisition
;using composite pulse
;
;A. Bax, J. Magn. Reson. 65, 142-145 (1985)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>


"d12=20u"


"if (d1/p18 < 1) {l6=1;} else {l6=d1/p18;}"


"acqt0=-(p1*6/3.1416)-4u"


1 ze
  d12 pl21:f2
2 30m do:f2
3 p18:sp6:f1 ph29
  4u
  lo to 3 times l6
  d12 pl1:f1
  p1 ph1
  4u
  p1 ph2
  4u
  p1 ph3
  4u
  p1 ph4
  go=2 ph31 cw:f2
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1=1 3 3 1 2 0 0 2
ph2=2 0 2 0 3 1 3 1
ph3=3 1 1 3 0 2 2 0
ph4=0 2 0 2 1 3 1 3
ph29=0
ph31=0 2 0 2 1 3 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl21: f2 channel - power level for decoupling
;sp6 : f1 channel - shaped pulse for presaturation
;p1 :  90 degree transmitter high power pulse
;p18:  f1 channel - presaturation using shaped pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                              [20 usec]
;l6:  p18*l6 = total duration of presaturation
;ns: 1 * n, total number of scans: NS * TD0
;ds: 4

;use 100msec pulse of square shape defined by 1000 points



