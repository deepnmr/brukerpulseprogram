;selno
;avance-version (21/09/15)
;1D NOESY using selective excitation with a shaped pulse
;dipolar coupling may be due to noe or chemical exchange.
;
;C.J. Bauer, R. Freeman, T. Frenkiel, J. Keeler & A.J. Shaka,
;   J. Magn. Reson. 58, 442 (1984)
;H. Kessler, H. Oschkinat, C. Griesinger & W. Bermel,
;   J. Magn. Reson. 70, 106 (1986)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>

define delay d8_orig

"d8_orig=d8"

#   ifdef CALC_SPOFFS
"spoffs1=bf1*(cnst21/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/


1 ze
2 30m
  "d8=random(d8_orig,cnst8)"
  d1
  4u pl0:f1
  p11:sp1:f1 ph1:r
  4u
  d14  pl1:f1
  p1 ph2
  d8
  p1 ph3
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph31= 0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse
;p1 : f1 channel -  90 degree high power pulse
;p11: f1 channel -  90 (or 270) degree shaped pulse
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time (cnst8 - random variation)
;d14: delay for evolution after shaped pulse: 
;               for 90 deg pulse               (p11)/2 + d14 ~ 1/(J)
;               for self-refocussing pulse     20 usec
;cnst21: chemical shift for selective pulse (offset, in ppm)
;cnst8: random variation of mixing time d8 in %   [5 %]
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4


;phcor 1 : phasedifference between power levels sp1 and pl1 

;choose p11 according to desired selectivity
;the flip-angle is determined by the amplitude
;set O1 on resonance on the multiplet to be excited or use spoffs



