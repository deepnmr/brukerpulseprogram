;zgpgsezr
;avance-version (17/08/11)
;1D sequence with power-gated decoupling
;with Z-restored spin echo
;(use parameterset ZGPGSEZR)
;
;Y. Xia, S. Moran, E.P. Nikonowicz & X. Gao, Magn. Reson. Chem. 46, 432-435 (2008)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"d11=30m"

"p0=p1*cnst18/90.0"


"DELTA=d1-100m"
"DELTA1=d21+p0*2/PI-de-4u"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl12:f2
2 30m do:f2
  10u pl13:f2
  d11 cpd2:f2
  DELTA
  4u do:f2
  10u pl12:f2
  100m cpd2:f2
  50u UNBLKGRAD

  (p26:sp8 ph1)
  p16:gp1
  d16 pl1:f1
  d20

  (p0 ph2)
  p19:gp2
  d16
  d21
  (p13:sp5 ph3)
  p19:gp2
  d16
  DELTA1
  4u BLKGRAD
  go=2 ph31
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph2=0 2 2 0 1 3 3 1
ph3=1 3 3 1 0 2 2 0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl13: f2 channel - power level for second CPD/BB decoupling
;sp5: f1 channel - shaped pulse (180degree)
;spnam5: Crp60comp.4  (Crp80comp.4)
;sp8: f1 channel - shaped pulse (180degree)
;spnam8: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;p0 : f1 channel - for flip angle 30 - 90 degrees
;p13: f1 channel - 180 degree shaped pulse
;     = 2msec for Crp60comp.4 (Crp80comp.4)
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [600 usec]
;p26: f1 channel - 180 degree shaped pulse
;     = 500us for Crp60,0.5,20.1 (Crp80,0.5,20.1)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: recovery delay                                 [30 msec]
;d21: spin-echo delay                                [250 usec]
;cnst18: flip angle in degree
;ns: 1 * n, total number of scans: NS * TD0
;ds=4
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 5%
;gpz2: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



