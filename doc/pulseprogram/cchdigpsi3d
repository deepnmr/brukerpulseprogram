;cchdigpsi3d
;avance-version (21/09/15)
;C-TOCSY-CHD2
;3D sequence with
;   inverse correlation using multiple inept transfer and
;      C-C DIPSI3 spinlock
;
;      F2(Cali,t1) -> F2(Cme,t2) -> F1(Hme,t3)
;
;using sensitivity improvement
;off resonance C=O pulse using shaped pulse
;phase sensitive using Echo/Antiecho gradient selection (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t2
;(use parameterset )
;
;R. Otten, B. Chu, K.D. Krewulak, H.J. Vogel & F.A.A. Mulder, 
;   J. Am. Chem. Soc. 132, 2952-2960 (2010)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA1 = { 1.000 -1.000}
define list<gradient> EA2 = { 1.000 -1.000}


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d4=1.98m"
"d21=1.98m"
"d23=14.0m"

"d0=3u"
"d10=d23-d21"
"d30=d23"

"in0=inf1/2"
"in10=inf2/2"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"l1=(d15/(p9*54.33*4))"

"d31=(p9*54.33*4)*l1"


"DELTA=d0*2+larger(p14,p22)-p14"
"DELTA1=d21-p19-d16-4u"
"DELTA2=d4-p24/2-p16-d16"
"DELTA3=p19+d16-p1*2/PI+de+8u"


"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst23)/1000000)"
"spoffs7=bf2*((cnst23-cnst36)/1000000)"
"spoffs9=0"


"o1_F1=bf2*cnst23/1000000"


aqseq 321


"acqt0=0"
baseopt_echo


1 ze 
  d11 pl12:f2 pl3:f3

2 d11 do:f2
  20u pl19:f1
  d1 cpds1:f1 ph1
  4u do:f1
  50u UNBLKGRAD
  20u pl1:f1
  20u fq=cnst23(bf ppm):f2

  (p1 ph1)
  p16:gp1
  d16 pl19:f1 pl2:f2

  20u cpds1:f1 ph1

  (p3 ph5):f2
  d0
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d0
  4u
  p19:gp2*EA1
  d16
  (p14:sp3 ph1):f2
  p19:gp2*EA1*-1
  d16
  DELTA
  (p14:sp5 ph1):f2
  2u
  2u pl2:f2
  (p3 ph6+ph16):f2
  2u
  2u pl15:f2

                                                 ;begin DIPSI3
4 (p9*2.722 ph2):f2
  (p9*4.389 ph4):f2
  (p9*2.778 ph2):f2
  (p9*3.056 ph4):f2
  (p9*0.333 ph2):f2
  (p9*2.556 ph4):f2
  (p9*4.000 ph2):f2
  (p9*2.722 ph4):f2
  (p9*4.111 ph2):f2
  (p9*3.778 ph4):f2
  (p9*3.889 ph2):f2
  (p9*2.889 ph4):f2
  (p9*3.000 ph2):f2
  (p9*0.333 ph4):f2
  (p9*2.500 ph2):f2
  (p9*4.050 ph4):f2
  (p9*2.830 ph2):f2
  (p9*4.389 ph4):f2
  (p9*2.722 ph4):f2
  (p9*4.389 ph2):f2
  (p9*2.778 ph4):f2
  (p9*3.056 ph2):f2
  (p9*0.333 ph4):f2
  (p9*2.556 ph2):f2
  (p9*4.000 ph4):f2
  (p9*2.722 ph2):f2
  (p9*4.111 ph4):f2
  (p9*3.778 ph2):f2
  (p9*3.889 ph4):f2
  (p9*2.889 ph2):f2
  (p9*3.000 ph4):f2
  (p9*0.333 ph2):f2
  (p9*2.500 ph4):f2
  (p9*4.050 ph2):f2
  (p9*2.830 ph4):f2
  (p9*4.389 ph2):f2
  (p9*2.722 ph4):f2
  (p9*4.389 ph2):f2
  (p9*2.778 ph4):f2
  (p9*3.056 ph2):f2
  (p9*0.333 ph4):f2
  (p9*2.556 ph2):f2
  (p9*4.000 ph4):f2
  (p9*2.722 ph2):f2
  (p9*4.111 ph4):f2
  (p9*3.778 ph2):f2
  (p9*3.889 ph4):f2
  (p9*2.889 ph2):f2
  (p9*3.000 ph4):f2
  (p9*0.333 ph2):f2
  (p9*2.500 ph4):f2
  (p9*4.050 ph2):f2
  (p9*2.830 ph4):f2
  (p9*4.389 ph2):f2
  (p9*2.722 ph2):f2
  (p9*4.389 ph4):f2
  (p9*2.778 ph2):f2
  (p9*3.056 ph4):f2
  (p9*0.333 ph2):f2
  (p9*2.556 ph4):f2
  (p9*4.000 ph2):f2
  (p9*2.722 ph4):f2
  (p9*4.111 ph2):f2
  (p9*3.778 ph4):f2
  (p9*3.889 ph2):f2
  (p9*2.889 ph4):f2
  (p9*3.000 ph2):f2
  (p9*0.333 ph4):f2
  (p9*2.500 ph2):f2
  (p9*4.050 ph4):f2
  (p9*2.830 ph2):f2
  (p9*4.389 ph4):f2
  lo to 4 times l1
                                                 ;end DIPSI3

  2u
  2u pl2:f2
  20u fq=cnst36(bf ppm):f2

  (p3 ph1):f2
  d30
  (p14:sp7 ph1):f2
  d10
  4u do:f1
  DELTA1
  p19:gp3*EA2*-1
  d16 pl1:f1 pl2:f2
  (center (p1 ph1) (p3 ph7):f2 )
  p16:gp5
  d16
  DELTA2
  (center (p2 ph1) (p24:sp9 ph1):f2 )
  DELTA2
  p16:gp5
  d16 pl2:f2
  (center (p1 ph2) (p3 ph8):f2 )
  p16:gp6
  d16
  DELTA2
  (center (p2 ph1) (p24:sp9 ph1):f2 )
  DELTA2
  p16:gp6
  d16
  (p1 ph1)
  DELTA3
  (p2 ph1)
  4u
  p19:gp4
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d11 do:f2 mc #0 to 2 
     F1EA(calgrad(EA1) & calph(ph6, +180), caldel(d0, +in0))
     F2EA(calgrad(EA2) & calph(ph16, +180) & calph(ph7, +180), caldel(d10, +in10) & caldel(d30, -in30))
  d31
exit 
  

ph1=0
ph2=1
ph3=2
ph4=3
ph5=1 3
ph6=0
ph16=0
ph7=1 1 3 3
ph8=0 0 2 2
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl15: f2 channel - power level for TOCSY-spinlock
;pl19: f1 channel - power level for CPD/BB decoupling
;sp3 : f2 channel - shaped pulse 180 degree (on resonance)
;sp5 : f2 channel - shaped pulse 180 degree (C=O off resonance)
;sp9: f2 channel - shaped pulse 180 degree  (off on resonance at cnst36)
;     sp9 requires higher selectivity
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p9 : f2 channel -  90 degree low power pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                               [500 usec]
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (selective)
;p28: f1 channel - trim pulse                        [1 msec]
;d0 : incremented delay (F1 in 3D)                   [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/((4J)CH)                                     [1.98 msec]
;d10: incremented delay (F2 in 3D) =  d23-d21
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/((4J)CH)                                     [1.98 msec]
;d23: 1/((2J)CC)                                     [14 msec]
;d30: decremented delay (F2 in 3D) = d23
;d31: length of DIPSI-3 cycle as executed = (p9*54.33*4)*l1
;cnst21: CO chemical shift (offset, in ppm)
;cnst36: Cme chemical shift (offset, in ppm)         [19.0 ppm]
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;inf2: 1/SW(Cme) = 2 * DW(Cme)
;in0: 1/(2 * SW(Cali)) = DW(Cali)
;nd0: 2
;in10: 1/(2 * SW(Cme)) = DW(Cme)
;nd10: 2
;in30: = in10
;ns: 4 * n
;ds: 32
;td1: number of experiments
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: echo-antiecho in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 10%
;gpz2: 40%
;gpz3: 50%
;gpz4: 32.7%
;gpz5: 7%
;gpz6: -3%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100


;F2 reverse



