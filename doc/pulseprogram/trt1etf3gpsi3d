;trt1etf3gpsi3d
;avance-version (21/09/15)
;3D H-1/X correlation via TROSY and inept transfer
;   using sensitivity improvement
;for measuring N-15 T1 relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;using flip-back pulse
;as pseudo3D
;(use parameterset )
;
;G. Zhu, Y. Xia, L.K. Nicholson & K.H. Sze,
;   J. Magn. Reson. 143, 423-426 (2000)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<delay> vd_list=<$VDLIST>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d25=1s/(cnst4*cnst12)"
"d26=1s/(cnst4*4)"


"d10=3u"

"in10=inf2/2"


"DELTA1=d26-p16-d16"
"DELTA2=d25-p16-d16"
"DELTA3=d26-p1-p11-p19-d16-4u"
"DELTA5=d26-p11-p19-d16-12u"
"DELTA6=d26-p11-p19-d16-p21-12u"

#   ifdef LABEL_CN
"DELTA=d10*2+p8-p21*4/3.1316"
"DELTA4=d26-p11-p19-d16-8u"
#   else
"DELTA4=d26+d10*2-p11-p19-d16-8u"
#   endif /*LABEL_CN*/



"l0=1"



"spoffs1=0"
"spoffs13=bf2*((cnst21+cnst22)/2000000)-o2"


aqseq 312


1 ze
  d11 st0
2 3m
3 6m
4 d1

  "TAU=vd_list-p26*2-p16-d16-8u"

  50u UNBLKGRAD
  (p21 ph1):f3
  p16:gp1
  d16 pl1:f1

  (p1 ph1)
  p16:gp2
  d16
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1
  p16:gp2
  d16
  (p1 ph2)

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  4u pl1:f1

  (p21 ph3):f3
  p16:gp3
  d16
  DELTA2 
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA2
  p16:gp3
  d16 pl19:f1
  (p21 ph2):f3

  (p26 ph2):f1

  TAU cpds1:f1 ph1

  4u do:f1
  (p26 ph2):f1
  4u
  p16:gp4
  d16 pl1:f1

  if "l0 %2 == 1"
     {
     (p21 ph4):f3
     }
  else
     {
     (p21 ph5):f3
     }

#   ifdef LABEL_CN
  DELTA
  (p22 ph1):f3
  d10
  (p8:sp13 ph1):f2
  d10
#   else
  d10
  d10
#   endif /*LABEL_CN*/

  (p1 ph6)
  4u pl0:f1
  (p11:sp1 ph6):f1
  p19:gp5
  d16
  DELTA3 pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p19:gp5
  d16 pl0:f1
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1

  (center (p1 ph1) (p21 ph2):f3 )

  4u
  p19:gp6
  d16
  DELTA5 pl0:f1
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph8:r):f1
  DELTA6
  p19:gp6
  d16 pl1:f1
  4u
  4u BLKGRAD
  (p21 ph7):f3

  goscnp ph31

  3m st vd_list.inc
  lo to 3 times nbl

  3m vd_list.res
  3m ipp3 ipp4 ipp5 ipp31
  lo to 4 times ns

  d1 mc #0 to 4
     F1QF()
     F2EA(calph(ph6, +180) & calph(ph7, +180) & calclc(l0, 1) & exec(rppall), caldel(d10, +in10) & calph(ph4, +180) & calph(ph5, +180) & calph(ph31, +180))

exit
   

ph1=0 
ph2=1
ph3=0 0 0 0 2 2 2 2
#   ifdef LABEL_CN
ph4=3 1 2 0
ph5=1 3 2 0
#   else
ph4=1 3 2 0
ph5=3 1 2 0
#   endif /*LABEL_CN*/
ph6=1
ph7=0
ph8=2
ph31=0 2 3 1 2 0 1 3
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d1 : relaxation delay; 1-5 * T1
;d10 : incremented delay                             [3 usec]
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d25: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d26: 1/(4J(YH))
;cnst4: = J(YH)
;cnst12: for multiplicity selection = 4 for NH, 8 for all multiplicities
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 32
;td1: number of delays in vd-list
;td2: number of experiments in F2
;NBL: = td1
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:	gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6
;                         30 :    3 :   -6 :    9 :   31 :   43

;for z-only gradients:
;gpz1: 30%
;gpz2: 3%
;gpz3: -6%
;gpz4: 9%
;gpz5: 31%
;gpz6: 43%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.50
;gpnam6: SMSQ10.50


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



