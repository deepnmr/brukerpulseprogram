;hsqctretf3gpsi3d.2
;avance-version (21/09/15)
;3D H-1/X correlation via double inept transfer
;   using sensitivity improvement
;for measuring N-15 T1rho relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using f3 - channel
;using flip-back pulse
;with adiabatic ramping
;with random H-1 decoupling
;as pseudo3D
;(use parameterset HSQCTRETF3GPSI.2)
;
;K.T. Dayie & G. Wagner, J. Magn. Reson. A 111, 121-126 (1994)
;F.A.A. Mulder, R.A. de Graaf, R. Kaptein & R. Boelens,
;   J. Magn. Reson. 131, 351-357 (1998)
;D.M. Korzhnev, N.R. Skrynnikov, O. Millet, D.A. Torchia &
;   L.E.Kay, J. Am. Chem. Soc. 124, 10743 (2002)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple2>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<delay> vd_list=<$VDLIST>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d24=1s/(cnst4*cnst11)"
"d25=1s/(cnst4*cnst12)"
"d26=1s/(cnst4*4)"

"p31=10m"

"cnst29=0"


"d10=3u"

"in10=inf2/2"


"DELTA2=p16+d16+8u"
"DELTA3=d25-p16-d16"
"DELTA4=d24-p19-d16"
"DELTA5=d26-p16-d16"

#   ifdef LABEL_CN
"DELTA1=d25-p16-d16-larger(p2,p8)-d10*2"
#   else
"DELTA1=d25-p16-d16-p2-d10*2"
#   endif /*LABEL_CN*/


"spoffs13=bf2*((cnst21+cnst22)/2000000)-o2"


aqseq 312

		
1 ze
  d11 pl16:f3 st0
2 6m do:f3 
3 6m
4 d11

  "d31=vd_list"
  d1 fq=cnst29(sfo hz):f3
  4u pl1:f1

  30m
  (p1 ph1)
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2)

  4u
  p16:gp1
  d16 pl1:f1

  (p21 ph3):f3
  d25 
  (center (p2 ph1) (p22 ph1):f3 )
  d25 pl19:f1
  (p21 ph11):f3

  p16:gp5
  d16 pl0:f3

  4u fq=cnst30(sfo hz):f3
  (p39:sp19 ph1):f3
  4u
  4u pl25:f3
  4u cpds8:f3 ph8
  
  "p30=random(p31,cnst31)"
6 (p30 ph10^):f1
  "d31=d31-p30"
  "p30=random(p31,cnst31)"
  if "d31 < p30"
     {
     "p30=d31"
     if "p30 < 3u"
        {
        "p30=3u"
        }
     goto 7
     }
  else
     {
     goto 6
     }
7 (p30 ph10^):f1
   
  4u do:f3
  4u pl0:f3
  (p39:sp20 ph1):f3
  4u
  4u fq=cnst29(sfo hz):f3

  p16:gp4
  d16 pl3:f3

  (p21 ph12):f3
  p16:gp2*-1*EA
  d16 
  DELTA3 pl1:f1
  (p22 ph6):f3
  d10

#   ifdef LABEL_CN
  (center (p2 ph7) (p8:sp13 ph1):f2 )
#   else
  (p2 ph7)
#   endif /*LABEL_CN*/

  d10
  p16:gp2*EA
  d16
  DELTA1

  (center (p1 ph1) (p21 ph4):f3 )
  p19:gp6
  d16
  DELTA4
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p19:gp6
  d16
  (center (p1 ph2) (p21 ph5):f3 )
  p16:gp7
  d16
  DELTA5
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA5
  p16:gp7
  d16
  (p1 ph1)
  DELTA2
  (p2 ph1)
  4u
  p16:gp3
  d16 pl16:f3
  4u  BLKGRAD
  goscnp ph31 cpd3:f3

  3m do:f3
  3m st vd_list.inc
  lo to 3 times nbl

  3m vd_list.res
  3m ipp3 ipp4 ipp5 ipp6 ipp7 ipp31
  lo to 4 times ns

  d11 mc #0 to 4
     F1QF()
     F2EA(calgrad(EA) & calph(ph5, +180) & exec(rppall), caldel(d10, +in10) & calph(ph12, +180) & calph(ph31, +180))
exit
   

ph0=0 
ph1=0 
ph2=1
ph3=0 2 
ph4=0 0 0 0 2 2 2 2
ph5=3 3 3 3 1 1 1 1
ph6=0 0 1 1 2 2 3 3
ph7=0 0 0 0 2 2 2 2
ph8=0
ph9=2
ph10=1 3
ph11=1
ph12=1
ph31=0 2 2 0 2 0 0 2
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;pl25: f3 channel - power level for spinlock
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;sp19: f3 channel - shaped pulse adiabatic ramp down
;sp20: f3 channel - shaped pulse adiabatic ramp up
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: f1 channel -  actual decoupler pulse (internally calculated)
;p31: f1 channel -  basic decoupler pulse            [10 msec]
;p39: f3 channel - shaped pulse for adiabatic ramping
;d1 : relaxation delay; 1-5 * T1
;d10 : incremented delay                             [3 usec]
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d24: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d25: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d26: 1/(4J(YH))
;d31: delay for T1rho spinlock (internally calculated)
;cnst4: = J(YH)
;cnst11: for multiplicity selection = 4 for NH, 8 for all multiplicities
;cnst12: for multiplicity selection = 4 for NH, 8 for all multiplicities
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst29: = 0, for on resonance frequency F3 [in Hz]
;cnst30: for off resonance frequency F3 [in Hz]
;cnst31: randomisation factor (in %)                 [10]
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 2 * n
;ds: >= 16
;td1: number of delays in vd-list
;td2: number of experiments in F2
;NBL: = td1
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2
;cpd3: decoupling according to sequence defined by cpdprg3
;cpds8: decoupling according to sequence defined by cpdprg8 : t1rho
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:	gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6 : gp 7
;			  30 :   80 : 16.2 :   50 :  -40 :    5 :   -2  for N-15

;for z-only gradients:
;gpz1: 30%
;gpz2: 80%
;gpz3: 16.2%
;gpz4: 50%
;gpz5: -40%
;gpz6: 5%
;gpz7: -2%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id: $

