;dipsi_hxineptgpphsp
;avance-version (20/06/19)
;2D heteronuclear shift correlation
;   with DIPSI2 TOCSY-mixing
;phase sensitive
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"

"d3=1s/(cnst2*cnst11)"
"d4=1s/(cnst2*4)"

"d11=30m"


"in0=inf1"

"d0=in0/2-p3*4/PI"


"DELTA1=de"
"DELTA2=p1*2/PI"
"DELTA3=d3-cnst17*p13/2-4u"
"DELTA4=d4-larger(p4,p26)/2"


"FACTOR1=(d9/(p9*115.112))/2"
"l1=FACTOR1*2"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl12:f2
2 d11 do:f2
3 d1
  20u pl2:f2
  50u UNBLKGRAD

  p16:gp1
  d16

  (center (p26:sp8 ph1) (p3 ph3 d0 p3 ph4):f2 )

  20u pl15:f2

						;begin DIPSI2
4 p9*3.556:f2 ph23
  p9*4.556:f2 ph25
  p9*3.222:f2 ph23
  p9*3.167:f2 ph25
  p9*0.333:f2 ph23
  p9*2.722:f2 ph25
  p9*4.167:f2 ph23
  p9*2.944:f2 ph25
  p9*4.111:f2 ph23
  
  p9*3.556:f2 ph25
  p9*4.556:f2 ph23
  p9*3.222:f2 ph25
  p9*3.167:f2 ph23
  p9*0.333:f2 ph25
  p9*2.722:f2 ph23
  p9*4.167:f2 ph25
  p9*2.944:f2 ph23
  p9*4.111:f2 ph25

  p9*3.556:f2 ph25
  p9*4.556:f2 ph23
  p9*3.222:f2 ph25
  p9*3.167:f2 ph23
  p9*0.333:f2 ph25
  p9*2.722:f2 ph23
  p9*4.167:f2 ph25
  p9*2.944:f2 ph23
  p9*4.111:f2 ph25

  p9*3.556:f2 ph23
  p9*4.556:f2 ph25
  p9*3.222:f2 ph23
  p9*3.167:f2 ph25
  p9*0.333:f2 ph23
  p9*2.722:f2 ph25
  p9*4.167:f2 ph23
  p9*2.944:f2 ph25
  p9*4.111:f2 ph23
  lo to 4 times l1
						;end DIPSI2

  20u pl2:f2

  (p3 ph1):f2
  DELTA4
  (center (p26:sp8 ph1) (p4 ph1):f2 )
  DELTA4
  (p3 ph2):f2

  p16:gp2
  d16 pl1:f1

  (p1 ph1)
  DELTA1
  DELTA3
  4u
  (center (p13:sp5 ph1) (p4 ph1):f2 )
  DELTA3 pl12:f2
  DELTA2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2
     F1PH(calph(ph3, +90), caldel(d0, +in0))
exit


ph1=0
ph2=1 3
ph3=0 0 2 2
ph4=0 0 0 0 2 2 2 2

ph23=1
ph25=3

ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl15: f2 channel - power level for TOCSY-spinlock
;sp5: f1 channel - shaped pulse (180degree)
;spnam5: Crp60comp.4  (Crp80comp.4)
;sp8: f1 channel - shaped pulse (180degree)
;spnam8: Crp60,0.5,20.1 (Crp80,0.5,20.1
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p9 : f2 channel - 180 degree low power pulse
;p13: f1 channel - 180 degree shaped pulse
;p26: f1 channel - 180 degree shaped pulse
;d0 : incremented delay (2D): in0/2-p3*4/PI
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(J(XH)*cnst11)
;d4 : 1/(4J(XH))
;d9 : TOCSY mixing time
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(XH)
;cnst11: = 6.9  XH, XH2, XH3 positive
;          4.0  XH only
;          2.667  XH, XH3 positive, XH2 negative
;cnst17: = -0.5 for Crp60comp.4
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/(2 * SW(H)) = DW(H)
;nd0: 2
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50% 
;gpz2: 30% 

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


;cnst17: Factor to compensate for coupling evolution during a pulse
;       (usually +1). A positive factor indicates that coupling
;       evolution continues during the pulse, whereas a negative
;       factor is necessary if the coupling is (partially) refocussed.


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



