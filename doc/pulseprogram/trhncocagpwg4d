;trhncocagpwg4d
;avance-version (21/09/15)
;TROSY-HNCOCA
;4D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O) -> F2(Ca,t1) 
;            -> F2(C=O,t2) -> F3(N,t3) -> F1(H,t4)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive using Echo/Antiecho (t3)
;using semi-constant time in t2
;using semi-constant time in t3
;water suppression using watergate sequence
;(use parameterset )
;
;(S. Grzesiek & A. Bax, J. Magn. Reson. 96, 432 - 440 (1992))
;(L.E. Kay, G.Y. Xu & T. Yamazaki, J. Magn. Reson. A109, 129-133 (1994))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA4 = { 1.0000 0.8750 }
define list<gradient> EA6 = { 0.6667 1.0000 }
define list<gradient> EA8 = { 1.0000 0.6595 }


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d22=4.5m"
"d23=12m"
"d25=2.4m"
"d26=2.4m"


"d31=3u"
"d32=3u"
"d33=3u"
"d52=3u"
"d53=3u"
"d42=d22+d52"
"d43=d23-d26-d25+p21*4/PI-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"FACTOR2=d42*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in32 ) { in42 = in32; } else { in42 = INCR2; }"
"if ( INCR2 > in32 ) { in52 = 0; } else { in52=in32-INCR2; }"

"FACTOR3=d43*10000000*2/td3"
"INCR3=FACTOR3/10000000"

"if ( INCR3 > in33 ) { in43 = in33; } else { in43 = INCR3; }"
"if ( INCR3 > in33 ) { in53 = 0; } else { in53=in33-INCR3; }"


"DELTA=d31*2+larger(p14,p44)-p14"
"DELTA1=d26-p11-4u"
"DELTA2=d23-d26-p44"
"DELTA3=d22-d32-larger(p22,p44)+4u"
"DELTA4=d23-d33-p14*2-d53-d25-p16-d16-de"
"DELTA5=d26-p44-p16-d16-p11-4u"
"DELTA6=d25-p1-p16-d16-larger(p14,p22)/2"
"DELTA7=d26-p11-p16-d16-4u"


"TAU1=de"
"TAU2=p1*2/PI"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst22)/1000000)"
"spoffs8=0"


"o1_F1=bf2*cnst22/1000000"
"o1_F2=bf2*cnst21/1000000"


"acqt0=0"
baseopt_echo


1 d11 ze
2 d11
3 d1 pl1:f1 fq=cnst21(bf ppm):f2

  (p1 ph1)
  2u
  (p11:sp1 ph3):f1
  2u
  DELTA1 pl1:f1 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1 UNBLKGRAD
  (p11:sp1 ph4):f1
  2u
  2u pl1:f1
  (p1 ph4):f1 

  4u
  p16:gp1
  d16

  (p21 ph1):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA2
  (p44:sp30 ph1):f1
  d26
  (p21 ph1):f3
  (p44:sp30 ph1):f1

  (p13:sp2 ph5):f2
  4u
  (p14:sp5 ph1):f2
  d22
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  d22
  (p13:sp8 ph2):f2

  4u
  30u fq=cnst22(bf ppm):f2

  (p13:sp2 ph6):f2
  d31
  (center (p44:sp30 ph1):f1 (p14:sp7 ph1):f2 (p22 ph1):f3 )
  d31
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u
  p16:gp2
  d16 fq=cnst21(bf ppm):f2

  (p13:sp2 ph7):f2
  d32
  (center (p44:sp30 ph1):f1 (p22 ph1):f3 )
  DELTA3
  (p14:sp5 ph1):f2
  d52
  (p14:sp3 ph1):f2
  d42
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2

  4u
  p16:gp3
  d16

  (p44:sp30 ph1):f1
  (p21 ph8):f3
  d33
  (p14:sp5 ph1):f2
  DELTA4
  (p14:sp3 ph1):f2
  d53
  (p22 ph1):f3
  d43

  (p44:sp30 ph1):f1
  DELTA5
  p16:gp4*EA4
  d16
  (p11:sp1 ph3:r):f1
  2u
  2u pl1:f1

  (p1 ph9)
  p16:gp5
  d16
  DELTA6
  (center (p2 ph2) (p14:sp3 ph1):f2 (p22 ph2):f3 )
  DELTA6
  p16:gp5
  d16
  (p1 ph1) 

  p16:gp6*EA6*-1
  d16
  TAU1

  (p21 ph1):f3
  p16:gp7
  d16
  DELTA7
  (p11:sp1 ph4:r):f1
  2u
  2u pl1:f1
  (center (p2 ph2) (p22 ph2):f3 )
  4u
  (p11:sp1 ph4:r):f1
  DELTA7
  p16:gp7
  d16 pl1:f1
  (p21 ph10:r):f3

  p16:gp8*EA8*-1
  d16
  TAU2 BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph6, +90), caldel(d31, +in31))
     F2PH(calph(ph7, +90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
     F3EA(calgrad(EA4) & calgrad(EA6) & calgrad(EA8) & calph(ph9, +180) & calph(ph10, +180), caldel(d33, +in33) & caldel(d43, -in43) & caldel(d53, +in53) & calph(ph8, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph6=0 2
ph7=0 0 0 0 2 2 2 2
ph8=1 1 3 3
ph9=3
ph10=1
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: 1/(4J(COCa)                                      [4.5 msec]
;d23: 1/(4J(NCO)                                       [12 msec]
;d25: 1/(4J'(NH)                                       [2.4 msec]
;d26: 1/(4J'(NH)                                       [2.4 msec]
;d31: incremented delay (F1 in 4D)                     [3 usec]
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D)                     [3 usec]
;d42: decremented delay (F2 in 4D) = d22+d52
;d43: decremented delay (F3 in 4D) = d23-d26-d25+p21*4/PI-4u
;d52: incremented delay (F2 in 4D)                     [3 usec]
;d53: incremented delay (F3 in 4D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(CO) = 2 * DW(CO)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(Ca)) = DW(Ca)
;in32: 1/(2 * SW(CO)) = DW(CO)
;in33: 1/(2 * SW(N)) = DW(N)
;in42: = k2 * in32
;in43: = k3 * in33
;in52: = (1 - k2) * in32
;in53: = (1 - k3) * in33
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: echo-antiecho in F3


;for z-only gradients:
;gpz1: -70%
;gpz2: 80%
;gpz3: 80%
;gpz4: 80%
;gpz5: 5%
;gpz6: 30%
;gpz7: 50%
;gpz8: 30.13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



