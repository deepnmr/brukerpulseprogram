;zTEDOR2D  


;version   TS3.5.6

;transverse echo double resonance experiment
;Tested 12/06 in jos1206 on AV III console
;updated and ..  JOS07/14/2011
;updated and debugged JOS 11/15/2016  with suggestions adn correctiosn by D Mukhopadhyay, Jaroniec Group 
;lastet corrections Jan 2017  on Topspin4.0  GALT /JOS 
;
;C.P. Jaroniec, C. Filip, and R.G. Griffin  

;Avance III version
;parameters:
;d1 : recycle delay
;d31 : taur
;p1 : X90 at PLW11
;p2 : X180 at PLW11
;p3 : H90 at PLW2
;p5 : Y90 at PLW3 
;p12 : Y180 at PLW3
;p15 : HX CP contact time at PLW1(f1) and SPW0(f2)
;p63 : SPINAL pulse length during mixing
;pl1 : X power level during HX CP
;pl2 : H90 power level
;pl3 : Y90 power level
;pl11 : X90 power level
;pl12 : H decoupling power during acquisition
;pl13 : H decoupling power during REDOR mixing
;pl14 : H z-filter power level [set f_nutation= f_rotation]
;sp0 : H power level during HX CP
;cnst31 : MAS speed (Hz)
;spnam0 : H power shape file name for HX CP
;cpdprg2 : H Decoupling scheme during acquisition (at PLW12)
;cpdprg3 : H Decoupling scheme during REDOR (at PLW13)
;pcpd2 : H decoupling sequence pulse length	
;l1 : loop counter to determine Tmix L1*4*2*rotor cycle
;l8 : loop counter to determine Delta (tauz) L8*rotor cycle want ~200 microseconds
;l9 : determines t1 increment in integer rotor periods  or fractions thereof with flag largeSW
;FnMODE: use States-TPPI, States or TPPI
;ZGOPTNS : -DlargeSW for SW > spinning speed, -DXY16 for xy16 REDOR phase cycle (default: xy4)
;ns : =n*16,  =n*64 with TD-phase cycle
;deltaz : z-filter duration (l8*taur)
;tau : Compensation time to keep rotor sync.
;mix : TEDOR block total duration


;$CLASS=Solids
;$DIM=2D
;$TYPE=cross polarisation
;$SUBTYPE=TEDOR
;$COMMENT=heteronuclear correlation  

prosol relations=<solids_cp>


"d25=0.25s/cnst31-1u"
"d26=0.25s/cnst31-(p12/2)"	; one-quarter rotor cycle ...
"d27=0.25s/cnst31-(p1)"
"d29=0.75s/cnst31-(p2/2)"
"d31=1s/cnst31"
define pulse tauz
"tauz=l8*1s/cnst31"

#include <trigg.incl>

"d0=1s/(l9*cnst31)"
"acqt0=1u*cnst11"
define delay t1incr

"l0=0"


# ifdef largeSW
define delay tau
"tau=(1s*(2*l9-1)/(l9*cnst31))-(2*p5)-p1"
"l10=1"
"l11=l10 %l9"
"t1incr=1s/(l9*cnst31)"
"in0=t1incr"
"inf1=in0"
#else
define delay tau
"tau=(1s*1/cnst31)-(2*p5)-p1"

"t1incr=(1s*l9)/(cnst31)"
"in0=t1incr"
"inf1=in0"
#endif
define delay mix
"mix=4*2*l1/cnst31"

1 ze
  t1incr
  tau
mix
2 30m do:f2
  d1 do:f2
#ifdef largeSW
  "l11=l10 %l9" 
	"tau=(1s*(2*l9-l11)/(l9*cnst31))-(2*p5)-p1"
#endif
  10u pl1:f1                  	;set power level to drive HP amplifier
  10u pl12:f2                  	;set decoupler power
  10u pl3:f3
#include <p15_prot.incl>	
				;make sure p15 does not exceed 10 msec	
				;let supervisor change this pulseprogram if 
				;more is needed
#ifndef lacq	/* disable protection file for long acquisition change decoupling power !!! or you risk probe damage */

				/* if you set the label lacq (ZGOPTNS -Dlacq), the protection is disabled */

#include <aq_prot.incl>	
				;allows max. 50 msec acquisition time, supervisor
				;may change  to max. 1s at less than 5 % duty cycle
				;and reduced decoupling field
#endif
  1m rpp17	       	              		; reset phase list ph8 ...
  1m rpp18
  1m rpp20
  1m rpp21
  trigg                       			;additional trigger available on HP router
  p3:f2 ph1                   			;90 degree proton pulse
  0.3u
  (p15 ph2):f1 (p15:sp0 ph0):f2   		;cross-polarization
   1u cpds2:f2
   d25  pl11:f1 				; tppm decoupling at pl12 if synchronized with TPPM use special decoupling sequence
5  d26 						; First 1/2 REDOR period several F3 pulses ...
  (p12 ph17^):f3         			; ... at intervals of ...
   d26	  					; ... one-half rotor cycle
   d26
  (p12 ph17^):f3	       			; ... at intervals of ...
   d26	                			; F1 pulse
   d26 						; several F3 pulses ...
  (p12 ph17^):f3        			; ... at intervals of ...
   d26	    		      			; ... at intervals of ...
   d26						; ... one-half rotor cycle
  (p12 ph17^):f3	       			; ... at intervals of ...
   d26	    			       		; F1 pulse
lo to 5 times l1 
  d29
  (p2 ph3):f1         				; Hahn echo refocussing pulse on F1
  d29         						
6 d26 						; second 1/2 REDOR period several F3 pulses ...
  (p12 ph18^):f3        			; ... at intervals of ...
   d26	              				; ... at intervals of ...
   d26						; ... one-half rotor cycle
  (p12 ph18^):f3	       			; ... at intervals of ...
   d26	        	       			; 
   d26 						; several F3 pulses ...
  (p12 ph18^):f3        			; ... at intervals of ...
   d26	        	    			; ... at intervals of ...
   d26						; ... one-half rotor cycle
  (p12 ph18^):f3	       			; ... at intervals of ...
   d26	        	      			; F1 pulse
lo to 6 times l1 				; 
   d27						; End of REDOR period
  (p1 ph4):f1 (1u do):f2 			; pi/2 pulse on f1			 
  (tauz pl14 ph19):f2				;Z-filter integer rotor period
  (p5 ph5):f3             			; pi/2 on f2 begin rotor period at beginning of pulse t1 evolution starts here
if "l0==1"{
  "d0=in0"
  }  
if "l0>0"{
 d0 cpds3:f2
  }
  (p5 ph6):f3  (1u do):f2			;pi/2 on f3 End of t1 evolution 
  tau cpds2:f2                   		;for rotor synchronization 
  (p1 pl11 ph7):f1 				; rotor period done at end of p1!
   1u 
   d25  pl11:f1 				; tppm decoupling at pl12
7  d26 						; several F3 pulses ...
  (p12 ph20^):f3        			; ... at intervals of ...
   d26	          				; ... one-half rotor cycle
   d26
  (p12 ph20^):f3	       			; ... at intervals of ...
   d26	 
   d26 						; several F3 pulses ...
  (p12 ph20^):f3        			; ... at intervals of ...
   d26            				; ... one-half rotor cycle
   d26
  (p12 ph20^):f3	       			; ... at intervals of ...
   d26	 
lo to 7 times l1 
  d29
  (p2 ph8):f1           			; Hahn echo refocussing pulse
  d29  
8 d26 						; several F3 pulses ...
  (p12 ph21^):f3        			; ... at intervals of ...
   d26	              				; ... one-half rotor cycle
   d26
  (p12 ph21^):f3	       			; ... at intervals of ...
   d26	 
   d26 						; several F3 pulses ...
  (p12 ph21^):f3        			; ... at intervals of ...
   d26	          				; ... one-half rotor cycle
   d26
  (p12 ph21^):f3	       			; ... at intervals of ...
   d26	 
lo to 8 times l1
  d27			      			; Hahn echo occurs about now
  (p1 ph9):f1 (1u do):f2
  (tauz pl14 ph19):f2
  (p1 ph10):f1 (1u cpds3):f2

  go=2 ph31 
  1m do:f2
  30m mc #0 to 2 F1PH(ip6,id0 & iu10 & iu0)

HaltAcqu, 1m
exit


ph0= 0								; phHCP
ph1= {1}*32 {3}*32						; phH90
ph2= 0 								; phXhx
ph3= 0 0 1 1							; phX180p1
ph4= 0 								; phX90p1
ph5= 0		 						; phY90p1
ph6= 0 2 0 2							; phY90p2
ph7= 0 								; phX90p2
ph8= {0}*4 {1}*4						; phX180p2
ph9= {1}*8 {3}*8						; phX90p3
ph10= {0}*16 {2}*16						; phX90p4
ph19= 0								; phHtauz
#ifdef XY16
ph17= 0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2	; phNredor		xy16
ph18= 0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2	; phNredor		xy16
ph20= 0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2	; phNredor		xy16
ph21= 0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2	; phNredor		xy16
#else
ph17= 0 1 0 1 							; phNredor	xy4  
ph18= 0 1 0 1 							; phNredor	xy4		
ph20= 0 1 0 1 							; phNredor	xy4		
ph21= 0 1 0 1 							; phNredor	xy4	
#endif

ph31= {{{{{1 3 3 1}^2}^2}^2}^2} 
      ;3 1 1 3 3 1 1 3 1 3 3 1
      ;3 1 1 3 1 3 3 1 1 3 3 1 3 1 1 3	
      ;3 1 1 3 1 3 3 1 1 3 3 1 3 1 1 3
      ;1 3 3 1 3 1 1 3 3 1 1 3 1 3 3 1	; PhRe



