;selcopg
;avance-version (21/09/15)
;1D COSY using selective excitation with a shaped pulse
;with power-gated decoupling
;
;C.J. Bauer, R. Freeman, T. Frenkiel, J. Keeler & A.J. Shaka,
;   J. Magn. Reson. 58, 442 (1984)
;H. Kessler, H. Oschkinat, C. Griesinger & W. Bermel,
;   J. Magn. Reson. 70, 106 (1986)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


"d11=30m"


"DELTA=d1-100m"


#   ifdef CALC_SPOFFS
"spoffs1=bf1*(cnst21/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/


1 ze
  d11 pl12:f2
2 30m do:f2
  10u pl13:f2
  d11 cpd2:f2
  DELTA
  4u do:f2
  10u pl0:f1 pl12:f2
  100m cpd2:f2
  p11:sp1:f1 ph1:r
  4u
  d14 pl1:f1
  p1 ph2
  go=2 ph31
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1=1 3 3 1 2 0 0 2
ph2=0 2 0 2 1 3 1 3
ph31=0 2 2 0 1 3 3 1


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl13: f2 channel - power level for second CPD/BB decoupling
;sp1: f1 channel - shaped pulse
;p1 : f1 channel -  90 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;d14: delay for evolution after shaped pulse: 
;               for 90 deg pulse               (p11)/2 + d14 ~ 1/(2J)
;cnst21: chemical shift for selective pulse (offset, in ppm)
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;phcor 1 : phasedifference between power levels sp1 and pl1 

;choose p11 according to desired selectivity
;the flip-angle is determined by the amplitude
;set O1 on resonance on the multiplet to be excited or use spoffs



