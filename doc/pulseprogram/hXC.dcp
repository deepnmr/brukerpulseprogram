;hXY.dcp

;version: 1.0/ TS4.1.4 06/16/2021
; JOS

;###############################################################
;#                                                             #
;#  H-Y CP followed by Y - X CP Cross Polarization Experiment  #
;#  with H and Y decoupling	and X decoupling during t1 		     #								
;#                                                             #
;#  The Hartman-Hahn CP condidition is B1(F)=B1(H)+1           #
;#  sp0: 1H  linear or tangenial amplitude modulated pulse 	   #
;#  sp5: X (13C) usually constant amplitude pulse	Y-X CP		   #
;#  sp3: Y (N or F) usually constant amplitude pulse	H->Y CP  #
;#  sp4: Y  linear or tangenial amplitude modulated pulse	     #
;#  p15, p16: usually between 500-10000 us (sample-dependent)  #
;#                                                             #
;###############################################################

;$CLASS=SolidsIcon
;$DIM=2D 
;$TYPE=CPMAS
;$SUBTYPE= double CP HFX
;$COMMENT=

prosol relations=<solids_ICON>
define loopcounter numrot
define loopcounter numrotCO
define loopcounter numrotCa

#ifdef NCO
"numrotCO=cnst58/cnst31"
#else 
"numrotCa=cnst57/cnst31"
#endif

define loopcounter fieldYX_Hz
define loopcounter fieldXY_Hz
define loopcounter fieldY_Hz
define loopcounter fieldH_Hz


#include <trigg.incl>
        ; definition of external trigger output$

#ifdef fastMASDQ
"cnst54=abs(trunc(cnst53)+1-cnst53)"
"cnst60=abs(1-cnst63)"
"fieldXY_Hz=(cnst63)*cnst31"
"fieldYX_Hz=(cnst60)*cnst31"
"fieldY_Hz=cnst54*cnst31"
"fieldH_Hz=(cnst53)*cnst31"
"spw0=plw30*pow(10,(2*log10((cnst53)*cnst31/(10000*integfac0))))*(1+(cnst33/100))"
"spw3=plw37*pow(10,(2*log10(cnst54*cnst31/(10000*integfac3))))"
"spw4=plw37*pow(10,(2*log10(cnst60*cnst31/(10000*integfac4))))*(1+(cnst34/100))"
"spw5=plw31*pow(10,(2*log10((cnst63)*cnst31/(10000*integfac5))))*(1+(cnst35/100))"

#elif fastMASZQ
"cnst54=1+cnst53"
"fieldXY_Hz=(cnst60)*cnst31"
"fieldYX_Hz=(cnst63)*cnst31"
"fieldY_Hz=cnst53*cnst31"
"fieldH_Hz=(cnst54)*cnst31"
"spw0=plw30*pow(10,(2*log10((cnst54)*cnst31/(10000*integfac0))))*(1+(cnst33/100))"			;1H pulse
"spw3=plw37*pow(10,(2*log10(cnst53*cnst31/(10000*integfac3))))"								;Y pulse

#else

"fieldY_Hz=cnst55+cnst37"
"fieldH_Hz=(cnst55+cnst31+cnst33)"
"spw0=plw30*pow(((fieldH_Hz)/(10000*integfac0)),2)"   	;1H pulse
"spw3=plw37*pow(((fieldY_Hz)/(10000*integfac3)),2)"						;Y, N pulse

#endif

#ifdef NCO					/* For slow spinning <20 kHz MAS */
"cnst60=(1+cnst63)"


"fieldYX_Hz=(cnst63)*cnst31"
"fieldXY_Hz=(cnst60)*cnst31"
"spw4=plw37*pow(((fieldYX_Hz+cnst34)/(10000*integfac4)),2)"
"spw5=plw31*pow((((fieldXY_Hz)+cnst35)/(10000*integfac5)),2)"
"cnst20=cnst21"
#elif NCaDQ
"cnst63=abs(trunc(cnst60)+1-cnst60)"
"spw4=plw37*pow((((cnst60*cnst31)+cnst34)/(10000*integfac4)),2)"
"spw5=plw31*pow((((cnst63*cnst31)+cnst35)/(10000*integfac5)),2)"						;X pulse
"fieldXY_Hz=(cnst63)*cnst31"
"fieldYX_Hz=(cnst60)*cnst31"
"cnst20=cnst22"
#elif NCODQ
"cnst63=abs(trunc(cnst60)+1-cnst60)"
"spw4=plw37*pow((((cnst60*cnst31)+cnst34)/(10000*integfac4)),2)"
"spw5=plw31*pow((((cnst63*cnst31)+cnst35)/(10000*integfac5)),2)"
"fieldXY_Hz=(cnst60)*cnst31"
"fieldYX_Hz=(cnst63)*cnst31"
"cnst20=cnst21"
#elif neq2
"cnst60=(2+cnst63)"

"fieldYX_Hz=(cnst63)*cnst31"
"fieldXY_Hz=(cnst60)*cnst31"

"spw4=plw37*pow(((fieldYX_Hz+cnst34)/(10000*integfac4)),2)"
"spw5=plw31*pow((((fieldXY_Hz)+cnst35)/(10000*integfac5)),2)"

"cnst20=cnst22"
#elif invNCa
"cnst60=(1+cnst63)"

"fieldYX_Hz=(cnst60)*cnst31"
"fieldXY_Hz=(cnst63)*cnst31"
"spw4=plw37*pow((((fieldYX_Hz)+cnst34)/(10000*integfac4)),2)"
"spw5=plw31*pow((((fieldXY_Hz)+cnst35)/(10000*integfac5)),2)"

"cnst20=cnst22"
#else
"cnst60=(1+cnst63)"

"fieldYX_Hz=(cnst63)*cnst31"
"fieldXY_Hz=(cnst60)*cnst31"

"spw4=plw37*pow((((fieldYX_Hz)+cnst34)/(10000*integfac4)),2)"
"spw5=plw31*pow((((fieldXY_Hz)+cnst35)/(10000*integfac5)),2)"

"cnst20=cnst22"
#endif 

#ifdef lpdec
"cnst62=0.25*cnst31"

#elif diydec 
						; set your own decoupling field
#else
"cnst62=cnst51"
#endif

"plw12=plw30*pow(10,(2*log10(cnst62/(10000))))*(1+(cnst32/100))"						;1H decoupling
"plw44=plw30*pow(10,(2*log10(cnst52/(10000))))*(1+(cnst32/100))"						;1H decoupling
;"plw16=plw37*pow(10,(2*log10(cnst59/(10000))))*(1+(cnst37/100))"						;15N (F3) Decoupling
;"plw18=plw31*pow(10,(2*log10(cnst56/(10000))))*(1+(cnst38/100))"			      ;13C (F1) decoupling)

#ifndef diydec
"p31=1000000/(2*cnst62)"
"pcpd2=p31"
;"p33=1000000/(4*cnst59)"
;"p32=1000000/(4*cnst56)"
;"pcpd1=p32"
;"pcpd3=p33"
#endif

# ifdef pidec
"p22=p33"
"d60=1s/cnst31-p22"
# endif /* pidec */
/* CORD */

define delay cordmix
define loopcounter cord
define pulse mixing

"cnst10=o1"
"d0=0"
"l0=0"

"in0=inf1"
"in30=inf1"
define delay ONTIME         ;##########################
define loopcounter T1evo    ;#   Constant Duty Cycle  #
                            ;##########################
#ifdef CDC
"T1evo=0.5*larger(td1,cnst30)"
"d30=(T1evo*in30)+0.5u"
#endif   
"acqt0=0"
 
Prepare, ze
/*1 0.05u
 lo to 1 times fieldY_Hz
2 0.05u
lo to 2 times fieldH_Hz
10 0.05u
 lo to 10 times fieldXY_Hz
20 0.05u
lo to 20 times fieldYX_Hz
*/
"d30=d30/2"

"ONTIME=aq+d0+d30+p25+p16"

#ifndef lacq
#include <acq_prot.incl>
        ;Max. 50 ms acquisition time
#include <ONTIME_prot.incl>
			;total RF deposition restriction
#endif
#ifndef longp15
#include <p15_prot.incl>
        ;p15 max. 10 ms
#endif
  (p31 ph10 pl12):f2
;  (p32 ph10 pl18):f1
;  (p33 ph10 pl16):f3
Start, 30m do:f2 
  
  d1
  ;1u pl1:f1 pl21:f3
if "l0>0"
{
  "d51=d0-1u"
}
  trigg
 

  (p3 pl2 ph1):f2
  (p15:sp3 ph2):f3  (p15:sp0 ph0):f2
if "l0>0"
{
  0.5u cpds2:f2  
  
	d51  
	

  0.5u do:f2  
}
  0.5u fq=cnst20(bf ppm):f1
  (p16:sp4 ph3):f3 (p16:sp5 ph4):f1 (p16 pl44 ph0):f2
   0.5u fq=cnst10(bf hz):f1

gosc ph31 cpds2:f2  finally do:f2  
#ifdef CDC
  d30                   
#endif					/*end of CDC*/
1m do:f2
lo to Start times ns

  30m mc #0 to Start 
  F1PH(calph(ph2, +90), caldel(d0, +in0) & calclc(l0,1) & caldel(d30, -in30))

HaltAcqu, 1m
Exit, exit

ph0 = 0                ; H CP spin lock
ph1 = 1 3              ; H hard pulse
ph2 = 0   
ph3 = 0 0 2 2
ph4 = 0 0 1 1 2 2 3 3
ph10 = 0 

ph31= 3 1 2 0 1 3 0 2  ; receiver

;#######################################################


;basic HFX dcp experiment

;Avance NEO / AVIII (?) version
;parameters:
;p1      : X 90 at pl1(acqt0-calculation & -DX90)
;p3      : H 90 at pl2
;p15     : HF CP at sp3 (f3,F) and sp0 (f2,H)
;p16  	 : FC CP at sp4 (f3,F) and sp1 (f1,X)
;pl1     : X 90 at pl1
;pl2     : H pulse power
;pl3     : F3 90 degree pulse
;pl12    : H dec power
;pl16	 : X GARP4 decoupling during t1 evol
;pl18  : Y Waltz16 during t2 evolution
;pl21  : F3 90 degree pulse
;pl30	 : H  10 kHz spinlock field
;pl31	 : X for 10kHz spinlock field
;pl37	 : N decoupling 10 kHz reference power for decoupling
;pl33	 : H decoupling 10 kHZ reference power for decoupling
;sp0     : H CP power H-F CP
;sp3     : F3 N CP power
;sp4	 : F3 N CP power NC CP
;sp5	 : F1 C CP power NC CP
;cnst31  : MAS rate in Hz
;cnst32  : 1H decoupling power correction factor in %
;cnst33  : 1H spinlock power correction factor in %
;cnst34  : 19F-X CP 19F spinlock power correction factor in %
;cnst37  : 19F decoupling power correction factor in %
;cnst50	 : desired spinlock field in Hz for CP X (n-0.5)*MASR  
;cnst51  : 1H decoupling field in Hz for pl12 decoupling 
;cnst52  : 1H heteronuclear decoupling in Hz pl12 decoupling
;cnst53  : fast MAS CP condition not equals n*cnst53*MASR condition for C and n*(cnst53+1) for H (ZQ) or n*(1-cnst53) for DQ
;cnst54	 : calculated  cnst54=cnst53+1 or cnst54=1-cnst53
;cnst55  : f3 (19F specified CP spinlock field) for H->F CP
;cnst56  : f1 decoupling during t1 evol 5kHz
;cnst57  : f1 max spinlock field Ca for NCa step
;cnst58  : f1 max spinlock field CO for NCO step
;cnst61	 : f3 decoupling field in Hz for pl12 decoupling  
;d1      : recycle delay; 1 to 5 times T1
;pcpd1	 : GARP decoupling 90 50us
;pcpd2   : pulse length in decoupling sequence cpdprg2
;pcpd3	 : p33 pi pulse 19F 
;cpdprg1 : X low power decoupling GARP or Waltz 50us 90 (5kHz)
;cpdprg2 : swftppm_12 or similar  (1H decoupling)
;cpdprg3 : pidec_13 (19F pi decoupling)
;spnam0 : H (f2) amplitude modulated pulse variable amplitude CP
;spnam3 : N (f3) amplitude modulated pulse square.100
;spnam4 : N (f3) amplitude modulated pulse square.100
;spnam5 : C (f1)  amplitude modulated pulse tacn80
;ZGOPTNS : -Dpidec (pi-decouping for 19F)-DCP for basic experiment
;		   -DfastMASDQ  or -DfastmasZQ for double or zero quantum CP at fast MAS >60 kHz
;          -Dlacq : aq is longer than 50 ms
;          -Ddiy - set your own power levels
;		   -Ddiydec - set your own decoupling power and pulses

;$Id: hFX.dcp,v 1.1                    Exp $
