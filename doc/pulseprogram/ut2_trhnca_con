;ut2_trhnca_con
;avance-version (21/09/15)
;
;A. Viegas, T. Viennet, T.Y. Yu, F. Schumann, W. Bermel, G. Wagner & M.Etzkorn,
;   J. Biomol. NMR 64, 9-15 (2016)
;
;Dataset 1 (F1)
;trhncagp3d2
;TROSY-HNCA
;3D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N) -> F2(Ca,t1) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho (t2)
;using constant time in t2
;with H-1 180degree pulses in t1
;
;(M. Salzmann, K. Pervushin, G. Wider, H. Senn & K. Wuethrich, Proc.
;   Natl. Acad. Sci. USA 95, 13585-13590 (1998))
;A. Eletsky, A. Kienhoefer & K. Pervushin,
;   J. Biomol. NMR 20, 188-180 (2001)
;
;Dataset 2 (F2)
;c_con_iasq
;CON
;2D sequence with
;   13C detected correlation for triple resonance using 
;      inept transfer steps
;
;      F1(C=O) -> F3(N,t1) -> F1(C=O,t2)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using IPAP scheme for virtual decoupling
;
;W. Bermel, I. Bertini,L. Duma, I.C. Felli, L. Emsley,  R. Pierattelli,
;   P.R. Vasos, Angew. Chem. Int. Ed. 44, 3089-3092 (2005)
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=



prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d22=4.5m"
"d23=12m"
"d26=2.3m"
"d27=12.5m"


"d31=3u"
"d32=3u"
"d33=3u"
"d42=d23-p11-8u-p1"

"in31=inf1/4"
"in32=inf2/2"

"in33=in2/4"

"in42=in32"

"td2=tdmax(td2,d42*2,in42)"


"DELTA=d31*4+larger(p14,p22)-p14+p2*2-4u"
"DELTA1=d26-p11-p16-d16-8u"
"DELTA2=d23-d32-p14-p21*4/3.1416"
"DELTA3=d26-p16-d16"

"DELTA11=d33*2+p8"
"DELTA12=d27/2-p14/2"
"DELTA13=d27-d22-p14"


"l0=1"
"l10=1"

"l3=td1/2"
"l13=td2/4"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst22)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"
"spoffs13=bf2*((cnst26-cnst21)/1000000)"


aqseq 321


1 4u ze1
  4u ze2

2 d11 do:f1 do:f3
  3m
3 3m
4 6m
5 15m
6 9m
7 3m

  d1
  50u UNBLKGRAD

  p16:gp6
  d16

; exp 1

  20u pl1:f1 pl3:f3
  20u fq=cnst22(bf ppm):f2

  (p1 ph1)
  4u
  (p11:sp1 ph3:r):f1
  4u
  p16:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA1
  p16:gp1
  d16
  (p11:sp1 ph4:r):f1
  4u
  4u pl1:f1
  (p1 ph4):f1 

  (p21 ph1):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph2):f3

  (p13:sp2 ph5):f2
  d31
  (p2 ph1):f1
  d31
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d31
  (p2 ph1):f1
  d31
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  if "l0 %2 == 1"
     {
     (p21 ph6):f3
     }
  else
     {
     (p21 ph7):f3
     }

  d32
  (p14:sp5 ph1):f2
  DELTA2
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d42
  (p11:sp1 ph1:r):f1
  4u
  4u pl1:f1

  (p1 ph8)
  p16:gp2
  d16
  DELTA3
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp2
  d16
  (center (p1 ph1) (p21 ph8):f3 )
  p16:gp3
  d16
  DELTA1
  (p11:sp1 ph3:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph3:r):f1
  DELTA1
  p16:gp3
  d16 pl1:f1
  4u BLKGRAD
  (p21 ph1):f3

  goscnp1 ph31

; exp 2

  50u UNBLKGRAD

  p16:gp4
  d16

  20u fq=cnst21(bf ppm):f2
  20u pl19:f1
  20u cpds1:f1

  (p13:sp2 ph1):f2
  d27
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d27
  (p13:sp8 ph2):f2

  p16:gp5
  d16 

  (p21 ph13):f3
  d33
  (p8:sp13 ph15):f2
  d33
  (p22 ph1):f3
  DELTA11
  (p21 ph14):f3

  if "l10 %2 == 1"
     {   
     (p13:sp2 ph1):f2
     DELTA12
     (p14:sp7 ph1):f2
     DELTA12
     (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
     DELTA12
     (p14:sp7 ph1):f2
     DELTA12 pl16:f3
     }   
  else
     {   
     (p13:sp2 ph16):f2
     d22 
     (p14:sp7 ph1):f2
     DELTA13
     (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
     DELTA12
     DELTA12 pl16:f3
     (p14:sp7 ph1):f2
     }

  4u BLKGRAD
  go2=2 ph30 cpd3:f3

  d11 do:f1 do:f3 wr1 #0 if1 #0 zd1

;exp_f1 phase F2
  3m ip8*2
  3m iu0
  lo to 3 times 2

;exp_f1 delay F2
  3m id32
  3m dd42
  lo to 4 times l13

  3m wr2 #1 if2 #1 zd2

;exp_f2 ipap
  3m iu10
  lo to 5 times 2

  3m rd32
  3m rd42

;exp_f1 phase F1
  3m ip5
;exp_f2 phase
  3m ip13
  lo to 6 times 2

;exp_f1 delay F1
  3m id31
;exp_f2 delay
  3m id33
  lo to 7 times l3

exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 2 2 2 2
ph6=2 0 1 3
ph7=2 0 3 1
ph8=3
ph13=0 2
ph14=0 0 0 0 2 2 2 2
ph15=0 0 2 2
ph16=3
ph30=0 2 0 2 2 0 2 0
ph31=1 3 2 0 3 1 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f1 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(2J(CaCO)                                      [4.5 msec]
;d23: 1/(4J(NCa)                                       [12 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d27: 1/(4J(NCO)                                       [12.5 msec]
;d31: incremented delay (F1 in 3D, exp 1)              [3 usec]
;d32: incremented delay (F2 in 3D, exp 1)              [3 usec]
;d33: incremented delay (F1 in 2D, exp 2)              [3 usec]
;d42: decremented delay (F2 in 3D, exp 1) = d23-p11-8u-p1
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;l3 : loop for 3D experiment = td1/2
;l13: loop for 3D experiment = td2/4
;o2p: CO chemical shift (cnst21)
;inf1: 1/SW(Ca) = 2 * DW(Ca), exp 1
;inf2: 1/SW(N) = 2 * DW(N), exp 1
;in2 : 1/SW(N) = 2 * DW(N), exp2
;in31: 1/(4 * SW(Ca)) =  (1/2) DW(Ca), exp 1
;nd31: 4
;in32: 1/(2 * SW(N)) = DW(N), exp 1
;nd32: 2
;in33: 1/(2 * SW(N)) = DW(N), exp 2
;nd33: 2
;in42: = in32
;ns: 8 * n
;ds: >= 16
;td1: exp 1: number of experiments in F1
;td2: exp 1: number of experiments in F2       td2 max = 2 * d42 / in42
;td1: exp 2: number of experiments in F1 = td1 (exp 1) * 4
;FnMODE: undefined in F1
;FnMODE: undefined in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence



;for z-only gradients:
;gpz1: 30%
;gpz2: 18%
;gpz3: 44%
;gpz4: 80%
;gpz5: 50%
;gpz6: 70%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



