;hsqcetfpf3gpjcsi
;avance-version (21/09/15)
;ct-HSQC
;2D H-1/X correlation via double inept transfer
;   using sensitivity improvement
;for determination of 3J NCg (Chi1) using spin-echo difference
;on/off resonance Ca, Cb/Cg and C=O pulses using shaped pulse
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using f3 - channel
;using flip-back pulse
;constant time version
;recording data in interleaved mode
;
;J.-S. Hu & A. Bax, J. Biomol. NMR 9, 323-328 (1997)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d23=100m"
"d26=2.3m"


"d0=3u"
"d20=d23-d21-p26+d0-4u"

"in0=inf1/2"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"DELTA1=d23-p14-p24*1.5+p22/2-4u"
"DELTA2=d21-p16-d16-4u"
"DELTA3=p16+d16-p1*0.78+de+8u"


"l0=1"


"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs9=0"
"spoffs16=bf2*(cnst22/1000000)-o2"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl16:f3
2 d1 do:f3
3 (p1 ph1)
  d26 pl3:f3
  (center (p2 ph1) (p22 ph9):f3 )
  d26 UNBLKGRAD
  (p1 ph2) 

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16 pl1:f1

  (p21 ph3):f3

  if "l0 %2 == 1"
     {
     (d21 pl19 p26 ph2 20u cpds1 ph1):f1 (d0 p14:sp5 4u p24:sp16 4u p24:sp9):f2 (d0 d23 p22 ph6 d20):f3
     }
  else
     {
     (d21 pl19 p26 ph2 20u cpds1 ph1):f1 (d0 p14:sp5 4u p24:sp16 DELTA1 p24:sp9):f2 (d0 d23 p22 ph6 d20):f3
     }

  4u do:f1
  (p26 ph10):f1
  4u
  p16:gp2*EA
  d16
  DELTA2 pl1:f1

  (center (p1 ph1) (p21 ph7):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (center (p1 ph2) (p21 ph8):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (p1 ph1)
  DELTA3
  (p2 ph1)
  4u
  p16:gp3
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d1 do:f3 mc #0 to 2 
     F1I(iu0, 2)
     F1EA(calgrad(EA) & calph(ph8, +180), caldel(d0, +in0) & caldel(d20, -in20) & calph(ph3, +180) & calph(ph9, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph5=0 0 0 0 2 2 2 2
ph6=0 2 1 3
ph7=0
ph8=3
ph9=0
ph10=3
ph31=0 2 2 0
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1 : f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp5: f2 channel - shaped pulse 180 degree   (C=O off resonance)
;sp9: f2 channel - shaped pulse 180 degree   (Cg on resonance)
;sp16: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (selective)
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d23-d21-p26+d0-4u
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: constant time delay T(N)                         [100 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;l0: flag to switch between reference and spin-echo difference experiment
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;in20: = in0
;ns: 8 * n
;ds: >= 32
;td1: number of experiments       td1 max = 2 * d20 / in20
;FnMODE: echo-antiecho
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:	gp 1 : gp 2 : gp 3
;			  50 :   80 :  8.1

;for z-only gradients:
;gpz1: 50%
;gpz2: 80%
;gpz3: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


;use AU-program split [2] to split data

;F1 reverse: true



