;noesyhmqcf3gpph3d
;avance-version (12/01/11)
;NOESY-HMQC
;3D sequence with
;   homonuclear correlation via dipolar coupling 
;   dipolar coupling may be due to noe or chemical exchange.
;   H-1/X correlation via double inept transfer
;phase sensitive (t1)
;phase sensitive (t2)
;with decoupling during acquisition
;water suppression using 3-9-19 pulse sequence with gradients
;(use parameterset NOESYHMQCF3GPPH3D)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d21=1s/(cnst4*2)"


"in0=inf1/2"
"in10=inf2"

"d0=3u"
"d10=in10/2-p21*4/3.1415"


"DELTA1=d21-p16-d16"

#   ifdef LABEL_CN
"DELTA=larger(p8,p22)+d0*2"
#   else
"DELTA=p22+d0*2"
#   endif /*LABEL_CN*/

"TAU=d8-p16-d16-p29-4u"
"TAU1=de+4u"
"TAU2=p1*2/3.1416"


"acqt0=0"
baseopt_echo


aqseq 312


1 d11 ze
  d11 pl16:f3
2 d11 do:f3
3 d1 pl1:f1 pl3:f3
  50u UNBLKGRAD

  (p1 ph2)
  DELTA
  (p2 ph2)
  d0

#   ifdef LABEL_CN
  (center (p8:sp13 ph2):f2 (p22 ph1):f3 )
#   else
  (p22 ph1):f3
#   endif /*LABEL_CN*/

  d0
  (p1 ph1)

  TAU 
  p16:gp1
  d16
  (p29:sp11 ph6)
  2u
  2u pl1:f1

  (p1 ph1)
  TAU1
  p16:gp2
  d16

#   ifdef LABEL_CN
  (center (p11:sp1 ph7 2u 2u pl1 p2 ph5 4u p11:sp1 ph7):f1 (p8:sp13 ph2):f2 (DELTA1 p21 ph3 d10 p21 ph4 DELTA1):f3 )
#   else
  (center (p11:sp1 ph7 2u 2u pl1 p2 ph5 4u p11:sp1 ph7):f1 (DELTA1 p21 ph3 d10 p21 ph4 DELTA1):f3 )
#   endif /*LABEL_CN*/

  p16:gp2
  d16 pl16:f3
  TAU2
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph2, +90), caldel(d0, +in0)) 
     F2PH(calph(ph3, +90), caldel(d10, +in10))
exit


ph1=0
ph2=0 0 2 2
ph3=0 2
ph4=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph5=0 0 0 0 2 2 2 2
ph6=2
ph7=2 2 2 2 0 0 0 0
ph31=0 2 2 0 0 2 2 0 2 0 0 2 2 0 0 2 


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp11: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: f1 channel -  90 degree shaped pulse (flipback pulse)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d10: incremented delay (F2 in 3D) = in10/2-p21*4/3.1415
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J)NH
;cnst4: = J(NH)
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(H)) = DW(H)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 31%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;Processing

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1



