;$Id:$
;pulse program for suppressing C13 background signals
; based on Hahn-Echo
; using composite 180deg pulse: 90x180y90x
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"p2=p1*2"
"d11=30m"

1 ze
2 d11
  d1
  p1 ph1
3 d20
  p1 ph21
  p2 ph22
  p1 ph23
  d20
  go=2 ph31
  d11 mc #0 to 2 F0(zd)
exit

ph1=0 0 2 2 1 1 3 3 

ph21=1 3 1 3 0 2 0 2
ph22=0 2 0 2 1 3 1 3
ph23=1 3 1 3 0 2 0 2

ph31=0 0 2 2 1 1 3 3

;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d20: fixed echo time according to parameter file  [<50-100us]
;NS: 1
;DS: 0
