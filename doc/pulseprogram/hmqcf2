; hmqc
; hmqc experiment using SR4 to generate heteronuclear multiple
; quantum correlation spectra
;
; reviewed and included in TS by 
; sewe 20130228
;
;
;PARAMETERS:
;ns : 4 * n
;d1 : recycle delay
;pl1 : RF power level p1/p2
;pl2 : RF power level p3
;pl11 : power level for mixing sequence
;pl20 : power of Presat pulses (p20)
;p1 90 degree pulse @ pl1
;p2 180 degree pulse @ pl1
;p3 90 degree pulse @pl3
;p16 : dipolar recoupling time (actual value in p17)
;p17 : actual dipolar recoupling time
;p20 : Presat pulses
;ph20 : phase of Presat pulses (p20)
;d20 : delay between Presat pulses (p20)
;cnst0 :  =2, for calculating 180deg or different factor
;cnst31 : =MAS spin rate
;FnMODE: States or States-TPPI
;zgoptns : -D_R2 (Default is SR4) / -Dd0sync
;            _R2 : use of R2 recoupling
;d0sync: synchronize d0 with rotor period (S=1 14N for example)
;l20 : number of Presat pulses (p20)
;
;
;$CLASS=Solids
;$DIM=2D
;$TYPE=
;$SUBTYPE=inverse detection
;$COMMENT=HMQCsolids

prosol relations=<solids_default>


;**************** calculation of t1 delays ******************
#ifdef d0sync
;l1: inital number of Tr for d0
"d0=1s*l1/cnst31-p3"
#endif

"cnst0=2.0"
"p2=p1*cnst0"

define delay delp1
"delp1=p1"

define delay Dmin
define loopcounter lmin
define delay delA
define delay delC
define delay delB
"Dmin=(2*p3+d0+2u)+ (delp1 + 1u)*2"
"lmin=trunc(Dmin*cnst31/2.0)+1"
"delA=((1s*lmin)/cnst31)-1u - p2/2.0"
"delB=(((2s*lmin)/cnst31)-2u-d0-p3*2.0)/2.0"
"delC=((((2s*lmin)/cnst31)-2u-d0-p3*2.0)/2.0) - delp1-1u"


define loopcounter LCounter
define delay dummy

#ifdef _R2
"p6=(1s/cnst31)"
"LCounter=trunc((p16/p6)+0.5)"
"p17=LCounter*p6"
#else
"p6=(0.25s/cnst31)"
"LCounter=trunc((p16/p6)+0.5)"
"p17=LCounter*p6"
#endif

"in0=inf1"
"acqt0=0"

1 ze  
  1u 
2 100m

	"Dmin=(2*p3+d0+2u)+ (delp1 + 1u)*2"
	"lmin=trunc(Dmin*cnst31/2.0)+1"
	"delA=((1s*lmin)/cnst31)-1u - p2/2.0"
	"delB=(((2s*lmin)/cnst31)-2u-d0-p3*2.0)/2.0"
	"delC=((((2s*lmin)/cnst31)-2u-d0-p3*2.0)/2.0) - delp1-1u"
3 d20 
  (p20 pl20 ph20^):f1
  lo to 3 times l20
  d1 
  1u rpp3 rpp6
  10u pl2:f2
  (p1 pl1 ph1):f1
  1u pl11:f1
#ifdef _R2
Sl1, (p6 ph13 ipp13):f1
lo to Sl1 times LCounter
#else
Sl1, (p6 ph3 ipp3):f1
lo to Sl1 times LCounter
#endif
  0.5u 
  0.5u 
  (delB pl3 p3 ph11 d0 p3 ph12  delC ):f2 (delA pl1 p2 ph2):f1
  1u
  delp1
  1u pl11:f1
#ifdef _R2
Sl2, (p6 ph13 ipp13):f1
lo to Sl2 times LCounter
#else
Sl2, (p6 ph6 ipp6):f1
lo to Sl2 times LCounter
#endif
  1u
  go=2 ph31
  1u
  100m mc #0 to 2 F1PH(ip11,id0) 
exit

ph0=0
ph2=0 
ph3=(360) 90 270 90 270 270 90 270 90 210 30 210 30 30 210 30 210 330 150 330 150 150 330 150 330
ph6=(360) 90 270 90 270 270 90 270 90 210 30 210 30 30 210 30 210 330 150 330 150 150 330 150 330
ph4={0}*8 {2}*8
ph5=0 
ph11=0
ph13=0 2
ph1={0 0}^2^1^3
ph12=0 2
ph31=0 2 2 0 3 1 1 3
ph30=0
ph20=0



