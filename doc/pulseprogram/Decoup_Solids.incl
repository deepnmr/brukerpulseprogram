define loopcounter CORR
#ifdef lpdec
"cnst62=0.25*cnst31"
#elif lpdec8
"cnst62=0.125*cnst31"
#elif diydec 
						; set your own decoupling field
#else
"cnst62=cnst52"
#endif
"CORR=((cnst62+cnst32)/cnst62)*100"
"plw12=plw0*pow(((cnst62+cnst32)*4*p0/(1000000)),2)"


#ifndef diydec
"pcpd2=1s/(2*(cnst62))"
#endif
#ifdef XiX
"pcpd2=(l10*1s/cnst31)*(1+(cnst10/100))"
#endif

# ifdef pidec
