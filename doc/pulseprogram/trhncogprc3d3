;trhncogprc3d3
;avance-version (21/09/15)
;IPAP-J-TROSY-HNCO
;3D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N) -> F1(H,J(N)) -> F2(C=O,t1)
;            -> F3(N,t2) -> F1(H,t3)
;
;for determination of 1J(1D) NC'
;   splitting in F1:  1J NC' * (cnst16+1)      (IPAP)
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho (t2)
;using constant time in t2
;(use parameterset TRHNCOGPRC3D3)
;
;P. Permi, P.R. Rosevear & A. Annila, J. Biomol. NMR 17, 43-54 (2000)
;(M. Salzmann, K. Pervushin, G. Wider, H. Senn & K. Wuethrich, Proc.
;   Natl. Acad. Sci. USA 95, 13585-13590 (1998))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d21=5.4m"
"d23=12m"
"d26=2.3m"


"d0=3u"
"d10=3u"
"d20=3u"
"d30=d23-p11-8u-p1"

"in0=inf1/4"
"in10=inf2/2"

"in20=in0*2*cnst16"
"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA=d0*2+p2*2"
"DELTA1=d26-p11-p16-d16-8u"
"DELTA2=d23-d21-p26"
"DELTA3=d23-d21-p26-4u"
"DELTA4=d21/4-p16-d16"
"DELTA5=d21/2-p16-d16+p22/2+p2"
"DELTA6=d20+d0*4+p2*2+p14-p22+4u"
"DELTA7=d23-d10-p14-p21*4/3.1416"
"DELTA8=d26-p16-d16"


"l0=1"
"l10=1"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs8=0"


aqseq 321


1 d11 ze
2 d11
3 d1 pl1:f1
  50u UNBLKGRAD

  p1 ph1
  4u pl0:f1
  (p11:sp1 ph3:r):f1
  4u
  p16:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA1
  p16:gp1
  d16 pl0:f1
  (p11:sp1 ph4:r):f1
  4u
  4u pl1:f1
  (p1 ph4):f1 

  (p21 ph1):f3
  d21 pl19:f1
  (p26 ph2):f1
  DELTA2 cpds1:f1 ph1
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA3
  4u do:f1
  (p26 ph4):f1
  d21 pl0:f1
  (p21 ph2):f3

  if "l10 %2 == 1"
    {
    (p11:sp1 ph9):f1
    4u
    4u pl1:f1
    (p1 ph9)
    p16:gp5
    d16
    DELTA4
    (p22 ph1):f3
    d21*0.25
    (p2 ph1)
    d21*0.25
    (p22 ph1):f3
    DELTA4
    p16:gp5
    d16
    (p1 ph2)
    4u pl0:f1
    (p11:sp1 ph4):f1
    }
  else
    {
    (p11:sp1 ph10):f1
    4u
    4u pl1:f1
    (p1 ph10)
    p16:gp5
    d16
    DELTA5
    (center (p2 ph1) (p22 ph1):f3 )
    DELTA5
    p16:gp5
    d16
    (p1 ph2)
    4u pl0:f1
    (p11:sp1 ph4):f1
    }

  p16:gp2
  d16 pl1:f1

  (p13:sp2 ph5):f2
  d0
  (p2 ph1)
  d0
  (p14:sp5 ph1):f2
  d0
  (p2 ph1)
  d0
  d20
  4u
  (p14:sp3 ph1):f2
  (d20 DELTA p14:sp5 ph1 4u):f2 (DELTA6 p22 ph1):f3
  (p13:sp8 ph1):f2

  if "l0 %2 == 1"
     {
     (p21 ph6):f3
     }
  else
     {
     (p21 ph7):f3
     }

  d10
  (p14:sp5 ph1):f2
  DELTA7
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d30 pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  4u pl1:f1

  (p1 ph8)
  p16:gp3
  d16
  DELTA8
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA8
  p16:gp3
  d16
  (center (p1 ph1) (p21 ph8):f3 )
  p16:gp4
  d16
  DELTA1 pl0:f1
  (p11:sp1 ph3:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph3:r):f1
  DELTA1
  p16:gp4
  d16 pl1:f1
  4u BLKGRAD
  (p21 ph1):f3
  go=2 ph31
  d11 mc #0 to 2 
     F1I(iu10, 2)
     F1PH(calph(ph5, +90), caldel(d0, +in0) & caldel(d20, +in20))
     F2EA(calph(ph8, +180) & calclc(l0, 1), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 2 2 2 2
ph6=2 0 1 3
ph7=2 0 3 1
ph8=3
ph9=1 1 1 1 1 1 1 1 3 3 3 3 3 3 3 3
ph10=2 2 2 2 2 2 2 2 0 0 0 0 0 0 0 0
ph31=3 1 0 2 1 3 2 0 1 3 2 0 3 1 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: incremented delay (F1 in 3D)                     [3 usec]
;d21: 1/(2J(NH))                                       [5.4 msec]
;d23: 1/(4J(NCO))                                      [12 msec]
;d26: 1/(4J'(NH))                                      [2.3 msec]
;d30: decremented delay (F2 in 3D) = d23-p11-8u-p1
;cnst16: = J(scale) factor
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(CO)) = (1/2) DW(CO)
;nd0: 4
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = in0*2*cnst16
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: twice the number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5
;                         30 :   11 :   18 :   44 :    2

;for z-only gradients:
;gpz1: 30%
;gpz2: 11%
;gpz3: 18%
;gpz4: 44%
;gpz5: 2%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



;use AU-program split [ipap 2] (F1) to create separate datasets



