;darrmix_prot.incl
;Test the rf on-time and duty cycle
; rotect against misset cnst31, rotation speed below 1000 Hz and too long a mixing period
;
;
;$CLASS=BioSolids INCL
;$COMMENT=protect against mixing time  >500 msec 


1u
if "{{darrmix<501m}||{cnst59 == 0}}"  goto Passdarr;  for TS >=3.0
 /*protect against too long DARR mixing*/
1u 
print "error: DARR mixing time exceeds 500 msec, DARR power plw14 not zero"
goto HaltAcqu
Passdarr, 1m



