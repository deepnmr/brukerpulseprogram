;dr_zg30_igf3
;avance-version (17/02/02)
;1D sequence with inverse gated decoupling on f3
;using 30 degree flip angle
;for dual receive on f1 and f2
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <De.incl>


"d11=30m"


"acqt0=-p1*0.66/PI"


1 ze1
  ze2
  d11 pl16:f3
2 30m do:f3
  d1
  (ralign (p1*0.33 ph1):f1 (p3*0.33 ph1):f2 (2u cpd3):f3 )

  ACQ_START1(ph30,ph31) ACQ_START2(ph30,ph31)

  0.1u DWELL_GEN1 DWELL_GEN2

  (aq1) (aq2)

  eoscnp2
  rcyc=2 
  30m do:f3 wr1 #0
  30m wr2 #1
exit


ph1=0 2 2 0 1 3 3 1
ph30=0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;ns: 1 * n, total number of scans: NS * TD0
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence



