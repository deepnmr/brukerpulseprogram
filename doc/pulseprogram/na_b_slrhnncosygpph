;na_b_slrhnncosygpph
;avance-version (21/11/23)
;(best)-selective long range HNN-COSY
;for direct observation of hydrogen bonds in A-U
;   base pairs by internucleotide 2J(N,N) couplings
;
;      F1(H2) -> F3(N1) -> F3(N3,t1) -> F3(N1) -> F1(H2,t2)
;
;phase sensitive
;with decoupling during acquisition
;(use parameterset)
;
;A. Dallmann, B. Simon, M.M. Duszczyk, H. Kooshapur, A. Pardi, W. Bermel & M. Sattler,
;  Angew. Chem. Int. Ed. 52, 10487-10490 (2013)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d26=9.6m"


#   ifdef CALC_SP
"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1*pow((p1*totrot26)/(p42*90.0*integfac26),2)"
"spoal26=0.5"

"p41=(bwfac25/(cnst55*cnst51*bf1))*1000000"
"spw25=plw1*pow((p1*totrot25)/(p41*90.0*integfac25),2)"
"spw27=plw1*pow((p1*totrot25)/(p41*90.0*integfac27),2)"
"spoal25=1"
"spoal27=0"

"p57=(bwfac40/(cnst57*bf3))*1000000"
"spw40=plw3*pow((p21*totrot40)/(p57*90.0*integfac40),2)"
"spoal40=0.5"

"spw14=plw3*pow((p21*totrot14)/(p32*90.0*integfac14),2)"
"spoal14=0.5"
#   endif /*CALC_SP*/


"in0=inf1"
"d0=in0/2-p21*4/PI"


"DELTA1=d26-p16-d16-larger(p42,p57)/2-p41*cnst41"
"DELTA2=d26-p16-d16-larger(p42,p57)/2-p41*cnst41"
"DELTA3=d26-p16-d16-larger(p42,p57)/2-4u-de"
"DELTA5=d27/2-p16-d16-p32/2-4u-p21*2/PI"
"DELTA6=d27-p16*2-d16*2-p32-8u"


"spoffs13=0"
"spoffs14=0"
"spoffs25=bf1*(cnst54/1000000)-o1"
"spoffs26=bf1*(cnst54/1000000)-o1"
"spoffs27=bf1*(cnst54/1000000)-o1"
"spoffs30=0"
"spoffs40=bf3*(cnst56/1000000)-o3"


"cnst29=0"


"acqt0=0"
baseopt_echo


1 ze
#   ifdef LABEL_CN
  d11 pl14:f2 pl26:f3
2 d11 do:f2 do:f3
  20u pl2:f2 pl3:f3
3 d1
  50u UNBLKGRAD
  (p21 ph1):f3
  (p3 ph1):f2
  p16:gp1
#   else
  d11 pl26:f3
2 d11 do:f3
  20u pl3:f3
3 d1
  50u UNBLKGRAD
  (p21 ph1):f3
  p16:gp1
#   endif /*LABEL_CN*/
  d16 fq=cnst29(sfo hz):f3
  "TAU=larger((d0/2-p44), 0)"

  (p41:sp25 ph1)
  DELTA1
  p16:gp3
  d16
  (center (p42:sp26 ph1) (p57:sp40 ph1):f3 )
  p16:gp3
  d16 pl3:f3
  DELTA1
  (p41:sp27 ph2)

  p16:gp4
  d16
  
  (p21 ph3):f3
  4u
  DELTA5
  p16:gp7
  d16
  (p32:sp14 ph1):f3
  4u
  p16:gp7
  d16
  DELTA6
  4u
  p16:gp7
  d16
  (p32:sp14 ph1):f3
  4u
  p16:gp7
#   ifdef LABEL_CN
  d16 pl2:f2 pl3:f3
  (center (p44:sp30 ph1 TAU p44:sp30 ph1):f1 (p8:sp13 ph1):f2 (DELTA5 p21 ph4 d0 p21 ph5 DELTA5):f3 )
#   else
  d16 pl3:f3
  (center (p44:sp30 ph1 TAU p44:sp30 ph1):f1 (DELTA5 p21 ph4 d0 p21 ph5 DELTA5):f3 )
#   endif /*LABEL_CN*/

  4u
  p16:gp8
  d16
  (p32:sp14 ph1):f3
  4u
  p16:gp8
  d16
  DELTA6
  p16:gp8
  d16
  4u
  (p32:sp14 ph1):f3
  4u
  p16:gp8
  d16 pl3:f3
  DELTA5
  (p21 ph6):f3

  p16:gp6
  d16

  (p41:sp25 ph1)
  DELTA2
  p16:gp5
  d16
  (center (p42:sp26 ph1) (p57:sp40 ph2):f3 )  
  p16:gp5
  d16 fq=cnst56(sfo hz):f3
#   ifdef LABEL_CN
  DELTA3 pl14:f2 pl26:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2
#   else
  DELTA3 pl26:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2
#   endif /*LABEL_CN*/
     F1PH(calph(ph3, +90) & calph(ph4, +90), caldel(d0, +in0))
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=1 1 3 3
ph5=1 1 1 1 1 1 1 1 3 3 3 3 3 3 3 3
ph6=0 0 0 0 2 2 2 2
ph31=0 2 0 2 2 0 2 0
  

;pl2 : f3 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl14: f2 channel - power level for CPD/BB low power decoupling
;pl26: f3 channel - power level for CPD/BB low power decoupling
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp14: f3 channel - shaped pulse 180 degree (adiabatic)
;spnam14: ca-HyperbolicSecant pow. factor 0.7, beta 5.3, 8kHz sweep at 600.13 MHz
;sp24: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp25: f1 channel - shaped pulse 90 degree (Pc9_4_90.1000)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;                   for time reversed pulse
;sp27: f1 channel - shaped pulse 90 degree (Pc9_4_90.1000)
;                   for time reversed pulse
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;p3 : f2 channel -  90 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion(adiabatic)
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p32: f3 channel - 180 degree shaped pulse for inversion (adiabatic)
;            ca-HyperbolicSecant                          [4.0ms]
;            pow. factor 0.7, beta 5.3, 8kHz sweep at 600.13 MHz, 
;            scale sweep with BF1/600
;p41: f1 channel -  90 degree shaped pulse for excitation
;                      Pc9_4_90.1000 (6.0ms at 600.13 MHz)
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (4.0ms at 600.13 MHz)
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;p57: f3 channel - shaped pulse 180 degree (Reburp.1000)
;d0 : incremented delay (2D) = in0/2-p21*4/PI
;d1 : relaxation delay
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(NH))
;d27: 1/(4J(NN))                                [17.5 - 22.5 ms]
;cnst41: compensation of chemical shift evolution during p41
;           Pc9_4_90.1000: 0.529
;cnst51: scaling factor for p41 to compensate for transition region
;           Pc9_4_90.1000: 1.172
;cnst52: scaling factor for p42 to compensate for transition region
;           Reburp.1000: 1.426
;cnst54: H2 chemical shift (offset, in ppm)           [7.5 ppm]
;cnst55: H2 bandwidth (in ppm)                          [2 ppm]
;cnst56: N1 chemical shift (offset, in ppm)           [225 ppm]
;cnst57: N1 bandwidth (in ppm)                         [20 ppm]
;inf1: 1/SW(N) = DW(N)
;in0: 1/(SW(N)) = DW(N)
;nd0: 1
;ns: 4 * n
;ds: >= 16
;aq: <= 50 msec
;td1: number of experiments
;FnMODE: States-TPPI
;o2p: 157 ppm
;o3p: 195 ppm
;cpd2: decoupling according to sequence defined by cpdprg3: garp4.p61
;cpd3: decoupling according to sequence defined by cpdprg3: garp4.p62
;cpdprg2: garp4.p61
;cpdprg3: garp4.p62
;pcpd2: f3 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio

;for z-only gradients:
;gpz1: 12%
;gpz3: 36%
;gpz4: 25%
;gpz5: -15%
;gpz6: -28%
;gpz7: 7%
;gpz8: 11%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective pulses based on constants
;             option -DCALC_SP (eda: ZGOPTNS)
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



