;trcbcaconhetgp3d
;avance-version (21/09/15)
;TROSY-CBCACONH
;3D sequence with
;   inverse correlation for triple resonance using 
;      TROSY and inept transfer steps 
;
;      F1(H) -> F2(Caliph.,t1 -> Ca) -> F2(C=O) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1
;using constant time in t2
;uncompensated version d25=d26
;(use parameterset TRCBCACONHETGP3D)
;
;T. Schulte-Herbrueggen & O.W. Sorensen, J. Magn. Reson. 144,
;   123 - 128 (2000)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include<Avance.incl>
#include<Grad.incl>
#include<Delay.incl>


define list<gradient> EA3 = { 0.8750 1.0000}
define list<gradient> EA5 = { 1.0000 0.6667}
define list<gradient> EA7 = { 0.6595 1.0000}


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=1.1m-larger(p14,p22)"
"d4=1.7m"
"d21=12.4m"
"d22=3.6m"
"d23=3.6m"
"d24=4.4m"
"d25=2.3m"
"d26=2.3m"
"d27=12.4m"


"d0=3u"
"d10=3u"
"d20=d22/2+d0-p14/2-2u"
"d30=d21/2-d25/2-p14/2-p16/2-d16/2-2u"

"in0=inf1/4"
"in10=inf2/4"

"in20=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d4-p16-d16"
"DELTA2=d22-d3-larger(p14,p22)-p2"
"DELTA3=d23-p14"
"DELTA4=d27-d24+4u"
"DELTA5=d21/2-d25/2-p14/2-d10+p21*2/3.1416"
"DELTA6=d21/2-d25/2-p14/2-d10-p16-d16-p11+p21*2/3.1416-8u"
"DELTA7=d25-p16-d16"
"DELTA8=d26-p11-p16-d16-8u"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst23)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"


"o1_F1=bf2*cnst23/1000000"


aqseq 321


1 ze
2 d11
3 d11 fq=cnst23(bf ppm):f2
  d1
  50u UNBLKGRAD
  d12 pl1:f1 pl3:f3

  (p1 ph1):f1
  p16:gp1
  d16
  DELTA1
  (center (p2 ph2):f1 (p14:sp3 ph1):f2 )
  DELTA1
  p16:gp1
  d16
  (p1 ph2):f1

  (p13:sp2 ph5):f2
  d0
  d0
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d3
  (p2 ph2):f1
  DELTA2 pl19:f1
  (p14:sp3 ph1):f2
  d20
  d20
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u cpds1:f1 ph2
  (p14:sp5 ph1):f2
  DELTA3
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA3
  (p13:sp2 ph1):f2

  4u do:f1
  (p26 ph3):f1
  p16:gp2
  d16 fq=cnst21(bf ppm):f2
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p13:sp2 ph6):f2
  d24
  (p14:sp7 ph1):f2
  DELTA4
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d27
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u do:f1
  (p26 ph4):f1

  (p21 ph7):f3
  d30
  (p14:sp7 ph1):f2
  d30
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA5
  d10
  (p14:sp7 ph1):f2
  d10
  DELTA6
  p16:gp3*EA3
  d16
  (p11:sp1 ph3:r):f1
  4u
  4u pl1:f1

  (p1 ph8)
  p16:gp4
  d16
  DELTA7
  (center (p2 ph2) (p14:sp3 ph1):f2 (p22 ph2):f3 )
  DELTA7
  p16:gp4
  d16
  (p1 ph1) 

  p16:gp5*EA5
  d16
  4u

  (p21 ph1):f3
  p16:gp6
  d16
  DELTA8
  (p11:sp1 ph4:r):f1
  4u
  4u pl1:f1
  (center (p2 ph2) (p22 ph2):f3 )
  4u
  (p11:sp1 ph4:r):f1
  4u
  DELTA8
  p16:gp6
  d16 pl1:f1
  (p21 ph9:r):f3

  p16:gp7*EA7
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph5, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2EA(calgrad(EA3) & calgrad(EA5) & calgrad(EA7) & calph(ph8, +180) & calph(ph9, +180), caldel(d10, +in10) & caldel(d30, -in30) & calph(ph7, +180) & calph(ph31, +180))

exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=0 0 2 2
ph6=0 0 0 0 2 2 2 2
ph7=0 2
ph8=3
ph9=3
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1 : f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(CH)) : 1.1m-p14
;d4 : 1/(4J(CH))                                       [1.7 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d22+d0-p14-4u
;d21: 1/(4J(NCO)), T(N)                                [12.4 msec]
;d22: 1/(8J(CaCb)), T(C)                               [3.6 msec]
;d23: 1/(4J(CaCO))                                     [3.6 msec]
;d24: 1/(4J'(CaCO))                                    [4.4 msec]
;d25: 1/(4J'(NH)                                       [2.3 msec]
;d26: 1/(4J(NH))                                       [2.3 msec]
;d27: 1/(4J'(NCO))                                     [12.4 msec]
;d30: decremented delay (F2 in 3D) = d21/2-d25/2-p14/2-p16/2-d16/2-2u
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(Cali)) = (1/2) DW(Cali)
;nd0: 4
;in10: 1/(4 * SW(N)) = DW(N)
;nd10: 4
;in20: = in0
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:  gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6 :  gp 7
;                        2 :  -40 :  -80 :    5 :   30 :   45 : 30.13

;for z-only gradients
;gpz1: 2%
;gpz2: -40%
;gpz3: -80%
;gpz4: 5%
;gpz5: 30%
;gpz6: 45%
;gpz7: 30.13%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100



;Processing

;PHC0(F2): 22.5



