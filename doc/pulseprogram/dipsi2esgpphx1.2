;dipsi2esgpphx1.2
;avance-version (14/08/04)
;2D homonuclear Hartman-Hahn transfer
;   using DIPSI2 sequence for mixing
;   with threefold C-13 filter in F1
;
;   H[C12] (t1) -> H (t2)
;
;phase sensitive
;water suppression using excitation sculpting with gradients
;water suppression using es sequence
;
;I.A. Lewis, R.H. Karsten, M.E. Norton, M. Tonelli, W.M. Westler & J.L. Markley,
;   Anal. Chem. 82, 4558-4563 (2010)
;(A.L. Breeze, Prog. NMR Spectrosc. 36, 323-372 (2000))
;(C. Zwahlen, P. Legault, S.J.F. Vincent, J. Greenblatt, R. Konrat &
;   L.E. Kay, J. Am. Chem. Soc. 119 6711-6721 (1997))
;(K. Ogura, H. Terasawa & F. Inagaki, J. Biomol. NMR 8, 492-498 (1996))
;(J. Iwahara, J.M. Wojciak & R.T. Clubb, J. Biomol. NMR 19, 231-241 (2001))
;(A.J. Shaka, C.J. Lee & A. Pines, J. Magn. Reson. 77, 274 (1988))
;(T.-L. Hwang & A.J. Shaka, J. Magn. Reson.,
;   Series A 112 275-279 (1995))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d12=20u"
"d28=1s/(cnst6*4)"
"d29=1s/(cnst7*4)"


"in0=inf1"

"d0=in0/2-p1*2/PI"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"DELTA1=d28-p19-d16-p15/2"
"DELTA2=d28-p19-d16+p15/2"
"DELTA3=d4-p19-d16-p15/2"
"DELTA4=d4-p19-d16+p15/2"
"DELTA5=d29-p19-d16-p15/2"
"DELTA6=d29-p19-d16+p15/2"

"TAU=p15"
"TAU1=de+p1*2/PI+8u"


"l10=0"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl12:f2
2 d11 do:f2
3 d12 pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1 pl2:f2
  50u UNBLKGRAD

  (p1 ph1)
  p19:gp2
  d16
  DELTA1
  if "l10 %2 == 0"
     {
     (p15:sp18 ph1):f2
     }
  else
     {
     (TAU):f2
     }
  (p2 ph1)
  DELTA2
  p19:gp2
  d16 pl2:f2
  (p1 ph1)

  if "l10 %2 == 0"
     {
     (p3 ph1):f2
     }
  else
     {
     }
  p16:gp3
  d16

  (p1 ph2)
  p19:gp4
  d16
  DELTA3
  if "l10 %2 == 0"
     {
     (p15:sp18 ph1):f2
     }
  else
     {
     (TAU):f2
     }
  (p2 ph1)
  DELTA4
  p19:gp4
  d16 pl2:f2
  (p1 ph1)

  if "l10 %2 == 0"
     {
     (p3 ph1):f2
     }
  else
     {
     }
  p16:gp5
  d16

  (p1 ph3)
  p19:gp6
  d16
  DELTA5
  if "l10 %2 == 0"
     {
     (p15:sp18 ph1):f2
     }
  else
     {
     (TAU):f2
     }
  (p2 ph1)
  DELTA6
  p19:gp6
  d16 pl2:f2
  (p1 ph1)

  if "l10 %2 == 0"
     {
     (p3 ph1):f2
     }
  else
     {
     }
  p16:gp7
  d16

 (center (p1 ph4 d0 p1 ph1) (p8:sp13 ph1):f2 )

  4u
  p19:gp8
  d16 pl10:f1

						;begin DIPSI2
4 p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  lo to 4 times l1
						;end DIPSI2

  4u
  p19:gp9
  d16 pl1:f1

  (p1 ph1)

  4u
  p16:gp1
  d16
  (p12:sp1 ph6:r):f1
  4u
  d12 pl1:f1

  p2 ph7

  4u
  p16:gp1
  d16
  TAU1
  p16:gp10
  d16
  (p12:sp1 ph8:r):f1
  4u
  d12 pl1:f1

  p2 ph9

  4u
  p16:gp10
  d16 pl12:f2
  4u BLKGRAD

  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1I(iu10, 2)
     F1PH(calph(ph4, +90) & calph(ph29, +90), caldel(d0, +in0))
exit


ph1=0
ph2=0 0 0 0 2 2 2 2
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0 2 
ph5=1
ph6=0 0 1 1
ph7=2 2 3 3
ph8=0 0 0 0 1 1 1 1
ph9=2 2 2 2 3 3 3 3
ph23=3
ph25=1
ph29=0
ph31=0 2 2 0 0 2 2 0 2 0 0 2 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl12: f2 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp1 : f1 channel - shaped pulse 180 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp18: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse (Squa100.1000)   [2 msec]
;p15: f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [500 usec]
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4*J(CH)av)
;d9 : TOCSY mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d28: 1/(4*J(CH)min)
;d29: 1/(4*J(CH)max)
;cnst2: = 1J(CH)av
;cnst6: = 1J(CH)min
;cnst7: = 1J(CH)max
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW = 2 * DW
;in0: 1/SW = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 32
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: 2%
;gpz1: 31%
;gpz2: 2%
;gpz3: 13%
;gpz4: 3%
;gpz5: 19%
;gpz6: 5%
;gpz7: 23%
;gpz8: 2%
;gpz9: -1%
;gpz10: 11%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100
;gpnam9: SMSQ10.100
;gpnam10: SMSQ10.100



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



;$Id:$
