;hmbcedetgpl3nd
;avance-version (12/01/11)
;edited HMBC
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;phase sensitive using Echo/Antiecho gradient selection
;with three-fold low-pass J-filter to suppress one-bond correlations
;no decoupling during acquisition
;
;N.T. Nyberg & O.W. Soerensen,
;   Magn. Reson. Chem. 44, 451-454 (2006)
;D.O. Cicero, G. Barbato & R. Bazzo, J. Magn. Reson. 148, 
;   209-213 (2001)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"cnst27=(2-sfo2*2/sfo1)/(2+sfo2*2/sfo1)"
"cnst28=1/(2+sfo2*2/sfo1)"
"cnst29=-(3-sfo2*3/sfo1)/(2+sfo2*3/sfo1)"
"cnst30=-(1-sfo2/sfo1)/(2+sfo2*3/sfo1)"

define list<gradient> EA1 = { 1.000 cnst29 }
define list<gradient> EA2 = { cnst29 1.000 }
define list<gradient> EA3 = { 1.000 cnst27 }

"cnst26=cnst27+cnst28+cnst29+cnst30"


"p2=p1*2"
"d11=30m"
"d6=1s/(cnst13*2)"


"d0=3u"

"in0=inf1/2"


"DELTA1=1s/(2 * (cnst6 + 0.07 * (cnst7-cnst6) ) ) -p16-d16"
"DELTA2=1s/(cnst7 + cnst6) -p16-d16"
"DELTA3=1s/(2 * (cnst7 - 0.07 * (cnst7-cnst6) ) ) -p16-d16"
"DELTA4=d6-p16*2-d16*2-4u"
"DELTA5=1s/(cnst7*2 + cnst6*2) -p16-d16"
"DELTA6=p2+d0*2"
"DELTA7=1s/(cnst7 + cnst6)-4u"


"l0=0"


1 ze 
2 d11
3 d1 pl12:f2

  if "l0 %2 == 0"
     {
     20u cpd2:f2
     p1 ph1
     DELTA7
     4u do:f2
     }
  else
     {
     p1 ph1
     }

  DELTA1 UNBLKGRAD
  p16:gp3
  d16 pl2:f2
  (p3 ph3):f2
  DELTA2
  p16:gp4
  d16
  (p3 ph3):f2
  DELTA3
  p16:gp5
  d16
  (p3 ph3):f2
  4u
  p16:gp6
  d16
  DELTA4

  if "l0 %2 == 0"
     {
     p16:gp1*cnst30
     d16
     (p3 ph4):f2
     d0
     p2 ph2
     d0
     p16:gp1*EA1
     d16
     DELTA5
     (p24:sp7 ph5):f2
     DELTA5
     DELTA6
     p16:gp1*EA2
     d16 pl2:f2
     (p3 ph5):f2
     }
  else
     {
     p16:gp1*EA3
     d16
     (p3 ph4):f2
     p16:gp1*cnst28*-1
     d16
     DELTA2
     d0
     p2 ph2
     d0
     (p24:sp7 ph5):f2
     DELTA6
     p16:gp1*cnst28
     d16 pl2:f2
     DELTA2
     (p3 ph5):f2
     }

  4u BLKGRAD
  go=2 ph31
  d11 mc #0 to 2 
     F1I(iu0, 2)
     F1EA(calgrad(EA1) & calgrad(EA2) & calgrad(EA3), caldel(d0, +in0) & calph(ph4, +180) & calph(ph31, +180))
exit 
  

ph1=0
ph2=0 0 0 0 2 2 2 2
ph3=0 0 2 2
ph4=0 2
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 0 2 0 2 0 2 2 0 2 0 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp7: f2 channel - shaped pulse (180degree refocussing)
;spnam7: Crp60comp.4
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d6 : delay for evolution of long range couplings (1/2Jlr)
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;cnst6: = 1J(XH)min
;cnst7: = 1J(XH)max
;cnst13: = J(XH) long range
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 3 : gp 4 : gp 5 : gp 6
;                         80 :   14 :   -8 :   -4 :   -2

;for z-only gradients:
;gpz1: 80%
;gpz3: 14%
;gpz4: -8%
;gpz5: -4%
;gpz6: -2%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



