;c_hbhacbcacocanco_ia5d
;avance-version (21/09/15)
;HabCabCO(Ca)NCO
;4D sequence with
;   13C detected correlation for triple resonance using 
;      multiple inept transfer steps
;
;      F2(Ha/b,t1) -> F1(Ca/b,t2) -> F1(Ca) -> F1(C=0,t3)
;                  -> F1(Ca) -> F3(N,t4) -> F1(C=O,t5)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;phase sensitive (t4)
;using semi-constant time in t1
;using constant time in t2
;using constant time in t4
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;P. Dziekanski, K. Grudziaz, P. Jarvoll, W. Kozminski & A. Zawadzka-Kazimierczuk,
;   J. Biomol. NMR 62, 179-190 (2015)
;(W. Bermel, I. Bertini, V. Csizmok, I. C. Felli, R. Pierattelli & 
;   P. Tompa, J. Magn. Reson. 198, 275-281 (2009) )
;(W. Bermel, I. Bertini, I.C. Felli, R. Kuemmerle
;   & R. Pierattelli, J. Magn. Reson. 178, 56-64 (2006) )
;
;$CLASS=HighRes
;$DIM=5D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=1.1m"
"d4=1.85m"
"d22=4.55m"
"d23=14.0m"
"d24=3.6m"
"d28=3.4m"


"d32=3u"
"d33=3u"
"d51=3u"
"d31=d4"
"d34=d23-larger(p8,p22)/2"
"d41=d4+p12+d51"
"d42=d24-p12-4u"
"d44=d23-larger(p8,p22)/2"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"
"in34=inf4/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"
"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"

"in42=in32"
"in43=in33"
"in44=in34"

"td2=tdmax(td2,d42*2,in42)"
"td4=tdmax(td4,d44*2,in44)"


"DELTA1=d3-d32-larger(p12,p22)"
"DELTA2=d24-d3-p4"
"DELTA3=d33*2+larger(p12,p22)-p12-4u"
"DELTA4=d23-d22-p12"
"DELTA5=d23-p12-4u"
"DELTA6=d23/2-p12/2"
"DELTA7=d23-d22-p12"


"l0=1"


"spoffs4=bf1*((cnst21-cnst23)/2000000)"
"spoffs13=bf1*((cnst22-cnst21)/2000000)"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst23)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs29=bf1*((cnst21-cnst22)/1000000)"


"o1_F1=bf2*cnst20/1000000"
"o1_F2=bf1*cnst23/1000000"
"o1_F3=bf1*cnst21/1000000"


"cnst62=-((bf2*cnst20)-(o2*1000000))"
"cnst63=-(cnst62*inf1/1000000)*360.0"


"TAU9=abs(cnst62+cnst63)/100000"


1 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 fq=cnst23(bf ppm):f1

  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph3):f2
  d31
  (p12:sp24 ph1)
  d51
  (p4 ph1):f2
  d41
  (p3 ph2):f2

  p16:gp1
  d16

  (p11:sp23 ph4)
  d32
  (center (p12:sp26 ph1) (p22 ph1):f3 )
  DELTA1
  (p4 ph1):f2
  DELTA2
  (p12:sp24 ph1)
  d42 pl12:f2
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph1)

  20u cpd2:f2 ph1
  d28*0.5
  (p39:sp4 ph1)
  4u
  d28
  4u
  (p39:sp4 ph1)
  d28*0.5
  4u
  (p11:sp23 ph1)

  4u do:f2
  (p26 ph8):f2
  p16:gp2
  d16 fq=cnst21(bf ppm):f1
  (p26 ph2):f2
  20u cpd2:f2 ph1

  (p11:sp23 ph5)
  4u
  (p12:sp27 ph1)
  DELTA3
  (p12:sp24 ph1)
  d33
  (center (p12:sp27 ph1) (p22 ph1):f3 )
  d33
  (p11:sp25 ph1)

  4u fq=cnst22(bf ppm):f1

  (p11:sp23 ph1)
  d22
  (p12:sp29 ph1)
  DELTA4
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  DELTA5
  (p12:sp29 ph1)
  4u
  (p11:sp25 ph1)

  4u do:f2
  (p26 ph8):f2
  p16:gp3
  d16 fq=cnst21(bf ppm):f1
  (p26 ph2):f2
  20u cpd2:f2 ph1

  (p21 ph6):f3
  d34
  (center (p8:sp13 ph1) (p22 ph1):f3 )
  d44
  (p21 ph1):f3

  4u do:f2
  p16:gp3
  d16
  20u cpd2:f2 ph1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph1)
     DELTA6
     (p12:sp27 ph1)
     DELTA6
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA6
     (p12:sp27 ph1)
     DELTA6 pl16:f3
     }
  else
     {
     (p11:sp23 ph8)
     d22
     (p12:sp27 ph1)
     DELTA7
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA6
     DELTA6 pl16:f3
     (p12:sp27 ph1)
     }
  
  4u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 

#   ifdef LABEL_F1
     F1I(iu0, 2)
#   else

#   ifdef LABEL_F2
     F2I(iu0, 2)
#   else

#   ifdef LABEL_F3
     F3I(iu0, 2)
#   else
     F4I(iu0, 2)
#   endif /*LABEL_F3*/

#   endif /*LABEL_F2*/

#   endif /*LABEL_F1*/

     F1PH(calph(ph3, +90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51) & calph(ph3, cnst63))
     F2PH(calph(ph4, +90), caldel(d32, +in32) & caldel(d42, -in42)) 
     F3PH(calph(ph5, -90), caldel(d33, +in33))
     F4PH(calph(ph6, +90), caldel(d34, +in34) & caldel(d44, -in44))

TAU9
exit


ph1=0
ph2=1
ph3=0 0 2 2
ph4=0 2
ph5=0 0 0 0 2 2 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph8=3
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp4 : f1 channel - shaped pulse (180degree refocussing)
;spnam4: Bip720,100,10.1
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp29: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f1 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f2 channel -  90 degree pulse at pl12
;p39: f1 channel - 180 degree shaped pulse for refocussing
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [1.1 msec]
;d4 : 1/(4J(HCa))                                      [1.85 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa))                                     [4.55 msec]
;d23: 1/(4J(NCa))                                      [14.0 msec]
;d24: 1/(8J'(CaCb))                                    [3.0 msec]
;d28: 1/(4J'(COCa))                                    [3.4 msec]
;d31: incremented delay (F1 in 4D) = d4
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D)                     [3 usec]
;d34: incremented delay (F4 in 4D) = d23-larger(p8,p22)/2
;d41: decremented delay (F1 in 4D) = d4+p12+d51
;d42: decremented delay (F2 in 4D) = d24-p12-4u
;d44: decremented delay (F4 in 4D) = d23-larger(p8,p22)/2
;d51: incremented delay (F1 in 4D)                     [3 usec]
;cnst20: H(ali) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;cnst62: offset for Hali region (Hz)
;cnst63: additional phase increment to center Hali region
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(Ha/b) = 2 * DW(Ha/b)
;inf2: 1/SW(Ca/b) = 2 * DW(Ca/b)
;inf3: 1/SW(CO) = 2 * DW(CO)
;inf4: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(Ha/b)) =  DW(Ha/b)
;nd31: 2
;in32: 1/(2 * SW(Ca/b)) =  DW(Ca/b)
;nd32: 2
;in33: 1/(2 * SW(CO)) =  DW(CO)
;nd33: 2
;in34: 1/(2 * SW(N)) =  DW(N)
;nd34: 2
;in41: = k1 * in31
;in42: = in32
;in44: = in34
;in51: = (1 - k1) * in31
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;td4: number of experiments in F4 * 2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;FnMODE: States-TPPI (or TPPI) in F4
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 39%
;gpz2: 29%
;gpz3: 13%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
;             only to be used for F1F4 plane
;LABEL_F2: to do ipap in F2 start experiment with
;             option -DLABEL_F2 (eda: ZGOPTNS)
;             only to be used for F2F4 plane
;LABEL_F3: to do ipap in F3 start experiment with
;             option -DLABEL_F3 (eda: ZGOPTNS)
;             only to be used for F3F4 plane
                                          ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] to process data



