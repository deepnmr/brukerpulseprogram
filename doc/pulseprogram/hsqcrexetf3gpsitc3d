;hsqcrexetf3gpsitc3d
;avance-version (23/09/25)
;3D 1H/15N correlation via double inept transfer
;   using sensitivity improvement
;for measuring 15N R(exchange) using a CPMG train
;includes phasecycling in CPMG pulse train for increased accuracy
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;as pseudo3D
;with temperature compensation
;(use parameterset HSQCREXETF3GPSITC3D)
; 
; This pulse program uses the relaxation compensated approach to perform a 15N CPMG
; relaxation dispersion experiment, where 15N magnetization is equally present as 
; anti- and inphase magnetization irrespective of the CPMG frequency due to a 
; central P-element that interconverts between anti- and inphase magnetization.
;
; The pulse sequence corresponds to the one described in Long et al. with one modification: 
; The increased R1 contribution to the measured R2 rates (as the magnetization passes 
; through the Z axis during the CPMG pulse train) at higher CPMG frequencies is 
; compensated as described in Yuwen et al. (Fig 3). Consequently the correction of 
; the measured R2 rates as described in Long et al. is not necessary.
;
; Total CPMG relaxation delay length is set as d20 (in seconds).
;
; CPMG frequencies are given via a vdlist. List entries are interpreted as 
; field strengths in Hz (e.g. an entry 100 in the vd list corresponds to 
; 100 Hz CPMG frequency). CPMG frequencies in the vdlist must be multiples 
; of 2/d20 (in Hz; displayed as cnst50 in the pulse program) !
;
; For measuring I0 (signal intensity in the absence of the CPMG relaxation 
; delay), set one entry in the vdlist to 0. 
;
; The zg option NCAL (see end of pulse program) allows for the calibration
; of the 15N pulse under RF load, since under load higher power will be 
; required than calculated from the 90 degree 15N hard pulse.
;
;
;D. Long, M. Liu & D. Yang, J. Am. Chem. Soc. 130, 2432-2433 (2008)
;
;T. Yuwen & L.E. Kay, J. Biomol. NMR, 73, 641-650 (2019)


;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define list<delay> RF_field=<$VDLIST>

define delay RF_max

define loopcounter COUNTER0
define loopcounter COUNTER1
define loopcounter COUNTER2
define loopcounter COUNTER3 


"p2=p1*2"
"p22=p21*2"

"d11=30m"
"d21=d20/2"
"d24=2.3m"
"d25=2.68m"

"cnst31=0"
"cnst50=2/d20"
"d31=0"
"d32=0"

"d10=4u"
"in10=inf2/2"

"DELTA2=p19+d16-p1*2/PI+de+8u"
"DELTA4=d25-p16-d16-p11-8u"
"DELTA5=d25-p16-d16+p44/2+2*d10+12u"
"DELTA6=d24-p16-d16"

#   ifdef LABEL_CN
"DELTA1=d25-p16-d16-p8-p44/2"
"spoffs13=0"
#   else
"DELTA1=d25-p16-d16-p44/2"
#   endif /*LABEL_CN*/

"l3=td1"
"l11=0"

"spoffs1=0"

"spoffs30=0"

# ifdef NCAL
"td1=1"
"td2=1"
# endif /*NCAL*/


"acqt0=0"
baseopt_echo


aqseq 312


1 ze
  d11 pl16:f3


# ifndef NCAL
  if "td1 != RF_field.len" 
     {
     2u
     print "Warning: td1 is not equal to the number of CPMG frequencies in the vdlist"
     }
# endif /*NCAL*/

  "RF_max=0"

3 20u

; determine maximum CPMG frequency in the vdlist (from the first td1 entries) and test whether frequencies are mulitples of 2/d20
  if "RF_field > RF_max"
     {
     20u
     "RF_max=RF_field"
     }
   if "1 > ((RF_field/cnst50) - trunc(RF_field/cnst50))*cnst50 || (1-((RF_field/cnst50) - trunc(RF_field/cnst50)))*cnst50 < 1"
     {
     }
  else
     {
     2u
     print "CPMG frequencies are not multiples of 2/d20 and will be rounded to multiples of 2/d20"
     }
  3m RF_field.inc
  lo to 3 times l3
  20u
  "COUNTER0=d20*RF_max/2"
  20u
  "RF_max=2*COUNTER0/d20"
  3m RF_field.res
  "d31=RF_field[0]"

2 d11 do:f3

  "d31=RF_field[l11]"

;use max. CPMG frequency for pulse calibration  
# ifdef NCAL
  20u
  "d31=RF_max"
# endif /*NCAL*/

; calculate number 360 degree rotations per CPMG block (COUNTER0), actual CPMG frequency 
; rounded to 2/d20 (d31) and half inter-pulse delay (DELTA3) from desired the CPMG frequency
; (RF_field). COUNTER1 and 2 correspond to the number of phase cycled (1102 and 11 phase 
; cycle) CPMG elements during the CPMG blocks.

  20u
  "if (d31 == 0) \
     { \
     DELTA3=1s; \
     COUNTER0=0; \
     } \
  else \
     { \
     COUNTER0=d20*d31/2; \
     d31=2*COUNTER0/d20; \
     DELTA3=(1 / (d31*4) ) - (p30*3)/8000000; \
     COUNTER1=trunc((COUNTER0/2)); \
     COUNTER2=((COUNTER0)%2); \
     }"

; calculate delay for T1 relaxation compensation
  "DELTA9=((RF_max-trunc(d31))*d20)*p30/4" 

; recycle delay
  d1 pl1:f1  

; start of heating compensation (applied for a duration of d20, at a CPMG frequency
; corresponding to the difference of RF_max and the current value of d31)

  if "RF_max - d31 > 0.1"
     {
     20u
     "COUNTER3=(RF_max-d31)*d20"
     20u
     "d32=COUNTER3/d20"
     20u
     "TAU1=(1 / (d32*4) ) - p30/2000000"
     }

  4u pl23:f3
  if "abs(RF_max-d31) < 0.1"
     {
     d20
     }
  else
     {
4    TAU1
     (p30 ph2):f3
     TAU1
     TAU1
     (p30 ph2):f3
     TAU1
     lo to 4 times COUNTER3
     }
; heating compensation end

; purge 15N magnetization
  4u UNBLKGRAD pl3:f3
  (p21 ph1):f3
  p16:gp1
  d16

; H -> N transfer
  (p1 ph1)
  p16:gp2
  d16
  DELTA6
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6 
  p16:gp2
  d16
  (p1 ph2)

  4u
  (p11:sp1 ph1:r):f1
  4u
  p16:gp3
  d16
  DELTA9

; Start first CPMG relaxation block
  (p21 ph11):f3
  4u pl23:f3
     4u
  if "COUNTER0 > 0"
     {
6    DELTA3
     (p30 ph21):f3
     DELTA3
     DELTA3
     (p30 ph21):f3
     DELTA3
     DELTA3
     (p30 ph20):f3
     DELTA3
     DELTA3
     (p30 ph22):f3
     DELTA3
     lo to 6 times COUNTER1

7    DELTA3
     (p30 ph21):f3
     DELTA3
     DELTA3
     (p30 ph21):f3
     DELTA3
     lo to 7 times COUNTER2
     }
; End first CPMG relaxation block

; P-element for 15N antiphase -> inphase transfer
  DELTA4
  p16:gp6
  d16
  (p11:sp1 ph14):f1
  4u
  4u pl1:f1 pl3:f3
  (center (p1 ph2 2u p2 ph15 2u p1 ph2) (p22 ph1):f3 )
  4u
  4u pl23:f3
  (p11:sp1 ph14):f1
  p16:gp6
  d16
  DELTA4

; Start second CPMG relaxation block
  if "COUNTER0 > 0"
     {
8    DELTA3
     (p30 ph20):f3
     DELTA3
     DELTA3
     (p30 ph20):f3
     DELTA3
     DELTA3
     (p30 ph21):f3
     DELTA3
     DELTA3
     (p30 ph23):f3
     DELTA3
     lo to 8 times COUNTER1

9    DELTA3
     (p30 ph20):f3
     DELTA3
     DELTA3
     (p30 ph20):f3
     DELTA3
     lo to 9 times COUNTER2
     }
     4u
  4u pl3:f3
  (p21 ph2):f3
; End second CPMG relaxation block

  DELTA9
  p16:gp7
  d16

; calibrate 15N pulse under load
# ifdef NCAL
  4u pl45:f3
  (p45 ph11):f3
  4u pl3:f3
  p19:gp1
  d16
# endif /*NCAL*/

; 15N chem. shift evolution
  (p21 ph12):f3
  p19:gp4*EA
  d16
  DELTA5
  (p22 ph1):f3
  d10 gron0*-1
  6u groff
  (p44:sp30 ph1)
  DELTA1
  p19:gp4*-1*EA
  d16 
#   ifdef LABEL_CN
  (p8:sp13 ph1):f2 
#   endif /*LABEL_CN*/
  d10 gron0
  6u groff pl1:f1

; N -> H backtransfer using sensitivity improvement
  (center (p1 ph3) (p21 ph13):f3 )
  p16:gp8
  d16
  DELTA6
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p16:gp8
  d16
  (center (p1 ph2) (p21 ph5):f3 )
  p16:gp9
  d16
  DELTA6
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p16:gp9
  d16
  (p1 ph1)
  DELTA2
  (p2 ph1)
  4u
  p19:gp5
  d16 pl16:f3
  4u  BLKGRAD

; acquisition   
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calgrad(EA) & calph(ph5, +180), caldel(d10, +in10) & calph(ph12, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=2
ph4=3 
ph5=1
ph11=0 2
ph12=1 1 1 1 3 3 3 3
ph13=0 
ph14=0 0 2 2
ph15=2 2 0 0 
ph20=0
ph21=1
ph22=2
ph23=3
ph31=0 2 0 2 2 0 2 0
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl23: f3 channel - power level for CPMG train
;pl45: f3 channel - power level for CPMG pulse calibration
;sp1 : f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [1000 usec]
;p19: gradient pulse 2                               [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: f3 channel - 180 degree pulse for CPMG train (at pl23)
;p44: f1 channel - 180 degree shaped pulse
;p45: f3 channel -  90 degree pulse for CPMG pulse calibration
;d1 : relaxation delay; 1-5 * T1
;d10 : incremented delay                             [6 usec]
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery          [200 usec]
;d20: total length of CPMG relaxation time
;d21: length of each CPMG block
;d24: <1/(4J)NH
;d25: 1/(4J)NH
;l3: l3=TD1
;l11: used for internal calculations
;vd : variable field strength, taken from vd-list
;cnst4: = J(YH)
;cnst50: 2/d20, set CPMG frequencies to multiples of this value
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 8 * n
;ds: >= 64
;td1: number of CPMG frequencies in vd-list
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: 1%
;gpz1: 25%
;gpz2: 10%
;gpz3: 3%
;gpz4: 80%
;gpz5: 16.2%
;gpz6: 5%
;gpz7: -7%
;gpz8: 12%
;gpz9: -22%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100
;gpnam9: SMSQ10.100

                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
;NCAL: for optimization of 15N CPMG pulse power under RF load. Converts the pulse program to a 1D version. 
;       Set p45 to half the duration of p30 (p45 is a 90 degree pulse) and optimize powerlevel plw45 for 
;       zero signal (the power should be slightly higher than plw23). Then set plw23 to the optimized 
;       value of plw45. Important: Set TD1 to the value that will be used in the final experiment. For 
;       optimization with popt: Process first FID as 1D and phase correctly, set F1P/F2P to amide proton 
;       region and start popt from this procno with the option "Run optimization in background".
                                          ;preprocessor-flags-end


