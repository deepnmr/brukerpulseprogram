;mehsqccest3d
;avance-version (22/09/02)
;3D H-1/C-13 correlation using inept transfer
; 
; for measuring methyl C-13 CEST (chemical exchange saturation transfer) on 
; 13CH3 groups.
; Duration of the CEST C-13 saturation is set in d21.
; Offsets for C-13 saturation are given in fqlist. An additional reference 
; experiment (no CEST delay) is performed first. Consequently, set td1 to 
; the number of offsets in fqlist + 1.
; The C-13 B1 field for saturation is set in cnst9. Saturation power is internally 
; calculated based on decoupling pulse length and powerlevel (pcpd2/plw12).
; 
; H-1 decoupling during the CEST duration is achieved using a 90x/240y/90x pulse
; train that generates weak decoupling sidebands at 1/(pcpd1*9.33) (pcpd1 = 
; length of 90 degree pulse used for decoupling). E.g. for a 70 us pcpd1 pulse 
; length, the sidebands appear at ± 1530 Hz, which should be outside the range 
; of excited state chemical shifts (see publication for details). 
;
; water suppression using watergate and/or presat
; as pseudo3D
;
; (use parameterset MEHSQCCEST3D)
;
; G. Bouvignies & L.E. Kay, J. Biomol. NMR 53, 303-310 (2012)

;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=



#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

prosol relations=<triple>

"d10=0.2u"
"in10=inf2/2"
"d11=30m"

define list<frequency> CEST_offset=<$FQ3LIST> 

"p2 = p1*2"
"p4 = p3*2"
"p19 = 500u"
"p25 = 1000000.0/(4.0*cnst9)" 
"plw15 = plw12 * pow((pcpd2/p25),2)"

"d27 = 784u"
"d3 = 1.217m"
"d4 = 1.8m"

"DELTA1 = d4  - p16 - d16"
"DELTA2 = d3  - p16 - d16"
"DELTA3 = d27 - p1*4 - p19 - d16"  
"DELTA4 = d27 - p19 - d16" 
"DELTA5 = d4  - p19 - d16 - p11 - 4u "
"DELTA6 = d4  - p19 - d16 - p11 - 8u - de"

"l11 = 0" 

"acqt0=0"
baseopt_echo

aqseq 312

1 ze

  if "td1 != CEST_offset.len+1" 
     {
     2u
     print "Warning: td1 is not equal to the number of CEST offsets in the frequency list + 1"
     }


2 d11 do:f2 
   
; start of heating compensation for 1H decoupling 
  4u fq=cnst49 (bf ppm):f1 pl19:f1                  
  if "l11 == 0"
  {
    d21 cpds8:f1       
  }
  else
  {
  "CEST_offset.idx=(l11-1)"
  }
  4u do:f1         
  4u fq=0:f1  pl1:f1 pl2:f2  
; heating compensation end


  (p1 ph1):f1
  20u UNBLKGRAD          
  p16:gp0*0.25          
  d16                    
  (p1 ph2):f1
  p16:gp0*0.5          
  d16                    
  20u BLKGRAD            
  4u pl9:f1     

; recycle delay, presaturation
  d1 cw:f1 ph1         
  4u do:f1               

; start actual pulse sequence
  (p3 ph1):f2           
  20u UNBLKGRAD            
  p16:gp0                 
  d16  fq=cnst49 (bf ppm):f1   pl1:f1          

; H -> C INEPT
  (p1 ph1):f1                                    
  p16:gp1                                        
  d16  
  DELTA1                                            
  (center (p2 ph7):f1 (p4 ph7):f2)        
  DELTA1                                              
  p16:gp1                                        
  d16  
  (p1 ph2):f1                                    

  p16:gp2                                         
  d16 

  (p3 ph5):f2                                 
  p16:gp3                                          
  d16  
  DELTA2                                           
  (center (p2 ph7):f1 (p4 ph7):f2)        
  DELTA2                                           
  p16:gp3                                         
  d16  
  (p3 ph2):f2

  (p1 ph1):f1                                                                   
  p16:gp4                                  
  d16         
  4u pl19:f1 
  4u pl15:f2 fq=CEST_offset:f2  

; CEST period                               
  if "l11 == 0"
  {
   4u          
  }
  else
  {   
   d21 cpds8:f1 cpd3:f2
   4u do:f2  do:f1                       
  }

 4u fq=0:f2 pl2:f2  
 4u pl10:f1         
 (2mp ph1):f1   
 4u                 
 (3.4mp ph2):f1                                         
  p16:gp5                                
  d16 pl1:f1 

; 13C chem. shift evolution          
  (p3 ph6):f2                             
  d10                                      
  DELTA3                                 
  p19:gp6                                  
  d16                                    
  (p1 ph2):f1                            
  (p2 ph1):f1                         
  (p1 ph2):f1                             
  d10                                       
  (p4 ph1):f2                          
  DELTA4                             
  p19:gp6                                  
  d16                                      
  (p3 ph2):f2                            

  4u fq=0:f1              
  p16:gp7                                  
  d16 

; back-transfer with watergate             
  (p1 ph1):f1  
  p19:gp8                                
  d16
  DELTA5     
  (p11:sp1 ph8:r):f1   
  4u  pl1:f1                             
  (center (p2 ph7):f1 (p4 ph7):f2) 
  4u
  (p11:sp1 ph8:r):f1     
  p19:gp8                                  
  d16 
  DELTA6
  4u BLKGRAD pl12:f2       
  go=2 ph31 cpds2:f2   

; acquisition
  d11 do:f2 mc #0 to 2
  F1QF(calclc(l11,1))
  F2PH(calph(ph6,+90), caldel(d10,+in10))

exit

ph1=0
ph2=1
ph5=0 2
ph6=0 0 2 2  
ph7=0
ph8=2
ph31=0 2 2 0

;pl1 : f1 channel - power level for pulse
;pl2 : f2 channel - power level for pulse 
;pl9 : f1 channel - power level for presaturation
;pl10: f1 channel - power level for purge pulse
;pl12: f2 channel - power level for CPD/BB decoupling
;pl15: f2 channel - power level for weak 13C CEST B1 field
;pl19: f1 channel - power level for 1H decoupling during CEST (calculate for 90 degree pulse length given by pcpd1)

;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse 
;p25: f2 channel -  90 degree pulse at CEST power level
;p11: f1 channel -  90 degree shaped pulse (watergate) 
;sp1 : f1 channel - shaped pulse for water flipback 

;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d21 : CEST duration [200-500 ms]

;d4 : ~1/(4*JCH)  [1.8 ms]
;d3 : 1/(6*JCH)  [1.217 ms]
;d27 : delay for C-H back transfer [784 us]
;d16: delay for homospoil/gradient recovery [200 us]

;l11 : internal counter for CEST offsets

;cnst9 : 13C B1 field for CEST in Hz ~ 20-50 Hz
;cnst49 : center of H(Methyl) region in ppm [~1]

;d10: incremented delay   
;inf2 : 1/SW = DW(X)
;in10: 1/(2*SW(x))=DW(X)/2

;pcpd1 :f1 channel - 90 degree pulse for 1H decoupling during CEST
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence

;nd10=2
;ns: 4 * n
;ds: 32

;for z-only gradients:
;gpz0: 30%
;gpz1: 20%
;gpz2: 48%
;gpz3: -10%
;gpz4: 64%
;gpz5: 28%
;gpz6: -30%
;gpz7: 10%
;gpz8: 36%

;use gradient files:  
;gpnam0: SMSQ10.100 
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100 
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.50

;Processing

;PHC0(F1): 0
;PHC1(F1): 0
;FCOR(F1): 0.5

;$Id: $

