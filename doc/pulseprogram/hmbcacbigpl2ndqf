;hmbcacbigpl2ndqf
;avance-version (12/01/11)
;2J,3J-HMBC, STAR-HMBC
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence 
;optimized on long range couplings using accordion
;with two-fold low-pass J-filter to suppress one-bond correlations
;no decoupling during acquisition
;using gradient pulses for selection
;using shaped pulses for inversion on f2 - channel
;
;V.V. Krishnamurthy, D.J. Russel, C.E. Hadden & G.E. Martin,
;   J. Magn. Reson. 146, 232-239 (2000)
;(C.E. Hadden, G.E. Martin & V.V. Krishnamurthy, 
;   Magn. Reson. Chem. 38, 143-147 (2000))
;(C.E. Hadden, G.E. Martin & V.V. Krishnamurthy, 
;   J. Magn. Reson. 140, 274-280 (1999))
;(R. Wagner & S. Berger, Magn. Reson. Chem. 36, S44-S46 (1998))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d2=1s/(cnst2*2)"
"d11=30m"


"in0=inf1/2"

"FACTOR1=( (1s/(cnst14*2)) - (1s/(cnst15*2)) ) * 10000000/ td1"
"in6=FACTOR1/10000000"

"in20=cnst16*0.5*in0"
"in28=in6/2"
"in29=in20"

"d0=3u"
"d6=1s/(cnst14*2)"
"d20=in20*td1+3u"
"d28=3u"
"d29=3u"


"DELTA1=1s/(2 * (cnst6 + 0.146 * (cnst7-cnst6)) ) -p16-d16"
"DELTA2=1s/(2 * (cnst7 - 0.146 * (cnst7-cnst6)) ) -p16-d16"
"DELTA3=d2-larger(p2,p14)/2"



1 ze
2 d11
3 d1
  (p1 ph1)
  DELTA1 UNBLKGRAD
  p16:gp4
  d16 pl2:f2
  (p3 ph3):f2
  DELTA2
  p16:gp5
  d16
  (p3 ph3):f2
  p16:gp6
  d16

  d28

  d29
  p16:gp7
  d16
  (p14:sp3 ph1):f2
  p16:gp7*-1
  d16
  d29

  d20
  p16:gp8
  d16
  (p1 ph1)
  DELTA3
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA3
  (p1 ph1)
  p16:gp8*-1
  d16
  d20

  (p14:sp3 ph1):f2
  d28

  d6 pl2:f2

  (p3 ph4):f2
  d0
  p16:gp1
  d16
  p2 ph2
  p16:gp2
  d16
  d0
  (p3 ph5):f2

  p16:gp3
  d16
  4u BLKGRAD
  go=2 ph31
  d11 mc #0 to 2 F1QF(caldel(d0, +in0) & caldel(d6, -in6) & caldel(d28, +in28) & caldel(d29, +in29) & caldel(d20, -in20))
exit


  ph1=0
  ph2=0 0 0 0 2 2 2 2
  ph3=0 0 2 2
  ph4=0 2
  ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
  ph6=2
  ph31=0 2 0 2 0 2 0 2 2 0 2 0 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;sp3: f2 channel - shaped pulse (180degree inversion)
;spnam3: Crp60,0.5,20.1
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse
;d0 : incremented delay (2D)                  [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J)XH
;d6 : delay for evolution of long range couplings
;d11: delay for disk I/O                      [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay
;d28: incremented delay                       [3 usec]
;d29: incremented delay                       [3 usec]
;cnst2: = J(XH)
;cnst6: = J(XH)min
;cnst7: = J(XH)max
;cnst14: = J(XH) long range (min)
;cnst15: = J(XH) long range (max)
;cnst16: = J(scale) factor
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;in6: (d6max - d6min)/td1                     [200msec-20msec]
;in20: = in0 * J(scale)
;in28: = in6 / 2
;in20: = in20
;ns: 4 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: QF


;use gradient ratio:
;     gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6 : gp 7 :  gp 8
;       50 :   30 : 40.1 :   60 :  -40 :  -20 :   11 :   -11   for C-13

;for z-only gradients:
;gpz1: 50%   for C-13
;gpz2: 30%
;gpz3: 40.1%   for C-13
;gpz4: 60%
;gpz5: -40%
;gpz6: -20%
;gpz7: 11%
;gpz8: -11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



