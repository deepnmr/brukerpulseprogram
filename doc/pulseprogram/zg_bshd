;zg_bshd
;avance-version (21/09/15)
;1D sequence
;with bandselective homodecoupling
;
;L. Castanar, P. Nolis A. Virgili & T. Parella, 
;   Chem. Eur. J. 19, 17283-17286 (2013)
;J. Ying, J. Roche & A. Bax, J. Magn. Reson. 241, 97-102 (2014)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
#include <De.incl>


"p2=p1*2"
"d11=30m"

"p29=300u"


"d62=aq/(l0*2)"
"d63=d62/2"


#   ifdef CALC_SPOFFS
"spoffs35=bf1*(cnst21/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/


"acqt0=-p1*2/PI"


1 ze
2 30m
  4u BLKGRAD
  d1 pl1:f1
  50u UNBLKGRAD

  (p1 ph1):f1

  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d63
  0.05u DWELL_HOLD
  0.1u REC_BLK
   
4 p29:gp2
  d16 pl1:f1
  (p2 ph2):f1
  p29:gp2
  d16 

  p29:gp3
  d16
  5u
  (p46:sp35 ph3):f1
  5u
  p29:gp3
  d16 

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK

  p29:gp2
  d16 pl1:f1
  (p2 ph2):f1
  p29:gp2
  d16 
 
  p29:gp3
  d16
  5u
  (p46:sp35 ph3):f1
  5u
  p29:gp3
  d16 

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK

  lo to 4 times l0

  d62

  rcyc=2
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph2=0 2
ph3=2 0
ph30=0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;sp35: f1 channel - shaped pulse 180 degree
;p1 : f1 channel -  high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p29: gradient pulse 3                                    [300 usec]
;p46: f1 channel - 180 degree shaped pulse                [20-80ms]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                                  [30 msec]
;d16: delay for homospoil/gradient recovery
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;cnst21: chemical shift for selective pulse (offset, in ppm)
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;ns: 1 * n, total number of scans: NS * TD0
;ds: 4


;for z-only gradients:
;gpz2: 7%
;gpz3: 5%

;use gradient files:
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



