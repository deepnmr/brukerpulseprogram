;mehmqcnoesyhmqc194d
;avance-version (20/03/03)
;4D HMQC-NOESY-HMQC for methy/methyl NOEs  
;
;for deuterated, methyl group 1H/13C labeled proteins
;
;  H(methyl),t1 -> C(methyl),t2 -> H(methyl)
;  -> NOE ->  H(methyl) -> C(methyl),t3 ->  H(methyl), t4
;
; center of F1 dimension H(methyl) = cnst49
; semi constant time in F1
; water suppression using 3-9-19 pulse sequence with gradients
; best used with NUS 
;
;(use parameterset MEHMQCNOESYHMQC194D)
;(J. Ying, F. Delaglio, D.A. Torchia & A. Bax, J Biomol NMR 68, 101-118 (2017))

;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
prosol relations=<triple>

"p2=p1*2"
"p4=p3*2"

"o1_F1=bf1*cnst49/1000000"

"d11=30m"
"d12=20u"
"d26=1s/(cnst4*2)"

"d31=3u"
"d51=3u"
"d41=d26-p19-d16"
"in31=inf1/2"
"in32=inf2"
"in33=inf3"
"d32=in32/2-p3*4/PI"
"d33=in33/2-p3*4/PI"
"d19=1/(4*(o1-cnst49*bf1/1000000))"
"DELTA1=d41-d31-d51-p4-p1*4/PI"
"DELTA2=d26-p16-d16-4u-de"
"DELTA3=4u+de"
"TAU=d8-2*p11-p16-d16-p3"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in51= 0; } else { in51=in31-INCR1; }"
"if ( INCR1 > in31 ) { in41=in31; } else { in41 = INCR1; }"



"acqt0=0"
baseopt_echo


1 ze 
  d11 pl12:f2
2 d1 do:f2 
3 d12 pl2:f2 
  (p3 ph1):f2
  p16:gp0
  d16
  (p11:sp1 ph13:r):f1
  4u fq=cnst49 (bf ppm):f1 pl1:f1
  (p1 ph3)
  d31 UNBLKGRAD
  (p4 ph6):f2 
  d51 
  (p1 ph0 p1*2.2 ph2 p1 ph0):f1
  p19:gp1
  d16
  d41 

  
  (center(p3 ph4 d32 p3 ph1):f2 (p1 ph0 p1*2.2 ph2 p1 ph0):f1)
  p19:gp1
  d16
  DELTA1
  (p1 ph1)
  4u fq=0:f1 
  (p11:sp1 ph9:r):f1
  TAU
  (p3 ph1):f2
  p16:gp2
  d16
  (p11:sp1 ph8:r):f1
  4u pl1:f1
  (p1 ph1) 
  DELTA3
  p16:gp3
  d16 pl18:f1
  (center
  (DELTA2 p3 ph5 d33  p3 ph1 DELTA2):f2 
  (p27*0.231 ph7  d19*2 p27*0.692 ph7 d19*2 p27*1.462 ph7 d19*2 p27*1.462 ph8 d19*2 p27*0.692 ph8 d19*2 p0*0.231 ph8):f1)
  p16:gp3
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
   F1PH(calph(ph3, +90) & calph(ph13, +90), caldel(d31, +in31) & caldel(d51, +in51) & caldel(d41, -in41))
   F2PH(calph(ph4, +90), caldel(d32, +in32))
   F3PH(calph(ph5, +90), caldel(d33, +in33))
exit 
  
ph0=0
ph1=0
ph2=1
ph3=0 0 0 0 2 2 2 2
ph4=0 0 2 2
ph5=0 2
ph6=0
ph7=0
ph8=2
ph9=2
ph13=2 2 2 2 0 0 0 0
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for decoupling
;pl18: f1 channel - power level for 3-9-19-pulse (watergate)
;
;p0 : f1 channel -  90 degree pulse at pl18 for 3-9-19-pulse (watergate)
;                      use for fine adjustment
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse 
;p4 : f2 channel -  180 degree high power pulse 
;p27: f1 channel -  90 degree pulse at pl18 for 3-9-19-pulse (watergate)
;
;p16: homospoil/gradient pulse   [1 ms]
;p19: homospoil/gradient pulse   [600 us]
;p11: f1 channel - 90 degree shaped pulse for water flipback [1 ms]
;sp1: f1 channel - shaped pulse for water flipback [Sinc1.1000]
;
;d1 : relaxation delay; 1-5 * T1
;d8 : NOESY mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery          [200 usec]
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;d26 : 1/(4J) CH
;
;d31: incremented delay (t1)                                     
;d41: decremented delay (t1)                                        
;d51: incremented delay (t1)                  
;d32: incremented delay (t2)                  
;d33: incremented delay (t3)             
;
;cnst4: = J(CH) in Hz [130]
;cnst49: Center of F1 dimension H(methyl) (in ppm)  [~1] 
;inf1: 1/SW(F1) = 2 * DW(F1)
;inf2: 1/SW(F2) = 2 * DW(F2)
;inf3: 1/SW(F3) = 2 * DW(F3)
;in31: 1/(2 * SW(F1)) = DW(F1)
;in32: 1/(SW(F2)) = 2 * DW(F2)
;in33: 1/(SW(F3)) = 2 * DW(F3)
;ns: 4 * n
;ds: >32
;FnMODE: States-TPPI in all dimensions
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: 37%
;gpz1: 43%
;gpz2: 53%
;gpz3: 30%

;use gradient files:   
;gpnam0: SMSQ10.100
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100

;Processing

;PHC0(F1): 0
;PHC1(F1): 0
;FCOR(F1): 0.5

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1

;PHC0(F3): 90
;PHC1(F3): -180
;FCOR(F3): 1


