;eretic
;avance-version (09/12/21)
;1D sequence for quantitative measurements
;using f2 channel for Eretic signal
;
;Akoka, S.; Barantin, L. und Trierweiler, M. Anal. Chem. 71, 1999, 2554-2557
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"p62=aq"


1 ze
  20u pl25:f2
2 30m do:f2
  d1
  4u reset:f1
  4u reset:f2
  p1 ph1
  4u cpds2:f2 ph5:r
  go=2 ph31
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1= 0 2 2 0 1 3 3 1
ph5= 0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl25: f2 channel - power level for eretic pulse
;sp15 : eretic shape pulse
;p1  : f1 channel  - high power pulse
;p62 : eretic pulse (exponential decay)
;d1  : relaxation delay; 1-5 * T1
;ns  : 8 * n, total number of scans: NS * TD0
;cpds2: decoupling according to sequence defined by cpdprg2


;phcor5:phase difference between eretic signal and spectrum


;use CPD program eretic



