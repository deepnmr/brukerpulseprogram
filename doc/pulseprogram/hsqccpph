;hsqccpph
;avance-version (20/08/26)
;HSQC
;2D H-1/X correlation via double inept transfer
;phase sensitive
;using purge pulses for xy before d1 
;with decoupling during acquisition
;all pulses replaced with shapes for use with composite pulses @hard power
;optional trim pulse before aq, reduces T1 noise but introduces COSY-type peaks
;
;G. Bodenhausen & D.J. Ruben, Chem. Phys. Lett. 69, 185 (1980)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>

"p1 = p0/integfac51"
"p2 = 2*p0/integfac52"
"p33 = p3/integfac53"
"p34 = 2*p3/integfac54"

"spw51 = plw1"
"spw52 = plw1"
"spw53 = plw2"
"spw54 = plw2"

"d4=1s/(cnst2*4)"
"d11=30m"

"d0=3u"

"in0=inf1/2"


"DELTA=d0*2+p2"


1 ze
  d11 pl12:f2 
2 d11 do:f2
  
  (p1:sp51 ph1)
  p28 ph3
  (p1:sp51 ph10)

  
  d1 pl1:f1 
  (p1:sp51 ph1)
  d4 pl2:f2
  (center (p2:sp52 ph2) (p34:sp54 ph9):f2 )
  d4

#   ifdef TRIMP
  (p28 ph1)
#   endif /* TRIMP */
  

  (p1:sp51 ph3)
  (p33:sp53 ph6):f2
  
  d0
  (p2:sp52 ph8)
  d0 
    
  (p34:sp54 ph7):f2
  DELTA pl1:f1
  
  (p33:sp53 ph7):f2
  (p1:sp51 ph4)
  d4
  (center (p2:sp52 ph2) (p34:sp54 ph5):f2 )
  d4 pl12:f2 
  
#   ifdef TRIMP2
  (p28*0.5 ph10)
#   endif /* TRIMP2 */
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2
     F1PH(calph(ph6, +90) & calph(ph9, +90), caldel(d0, +in0))
exit


ph1=0
ph2=0
ph3=1
ph4=0
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph6=0 2
ph7=0 0 2 2
ph8=0 0 0 0 2 2 2 2
ph9=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph10=2
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;p1 : f1 channel -  90 degree high power composite pulse
;p2 : f1 channel - 180 degree high power composite pulse
;p33 : f2 channel -  90 degree high power composite pulse
;p34 : f2 channel - 180 degree high power composite pulse
;p28: f1 channel - trim pulse (pl1)                    [1 msec]
;spnam51: f1 channel - excitation shape
;spnam52: f1 channel - inversion/refocussing shape
;spnam53: f2 channel - excitation shape
;spnam54: f2 channel - inversion/refocussing shape
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J)XH
;d11: delay for disk I/O                               [30 msec]
;cnst2: = J(XH)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence



                                          ;preprocessor-flags-start
;TRIMP: to use trimpulse in first inept start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
;TRIMP2: to use trimpulse before acquisition start experiment with
;          option -DTRIMP2 (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


