;lc2pnps
;avance-version (13/02/04)
;pseudo-2D-sequence for lc-nmr on flow detection
;1D-version of noesyprph using presaturation during relaxation delay 
;   and mixing time
;using shaped pulse for off-resonance presaturation
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d13=4u"


"if (d1/p18 < 1) {l6=1;} else {l6=d1/p18;}"

"l7=trunc(d8/p18)"

"DELTA=d8-(p18*l7)"


"acqt0=-p1*2/3.1416"


1 ze

#   ifdef WAITFORSTART
  autosuspend
#   endif

2 d11 
3 d12
4 p18:sp6:f1 ph29
  4u
  lo to 4 times l6
  d12 pl1:f1
  p1 ph1
  d13
  p1 ph2
  4u 
  DELTA
5 p18:sp6:f1 ph29
  4u
  lo to 5 times l7
  4u pl1:f1
  p1 ph3
  go=2 ph31
  d11 wr #0 if #0 zd 
  lo to 3 times td1
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;sp6: f1 channel - shaped pulse for presaturation
;p1 : f1 channel -  90 degree high power pulse
;p18: f1 channel - presaturation using shaped pulse
;d1 : relaxation delay; 1-5 * T1                     [ca. 1-2sec]
;d8 : mixing time                                    [ca. 80 msec]
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;l6: p18 * l6 = total duration of presaturation
;                  during relaxation delay           [16]
;l7: p18 * l7 = total duration of presaturation
;                  during mixing time                [1]
;ns: 8 * n
;ds: 16
;td1: number of increments along the chromatographic time axis

;use 100msec pulse of square shape defined by 1000 points


                                          ;preprocessor-flags-start
;WAITFORSTART: Start experiment with option -DWAITFORSTART (eda: ZGOPTNS)
;                 Acquisition waits for 'resume' command for sychronisation
;                 with chromatography
                                          ;preprocessor-flags-end



