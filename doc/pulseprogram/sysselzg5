;2D sequence
;excitation profile
;
;$CLASS=HighRes HWT
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$HIDE=y


#include <Avance.incl>


1 ze
2 d1 pl0:f1
3 50u fq1:f1
  p11:sp1:f1 ph1
  4u
  go=2 ph31
  d1 wr #0 if #0 zd
  lo to 3 times td1
exit


ph1=0 2 1 3
ph31=0 2 1 3


;pl1 : f1 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse
;p11: f1 channel -  90 (or 270) degree shaped pulse
;d1 : relaxation delay; 1-5 * T1



