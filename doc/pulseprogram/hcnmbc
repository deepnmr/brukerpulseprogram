;hcnmbc
;avance-version (15/09/21)
;HCNMBC
;2D H-1/N-15 correlation via multiple inept transfer
;
;    F1(H) -> F2(C) -> F3(N,t1) -> F2(C) -> F1(H,t2)
;   
;phase sensitive using Echo/Antiecho gradient selection
;using shaped pulses for all 180degree pulses on f2 and f3 - channel
;(use parameterset )
;
;S. Cheatham, P. Gierth, W. Bermel & E. Kupce, 
;   J. Magn. Reson. 247, 38-41 (2014)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d22=1s/(cnst5*4)"


"d0=3u"

"in0=inf1/2"


"DELTA1=d4-larger(p2,p14)/2"
"DELTA2=d22-p57+p3*2/PI"
"DELTA3=d22+p57-p3*2/PI"
"DELTA4=d4-larger(p2,p14)/2-p16-d16+p1*2/PI-de-4u"


#   ifdef NODEC
"DELTA=p16+d16-d0*2-p2-p21*4/PI-4u"
#   else
"DELTA=p16+d16-d0*2-larger(p2,p14)-p21*4/PI-4u"
#   endif /*NODEC*/


"acqt0=0"
baseopt_echo


1 d11 ze
  d11 pl1:f1
2 d11 do:f2 do:f3
  4u pl2:f2 pl3:f3
  d1

  50u UNBLKGRAD
  (p3 ph1):f2
  (p21 ph1):f3
  4u
  p16:gp3
  d16

  (p1 ph3):f1
  DELTA1
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA1
  (p1 ph2):f1

  p16:gp4
  d16 pl2:f2

  (p3 ph4):f2
  4u
  (p14:sp3 ph1):f2
  (p57:sp38 ph1):f3
  DELTA2
  8u
  (p57:sp38 ph1):f3
  (p14:sp3 ph1):f2
  4u
  DELTA3 pl2:f2 pl3:f3  
  (p3 ph2):f2

  (p21 ph5):f3
  d0 

#   ifdef NODEC
  (p2 ph1)
#   else
  (center (p2 ph1) (p14:sp3 ph1):f2 )
#   endif /*NODEC*/

  d0
  DELTA
  (p57:sp38 ph1):f3
  p16:gp1*EA*-1
  d16 
  (p57:sp38 ph1):f3
  2u
  2u pl2:f2 pl3:f3
  (p21 ph1):f3
  
  p16:gp5
  d16

  (p3 ph2):f2
  4u
  (p14:sp3 ph1):f2
  (p57:sp38 ph1):f3
  DELTA2
  8u
  (p57:sp38 ph1):f3
  (p14:sp3 ph1):f2
  4u
  DELTA3 pl2:f2
  (p3 ph1):f2

  p16:gp6
  d16

  (p1 ph1):f1
  DELTA1
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  p16:gp2
  d16
  DELTA4 pl12:f2 pl16:f3
  4u BLKGRAD
  
  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph5, +180) & calph(ph31, +180)) 
exit
 

ph1=0 
ph2=1
ph3=0 0 0 0 2 2 2 2
ph4=0 0 2 2
ph5=0 2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp3 : f2 channel - shaped pulse 180 degree for inversion (adiabatic)
;spnam3: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;sp38: f3 channel - shaped pulse 180 degree for inversion (adiabatic)
;spnam38: CaWu40,2,20.1
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse on C-13
;p14: f2 channel - 180 degree shaped pulse
;     = 500usec for Crp60,0.5,20.1 (Crp80,0.5,20.1)
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p57: f3 channel - 180 degree shaped pulse
;     = 2msec for CaWu40,2,20.1
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(CN))
;cnst2: = J(CH)
;cnst5: = J(CN)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) = DW(N)
;nd0: 2
;ns: 2 * n
;ds: >= 32
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 8.1%
;gpz3: 31%
;gpz4: 19%
;gpz5: 11%
;gpz6: 7%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



