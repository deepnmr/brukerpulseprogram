;noesyprigld1d
;avance-version (13/08/01) 
;1D version of noesyph with inverse gated decoupling
;using low power decoupling
;with presaturation during relaxation delay and mixing time
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>


"d11=30m"
"d12=20u"

"acqt0=-p1*2/3.1416"


1 ze
  d11 pl14:f2
2 30m do:f2
  d12 pl9:f1
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1
  p1 ph1
  4u
  p1 ph2
  d12 pl9:f1
  d8 cw:f1
  4u do:f1
  d12 pl1:f1
  p1 ph3
  go=2 ph31 cpd2:f2
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl14: f2 channel - power level for low power decoupling
;p1 : f1 channel -  90 degree high power pulse
;p61: f2 channel - 90 degree pulse for low power decoupling
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence: waltz64.p61



