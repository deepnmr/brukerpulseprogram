;stdmlevph
;avance-version (20/01/09)
;2D sequence
;   for saturation transfer difference
;   with homonuclear Hartman-Hahn transfer using MLEV17
;      sequence for mixing
;with shaped pulse train for saturation on f2 channel
;alternating between on and off resonance
;   to be defined by fq2list
;phase sensitive
;
;(M. Mayer & B. Meyer, Angew. Chem. Int. Ed. 38, 1784-1788 (1999))
;(M. Mayer & B. Meyer, Angew. Chem. 111, 1902-1906 (1999))
;(A. Bax & D.G. Davis, J. Magn. Reson. 65, 355-360 (1985))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<frequency> stdlist=<$FQ2LIST>


"p5=p6*.667"
"p7=p6*2"
"d11=30m"
"d12=20u"

"l5=d20/p42"
"d31=p42*l5"


"in0=inf1"

"d0=in0/2-p1*2/3.1416-4u"


"DELTA1=d1-d31"


"SCALEF=p7*2/p5"
"FACTOR1=((d9-p17*2)/(p6*64+p5))/SCALEF"
"l1=FACTOR1*SCALEF"


1 ze
2 d11
3 d12 stdlist:f2
  d12 stdlist.inc

  50u UNBLKGRAD
  4u pl10:f1
  (p17 ph3)
  (p17*2 ph4)
  4u
  p30:gp1
  10m pl1:f1
  4u BLKGRAD

  DELTA1
4 (p42:sp9 ph2):f2
  4u
  lo to 4 times l5

  p1 ph1
  d0
  4u pl10:f1
  (p17 ph26)
						;begin MLEV17
5 (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p5 ph23)
  lo to 5 times l1 
						;end MLEV17
  (p17 ph26) 
  go=2 ph31
  d11 mc #0 to 2 F1PH(calph(ph1, +90), caldel(d0, +in0))
exit


ph1=0 0 2 2 2 2 0 0 1 1 3 3 3 3 1 1
ph2=0
ph3=0
ph4=1
ph22=3 3 1 1 3 3 1 1 0 0 2 2 0 0 2 2
ph23=0 0 2 2 0 0 2 2 1 1 3 3 1 1 3 3
ph24=1 1 3 3 1 1 3 3 2 2 0 0 2 2 0 0
ph25=2 2 0 0 2 2 0 0 3 3 1 1 3 3 1 1
ph26=0 0 2 2 0 0 2 2 1 1 3 3 1 1 3 3
ph31=0 2 2 0 2 0 0 2 1 3 3 1 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)       [120 dB]
;pl10: f1 channel - power level for TOCSY-spinlock
;sp9 : f2 channel - shaped pulse  for saturation          [40 - 60 dB]
;p1 : f1 channel -  90 degree high power pulse
;p5 : f1 channel -  60 degree low power pulse
;p6 : f1 channel -  90 degree low power pulse
;p7 : f1 channel - 180 degree low power pulse
;p17: f1 channel - trim pulse                             [2.5 msec]
;p30: gradient pulse                                      [3 msec]
;p42: f2 channel -  shaped pulse for saturation           [50 msec]
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d11: delay for disk I/O                                  [30 msec]
;d12: delay for power switching                           [20 usec]
;d20: saturation time
;d31: saturation time as executed
;l1: loop for MLEV cycle: (((p6*64) + p5) * l1) + (p17*2) = mixing time
;l5: loop for saturation: p42 * l5 = saturation time
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 16 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ

;define FQ2LIST (irradiation frequencies)
;               (list has to be stored in "/u/exp/stan/nmr/lists/f1")


;use gradient ratio:    gp 1
;                         40

;for z-only gradients:
;gpz1: 40%

;use gradient files:
;gpnam1: SMSQ10.100



;Processing

;PHC0(F1): 180
;PHC1(F1): -180
;FCOR(F1): 1



