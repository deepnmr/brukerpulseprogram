;
;(A. Viegas, T. Viennet, T.Y. Yu, F. Schumann, W. Bermel, G. Wagner & M.Etzkorn,
;   J. Biomol. NMR 64, 9-15 (2016) )
;
;Dataset 1 (F1)
;dipsi2gpphzs
;homonuclear Hartman-Hahn transfer using DIPSI2 sequence
;   for mixing
;phase sensitive
;with zero quantum suppression
;
;M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)
;
;Dataset 2 (F2)
;zgig
;1D sequence with inverse gated decoupling
;
;2D experiment leads to NOE for the 1D
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"d11=30m"
"d12=20u"


"in0=inf1"

"d0=in0/2-p1*4/3.1416"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"

"l3=td1/2"


"spoffs29=0"


"acqt0=-p1*2/3.1416"


1 ze1
  ze2

2 d11 do:f1
  9m
3 3m

4 d1

  d12 pl1:f1
  50u UNBLKGRAD

; exp 1

  p1 ph1
  d0
  p1 ph2

  10u gron0
  (p32:sp29 ph4):f1
  20u groff
  d16 pl10:f1

						;begin DIPSI2
5 p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  lo to 5 times l1
						;end DIPSI2

  p16:gp1
  d16
  10u gron0*1.333
  (p32*0.75:sp29 ph4):f1
  20u groff
  d16 pl1:f1
  4u BLKGRAD
  p1 ph3

  goscnp1 ph30


; exp 2

  20u pl19:f1
  (p3 ph11):f2
  go2=2 ph31 cpd1:f1

  d11 do:f1 wr1 #0 if1 #0 zd1
  3m wr2 #1
  3m zd2

;exp_f1 phase
  3m ip1
  lo to 3 times 2

;exp_f1 delay
  3m id0
  lo to 4 times l3

exit 
  

ph1=0 2
ph2=0 0 0 0 2 2 2 2
ph3=0 0 2 2 
ph4=0
ph23=3
ph25=1

ph11=0 2 2 0 1 3 3 1

ph30=0 2 2 0 2 0 0 2
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl19: f1 channel - power level for CPD/BB decoupling
;sp29: f1 channel - shaped pulse (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p16: homospoil/gradient pulse                              [1 msec]
;p32: f1 channel - 180 degree shaped pulse (adiabatic)      [20 msec]
;     smoothed chirp (sweepwidth, 20% smoothing, 10000 points)
;d0 : incremented delay (2D) = in0/2-p1*4/3.1416
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d11: delay for disk I/O                                    [30 msec]
;d12: delay for power switching                             [20 usec]
;d16: delay for homospoil/gradient recovery
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: undefined
;cpd1: decoupling according to sequence defined by cpdprg1
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: ca. 11%
;gpz1: 31%

;use gradient files:
;gpnam1: SMSQ10.100



;for sweepwidth of adiabatic shape and adjusting gpz0
;   see supplementary material of M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



