;mqsgp1d
;avance-version (12/01/11)
;1D multiple quantum filter
;using gradient pulses for selection
;with multiple quantum filter according to gradient ratio
;use as setup for pulseprogram 'cosygpmftp' 
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>


"p2=p1*2"
"d13=4u"

"d20=p16+d16"


1 ze
2 30m
  d1
  p1 ph1
  d4 
  p2 ph4
  d4
  p1 ph2
  d13
  d20 UNBLKGRAD
  p2 ph4
  d13
  p16:gp1
  d16
  p1 ph3
  d20
  p2 ph4
  d13
  p16:gp2
  d16
  4u BLKGRAD
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2
ph2=0 
ph3=0
ph4=1
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J)
;d13: short delay                                    [4 usec]
;d16: delay for homospoil/gradient recovery
;d20: p16 + d16
;ns: 1 * n, total number of scans: NS * TD0
;ds: 16


;use gradient ratio:	gp 1 : gp 2
;			  10 :   20   for double quantum filter
;			  10 :   30   for triple quantum filter

;for z-only gradients:
;gpz1: 10%
;gpz2: 20% for DQS, 30% for TQS

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



