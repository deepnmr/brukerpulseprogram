;adeq11etgprdsp_bbhd
;avance-version (20/03/03)
;1,1-ADEQUATE: 2D-HSQC-1J(CC)-ADEQUATE
;   with refocussing of C chemical shift
;   using sensitivity improvement
;phase sensitive using Echo/Antiecho gradient selection
;with decoupling during acquisition
;using shaped pulses for 180degree pulses on f2 - channel
;using 1H broadband homodecoupling during acquisition with [BIRD]d element
;
;J.Sauri, W. Bermel, A.V. Buevich, E.C. Sherer, L.A. Joyce, M.H.M Sharaf,
;   P.L. Schiff jr, T. Parella, R.T. Williamson & G.E. Martin,
;   Angew. Chem. Int. Ed. 54, 10160-4 (2015)
;(B. Reif, M. Koeck, R. Kerssebaum, H. Kang, W. Fenical & C. Griesinger
;   J. Magn. Reson. A118, 282-285 (1996))
;(M. Koeck, R. Kerssebaum & W. Bermel, Magn. Reson. Chem. 41, 65-69 (2003))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>


"p2=p1*2"
"d0=3u"
"d11=30m"
"d12=20u"

"p0=p3*1.333"
"d2=1s/(cnst2*2)"
"d4=1s/(cnst2*4)"
"d23=1s/(cnst3*4)"
"d24=1s/(cnst2*cnst11)"

"p29=300u"
"p30=3m"


"in0=inf1/2"

"in20=in0"

"d20=d23-4u"

"td1=tdmax(td1,d20*2,in20)"


"d62=aq/l0"
"d63=d62/2"


"l1=l0-1"


"DELTA1=p16+d16-p2-d0*2+4u"
"DELTA2=p16+d16+8u"
"DELTA3=d23-p16-d16-4u-p2-d0"
"DELTA4=d4-p14/2-4u"
"DELTA5=d23-p24/2-4u"
"DELTA6=d24-cnst17*p24/2-4u"
"DELTA7=d2-larger(p2,p39)/2"
"DELTA8=d2-larger(p2,p14)/2-p16-d16"

"TAU=p39"


1 ze
  d11 pl12:f2
2 d11 do:f2

  d12 pl10:f1
  p17 ph1
  p17*2 ph2
  d12 pl1:f1

  p16:gp8
  d16

  4u BLKGRAD
  d1
  50u UNBLKGRAD

  (p1*0.5 ph1)
  DELTA8
  p16:gp6
  d16
  4u
  (center (p2 ph2) (p14:sp3 ph1):f2 )
  4u
  p16:gp6
  d16
  DELTA8
  (p1*1.5 ph1)

  4u
  p30:gp7
  d16

3 (p1 ph1)
  4u
  DELTA4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  4u
  DELTA4 pl2:f2

#   ifdef TRIMP
  (p28 ph1)
#   endif /* TRIMP */

  (p1 ph2)

  (p3 ph4):f2
  4u
  DELTA5
  (p24:sp7 ph8):f2
  4u
  DELTA5 pl2:f2
  (p3 ph9):f2
  d0
  (p2 ph1)
  d0
  DELTA1
  (p24:sp7 ph11):f2
  4u
  p16:gp1
  d16 pl2:f2
  (p0 ph10):f2
  4u
  d20
  (p24:sp7 ph11):f2
  4u
  p16:gp2
  d16
  DELTA3 pl2:f2
  (p2 ph1)
  d0
  (center (p1 ph1) (p3 ph5):f2 )
  4u
  DELTA6
  (center (p2 ph1) (p24:sp7 ph1):f2 )
  4u
  DELTA6 pl2:f2
  (center (p1 ph2) (p3 ph6):f2 )
  4u
  DELTA4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  4u
  DELTA4
  (p1 ph1)
  DELTA2
  (p2 ph1)
  4u
  p16:gp3*EA
  d16 pl12:f2 

  4u cpd2:f2
  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d63
  0.05u DWELL_HOLD
  0.1u REC_BLK

  10u do:f2
  p29:gp4
  d16
  TAU
  (p1 ph1)
  DELTA7
  4u
  (center (p2 ph2) (p39:sp4 ph1):f2 )
  4u
  DELTA7
  (p1 ph7)
  (p39:sp4 ph1):f2
  p29:gp4
  d16 pl12:f2
  20u
  p29:gp5
  d16
  4u
  (p2 ph1)
  4u
  p29:gp5
  d16
  10u cpd2:f2

4 0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK
  
  10u do:f2
  p29:gp4
  d16
  TAU
  (p1 ph1)
  DELTA7
  4u
  (center (p2 ph2) (p39:sp4 ph1):f2 )
  4u
  DELTA7
  (p1 ph7)
  (p39:sp4 ph1):f2
  p29:gp4
  d16 pl12:f2
  20u
  p29:gp5
  d16
  4u
  (p2 ph1)
  4u
  p29:gp5
  d16
  10u cpd2:f2

  lo to 4 times l1

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62*2
  0.05u DWELL_HOLD
  0.1u REC_BLK

  rcyc=2

  d11 do:f2 mc #0 to 2
     F1EA(calgrad(EA) & calph(ph6, +180), caldel(d0, +in0) & caldel(d20, -in20))
  4u BLKGRAD
exit
   

ph1=0 
ph2=1
ph4=0 2
ph5=0 0 2 2 	
ph6=1 1 3 3
ph7=2
ph8=0
ph9=0 0 0 0 2 2 2 2
ph10=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph11=0
ph30=0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse (180degree inversion)
;spnam3: Crp60,0.5,20.1
;sp4: f2 channel - shaped pulse (180degree refocussing)
;spnam4: Bip720,100,10.1
;sp7: f2 channel - shaped pulse (180degree refocussing)
;spnam7: Crp60comp.4
;p0 : f2 channel - 120 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse
;p17: f1 channel - trim pulse                             [2.5 msec]
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;p28: f1 channel - trim pulse                             [1 msec]
;p29: gradient pulse 3                                    [300 usec]
;p30: gradient pulse                                      [3 msec]
;p39: f2 channel - 180 degree shaped pulse for refocussing
;                      Bip720,100,10.1 (160us at 600.13 MHz)
;d0 : incremented delay (2D)                              [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/2J(CH)
;d4 : 1/4J(CH)
;d11: delay for disk I/O                                  [30 msec]
;d12: delay for power switching                           [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D): d23-4u
;d23: 1/(4J(CC))
;d24: 1/(4J(CH)) for CH
;     1/(8J(CH)) for all multiplicities
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;cnst2 : J(CH) = 127 .. 160 Hz
;cnst3 : J(CC) = 35 .. 55 Hz
;cnst11: for multiplicity selection = 4 for CH, 8 for CHn
;cnst17: = -0.5 for Crp60comp.4
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;inf1: 1/SW(C) = 2 * DW(C)
;in0: 1/(2 * SW(C)) = DW(C)
;nd0: 2
;in20: = in0
;ns: 16 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: +78.5%
;gpz2: +77.6%
;gpz3: -59%
;gpz4: 13%
;gpz5: 19%
;gpz6: 11%
;gpz7: 60%
;gpz8: 23%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.50
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100


                                          ;preprocessor-flags-start
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;cnst17: Factor to compensate for coupling evolution during a pulse
;       (usually +1). A positive factor indicates that coupling
;       evolution continues during the pulse, whereas a negative
;       factor is necessary if the coupling is (partially) refocussed.



