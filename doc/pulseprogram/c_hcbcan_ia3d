;c_hcbcan_ia3d
;avance-version (21/09/15)
;HCbCaN
;3D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(H) -> F1(Ca/b,t1) -> F1(Ca)
;            -> F3(N,t2) -> F1(Ca,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using constant time in t1
;using DIPAP scheme for virtual decoupling
;(use parameterset C_HCBCAN_IA3D)
;
;W. Bermel, I. Bertini,L. Duma, I.C. Felli, L. Emsley,  R. Pierattelli,
;   P.R. Vasos, Angew. Chem. Int. Ed. 44, 3089-3092 (2005)
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=1.1m"
"d4=1.8m"
"d22=4.5m"
"d23=12.4m"
"d25=4.0m"
"d27=3.6m"


"d0=3u"
"d10=3u"
"d20=d25+d0-p12-4u"

"in0=inf1/2"
"in10=inf2/2"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"DELTA=d10*2+larger(p4,p8)"
"DELTA1=d25-p12-d3-p4"
"DELTA2=d23-d27*2-p12/2-p25"
"DELTA3=d27-p12/2"
"DELTA4=d27+d22/2-p12/2"
"DELTA5=d27-d22/2-p12/2"


"l0=0"


"spoffs13=bf1*((cnst21/2+cnst22/2)/1000000)-o1"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst23)/1000000)"
"spoffs28=0"
"spoffs29=bf1*((cnst23-cnst22)/1000000)"


"o1_F1=bf1*cnst23/1000000"


aqseq 312


1 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 fq=cnst23(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph1):f2
  d4 
  (center (p12:sp24 ph1) (p4 ph1):f2 )
  d4
  (p3 ph2):f2

  p16:gp1
  d16

  (p11:sp23 ph3)
  d0
  (p12:sp26 ph6)
  d3
  (p4 ph6):f2
  DELTA1
  (p12:sp24 ph1)
  d20
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph1)

  d25
  (p12:sp24 ph1)
  d25
  (p11:sp23 ph2)

  p16:gp2
  d16 fq=cnst22(bf ppm):f1

  (p11:sp23 ph1)
  d23
  (center (p25:sp28 ph1) (p22 ph1):f3 )
  d23
  (p11:sp25 ph2)
  
  p16:gp3
  d16

  (p21 ph4):f3
  d10
  (center (p8:sp13 ph6) (p4 ph6):f2 )
  d10
  (p22 ph1):f3
  DELTA
  (p21 ph1):f3

  p16:gp4
  d16 pl12:f2

  if "l0 %4 == 0"
     {
     (p11:sp23 ph5)
     DELTA2
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA2
     (center (p12:sp29 ph1) (p22 ph1):f3 )
     DELTA3
     (p12:sp26 ph1)
     DELTA3
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA3
     (p12:sp26 ph1)
     DELTA3 pl16:f3
     }
  if "l0 %4 == 1"
     {
     (p11:sp23 ph7)
     DELTA2
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA2
     (center (p12:sp29 ph1) (p22 ph1):f3 )
     DELTA4
     (p12:sp26 ph1)
     DELTA5
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA4
     (p12:sp26 ph1)
     DELTA5 pl16:f3
     }
  if "l0 %4 == 2"
     {
     (p11:sp23 ph8)
     DELTA2
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA2
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA3
     (p12:sp26 ph1)
     DELTA3
     (center (p12:sp29 ph1) (p22 ph1):f3 )
     DELTA3
     (p12:sp26 ph1)
     DELTA3 pl16:f3
     }
  if "l0 %4 == 3"
     {
     (p11:sp23 ph5)
     DELTA2
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA2
     (center (p25:sp28 ph1) (p22 ph1):f3 )
     DELTA4
     (p12:sp26 ph1)
     DELTA5
     (center (p12:sp29 ph1) (p22 ph1):f3 )
     DELTA4
     (p12:sp26 ph1)
     DELTA5 pl16:f3
     }

  4u BLKGRAD

  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1I(iu0, 4)
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph7=3 3 3 3 1 1 1 1
ph8=1 1 1 1 3 3 3 3
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;sp29: f1 channel - shaped pulse 180 degree  (Cali off resonance)
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [1.1 msec]
;d4 : 1/(4J(HCa))                                      [1.8 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d25+d0-p12-4u
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCa))                                      [12.4 msec]
;d25: 1/(8J'(CaCb))                                    [4.0 msec]
;d27: 1/(8J(CaCb))                                     [3.6 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o1p: Calpha chemical shift (cnst22)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(Ca/b) = 2 * DW(Ca/b)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Ca/b)) =  DW(Ca/b)
;nd0: 2
;in10: 1/(2 * SW(N)) =  DW(N)
;nd10: 2
;in20: = in0
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1 * 4
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1   td1 max = 8 * d20 / in20
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4
;                         50 :   30 :   19 :   13

;for z-only gradients:
;gpz1: 50%
;gpz2: 30%
;gpz3: 19%
;gpz4: 13%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



;use AU-program splitcomb [ipap 4] (F1) to process data



