;c_hnconcacon_ia5d
;avance-version (21/09/15)
;HNCONCaCON
;5D sequence with 
;   13C detected correlation for triple resonance using 
;      multiple inept transfer steps 
; 
;      F2(HN) -> F3(N) -> F1(C=O,t1) -> F3(N,t2) -> F1(Ca,t3)
;                      -> F1(C=O) -> F3(N,t4) -> F1(C=O,t5)
; 
;on/off resonance 13C pulses using shaped pulses 
;phase sensitive (t1) 
;phase sensitive (t2) 
;phase sensitive (t3) 
;phase sensitive (t4) 
;using semi-constant time in t2
;using semi-constant time in t3
;using IPAP scheme for virtual decoupling 
;(use parameterset ) 
; 
;W. Bermel, I.C. Felli, L. Gonnelli, W. Kozminski, A. Piai, R. Pierattelli &
;   A. Zawadzka-Kazimierczuk, J. Biomol. NMR 57, 353-361 (2013)
; 
;$CLASS=HighRes 
;$DIM=5D 
;$TYPE= 
;$SUBTYPE= 
;$COMMENT= 


prosol relations=<triple_c> 


#include <Avance.incl> 
#include <Grad.incl> 
#include <Delay.incl> 


"p4=p3*2" 
"p22=p21*2" 
"d11=30m" 
"d12=20u" 

"d22=4.5m" 
"d23=12.4m" 
"d24=12m" 
"d26=2.7m" 
"d27=16m" 
"d28=14m" 


"d31=3u"
"d32=3u"
"d33=3u"
"d34=3u"
"d52=3u"
"d53=3u"
"d42=d23+d52+p12/2"
"d43=d28-p12+d53+p22/2-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"
"in34=inf4/2"

"FACTOR2=d42*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in32 ) { in42 = in32; } else { in42 = INCR2; }"
"if ( INCR2 > in32 ) { in52 = 0; } else { in52=in32-INCR2; }"

"FACTOR3=d43*10000000*2/td3"
"INCR3=FACTOR3/10000000"

"if ( INCR3 > in33 ) { in43 = in33; } else { in43 = INCR3; }"
"if ( INCR3 > in33 ) { in53 = 0; } else { in53=in33-INCR3; }"


"DELTA1=p4+p22-p21"
"DELTA2=d26-p4/2"
"DELTA3=d26+p4/2"
"DELTA4=d31*2+larger(p12,p22)-p12"
"DELTA5=d24-d32-p44-p12/2"
"DELTA6=d23-d24-p12"
"DELTA7=d22-d33-p44-p12/2"
"DELTA8=d28-d22-p12/2-p22/2"
"DELTA9=d27-d22-p12"
"DELTA10=d34*2+larger(p4,p8)"
"DELTA11=d27/2-p12"
"DELTA12=d27-d22-p12"


"l0=1"


"spoffs13=bf1*((cnst22/2-cnst21/2)/1000000)"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs29=bf1*((cnst23-cnst22)/1000000)"


"o1_F1=bf1*cnst21/1000000"
"o1_F3=bf1*cnst22/1000000"


1 ze 
  d11 pl16:f3
2 d11 do:f3
3 d1 fq=cnst21(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD 
 
  (p3 ph9):f2
  d26
  (center (p4 ph2):f2 (p22 ph1):f3) 
  d26
  (p3 ph2):f2

  DELTA1

  (p21 ph1):f3
  DELTA2
  (p4 ph2):f2
  (p22 ph1):f3
  DELTA3
  (p3 ph10):f2 (p21 ph2):f3

  4u 
  p16:gp1
  d16

  (p21 ph1):f3
  d24
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d24
  (p21 ph2):f3

  4u 
  p16:gp2
  d16

  (p11:sp23 ph8)
  d31
  (center (p12:sp27 ph1) (p22 ph1):f3 )
  d31
  4u 
  (p12:sp24 ph1)
  DELTA4
  (p12:sp27 ph1)
  4u 
  (p11:sp25 ph1)

  4u 
  p16:gp3
  d16 fq=cnst22(bf ppm):f1

  (p44:sp3 ph6):f2
  (p21 ph5):f3
  d32
  (p44:sp3 ph1):f2
  DELTA5
  (p12:sp26 ph1) 
  DELTA6
  (p12:sp29 ph1)
  d52
  (p22 ph1):f3
  d42
  (p21 ph1):f3

  4u 
  p16:gp4
  d16

  (p44:sp3 ph6):f2
  (p11:sp23 ph4) 
  d33
  (p44:sp3 ph1):f2
  DELTA7
  (p12:sp26 ph1) 
  DELTA8
  (p22 ph1):f3
  d53
  (p12:sp29 ph1) 
  d43
  (p12:sp26 ph1) 
  4u 
  (p11:sp25 ph1) 

  4u 
  p16:gp5
  d16 fq=cnst21(bf ppm):f1
 
  (p11:sp23 ph1) 
  d22
  (p12:sp27 ph1) 
  DELTA9
  (center (p12:sp24 ph1) (p22 ph1):f3 ) 
  d27 
  (p11:sp25 ph1) 

  4u
  p16:gp6
  d16 pl2:f2

  (p21 ph3):f3
  d34
  (center (p8:sp13 ph1) (p4 ph1):f2 ) 
  d34
  (p22 ph1):f3
  DELTA10 
  (p21 ph1):f3

  if "l0 %2 == 1" 
     { 
     (p11:sp23 ph1) 
     DELTA11
     (p12:sp27 ph1) 
     DELTA11
     (center (p12:sp24 ph1) (p22 ph1):f3 ) 
     DELTA11
     (p12:sp27 ph1) 
     DELTA11 pl16:f3
     } 
  else 
     { 
     (p11:sp23 ph7) 
     d22
     (p12:sp27 ph1) 
     DELTA12
     (center (p12:sp24 ph1) (p22 ph1):f3 ) 
     DELTA11
     DELTA11 pl16:f3
     (p12:sp27 ph1) 
     } 

  4u BLKGRAD 
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2

#   ifdef LABEL_F1
     F1I(iu0, 2)
#   else

#   ifdef LABEL_F2
     F2I(iu0, 2)
#   else

#   ifdef LABEL_F3
     F3I(iu0, 2)
#   else
     F4I(iu0, 2)
#   endif /*LABEL_F3*/

#   endif /*LABEL_F2*/

#   endif /*LABEL_F1*/

     F1PH(calph(ph8, +90), caldel(d31, +in31))
     F2PH(calph(ph5, +90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
     F3PH(calph(ph4, +90), caldel(d33, +in33) & caldel(d43, -in43) & caldel(d53, +in53))
     F4PH(calph(ph3, +90), caldel(d34, +in34))
exit


ph1=0
ph2=1
ph3=0 0 0 0 2 2 2 2
ph4=0 0 2 2
ph5=0 2
ph6=2
ph7=3
ph8=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph9=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph10=2 2 2 2 2 2 2 2 0 0 0 0 0 0 0 0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp3 : f2 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp29: f1 channel - shaped pulse 180 degree  (Cali off resonance)
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p44: f2 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCa)                                       [12.4 msec]
;d24: 1/(4J'(NCO)                                      [12 msec]
;d26: 1/(4J'(NH)                                       [2.7 msec]
;d27: 1/(4J(NCO))                                      [16.0 msec]
;d28: 1/(2J(CaCb))                                     [14.0 msec]
;d31: incremented delay (F1 in 5D)                     [3 usec]
;d32: incremented delay (F2 in 5D)                     [3 usec]
;d33: incremented delay (F3 in 5D)                     [3 usec]
;d34: incremented delay (F4 in 5D)                     [3 usec]
;d42: decremented delay (F2 in 5D) = d23+d52+p12/2
;d43: decremented delay (F3 in 5D) = d28-p12+d53+p22/2-4u
;d52: incremented delay (F2 in 5D)                     [3 usec]
;d53: incremented delay (F3 in 5D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;inf3: 1/SW(Ca) = 2 * DW(Ca)
;inf4: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(CO)) =  DW(CO)
;nd31: 2
;in32: 1/(2 * SW(N)) =  DW(N)
;nd32: 2
;in33: 1/(2 * SW(Ca)) =  DW(Ca)
;nd33: 2
;in34: 1/(2 * SW(N)) =  DW(N)
;nd34: 2
;in42: = k2 * in32
;in43: = k3 * in33
;in52: = (1 - k2) * in32
;in53: = (1 - k3) * in33
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;td4: number of experiments in F4 * 2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;FnMODE: States-TPPI (or TPPI) in F4
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients: 
;gpz1: 50% 
;gpz2: 30% 
;gpz3: 60% 
;gpz4: 40% 
;gpz5: 23% 
;gpz6: 17% 

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



                                           ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
;LABEL_F2: to do ipap in F2 start experiment with
;             option -DLABEL_F2 (eda: ZGOPTNS)
;LABEL_F3: to do ipap in F3 start experiment with
;             option -DLABEL_F3 (eda: ZGOPTNS)
                                           ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] to process data



