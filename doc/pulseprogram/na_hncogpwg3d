;na_hncogpwg3d
;avance-version (22/12/10)
;HNCO for nucleic acids: G (H1-N1-C2/C6) 
;  and U/T (H3-N3-C2/C4) correlations
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O,t1) -> F3(N,t2) -> F1(H,t3)
;
;on resonance C=O pulses using shaped pulse
;using constant time in t2
;water suppression using watergate sequence
;(use parameterset NA_HNCOGPWG3D)
;
;
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

"p14=bwfac3/(bf2*cnst8*0.000001)"
"spw3=plw2/(((p14*90.0)/(p3*totrot3))*((p14*90.0)/(p3*totrot3))*(integfac3*integfac3))"
"spoal3=0.5"
"spoffs3=0"


"p2=p1*2"
"p4=p3*2"
"p22=p21*2"

"d11=30m"
"d13=4u"
"d26=2.3m"
"d21=5.4m"
"d10=d23-p26-d21-4u"
"d30=d23"

"in0=inf1"
"in10=inf2/2"
"d0=in0/2-p3*4/PI"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"

"DELTA=d0*2+p22"
"DELTA1=d23-d21-p26"
"DELTA2=d26-p16-d16-p11-12u-(p1*2)/PI"
"DELTA3=d26-p16-d16-p11-12u-de"


aqseq 321
"acqt0=0"
baseopt_echo

1 d11 ze
  d11 pl16:f3 
2 d11 do:f3
3 d1 pl1:f1
  p1 ph1
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph3):f3
  d21 pl19:f1
  (p26 ph2):f1
  DELTA1 cpds1:f1 ph1
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23 pl2:f2
  (p21 ph1):f3

  (center(p3 ph4 d0 p3 ph1):f2 (p22 ph1):f3)

  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph5):f3
  d30
  (center (p14:sp3 ph1):f2 (p22 ph8):f3 )
  d10
  4u do:f1
  (p26 ph7):f1
  d21
  (p21 ph1):f3

  p16:gp3
  d16 pl0:f1
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA2 pl0:f1
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph6):f1
  4u
  DELTA3
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d0, +in0)) 
     F2PH(calph(ph5, -90), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=2
ph7=3
ph8=0 
ph9=0 
ph31=0 2 2 0 2 0 0 2

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p14: f2 channel - shaped pulse 180 degree  (C=O sel. on resonance)
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [inf1/2]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d13: short delay                                      [4 usec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.4 msec]
;d23: 1/(4J(NCO)                                       [8 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d10: incremented delay (F2 in 3D)
;d30: decremented delay (F2 in 3D) = d23
;cnst8: Bandwith for C=O selective 180 pulse p14 (in ppm) [40]
;o2p: CO chemical shift 
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in10: 1/(2 * SW(N)) = (1/2) DW(N)
;nd10: 2
;in30: = in10
;ns: 4 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4
;                         50 :   40 :   60 :   30

;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



