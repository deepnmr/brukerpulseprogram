;hmqcnoesytrosynngp4d
;avance-version (21/09/15)
;(N15)HSQC-NOESY-(N15)TROSY
;4D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange.
;   H-1/X correlation via heteronuclear zero and double quantum coherence
;      using sensitivity improvement
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive using Echo/Antiecho (t3)
;water suppression using watergate sequence
;using shaped pulses for inversion on f2 - channel
;spectrum shifted in F2 by linear phase ramp (cnst63)
;(use parameterset )
;
;(M. Czisch & R. Boelens, J. Magn. Reson. 134, 158-160 (1998) )
;(K. Pervushin, G. Wider & K. Wuethrich, J. Biomol. NMR 12,
;   345-348 (1998) )
;(A. Meissner, T. Schulte-Herbrueggen, J. Briand & O.W. Sorensen, Mol. Phys. 96,
;   1137-1142 (1998) )
;(J. Weigelt, J. Am. Chem. Soc. 120, 10778-10779 (1998) )
;(M. Rance, J.P. Loria & A.G. Palmer III, J. Magn. Reson. 136, 91-101 (1999) )
;(G. Zhu, X.M. Kong & K.H. Sze, J. Biomol. NMR 13, 77-81 (1999) )
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=1s/(cnst4*2)"
"d26=1s/(cnst4*4)"

"p30=250u"


"in31=inf1"
"in32=inf2/2"
"in33=inf3"

"d31=in31/2-p21*4/PI"
"d32=3u"
"d33=in33/2-p21*4/PI"


"DELTA1=d32+larger(p22,p35)/2-p22/2"
"DELTA2=d21-p16-d16"
"DELTA3=d26-p11-p19-d16-p56/2-4u"
"DELTA4=d26-p11-p30-d16-p57/2-4u"
"DELTA5=d26-p16-d16-larger((p11*2+p2+8u),p57)/2"
"DELTA6=d26-p16-d16-larger((p11*2+p2+8u),p57)/2-4u-de-p1*2/PI"

"TAU=d8-p16-d16-p29-2u"


"l0=0"


"spoffs41=bf2*(cnst26/1000000)-o2"


"cnst62=-((bf1*cnst19)-(o1*1000000))"
"cnst63=-(cnst62*inf2/1000000)*360.0"


"TAU9=abs(cnst62+cnst63)/100000"


"o1_F1=bf1*cnst19/1000000"


"acqt0=0"
baseopt_echo


1 ze
2 d11
  d1 pl1:f1 pl3:f3 
  50u UNBLKGRAD

  (p11:sp1 ph3)
  2u  
  2u pl1:f1
  (p1 ph1)
  DELTA1
  (p22 ph1):f3
  DELTA1
  p16:gp5
  d16 
  (
   refalign (DELTA2 p21 ph8 d31 p21 ph1 DELTA2):f3
   center (p11:sp1 ph3 2u 2u pl1 p2 ph1 4u p11:sp1 ph3):f1
   center (p35:sp41 ph1):f2
  )
  p16:gp5
  d16 pl1:f1

  d32 
  (center (p35:sp41 ph1):f2 (p22 ph1):f3 )
  d32 
  (p1 ph9)

  2u  
  (p29:sp11 ph10)
  TAU 
  p16:gp6
  d16 pl1:f1

  (p1 ph1):f1
  4u
  (p11:sp1 ph3:r):f1
  p19:gp1
  d16 pl1:f1
  DELTA3
  (center (p2 ph2):f1 (p56:sp39 ph1):f3) 
  DELTA3
  p19:gp1
  d16
  (p11:sp1 ph4:r):f1
  4u pl1:f1 pl3:f3
  (p1 ph4):f1

  p19:gp2
  d16

#   ifdef LABEL_CN

  "TAU3=larger((d33/2-p35/2),0)"

  if "l0 %2 == 1"
     {
     (ralign (p35:sp41 ph1 TAU3):f2 (p21 ph5 d33):f3)
     }
  else
     {
     (ralign (p35:sp41 ph1 TAU3):f2 (p21 ph6 d33):f3)
     }

#   else

  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     d33
     }
  else
     {
     (p21 ph6):f3
     d33
     }

#   endif /*LABEL_CN*/

  (p1 ph7):f1
  4u
  (p11:sp1 ph17:r):f1
  p30:gp3
  d16 pl1:f1
  DELTA4
  (center(p2 ph1):f1 (p57:sp40 ph1):f3)
  DELTA4
  p30:gp3
  d16
  (p11:sp1 ph1:r):f1  
  4u pl1:f1 pl3:f3
  (lalign (p1 ph1):f1 (p21 ph7):f3)
  DELTA5
  p16:gp4
  d16
  (center (p11:sp1 ph3:r 4u pl1 p2 ph1 4u p11:sp1 ph3:r):f1 (p57:sp40 ph1):f3)
  p16:gp4
  d16 pl3:f3
  4u BLKGRAD
  DELTA6
  (p21 ph1):f3
  go=2 ph31 
  d11 mc #0 to 2 
     F1PH(calph(ph8, +90), caldel(d31, +in31))
     F2PH(calph(ph9, -90) & calph(ph10, -90), caldel(d32, +in32) & calph(ph9, -cnst63) & calph(ph10, -cnst63))
     F3EA(calph(ph7, +180) & calph(ph17, +180) & calclc(l0, 1), caldel(d33, +in33) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))

TAU9
exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=1 2 3 0
ph6=1 0 3 2
ph7=1
ph8=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph9=0 0 0 0 2 2 2 2
ph10=2 2 2 2 0 0 0 0
ph17=3
ph31=1 2 3 0 3 0 1 2 3 0 1 2 1 2 3 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse
;sp11: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;sp41: f2 channel - shaped pulse 180 degree (Bip720,100,10.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: f1 channel -  90 degree shaped pulse (flipback pulse)
;p30: gradient pulse 3                                 [250 usec]
;p35: f2 channel - 180 degree shaped pulse
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1            (500us at 600.13 MHz)
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.6ms at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH))
;d26: 1/(4J)YH
;d31: incremented delay (F1 in 4D) = in31/2-p21*4/PI
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D) = in33/2-p21*4/PI
;cnst4: = J(YH)
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;cnst62: offset for H(N) region (Hz)
;cnst63: additional phase increment to center H(N) region
;inf1: 1/SW(N) = 2 * DW(N)
;inf2: 1/SW(H) = 2 * DW(H)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(N)) = DW(N)
;in32: 1/(SW(H)) = 2 * DW(H)
;in33: 1/(2 * SW(N)) = DW(N)
;nd31: 1
;nd32: 2
;nd33: 1
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: echo-antiecho in F3


;for z-only gradients:
;gpz1: 19%
;gpz2: 47%
;gpz3: 65%
;gpz4: 80%
;gpz5: 31% 
;gpz6: 71%

;use gradient files:
;gpnam1: SMSQ10.50
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100


;Processing F1 and F3

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1


