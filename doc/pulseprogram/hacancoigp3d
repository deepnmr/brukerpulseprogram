;hacancoigp3d
;avance-version (21/09/15)
;intra-(HCa)CO(Ca)N(Ca)H = intra-H(Ca)NCO (b)
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F2(Ca) -> F2(C=O,t1) -> F2(Ca)
;            -> F3(N,t2) -> F2(Ca) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;using constant time in t1
;(use parameterset )
;
;S. Maentylahti, O. Aitio, M. Hellman & P. Permi,
;   J. Biomol. NMR 47, 171-181 (2010)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d4=1.7m"
"d22=4.5m"
"d23=16.6m"
"d24=14m"
"d27=28.6m"

#   ifdef LABEL_NOGLY
"d3=3.4m"
#   else
"d3=2.2m"
#   endif /*LABEL_NOGLY*/


"d0=3u"
"d10=3u"
"d20=d23-p14+d0-4u"
"d28=d27-d23"

"in0=inf1/2"
"in10=inf2/2"

"in20=in0"
"in28=in0"

"td1=tdmax(td1,d28*2,in28)"


"DELTA=d10*2+p8"
"DELTA1=p16+d16+8u" 
"DELTA2=d22*2-d3-p26*2"
"DELTA3=d27-d23-d22*2+p14-d0+4u"
"DELTA5=d24-d3-p26-4u"
"DELTA6=d3-p16-d16"
"DELTA7=d4-p19-d16"
"DELTA8=d4-larger(p2,p24)/2"

"TAU=p13-p1"


"spoffs2=0"
"spoffs3=0"
"spoffs4=bf2*((cnst22-cnst21)/1000000)"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs6=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"
"spoffs9=bf2*((cnst22-cnst21)/1000000)"
"spoffs13=bf2*((cnst26-cnst22)/1000000)"


"o1_F1=bf2*cnst21/1000000"


aqseq 321


1 d11 ze
  d11 pl14:f2 pl3:f3
2 d11 do:f2
3 d1 pl1:f1 fq=cnst21(bf ppm):f2

  (p1 ph1)
  DELTA8
  (center (p2 ph1) (p24:sp9 ph1):f2 )
  DELTA8 UNBLKGRAD
  (p1 ph2):f1 
  
  p16:gp8
  d16

  (p13:sp4 ph5):f2
  d3 pl19:f1
  (p26 ph1):f1
  (p26 ph2):f1
  DELTA2 cpds1:f1 ph1

  (p13:sp2 ph6):f2
  d20
  (p14:sp5 ph1):f2
  4u
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  d0
  (p13:sp8 ph10:r):f2

  d28
  (p14:sp5 ph1):f2
  DELTA3
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d0
  4u
  (p13:sp6 ph2):f2

  4u do:f1
  (p26 ph4):f1

  p16:gp3
  d16 fq=cnst22(bf ppm):f2

  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p21 ph7):f3
  d10
  (p8:sp13 ph1):f2
  d10
  (p22 ph1):f3
  DELTA
  (p21 ph1):f3

  4u do:f1
  (p26 ph4):f1

  p16:gp4
  d16

  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p13:sp2 ph8):f2
  d24
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA5
  4u do:f1
  (p26 ph4):f1
  DELTA6
  p16:gp1*EA
  d16 pl1:f1

  (ralign (p1 ph1) (p13:sp8 ph1):f2 )
  p19:gp5
  d16
  DELTA7
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA7
  p19:gp5
  d16
  (lalign (p1 ph2) (p13:sp2 ph9):f2 )
  p19:gp6
  d16
  DELTA7
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA7
  p19:gp6
  d16
  TAU
  (p1 ph1)
  DELTA1
  (p2 ph1)
  4u
  p16:gp2
  d16 pl14:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph6, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, -in28)) 
     F2PH(calph(ph7, +90), caldel(d10, +in10))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 2 2 2 2
ph6=0 0 2 2
ph7=0 2
ph8=0
ph9=3
ph10=1
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl14: f2 channel - power level for low power decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp4: f2 channel - shaped pulse  90 degree  (Ca off resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp6: f2 channel - shaped pulse  90 degree  (Ca off resonance)
;                  for time reversed pulse
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp9: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;     sp9 requires higher selectivity - refocussing Calpha only
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (Ca, selective)
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(3J(CH))                                       [2.2 msec]
;     or 1/(2J(CH))                                    [3.3 msec]
;d4 : 1/(4J(CH))                                       [1.7 msec]
;d10: incremented delay (F2 in 3D) =  d23/2-p14/2
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d23-p14+d0-4u
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCO))                                      [16.6 msec]
;d24: 1/(4J(NCa))                                      [14.0 msec]
;d27: 1/(J(CaCb)                                       [28.6 msec]
;d29 : incremented delay (F1 in 3D) = d27-d23
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = in0
;in28: = in0
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 20.1%
;gpz3: 40%
;gpz4: 40%
;gpz5: 40%
;gpz6: 5%
;gpz7: 2%
;gpz8: 40%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_NOGLY: for spectrum without Gly cross peaks start experiment with
;              option -DLABEL_NOGLY (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



