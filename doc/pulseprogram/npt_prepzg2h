;$Id:$
;1D sequence for 2D dataset
;using 2H lockswitch unit or BSMS 2H-TX board
;H2_PULSE is executed prior to go-statement
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include<Avance.incl>
#include<Sysconf.incl>

"d11=30m"
"d12=100u"

1 ze
  d11 LOCKDEC_ON
  d11 H2_PULSE
2 d11
  d11 H2_LOCK
  d1
  d11 H2_PULSE
  d12
  p1:D ph1
  d12 H2_LOCK
  go=2 ph31
  d11 mc #0 to 2 F1QF()
  d11 H2_LOCK
  d11 LOCKDEC_OFF
exit

ph1=0 2 2 0 1 3 3 1
ph2=0 2 2 0 1 3 3 1
ph3=2 0 0 2 3 1 1 3
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d20: delay for recovery of H-2 signal after lock steady state
;        set according to solvent T1
;NS: 1 * n, total number of scans: NS * TD0

;locnuc: off
