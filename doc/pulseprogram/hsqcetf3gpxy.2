;hsqcetf3gpxy.2
;avance-version (12/01/11)
;HSQC
;2D H-1/X correlation
;   using XY16-CPMG for transfer
;   for minimum saturation transfer with water
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using f3 - channel
;
;F.A.A. Mulder, C.A.E.M. Spronk, M. Slijper, R. Kaptein &
;   R. Boelens, J. Biomol. NMR 8, 223-228 (1996)
;(Davis et al., J. Magn. Reson. 98, 207 - (1992))
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"


"d0=3u"

"in0=inf1/2"


"DELTA1=(d26*2/16-p22)/2"
"DELTA2=p16+d16+4u"

#   ifdef LABEL_CN
"DELTA=larger(p2,p14)+d0*2"
#   else
"DELTA=p2+d0*2"
#   endif /*LABEL_CN*/


1 ze
  d11 pl16:f3
2 d1 do:f3
3 50u pl3:f3 UNBLKGRAD
  20u rpp6
  20u rpp16

  (p1 ph1)

4 DELTA1
  (center (p2 ph6) (p22 ph16):f3 )
  DELTA1 ipp6 ipp16
  lo to 4 times 16

  (p1 ph2) 

  p16:gp1
  d16

  (p21 ph3):f3
  d0 

#   ifdef LABEL_CN
  (center (p2 ph5) (p14:sp3 ph1):f2 )
#   else
  (p2 ph5)
#   endif /*LABEL_CN*/

  d0
  p16:gp2*EA
  d16
  (p22 ph4):f3
  p16:gp2*EA*-1
  d16
  DELTA
  (p21 ph4):f3

  p16:gp1
  d16

  (p1 ph1)

5 DELTA1
  (center (p2 ph6) (p22 ph16):f3 )
  DELTA1 ipp6 ipp16
  lo to 5 times 16

  DELTA2
  (p2 ph7)
  p16:gp3
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d1 do:f3 mc #0 to 2 
     F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph3, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=1 1 3 3
ph6=0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2
ph7=3
ph16=0 1 0 1 1 0 1 0 2 3 2 3 3 2 3 2
ph31=0 2 0 2 2 0 2 0
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(YH))
;cnst4: = J(YH)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 1 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:	gp 1 : gp 2 : gp 3
;			  30 :   80 : 40.2     for C-13
;			  30 :   80 : 16.2     for N-15

;for z-only gradients:
;gpz1: 30%
;gpz2: 80%
;gpz3: 16.2% for N-15, 40.2% for C-13

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



