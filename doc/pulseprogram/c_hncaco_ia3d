;c_hncaco_ia3d
;avance-version (21/09/15)
;HNCaCO
;3D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(H) -> F3(N,t1) -> F1(Ca,t2) -> F1(C=O,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using constant time in t1
;using constant time in t2
;using IPAP scheme for virtual decoupling
;(use parameterset C_HNCACO_IA3D)
;
;W. Bermel, I. Bertini,L. Duma, I.C. Felli, L. Emsley,  R. Pierattelli,
;   P.R. Vasos, Angew. Chem. Int. Ed. 44, 3089-3092 (2005)
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d21=5.5m"
"d22=4.5m"
"d23=12.4m"
"d26=2.3m"


"d10=3u"
"d0=d23/2-p12/2"
"d20=d23/2-p12/2"
"d28=d23/2-p12/2-p26-d21-4u"
"d30=d23-p12-4u"

"in0=inf1/4"
"in10=inf2/2"

"in20=in0"
"in28=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d23-d22-d10-p12"


"l0=1"


"spoffs11=0"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs28=0"


"o1_F2=bf1*cnst22/1000000"


aqseq 312


1 ze
  d11 pl12:f2 pl16:f3 
2 d11 do:f2 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl2:f2 pl3:f3 
  50u UNBLKGRAD

  (p3 ph1):f2
  d26
  (center (p4 ph1):f2 (p22 ph1):f3 )
  d26
  (p3 ph2):f2 

  4u pl0:f2
  (p29:sp11 ph1:r):f2
  4u
  p16:gp1
  d16 pl12:f2

  (p21 ph3):f3
  d21
  (p26 ph2):f2
  4u cpds2:f2 ph1
  d28
  (p12:sp26 ph1)
  d0
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d20
  (p12:sp26 ph1)
  d20
  (p21 ph1):f3

  4u do:f2
  (p26 ph7):f2
  4u
  p16:gp2
  d16
  (p26 ph2):f2
  20u cpds2:f2 ph1


  (p11:sp23 ph4)
  d10
  d22
  (p12:sp26 ph1)
  DELTA1
  (center (p25:sp28 ph1) (p22 ph8):f3 )
  d30
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph1)

  4u do:f2
  (p26 ph7):f2
  4u
  p16:gp3
  d16 fq=cnst21(bf ppm):f1
  (p26 ph2):f2
  20u cpds2:f2 ph1
  20u pl16:f3

  if "l0 %2 == 1"
     {
     (p11:sp23 ph5)
     4u
     (p12:sp27 ph1)
     d22
     (p12:sp24 ph1)
     4u
     (p12:sp27 ph1)
     d22
     }
  else
     {
     (p11:sp23 ph6)
     4u
     d22*0.5
     (p12:sp27 ph1)
     d22*0.5
     (p12:sp24 ph1)
     4u
     d22*0.5
     (p12:sp27 ph1)
     d22*0.5
     }

  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f2 do:f3 mc #0 to 2 
     F1I(iu0, 2)
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=3 3 3 3 1 1 1 1
ph7=3
ph8=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 2 0 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp11: f2 channel - shaped pulse  90 degree
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;p26: f2 channel -  90 degree pulse at pl12
;p29: f2 channel -  90 degree shaped pulse (water flipback)
;d0 : incremented delay (F1 in 3D) = d23/2-p12/2
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d23/2-p12/2
;d21: 1/(2J(NH))                                       [5.5 msec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCa))                                      [12.4 msec]
;d26: 1/(4J(NH))                                       [2.3 msec]
;d28: incremented delay (F1 in 3D) = d23/2-p12/2-p26-d21-4u
;d30: decremented delay (F2 in 3D) = d23-p12-4u
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(N) = 2 * DW(N)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;in0: 1/(2 * SW(N)) = (1/2) DW(N)
;nd0: 4
;in10: 1/(2 * SW(Ca)) =  DW(Ca)
;nd10: 2
;in20: = in0
;in28: = in0
;in30: = in10
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1 * 2
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1   td1 max = 4 * d20 / in20
;FnMODE: States-TPPI (or TPPI) in F2   td2 max = 2 * d30 / in30
;cpds2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3
;                         50 :   30 :   19

;for z-only gradients:
;gpz1: 50%
;gpz2: 30%
;gpz3: 19%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



;use AU-program splitcomb [ipap 2] (F1) to process data



