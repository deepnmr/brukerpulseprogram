;dipsihsqcf3gpwg3d
;avance-version (21/09/15)
;TOCSY-HSQC
;3D sequence with
;   homonuclear Hartman-Hahn transfer using DIPSI2 sequence
;      for mixing
;   H-1/X correlation via double inept transfer
;      using sensitivity improvement
;phase sensitive (t1)
;phase sensitive (t2)
;(use parameterset )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"

"p30=3m"
"p31=5m"


"d0=3u"
"d10=3u"

"in0=inf1/2"
"in10=inf2/2"


"DELTA2=d26-p11-p16-d16"

#   ifdef LABEL_CN
"DELTA=d10*2+larger(p2,p8)"
"DELTA1=d0*2+larger(p8,p22)"
#   else
"DELTA=d10*2+p2"
"DELTA1=d0*2+p22"
#   endif /*LABEL_CN*/


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"

"d31=(p6*115.112)*l1"


"spoffs13=0"


aqseq 321


  ze
2 d11 do:f3
  d1
  50u UNBLKGRAD
  10u pl1:f1 pl3:f3

  (p1 ph3):f1
  DELTA1
  (p2 ph4)
  d0

#   ifdef LABEL_CN
  (center (p8:sp13 ph1):f2 (p22 ph1):f3 )
#   else
  (p22 ph1):f3
#   endif /*LABEL_CN*/

  d0
  (p1 ph1):f1

  p16:gp7
  d16 pl10:f1

4 p6*3.5556 ph23 
  p6*4.5556 ph25
  p6*3.2222 ph23
  p6*3.1667 ph25
  p6*0.3333 ph23
  p6*2.7222 ph25
  p6*4.1667 ph23
  p6*2.9444 ph25
  p6*4.1111 ph23

  p6*3.5556 ph25
  p6*4.5556 ph23
  p6*3.2222 ph25
  p6*3.1667 ph23
  p6*0.3333 ph25
  p6*2.7222 ph23
  p6*4.1667 ph25
  p6*2.9444 ph23
  p6*4.1111 ph25

  p6*3.5556 ph25
  p6*4.5556 ph23
  p6*3.2222 ph25
  p6*3.1667 ph23
  p6*0.3333 ph25
  p6*2.7222 ph23
  p6*4.1667 ph25
  p6*2.9444 ph23
  p6*4.1111 ph25
  
  p6*3.5556 ph23
  p6*4.5556 ph25
  p6*3.2222 ph23
  p6*3.1667 ph25
  p6*0.3333 ph23
  p6*2.7222 ph25
  p6*4.1667 ph23
  p6*2.9444 ph25
  p6*4.1111 ph23
  lo to 4 times l1

  2u
  p31:gp3	
  d16 pl1:f1

  (p1 ph1):f1
  d26
  (center (p2 ph2):f1 (p22 ph1):f3 )
  d26
  (p1 ph2):f1

  2u
  p30:gp4
  d16 
  
  (p21 ph5):f3
  d10

#   ifdef LABEL_CN
  (center (p2 ph1) (p8:sp13 ph1):f2 )
#   else
  (p2 ph1)
#   endif /*LABEL_CN*/

  d10
  (p22 ph7):f3
  DELTA
  (p21 ph7):f3

  2u
  p16:gp5	
  d16

  (p1 ph1):f1
  4u
  p16:gp6	
  d16
  DELTA2
  (p11:sp1 ph6:r):f1
  2u
  2u pl1:f1
  (center (p2 ph1):f1 (p22 ph1):f3 )
  4u
  (p11:sp1 ph6:r):f1
  DELTA2
  p16:gp6
  d16 pl16:f3
  4u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2
     F1PH(calph(ph3, +90) & calph(ph4, +90), caldel(d0, +in0))
     F2PH(calph(ph5, +90), caldel(d10, +in10))
exit


ph1=0
ph2=1
ph3=0 2
ph4=1 3
ph5=0 0 2 2
ph6=2
ph7=0 0 0 0 2 2 2 2
ph23=0
ph25=2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: gradient pulse 4                                 [3 msec]
;p31: gradient pulse 5                                 [5 msec]
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(NH))
;d31: length of DIPSI-3 cycle as executed = (p6*115.112)*l1
;cnst4: = J(NH)
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(H)) = DW(H)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz3: -50%
;gpz4: 40%
;gpz5: -60%
;gpz6: 11%
;gpz7: 31%

;use gradient files:   
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



