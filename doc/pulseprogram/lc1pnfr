;lc1pnfr
;avance-version (12/01/11)
;1D version of noesyprph using presaturation during relaxation delay 
;   and mixing time
;multiple offset presaturation using frequency list
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>
#include <Delay.incl>


define list<frequency> presatlist=<$FQ2LIST>

define loopcounter LCYCLE1
define loopcounter LCYCLE2


"d12=20u"
"d13=4u"


"FACTOR1=d1/(5m*l8)"
"LCYCLE1=FACTOR1*l8"
"FACTOR1=d8/(5m*l8)"
"LCYCLE2=FACTOR1*l8"


"acqt0=-p1*2/3.1416"


1 ze
2 d12 pl9:f1
3 30m
  d12 presatlist:f1
  d12 presatlist.inc
  5m cw:f1 ph29
  d13 do:f1 
  lo to 3 times LCYCLE1
  d12 pl1:f1
  p1 ph1
  d13
  p1 ph2
  d12 pl9:f1
4 d12 presatlist:f1
  d12 presatlist.inc
  5m cw:f1
  d13 do:f1
  lo to 4 times LCYCLE2
  d12 pl1:f1
  p1 ph3
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1                  [ca. 1-2sec]
;d8 : mixing time                                [ca. 80 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;l8: number of entries in FQ1LIST
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4

;define FQ1LIST (list has to be stored in "/u/exp/stan/nmr/lists/f1")
;   for presaturation frequencies



