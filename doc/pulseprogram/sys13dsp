;sys13dsp
;avance-version (00/08/16)
;2D sequence
;13 degree test using shaped pulses
;
;G.A. Morris, J. Magn. Reson. 78, 281 (1988)
;
;$CLASS=HighRes HWT
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$HIDE=y


#include <Avance.incl>
#include <Delay.incl>


"DELTA=d20-4u"


1 ze
2 d1
3 d12
  d12 pl0:f1
  p11:sp1:f1 ph1
  4u
  DELTA pl0:f1
  p11:sp1:f1 ph2
  go=2 ph31
  d1 wr #0 if #0 zd
  lo to 3 times td1
exit


ph1=0
ph2=0
ph31=0



