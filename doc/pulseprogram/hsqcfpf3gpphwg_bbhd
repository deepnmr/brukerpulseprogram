;hsqcfpf3gpphwg_bbhd
;avance-version (16/11/30)
;reset-HSQC
;2D H-1/X correlation via double inept transfer
;phase sensitive
;with decoupling during acquisition
;using f3 - channel
;using flip-back pulse
;water suppression using watergate sequence
;similar to fhsqc 
;using 1H broadband homodecoupling during acquisition with [BIRD]d element
;NH2 groups may be left as doubletts with 2J(HH) spliting
;(use parameterset )
;
;L. Paudel, R.W. Adams, P. Kiraly, J.A. Aguilar, M. Foroozandeh,
;   M.J. Cliff, M. Nilsson, P. Sandor, J.P. Waltho & G.A. Morris,
;   Angew. Chem. 125, 11830-11833 (2013)
;(P. Sakhaii, B. Haase & W. Bermel, J. Magn. Reson. 199, 192-198 (2009))
;G. Bodenhausen & D.J. Ruben, Chem. Phys. Lett. 69, 185 (1980)
;M. Piotto, V. Saudek & V. Sklenar, J. Biomol. NMR 2, 661 - 666 (1992)
;V. Sklenar, M. Piotto, R. Leppik & V. Saudek, J. Magn. Reson.,
;   Series A 102, 241 -245 (1993)
;S. Mori, C. Abeygunawardana, M. O'Neil-Johnson & P.C.M. van Zijl,
;   J. Magn. Reson. B 108, 94-98 (1995)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>

  
#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"
"d21=1s/(cnst4*2)"
"d26=1s/(cnst4*4)"

"p29=300u"


"d0=3u"

"in0=inf1/2"


"d62=aq/l0"
"d63=d62/2"


"l1=l0-1"


"DELTA1=d26-p16-d16"
"DELTA2=d26-p16-d16-p11-p1*2/PI-12u"
"DELTA3=d26-p16-d16-p11-de-12u"
"DELTA4=d21-larger(p2,p22)/2"

#   ifdef LABEL_CN
"DELTA=d0*2+larger(p2,p8)"
#   else
"DELTA=d0*2+p2"
#   endif /*LABEL_CN*/

"TAU=p22"


"acqt0=0"
baseopt_echo


1 ze 
  d11 pl16:f3
2 d11 do:f3
  4u BLKGRAD
  4u pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  4u pl1:f1 pl3:f3
  50u UNBLKGRAD

  (p1 ph1)
  p16:gp3
  d16
  DELTA1
  (center (p2 ph2) (p22 ph6):f3 )
  DELTA1
  p16:gp3
  d16
  (p1 ph2) 

  4u
  (p11:sp1 ph8:r):f1
  4u
  p16:gp4
  d16 pl1:f1

  (p21 ph3):f3
  d0

#   ifdef LABEL_CN
  (center (p2 ph5) (p8:sp13 ph1):f2 )
#   else
  (p2 ph5)
#   endif /*LABEL_CN*/

  d0
  (p22 ph4):f3
  DELTA
  (p21 ph4):f3

  4u
  p16:gp4
  d16
  (p11:sp1 ph7:r):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp5
  d16
  DELTA2
  (p11:sp1 ph7:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph7:r):f1
  4u
  p16:gp5
  d16
  DELTA3 pl1:f1 pl16:f3

  4u cpd3:f3
  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d63
  0.05u DWELL_HOLD
  0.1u REC_BLK

  10u do:f3
  p29:gp6
  d16 pl3:f3
  TAU
  (p1 ph1)
  DELTA4
  4u
  (center (p2 ph2) (p22 ph1):f3 )
  4u
  DELTA4
  (p1 ph7)
  (p22 ph1):f3
  p29:gp6
  d16 pl16:f3
  20u
  p29:gp7
  d16
  4u
  (p2 ph1)
  4u
  p29:gp7
  d16
  10u cpd3:f3

4 0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK

  10u do:f3
  p29:gp6
  d16 pl3:f3
  TAU
  (p1 ph1)
  DELTA4
  4u
  (center (p2 ph2) (p22 ph1):f3 )
  4u
  DELTA4
  (p1 ph7)
  (p22 ph1):f3
  p29:gp6
  d16 pl16:f3
  20u
  p29:gp7
  d16
  4u
  (p2 ph1)
  4u
  p29:gp7
  d16
  10u cpd3:f3

  lo to 4 times l1

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62*2
  0.05u DWELL_HOLD
  0.1u REC_BLK

  rcyc=2

  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90) & calph(ph6, +90), caldel(d0, +in0))

  4u BLKGRAD
exit 
  

ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0
ph7=2
ph8=0
ph29=0
ph30=0
ph31=0 2 0 2 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp1: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                    [300 usec]
;d0 : incremented delay (2D)                              [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                                  [30 msec]
;d12: delay for power switching                           [20 usec]
;d16: delay for homospoil/gradient recovery
;d21 : 1/(2J(YH))
;d26 : 1/(4J)YH
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;cnst4: = J(YH)
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz3: 50%
;gpz4: 80%
;gpz5: 30%
;gpz6: 3%
;gpz7: 5%


;use gradient files:   
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.50


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



