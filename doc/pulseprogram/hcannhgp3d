;hcannhgp3d
;avance-version (21/09/15)
;CO-coupled (H)CANNH
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F2(Ca,t1) -> F3(N,t2) -> F1(H,t3)
;
;for determination of 3J H(N)C' (Phi) using E.COSY
;   splitting in F1:  CaC'
;   splitting in F3:  H(N)C'
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1
;using constant time in t2
;(use parameterset HCANNHGP3D)
;
;F. Loehr & H. Rueterjans, J. Biomol. NMR 5, 25-36 (1995)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d3=2.0m"
"d4=1.7m"
"d21=5.5m"
"d23=12m"
"d26=2.3m"
"d27=13.3m"


"d0=d27"
"d10=d23/2-p14/2"
"d20=d27"
"d29=d23/2-p14/2-p26-d21-4u"
"d30=d23/2-p14/2"

"in0=inf1/2"
"in10=inf2/4"

"in20=in0"
"in29=in10"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=p16+d16+8u" 
"DELTA2=d21-p16-d16-4u"

"CEN_CN2=(larger(p14,p22)-p22)/2"


"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs7=bf2*(cnst23/1000000)-o2"
"spoffs10=0"
"spoffs12=0"
"spoffs15=0"


aqseq 321


1 d11 ze
  d11 pl28:f2 pl16:f3 
2 d11 do:f2 do:f3
3 d1 pl1:f1 pl3:f3
  p1 ph1
  d4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  d4 UNBLKGRAD
  (p1 ph2):f1 

  4u
  p16:gp1
  d16

  (p23:sp10 ph3):f2
  (d3 pl19 p26 ph2 20u cpds1 ph1):f1 (d0 p14:sp7 ph4 d20):f2 (d0 CEN_CN2 p22 ph1):f3
  (p23:sp12 ph1):f2

  (p21 ph1):f3
  d30
  (p14:sp5 ph1):f2
  d30
  (center (p14:sp3 ph1):f2 (p22 ph8):f3 )
  d10
  (p14:sp5 ph1):f2
  d29
  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2*EA
  d16 
  DELTA2 pl1:f1

  (center (p1 ph1) (p21 ph5):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (center (p1 ph2) (p21 ph6):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (p1 ph1)
  DELTA1
  (p2 ph1)
  4u
  p16:gp3
  d16 pl28:f2 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3 
  d11 do:f2 do:f3 mc #0 to 2
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20))
     F2EA(calgrad(EA) & calph(ph6, +180), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=0 2
ph4=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph5=0 0 2 2
ph6=3 3 1 1
ph7=3
ph8=0 0 0 0 2 2 2 2
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;pl28: f2 channel - power level for selective Ca or CO decoupling
;sp3 : f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5 : f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp7 : f2 channel - shaped pulse 180 degree  (Cali off resonance)
;sp10: f2 channel - shaped pulse 90 degree  (Ca on resonance)
;sp12: f2 channel - shaped pulse 90 degree  (Ca on resonance)
;                   sp12 for time reversed Ca pulse
;                   sp10, sp12 may require higher selectivity
;sp15: f2 channel - shaped pulse 180 degree for decoupling
;                                           (Ca on resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p23: f2 channel -  90 degree shaped pulse (Ca, selective)
;p26: f1 channel -  90 degree pulse at pl19
;p31: f2 channel - 180 degree pulse for decoupling sequence
;d0 : incremented delay (F1 in 3D)  = d27
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(3.4J(CH)                                      [2.0 msec]
;d4 : 1/(4J(CH)                                        [1.7 msec]
;d10: incremented delay (F2 in 3D) =  d23/2-p14/2
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d27
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NCa)                                       [12 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d27: constant time delay T(C)                         [13.3 msec]
;d29: incremented delay (F2 in 3D) = d23/2-p14/2-p26-d21-4u
;d30: decremented delay (F2 in 3D) = d23/2-p14/2
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Ca)) =  DW(Ca)
;nd0: 2
;in10: 1/(4 * SW(N)) = (1/2) DW(N)
;nd10: 4
;in20: = in0
;in29: = in10
;in30: = in10
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2 : mlevsp180.p31
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3
;                         30 :   80 :  8.1

;for z-only gradients:
;gpz1: 30%
;gpz2: 80%
;gpz3: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



