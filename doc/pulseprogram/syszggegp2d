;syszggegp2d
;avance-version (00/06/30)
;2D sequence
;stability test after gradient echo
;
;$CLASS=HighRes HWT
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$HIDE=y


#include <Avance.incl>
#include <Grad.incl>


1 ze
2 d1
3 d12
  p1 ph1
  50u UNBLKGRAD
  p16:gp1
  d16
  p16:gp2
  d16
  4u BLKGRAD
  go=2 ph31
  d1 wr #0 if #0 zd
  lo to 3 times td1
exit


ph1=0 
ph31=0


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse
;d1 : relaxation delay; 1-5 * T1
;d16: delay for homospoil/gradient recovery
;NS: 2 * n


;use gradient ratio:    gp 1 : gp 2
;                          1 :   -1



