;b_hncocagp4d
;avance-version (21/11/23)
;best-HNCOCA
;4D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O) -> F2(Ca,t1)
;            -> F2(C=O,t2) -> F3(N,t3) -> F1(H,t4)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive using Echo/Antiecho gradient selection (t3)
;using constant time in t2
;using constant time in t3
;(use parameterset B_HNCOCAGP4D)
;
;(E. Lescop, P. Schanda & B. Brutscher,
;   J. Magn. Reson.  187 163-169 (2007))
;(S. Grzesiek & A. Bax, J. Magn. Reson. 96, 432 - 440 (1992))
;(L.E. Kay, G.Y. Xu & T. Yamazaki, J. Magn. Reson. A109,
;   129-133 (1994))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p22=p21*2"
"d11=30m"

"d22=5.0m"
"d23=14.5m"
"d26=2.4m"

"p29=300u"


#   ifdef CALC_SP
"p41=(bwfac25/(cnst55*cnst51*bf1))*1000000"
"spw25=plw1*pow((p1*totrot25)/(p41*90.0*integfac25),2)"
"spw27=plw1*pow((p1*totrot27)/(p41*90.0*integfac27),2)"
"spoal25=1"
"spoal27=0"

"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1*pow((p1*totrot26)/(p42*90.0*integfac26),2)"
"spoal26=0.5"

"p43=(bwfac28/(cnst55*cnst53*bf1))*1000000"
"spw28=plw1*pow((p1*totrot28)/(p43*90.0*integfac28),2)"
"spw29=plw1*pow((p1*totrot29)/(p43*90.0*integfac29),2)"
"spoal28=1"
"spoal29=0"
#   endif /*CALC_SP*/


"d31=3u"
"d32=3u"
"d33=3u"
"d42=d22"
"d43=d23-p43"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"in42=in32"
"in43=in33"

"td2=tdmax(td2,d42*2,in42)"
"td3=tdmax(td3,d43*2,in43)"


"TAU=larger(p14,p22)"

"DELTA=d31*2+larger(p44,TAU)-p14"
"DELTA1=d26-p29-d16-p41*cnst41-p42*cnst40"
"DELTA2=d23-larger(p14,p44)-d33-p16-d16"
"DELTA3=d22-p14-4u"
"DELTA4=d22-d32-p22"
"DELTA5=d26-p19-d16-p42/2"
"DELTA6=d26-p29-d16-p43*cnst43-p42*cnst42"
"DELTA7=p16+d16+de+8u" 


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst22)/1000000)"
"spoffs8=0"

"spoffs25=bf1*(cnst54/1000000)-o1"
"spoffs26=bf1*(cnst54/1000000)-o1"
"spoffs27=bf1*(cnst54/1000000)-o1"
"spoffs28=bf1*(cnst54/1000000)-o1"
"spoffs29=bf1*(cnst54/1000000)-o1"
"spoffs30=0"


"o1_F1=bf2*cnst22/1000000"
"o1_F2=bf2*cnst21/1000000"


"acqt0=0"
baseopt_echo


1 d11 ze
  d11 pl26:f3 
2 d11 do:f3
3 d1 fq=cnst21(bf ppm):f2
  50u UNBLKGRAD

  (p41:sp25 ph1)
  p29:gp3
  d16
  DELTA1 pl3:f3
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA1
  p29:gp3
  d16
  (p41:sp27 ph2):f1 

  p16:gp4
  d16

  (p21 ph1):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph2):f3

  p16:gp5
  d16

  (p13:sp2 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA3
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA3
  (p13:sp8 ph2):f2

  4u
  30u fq=cnst22(bf ppm):f2

  (p13:sp2 ph4):f2
  d31
  (center (p44:sp30 ph1) (p14:sp7 ph1):f2 (p22 ph7):f3 )
  d31
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u
  30u fq=cnst21(bf ppm):f2

  (p13:sp2 ph2):f2
  d32
  (p22 ph7):f3
  DELTA4
  (p14:sp5 ph1):f2
  4u
  (p14:sp3 ph1):f2
  d42
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph3):f2

  p16:gp6
  d16

  (p21 ph8):f3
  d33
  (p44:sp30 ph1) (p14:sp5 ph1):f2
  DELTA2
  p16:gp1*EA
  d16 
  (center (p14:sp3 ph1):f2 (p22 ph7):f3 )
  d43

  (p43:sp28 ph1) 
  (p21 ph5):f3
  p19:gp7
  d16
  DELTA5
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA5
  p19:gp7
  d16
  (p21 ph6):f3

  (p43:sp29 ph2)
  p29:gp8
  d16
  DELTA6
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA6
  p29:gp8
  d16
  (p43:sp28 ph1)
  DELTA7
  (p42:sp26 ph1)
  4u
  p16:gp2
  d16 pl26:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d31, +in31)) 
     F2PH(calph(ph3, +90), caldel(d32, +in32) & caldel(d42, -in42)) 
     F3EA(calgrad(EA) & calph(ph6, +180), caldel(d33, +in33) & caldel(d43, -in43) & calph(ph8, +180) & calph(ph31, +180))
  TAU
exit


ph1=0
ph2=1 
ph3=0 0 0 0 2 2 2 2
ph4=0 2
ph5=0 0 2 2
ph6=1 1 3 3
ph7=0 0 0 0 2 2 2 2
ph8=1
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl26: f3 channel - power level for CPD/BB low power decoupling
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp25: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp27: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;                   for time reversed pulse
;sp28: f1 channel - shaped pulse  90 degree (Eburp2.1000)
;sp29: f1 channel - shaped pulse  90 degree (Eburp2tr.1000)
;                   for time reversed pulse
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                 [300 usec]
;p41: f1 channel -  90 degree shaped pulse for excitation
;                      Pc9_4_90.1000             (2.2ms at 600.13 MHz)
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.4ms at 600.13 MHz)
;p43: f1 channel -  90 degree shaped pulse for excitation
;                      Eburp2.1000/Eburp2tr.1000 (1.7ms at 600.13 MHz)
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa)                                      [5.0 msec]
;d23: 1/(4J(NCO)                                       [14.5 msec]
;d26: 1/(4J'(NH)                                       [2.4 msec]
;d31: incremented delay (F1 in 3D)                     [3 usec]
;d32: incremented delay (F2 in 3D)                     [3 usec]
;d33: incremented delay (F3 in 3D)                     [3 usec]
;d42: decremented delay (F2 in 3D) = d22
;d43: decremented delay (F3 in 3D) = d23-p43
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst40: compensation of chemical shift evolution during p42
;           Reburp.1000: 0.5
;           compensate to the extend the other delays allow
;cnst41: compensation of chemical shift evolution during p41
;           Pc9_4_90.1000: 0.529
;cnst42: compensation of chemical shift evolution during p42
;           Reburp.1000: 0.5
;cnst43: compensation of chemical shift evolution during p43
;           Eburp2.1000: 0.5
;cnst51: scaling factor for p41 to compensate for transition region
;           Pc9_4_90.1000: 1.172
;cnst52: scaling factor for p42 to compensate for transition region
;           Reburp.1000: 1.426
;cnst53: scaling factor for p43 to compensate for transition region
;           Eburp2.1000: 1.000
;cnst54: H(N) chemical shift (offset, in ppm)
;cnst55: H(N) bandwidth (in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(CO) = 2 * DW(CO)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(Ca)) = DW(Ca)
;in32: 1/(2 * SW(CO)) = DW(CO)
;in33: 1/(2 * SW(N)) = DW(N)
;in42: = in32
;in43: = in33
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d42 / in42
;td3: number of experiments in F3       td3 max = 2 * d43 / in43
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: echo-antiecho in F3
;cpd3: decoupling according to sequence defined by cpdprg3: garp4.p62
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence
;cpdprg3: garp4.p62


;for z-only gradients:
;gpz1: 80%
;gpz2: 8.1%
;gpz3: 7%
;gpz4: -40%
;gpz5: -50%
;gpz6: 60%
;gpz7: -5%
;gpz8: 5%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.50
;gpnam8: SMSQ10.32



                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54 and cnst55
;             option -DCALC_SP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end
										  


