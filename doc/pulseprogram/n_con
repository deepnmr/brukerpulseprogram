;n_con
;avance-version (21/09/15)
;2D sequence with
;   15N detected correlation for triple resonance using
;      inept transfer steps
;
;      F2(C=O,t1) -> F1(N,t2)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using contsant time in t1
;(use parameterset N_CON)
;
;K. Takeuchi, G. Heffron, Z.-Y. J. Sun, D. P. Frueh & G. Wagner,
;   J. Biomol. NMR 47, 271-282 (2010)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"d11=30m"
"d12=20u"

"d23=12.5m"


"d0=d23/2-p14/2-larger(p2,p14/2)"
"d20=d23/2-p14/2-larger(p2,p14/2)"

"in0=inf1/4"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"DELTA1=d23/2-p14/2"
"DELTA2=d23/2-p14/2-d12-4u+p1*2/PI-de"


"cnst24=cnst21/2+cnst22/2"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"


"o1_F1=bf2*cnst21/1000000"


"acqt0=0"
baseopt_echo


1 ze 
  d11 pl12:f2
2 d11 do:f2 do:f3
3 d1 pl1:f1 pl16:f3
  50u UNBLKGRAD
  (p1 ph1):f1
  p16:gp1
  d16 fq=cnst21(bf ppm):f2
  d12 cpd3:f3

  (p13:sp2 ph3):f2
  d20
  (p14:sp5 ph1):f2
  d20
  (center (p14:sp3 ph1):f2 (p2 ph1):f1 )
  d0
  (p14:sp5 ph1):f2
  d0
  (p13:sp8 ph2):f2

  4u do:f3
  p16:gp2
  d16

  (p1 ph4):f1
  DELTA1
  (p14:sp5 ph1):f2
  DELTA1
  (center (p14:sp3 ph1):f2 (p2 ph1):f1 )
  DELTA1
  (p14:sp5 ph1):f2
  DELTA2 fq=cnst24(bf ppm):f2
  d12 pl12:f2
  4u BLKGRAD

  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20))
exit 
  

ph1=0 
ph2=1 
ph3=0 2
ph4=0 0 2 2
ph31=0 2 2 0

  
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;d0 : incremented delay (2D) = d23/2-p14/2-larger(p2,p14/2)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d23/2-p14/2-larger(p2,p14/2)
;d23: 1/(4J(NCO))                                      [12.5 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst24: center of Calpha and CO chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;inf1: 1/SW(CO) = 2 * DW(CO)
;in0: 1/(4 * SW(CO)) =  (1/2) DW(CO)
;nd0: 4
;in20: = in0
;ns: 4 * n
;ds: >= 16
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



