;aringpgsp
;avance-version (18/06/14)
;1D antiring sequence 
;with power-gated decoupling
;using adiabatic inversion pulse
;WaveMaker supported
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


"d11=30m"


"DELTA=d1-100m"


"TAU1=p26"


"acqt0=-p1*2/PI"


1 ze
  d11 pl12:f2
2 30m do:f2
  10u pl13:f2
  d11 cpd2:f2
  DELTA
  4u do:f2
  10u pl12:f2
  100m cpd2:f2

  if "nsdone %2 == 0"
     {
     (p26:sp8 ph2):f1
     }
  else
     {
     TAU1
     }

  2u pl1:f1
  p1 ph1
  go=2 ph31
  30m do:f2 pl13:f2 mc #0 to 2 F0(zd)
exit


ph1=0 0 1 1 2 2 3 3
ph2=0
ph31=2 0 3 1 0 2 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl13: f2 channel - power level for second CPD/BB decoupling
;sp8: f1 channel - shaped pulse (180degree)
;spnam8: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;p1 : f1 channel -  high power pulse
;p26: f1 channel - 180 degree shaped pulse
;     = 500us for Crp60,0.5,20.1 (Crp80,0.5,20.1)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;ns: 1 * n, total number of scans: NS * TD0
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence



;WaveMaker shapes (optional)
;use 'wvm -a' command to create the necessary shape files
;sp8:wvm:cawurst-20(cnst21 ppm, 2 ms)
;cnst21: adiabatic sweep width in ppm for p26:sp8 (wvm only)



