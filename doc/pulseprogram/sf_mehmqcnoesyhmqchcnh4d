;sf_mehmqcnoesyhmqchcnh4d
;avance-version (23/09/24)
;4D 13C SOFAST HMQC-NOESY- 15N SOFAST HMQC for methyl/H(N) NOEs  
;
;  H(methyl),t1 -> C(methyl),t2 -> H(methyl)
;  -> NOE ->  H(N) -> N,t3 ->  H(N), t4
;
; using only bandselective 1H pulses. Bandwidth and center of these pulses are set 
;   via cnst54 - cnst57. cnst54 also sets the center of F1 dimension (HMe NOESY 
;   dimension)
; best used for deuterated proteins with selective 1H/13C labelled methyl groups
; for uniformly 13C labeled samples use ZGOPTN LABEL_CN for CA/CO decoupling
;   during 15N chem. shift evolution (F3 dimension).  
;(use parameterset SF_MEHMQCNOESYHMQCHCNH4D)
;
;(P. Rossi, Y. Xia, N. Khanra & G. Veglia & G. Kalodimos,
;  J. Biomol. NMR 66, 259 (2016))
;(J. Ying, F. Delaglio, D.A. Torchia & A. Bax, J Biomol NMR 68, 101-118 (2017))

;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d2=1s/(cnst2*2)"
"d3=1s/(cnst3*2)"
"p4=p3*2"

#   ifdef CALC_SP

;cnst44/45: scaling factors for bandwidth, used in calculation of shaped pulses in orignal
;publication (cnst44 for Pc9_4_90.1000: 1.172, cnst45 for Reburp.1000: 1.426),
;set to 1.0 in case other shapes are used:
"cnst44=1.172"
"cnst45=1.426"

"p39=(bwfac23/(cnst55*cnst44*bf1))*1000000"
"spw23=plw1/(((p39*90.0)/(p1*totrot23))*((p39*90.0)/(p1*totrot23))*(integfac23*integfac23))"
"spoal23=1"

"p42=(bwfac26/(cnst55*cnst45*bf1))*1000000"
"spw26=plw1/(((p42*90.0)/(p1*totrot26))*((p42*90.0)/(p1*totrot26))*(integfac26*integfac26))"
"spoal26=0.5"

"p43=(bwfac28/(cnst55*bf1))*1000000"
"spw28=plw1/(((p43*90.0)/(p1*totrot28))*((p43*90.0)/(p1*totrot28))*(integfac28*integfac28))"
"spw29=plw1/(((p43*90.0)/(p1*totrot29))*((p43*90.0)/(p1*totrot29))*(integfac29*integfac29))"
"spoal28=1"
"spoal29=0"

"spnam22=spnam26"
"p51=(bwfac22/(cnst57*cnst45*bf1))*1000000"
"spw22=plw1/(((p51*90.0)/(p1*totrot22))*((p51*90.0)/(p1*totrot22))*(integfac22*integfac22))"
"spoal22=0.5"
#   endif /*CALC_SP*/

"in31=inf1"
"in32=inf2"
"in33=inf3"

"d31=in31/2"
"d32=in32/2-p3*4/PI"
"d33=in33/2-p21*4/PI"

"DELTA1=d2-p16-d16-d32/2-p3"
"DELTA2=d3-p16-d16-p39*cnst39-p21-d33/2"
"DELTA3=p39*cnst39-de-4u"

"TAU=d8-p21-p16-d16-p39"

"spoffs13=bf2*(110/1000000)-o2"
"spoffs22=bf1*(cnst56/1000000)-o1"
"spoffs23=bf1*(cnst56/1000000)-o1"
"spoffs26=0"
"spoffs28=0"
"spoffs29=0"

"o1_F1=bf1*cnst54/1000000"

"acqt0=0"
baseopt_echo

1 ze 
  d11 pl16:f3
2 d1 do:f3
3 d12 pl2:f2 pl3:f3
  50u UNBLKGRAD
  (p3 ph1):f2
  p16:gp1
  d16 fq=cnst54 (bf ppm):f1
  (p43:sp28 ph2) 
  (center (d31) (p4 ph1):f2)
  p16:gp2
  d16
  (center (p42:sp26 ph1):f1 (DELTA1 p3 ph5 d32 p3 ph3 DELTA1):f2 )
  p16:gp2
  d16 
  (p43:sp29 ph1)

  10u fq=0:f1
  (p39:sp23 ph1):f1
  TAU 
  (p21 ph1):f3
  p16:gp3
  d16

  (p39:sp23 ph1):f1
  p16:gp4
  d16
#  ifdef LABEL_CN
  (center (p51:sp22 ph1):f1 (p8:sp13 ph1):f2 (DELTA2 p21 ph4 d33 p21 ph1 DELTA2):f3 )
#  else
  (center (p51:sp22 ph1):f1 (DELTA2 p21 ph4 d33 p21 ph1 DELTA2):f3 )
#  endif /* LABEL_CN */
  DELTA3
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD

  go=2 ph31 cpd3:f3 
  d1 do:f3 mc #0 to 2 
     F1PH(calph(ph2, +90), caldel(d31, +in31))
     F2PH(calph(ph5, +90), caldel(d32, +in32))
     F3PH(calph(ph4, +90), caldel(d33, +in33))
exit 
  

ph1=0 
ph2=0 
ph3=0 0 0 0 2 2 2 2
ph4=0 2
ph5=0 0 2 2
ph31=0 2 2 0 2 0 0 2


;pl2 : f2 channel - power level for pulse (default)
;pl16: f3 channel - power level for decoupling
;
;sp23: f1 channel - shaped pulse 90 degree (Pc9_4_90.1000)              
;sp24: f1 channel - shaped pulse 180 degree (Reburp.1000)
;
;p1 : f1 channel -  90 degree high power pulse (used for calculation of sel. 1H pulses)
;p3 : f2 channel -  90 degree high power pulse 
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse (adiabatic)
;p16: homospoil/gradient pulse                       [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p39: f1 channel - 90 degree shaped pulse for excitation (Pc9_4_90.1000) 
;p42: f1 channel - 180 degree shaped pulse for refocussing (Reburp.1000)
;p43: f1 channel -  90 degree shaped pulse for excitation (Eburp2.1000/Eburp2tr.1000)
;p61: f2 channel -  90 degree pulse at pl14 (low power decoupling) 
;
;d1 : relaxation delay [0.3-1 s]
;d2: 1/(2J CH)                                   [3.8 msec]
;d8 : NOESY mixing time
;d11: delay for disk I/O                         [30 msec]
;d12: delay for power switching                   [20 usec]
;d16: delay for homospoil/gradient recovery
;d31: incremented delay (t1)                                                  
;d32: incremented delay (t2)                  
;d33: incremented delay (t3)  
;inf1: 1/SW(F1) = 2 * DW(F1)
;inf2: 1/SW(F2) = 2 * DW(F2)
;inf3: 1/SW(F3) = 2 * DW(F3)
;in31: 1/(SW(F1)) = 2 * DW(F1)
;in32: 1/(SW(F2)) = 2 * DW(F2)
;in33: 1/(SW(F3)) = 2 * DW(F3)

;cnst2: = J(CH) in Hz [130]
;cnst3: = J(NH) in Hz [95]
;cnst39: compensation of chemical shift evolution during PC9 pulse [~0.52] 
;        optimize for 0 first order phase in F4     
;cnst44: scaling factor for Pc9 bandwidth (Pc9_4_90.1000: 1.172)         
;cnst45: scaling factor for Reburp bandwidth (Reburp.1000: 1.426)
;cnst54: Center of F1 dim. and offset of HMe sel. pulses (in ppm) [~1]
;cnst55: Bandwidth of HMe pulses (in ppm) [~4]
;cnst56: H(N) chemical shift (offset, in ppm) [~8.3]
;cnst57: H(N) bandwidth of pulses (in ppm) [~5]


;ns: 4 * n
;ds: >=64
;td1: number of experiments in F1
;FnMODE: States-TPPI in F1
;FnMODE: States-TPPI in F2
;FnMODE: States-TPPI in F3
;
;cpd2: decoupling according to sequence defined by cpdprg2: bi_garp4_2plcp.p61
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;cpdprg2: bilevel decoupling (bi_garp4_2plcp.p61)
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence

;for z-only gradients:
;gpz1: 60%
;gpz2: 40%
;gpz3: 20%
;gpz4: 35%


;use gradient files:
;gpnam1: SMSQ10.100   
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100


                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54 - cnst57
;             option -DCALC_SP (eda: ZGOPTNS)
;LABEL_CN: use for uniformly 13C labelled protein samples to enable CO/CA decoupling during 15N chem. shift evolution
;             option -LABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1

;PHC0(F3): 90
;PHC1(F3): -180
;FCOR(F3): 1



