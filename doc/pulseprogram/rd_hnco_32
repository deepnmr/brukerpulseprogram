;rd_hnco_32
;avance-version (21/09/15)
;3,2 RD-HNCO (APSY)
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O,t1) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1, States)
;using constant time in t2
;water suppression using watergate sequence
;
;S. Hiller, F. Fiorito. K. Wuethrich & G. Wider, Proc. Natl. Acad. 
;   Sci. USA 102, 10876-10881 (2005).
;(S. Grzesiek & A. Bax, J. Magn. Reson. 96, 432 - 440 (1992))
;(J. Schleucher, M. Sattler & C. Griesinger, 
;   Angew. Chem. Int. Ed. 32, 1489-1491 (1993)
;(L.E. Kay, G.Y. Xu & T. Yamazaki, J. Magn. Reson. A109,
;   129-133 (1994)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define delay PI
"PI=3.141592653589793"


"p2=p1*2"
"p22=p21*2"
"d31=3u"
"d11=30m"
"d13=4u"

"d21=5.5m"
"d23=12m"
"d26=2.3m"


"d32=d23/2-p14/2"
"d42=d23/2-p14/2"
"d52=d23/2-p14/2-p26-d21-4u"


"in31=abs(in1*cos(2*PI*cnst51/360)/2)"
"in32=abs(in1*sin(2*PI*cnst51/360)/4)"
"in42=in32"
"in52=in32"


"DELTA=d31*2+larger(p14,p22)-p14"
"DELTA1=d23-d21-p26"
"DELTA2=d26-p16-d16-p11-12u"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs8=0"


"l3=td1/4"


1 d11 ze
  d11 pl16:f3 
2 d11 do:f3
  3m
3 6m
4 15m
5 d1 pl1:f1
  p1 ph1
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph3):f3
  d21 pl19:f1
  (p26 ph2):f1
  DELTA1 cpds1:f1 ph1
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph1):f3

  p16:gp5
  d16

  (p13:sp2 ph4):f2
  d31
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d31
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph5):f3
  d42
  (p14:sp5 ph1):f2
  d42
  (center (p14:sp3 ph1):f2 (p22 ph8):f3 )
  d32
  (p14:sp5 ph1):f2
  d52
  4u do:f1
  (p26 ph7):f1
  d21
  (p21 ph1):f3

  p16:gp3
  d16 pl0:f1
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA2 pl0:f1
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph6):f1
  4u
  DELTA2
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 

  d11 do:f3 wr #0 if #0 zd

  if "cnst51 == 90"
     {
     3m
     }
  else
     {
     3m ip4
     lo to 3 times 2
     }

  if "cnst51 == 0"
     {
     3m rp4
     3m
     3m
     }
  else
     {
     3m rp4
     3m dp5
     lo to 4 times 2
     3m rp5
     }

  3m id31
  3m id32
  3m dd42
  3m id52
  lo to 5 times l3
	
exit


ph1=0
ph2=1 
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0 2
ph5=0 0 2 2
ph6=2
ph7=3
ph8=0 0 0 0 2 2 2 2
ph31=0 2 2 0 0 2 2 0 2 0 0 2 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d13: short delay                                      [4 usec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NCO)                                       [12 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d31: incremented delay (F1 in 3D)                     [3 usec]
;d32: incremented delay (F2 in 3D) =  d23/2-p14/2
;d42: decremented delay (F2 in 3D) = d23/2-p14/2
;d52: incremented delay (F2 in 3D) = d23/2-p14/2-p26-d21-4u
;cnst18: H2O chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst29: N(H) chemical shift (offset, in ppm)
;cnst51: projection angle alpha
;o1p: H2O chemical shift (cnst18)
;o2p: CO chemical shift (cnst21)
;o3p: N(H) chemical shift (cnst29)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(CO)) =  DW(CO)
;in32: 1/(4 * SW(N)) = (1/2) DW(N)
;in52: = in32
;in42: = in32
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;        (2 times the number of points in final 2D projection)
;FnMODE: States in F1
;USERA4: aqapsy
;USERA5: 3D NOH st
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5
;                         50 :   40 :   60 :   30 :  -67

;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%
;gpz5: -67%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



