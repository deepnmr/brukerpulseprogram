;dr_tocsy_hetcor
;avance-version (16/07/25)
;dual receive 2D H-H TOCSY and 2D H-C HETCOR experiment
;with multiplicity editing
;parent dataset:
;H-H TOCSY
;
;child dataset:
;H-C HETCOR
;
;using adiabatic pulses for inversion on f2 - channel
;
;E. Kupce, R. Freeman & B. John, J. Am. Chem. Soc. 128, 9606-9607 (2006)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$OWNER=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>


"p2=p1*2"
"d3=1/(cnst2*cnst11)"
"d4=1/(cnst2*4)"
"d21=3m"


"in0=inf1/2"

"d0=in0/2"


"DELTA1=d3-cnst17*p24/2-4u"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"l3=td1/2"


"acqt0=-p1*2/PI"


"d31=l1*p6*115.112"


1 ze1  
  ze2
2 30m
3 65m
4 1m pl9:f1
  d1 cw:f1 ph4
  4u do:f1
  4u pl1:f1 
  50u UNBLKGRAD

  (p1 ph1):f1
  d0
  (p14:sp3 ph4):f2 
  d0
  d4
  (p2 ph4):f1
  (p14:sp3 ph4):f2 
  d4 pl2:f2
  (p1 ph2):f1
  
  (p3 ph2):f2
  DELTA1
  4u
  (center (p2 ph4):f1 (p24:sp7 ph4):f2 ) 
  4u
  DELTA1 pl2:f2
  (p3 ph4):f2
  
  (p1 ph5):f1 
  p16:gp1
  d16 
  4u pl10:f1 
6 (p3 ph4):f2
  ACQ_START2(ph29,ph30)

  0.1u DWELL_GEN2
  
7 p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  lo to 7 times l1
		
  eoscnp2

  4u
  d21 pl1:f1 
  p16:gp2
  d16  
  4u BLKGRAD
  p1 ph3
  ACQ_START1(ph31, ph30)
  aq1 DWELL_GEN1
  rcyc1=2

  30m wr1 #0 if1 #0 zd1
  30m wr2 #1 if2 #1 zd2

  5m ip1
  lo to 3 times 2
  1m id0
  lo to 4 times l3 
  
  d31    
exit 

  
ph1=0 2
ph2=1
ph3=0 0 2 2 
ph4=0 
ph5=2
ph23=3
ph25=1
ph28=0
ph29=0 2 
ph30=0
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl10: f1 channel - power level for TOCSY-spinlock
;sp3: f2 channel - shaped pulse 180 degree (adiabatic)
;spnam3: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;sp7: f2 channel - shaped pulse 180 degree for refocussing
;spnam7: Crp60comp.4 (Crp80comp.4)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                            [1 msec]
;p24: f2 channel - 180 degree shaped pulse for refocussing (adiabatic)
;d0 : incremented delay (2D) = in0/2-p1*4/PI
;d1 : relaxation delay; 1-5 * T1
;d3 : multiplicity editing delay; see cnst11
;d4 : 1/(4J)CH
;d9 : TOCSY mixing time
;d16: delay for homospoil/gradient recovery
;d21: second z-filter delay                               [3 msec]
;d31: TOCSY mixing delay as executed, must be > aq2 !
;cnst2 : 1J(CH) 
;cnst11: for multiplicity editing  = 3 - CH2 negative, 6 - all positive  
;cnst17: = -0.5 for Crp60comp.4 (Crp80comp.4)
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;l3 : loop for 2D experiment = td1/2
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(1 * SW) = 2 * DW
;ns: 2 * n
;ds: 32
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;for z-only gradients
;gpz1: 40%
;gpz2: 27%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



;cnst17: Factor to compensate for coupling evolution during a pulse
;       (usually +1). A positive factor indicates that coupling
;       evolution continues during the pulse, whereas a negative
;       factor is necessary if the coupling is (partially) refocussed.



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



;WaveMaker shapes (optional) : 
;use 'wvm -a' command to create the shaped pulses 
;sp3:wvm:  cawurst-20(60 kHz, 0.5 ms)
;sp7:wvm:  cawurst-20(60 kHz, 2.0 ms, [comp121])



