;dr_pansy_cosy
;avance-version (17/02/10)
;K-K and K-X 2D PANSY COSY (K=1H, 19F etc.)
;parent dataset:
;H-H COSY
;
;child dataset:
;H-X COSY
;
;E. Kupce, R. Freeman & B. John, J. Am. Chem. Soc. 128, 9606-9607 (2006)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>


"d0=3u"

"in0=inf1"


"l3=td1"


1 ze1
  ze2 
  4u pl1:f1 pl2:f2
2 9m
3 50u UNBLKGRAD  
  p16:gp4
  (p1 ph2):f1
  (p3 ph2):f2 
  p16:gp5
  4u BLKGRAD
  d1

  (p1 ph1):f1
  50u UNBLKGRAD
  p16:gp1
  d16 
  d0
  (p1 ph3):f1 

  p16:gp2
  d16

  (p3 ph3):f2 
  p16:gp3
  d16 
  4u BLKGRAD

  ACQ_START1(ph29,ph30) ACQ_START2(ph29,ph31)
  0.1u DWELL_GEN1 DWELL_GEN2
  (aq1) (aq2)  
  eoscnp2			                	
  rcyc=2

  3m wr1 #0 if1 #0 zd1
  3m wr2 #1 if2 #1 zd2
  3m id0
  lo to 3 times l3  
exit


ph1=0 2
ph2=0 
ph3=0 0 2 2
ph29=0 2
ph30=0
ph31=0 


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                         [1 msec]
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d16: delay for homospoil/gradient recovery
;l3 : loop for 2D experiment = td1
;inf1: 1/SW = 2 * DW
;in0: 1/SW = 2 * DW
;ns: 4 * n
;ds: 32
;td1: number of experiments
;FnMODE: QF in F1


;for z-only gradients:
;gpz3/gpz1 = 1.063  (gammaH/gammaF) or 0.94 (gammaF/gammaH)
;gpz2+gpz3 = gp1 

;gpz1: 40% 
;gpz2: -2.52%  for 1H-obs  or  2.4 19F-obs
;gpz3: 42.52%  for 1H-obs  or 37.6 19F-obs
;gpz4: 7%
;gpz5: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



