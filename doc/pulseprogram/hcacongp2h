;hcacongp2h
;avance-version (21/09/15)
;2D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F2(Ca) -> F2'(C=O) -> F3(N, t1) 
;                      -> F2'(C=O) -> F2(Ca) -> F1(H,t2)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive using States-TPPI (t1)
;with H-2 decoupling - requires lockswitch unit or BSMS 2H-TX board
;(use parameterset HCACONGP2H)
;
;A.C. Wang, S. Grzesiek, R. Tschudin, P.J. Lodi & A. Bax, 
;   J. Biomol. NMR 5, 376-382 (1995)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d4=1.5m"		;tau
"d21=1.55m"		;DELTA
"d22=4.5m"		;delta
"d23=13.1m"		;T
"d25=4.5m"		;epsilon


"d0=3u"

"in0=inf1/2"


"DELTA=d0*2+larger(p2,p8)"
"DELTA1=d22-d21-p2-p14-p24/2-4u"
"DELTA2=d22-p14-p24/2-4u"
"DELTA3=d23-d25-p14-larger(p14,p22)/2-p16-4u"
"DELTA4=d23-p14-larger(p14,p22)/2-p16-8u"
"DELTA5=d23-p14-larger(p14,p22)/2-4u"
"DELTA6=d23-d25-p14-larger(p14,p22)/2"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst22)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"
"spoffs9=0"
"spoffs10=0"
"spoffs12=0"
"spoffs13=bf2*((110-cnst21)/1000000)"


1 d11 ze
  d11 LOCKDEC_ON
  50u LOCKH_ON
  d11 H2_PULSE
  d11 pl12:f2 pl17:f4

2 d11 do:f2 
3 d11 H2_LOCK
  6m LOCKH_OFF
  d1 fq=cnst22(bf ppm):f2
  50u LOCKH_ON
  d12 H2_PULSE
  (p1 ph2)
  d4 
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  d4 UNBLKGRAMP
  (p28 ph2)
  4u
  (p1 ph1) 

  4u
  p16:gp1
  d16

  (p13:sp2 ph3):f2
  d21
  p2 ph1
  DELTA1
  (p14:sp5 ph1):f2
  4u
  (p24:sp9 ph4):f2
  DELTA2
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2 

  4u
  30u fq=cnst21(bf ppm):f2
  p16:gp2
  d16

  (p23:sp10 ph5):f2
  d25
  (p14:sp7 ph1):f2
  4u
  p16:gp3
  DELTA3
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  4u
  p16:gp3
  DELTA4
  (p14:sp7 ph1):f2
  4u
  (p23:sp12 ph1):f2

  4u
  p16:gp4
  d16
  20u cpd4:f4

  (p21 ph6):f3
  d0
  (center (p2 ph1) (p8:sp13 ph1):f2 )
  d0
  (p22 ph1):f3
  DELTA
  (p21 ph1):f3
  
  4u do:f4
  p16:gp5
  d16

  (p23:sp10 ph7):f2
  4u
  (p14:sp7 ph1):f2
  DELTA5
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA6
  (p14:sp7 ph1):f2
  d25
  (p23:sp12 ph1):f2

  4u
  30u fq=cnst22(bf ppm):f2

  (p13:sp2 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA2
  (p24:sp9 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA1
  p2 ph1
  d21
  (p13:sp8 ph1):f2

  4u
  p16:gp6
  d16

  (p1 ph1) 
  4u
  d4
  (center (p2 ph2) (p14:sp3 ph1):f2 )
  d4 pl12:f2
  4u BLKGRAMP
  (p1 ph1) 
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 F1PH(calph(ph6, +90), caldel(d0, +in0))

  d11 H2_LOCK
  d11 LOCKH_OFF
  d11 LOCKDEC_OFF

exit


ph1=0
ph2=1
ph3=1
ph4=0 1
ph5=0
ph6=0 0 2 2
ph7=0 0 0 0 2 2 2 2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl17: f4 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (on resonance, Ca)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance, Ca)
;sp5: f2 channel - shaped pulse 180 degree  (off resonance, C=O)
;sp7: f2 channel - shaped pulse 180 degree  (off resonance, Ca)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance, Ca)
;     sp8 for time reversed Calpha pulses
;sp9: f2 channel - shaped pulse 180 degree  (on resonance, Ca)
;     sp9 requires higher selectivity - refocussing Calpha only
;sp10: f2 channel - shaped pulse  90 degree  (on resonance, C=O)
;sp12: f2 channel - shaped pulse  90 degree  (on resonance, C=O)
;     sp12 for time reversed C=O pulse
;     sp10, sp12 may require higher selectivity
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse (Ca and C=O, adiabatic)
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p23: f2 channel -  90 degree shaped pulse (C=O, selective)
;p24: f2 channel - 180 degree shaped pulse (Ca, selective)
;p28: f1 channel -  trim pulse                         [1 msec]
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(HCa))                                      [1.5 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(4J`(HCa))                                     [1.55 msec]
;d22: 1/(4J(CaCO))                                     [4.5 msec]
;d23: 1/(4J(NCO))                                      [13.1 msec]
;d25: 1/(4J`(CaCO))                                    [4.5 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(N)) = (1/2) DW(N)
;nd0: 2
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI)
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd4: decoupling according to sequence defined by cpdprg4
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd4: f4 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6
;                         60 :  -20 :    3 :   10 :  -30 :   50

;for z-only gradients:
;gpz1: 60%
;gpz2: -20%
;gpz3: 3%
;gpz4: 10%
;gpz5: -30%
;gpz6: 50%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



