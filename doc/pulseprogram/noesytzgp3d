;noesytzgp3d
;avance-version (15/01/26)
;NOESY - ZQ-TROSY
;3D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange
;   H-1/X correlation via TROSY
;phase sensitive (t1)
;phase sensitive (t2)
;using f3 - channel
;(use parameterset NOESYTZGP3D)
;
;K.V. Pervushin, G. Wider, R. Riek & K. Wuethrich, 
;   Proc. Natl. Acad. Sci USA 96, 9607-9612 (1999)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"

"p19=2m"


"in0=inf1"
"in10=inf2/2"


"d0=in0/2-p1*4/3.13159"
"d10=in10/2-5u"


"DELTA1=d26/2-p16-d16-p21-3u"
"DELTA2=d26-p16-d16"
"DELTA3=p21+d10*2+10u"
"DELTA4=d26-p16-d16-p11-8u"
"DELTA5=d26-p16-d16-p11-p21-4u"

"TAU=d8-p19-d16-p11-8u"


"l0=1"


aqseq 321


1 ze 
2 d11
3 d1
  50u UNBLKGRAD

  (p1 ph3)
  p16:gp1
  d16
  DELTA1
  (center (p2 ph1) (p21 ph1 3u p22 ph2 3u p21 ph1):f3 )
  DELTA1
  p16:gp1
  d16
  (p1 ph2)
  d0
  (p1 ph4)
  TAU
  p19:gp3
  d16
  (p11:sp1 ph5):f1
  4u
  4u pl1:f1
  (p1 ph1)

  if "l0 %2 == 1"
     {
     (p21 ph6):f3
     }
  else
     {
     (p21 ph7):f3
     }

  p16:gp1
  d16
  DELTA2
  DELTA3

  (center (p2 ph1) (p22 ph1):f3 )
  DELTA2
  p16:gp1
  d16

  if "l0 %2 == 1"
     {
     (p21 ph8):f3
     }
  else
     {
     (p21 ph9):f3
     }
  d10 gron0
  d10 gron0*-1
  10u groff

  (p21 ph1):f3
  (p1 ph1 4u p1 ph10) 
  p16:gp2
  d16
  DELTA4
  (p11:sp1 ph11:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph11:r):f1
  DELTA5
  p16:gp2
  d16 pl1:f1
  (p21 ph12):f3
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d0, +in0))
     F2EA(calph(ph5, +180) & calph(ph10, +180) & calph(ph12, +180) & calclc(l0, 1), caldel(d10, +in10))
exit 
  

ph1=0
ph2=1
ph3=(8) 1 1 1 1 3 3 3 3
ph4=0
ph5=2
ph6=2 0 3 1
ph7=2 0 1 3
ph8=1 3 0 2
ph9=1 3 2 0
ph10=0
ph11=2
ph12=1
ph31=0 2 3 1 2 0 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse  90 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [2 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d10: incremented delay (F2 in 3D)
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d26 : 1/(4J)YH
;cnst4: = J(YH)
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(X) = 2 * DW(X)
;in0: 1/(1 * SW(H)) = 2 * DW(H)
;nd0: 1
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2


;use gradient ratio:    gp 0 : gp 1 : gp 2 : gp 3
;                          3 :   30 :   50 :   80

;for z-only gradients:
;gpz0: 3%
;gpz1: 30%
;gpz2: 50%
;gpz3: 80%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



;$Id:$
