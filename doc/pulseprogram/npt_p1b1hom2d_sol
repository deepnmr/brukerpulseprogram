;$Id:$
;pulse program for B1 homogeneity determination on f1 channel

;$CLASS=Solids HWT
;$DIM=2D
;$HIDE=y

prosol relations=<solids_default>

#include <Avance.incl>

define list<pulse> Plist = <npt_b1meas>

"d12=20u"

 1 ze
 2 d1
30 d12
   (Plist ph1):f1
   go=30 ph31
   d12 Plist.inc
   d1 mc #0 to 2 F1QF()
exit

ph1=0
ph31=0

;pl1 : f1 channel - power level for Plist pulse (default)
;vplist: determines flip angle on F1 channel, generated by au program
;d1 : relaxation delay; 1-5 * T1
;nd0: 1
;NS: 1
;DS: 4
;td1: number of experiments
;FnMODE: QF
