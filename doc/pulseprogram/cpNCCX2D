;cpNCCX2D 
;
;
;version: 1.0/ TS3.0  /6/26/2011
;
;basic double cp experiment with darr or spindiff Ca-Cx tor CO-Cx transfer
;written by HF and JOS  13.12.2008 and modified 29.06.2010
;updated by JOS 6/26/2011
;checked by JOS 7/9/2011
;
;General comment:
;cross polarise from H to N, then from N to C
;using tangential shape for N-C-cp with shape on C
;with frequency shift from middle of C13 spectral window (so CO region is observed) to about 50 ppm for 
;second contact N to C.
;carrier for N-C contact is for Ca (about 55 ppm) or CO (170 ppm) 
;cnst10 sets this offset frequency in ppm
;set cnst9 for detection position (in ppm) must be = o1p!!,
;
;Avance III version
;parameters:
;d1 : recycle delay
;p3 : proton 90 at power level plw12
;p15 : contact pulse time at plw3 (f3) and spw0 (f2)
;p16 : N-C contact time, spnam1 square or ramp, plW5 is N contact pulse power and spw1 is 13C rf-power
;pl1 : 13C power level
;sp0 : proton power level during contact
;pl2 : =0, not used
;pl3 : N power level (for H to N CP)
;pl5 : N power level for N to C CP, preselect 3.5*(spin rate) on N and 2.5*(spin rate) on C 
;	 to avoid rotational resonance conditions 
;p3 : H 90 degree pulse
;d8 : mixing delay, recalculated for rotor synchronization
;spnam0 : file name for variable amplitude CP  (moderate ramp)
;spnam1 : file name for N to C CP shape on 13C tan amplitude modulation tancn5500
;sp1 : shape power levelfor N to C transfer, use ramp from 45 to 55 % or
;	TangAmpMod pulse, scale to 50% amplitude (means 6 dB more attenuation,
;	1/4 in power!),spw1 must acount for that loss.
;pl12 : power level for H 90 and standard proton decoupling 
;pl13 : for cw decoupling during N-C CP step as high as possible > 2.5* Nutation rate of N or C
;pl14 : (0 W) for PDSD, for RF-field = 1*(spin rate) for DARR, RAD
;cnst10 : 13C carrier position in ppm for C-N transfer,  55 (ppm) or 170 (ppm)
;cnst9 : 13C carrier position for detection (around 100 (ppm))
;cpdprg2 : sequence used for decoupling SPINAL64 recommended
;pcpd2 : pulse length in decoupling sequence, about 2*p3
;inf1 : = 1/swh(f1) such that integer multiples or integer fractions of rotation rate 
;	so that SSB's do overlap in F1
;FnMODE: TPPI, States or States-TPPI
;
;
;$CLASS=BioSolids
;$DIM=2D
;$TYPE=cross polarisation
;$SUBTYPE=heteronuclear correlation
;$COMMENT=double cp experiment

prosol relations=<solids_cp>


#include<trigg.incl>
"d31=1s/cnst31"
"l1=d8/d31"
"cnst59=plw14"
define pulse mixing
define delay darrmix
"mixing=((l1*1s/cnst31))" 
"darrmix=mixing"
"acqt0=-(p1/2)-1u"
"in0=inf1"
"d0=1u"
"l0=0"


1 ze
  darrmix
2 10m
  d1 do:f2 
10m
#include <darrmix_prot.incl>    /*allows max. 500 msec mixing time*/
trigg
  (p3 pl12 ph1):f2
  (p15 pl3 ph2):f3 (p15:sp0 ph10):f2
 if "l0==1"{
"d0=in0-2u"
}
if "l0>0"{
  1u cpds2:f2
  (center (d0) (p2 pl11 ph5):f1)
  1u do:f2
}
  1u fq=cnst10(bf ppm):f1
  (p16:sp1 ph4):f1 (p16 pl5 ph3):f3 (p16 pl13 fq=cnst24 ph0):f2
  (p1 pl11 ph5):f1
  (mixing pl14 ph6):f2
  (p1 ph7 fq=cnst9(bf ppm)):f1 (1u cpds2):f2
  go=2 ph31
  1m do:f2 
  10m mc #0 to 2 F1PH(ip2,id0 & iu0)
HaltAcqu, 1m
exit

ph0= 0
ph1= 1 3 
ph2= 0 
ph3= 0 0 2 2 2 2 0 0
ph4= 0 0 0 0 0 0 0 0
     2 2 2 2 2 2 2 2
ph5= {1}*8 {3}*8 
ph6= 0
ph7= {3}*8 {1}*8 
ph10= 0
ph31= ph1+ph3+ph4+ph5+ph7

;$Id:$
