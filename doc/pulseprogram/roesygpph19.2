;roesygpph19.2
;avance-version (12/01/11)
;2D ROESY with cw spinlock for mixing
;phase sensitive
;spinlock using 180x 180-x pulses
;water suppression using 3-9-19 pulse sequence with gradients
;
;A. Bax & D.G. Davis, J. Magn. Reson 63, 207-213 (1985)
;T.-L. Hwang & A.J. Shaka, J. Am. Chem. Soc. 114, 3157-3159 (1992)
;M. Piotto, V. Saudek & V. Sklenar, J. Biomol. NMR 2, 661 - 666 (1992)
;V. Sklenar, M. Piotto, R. Leppik & V. Saudek, J. Magn. Reson.,
;   Series A 102, 241 -245 (1993)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d12=20u"


"in0=inf1"

"d0=in0/2-p1*2/3.1416-4u"


"TAU=p1*2/3.1416-(p0-p27)*0.231-de+46u"


"l4=p15/(p25*2)"


"acqt0=0"
baseopt_echo


1 ze
2 d1
3 d12 pl1:f1
  p1 ph1
  d0 
  4u pl27:f1
4 p25 ph2
  p25 ph3
  lo to 4 times l4
  50u pl18:f1 UNBLKGRAD
  p16:gp1
  d16
  p27*0.231 ph4
  d19*2
  p27*0.692 ph4
  d19*2
  p27*1.462 ph4
  d19*2
  p27*1.462 ph5
  d19*2
  p27*0.692 ph5
  d19*2
  p0*0.231 ph5
  TAU
  p16:gp2
  d16
  4u BLKGRAD
  go=2 ph31
  d1 mc #0 to 2 F1PH(calph(ph1, +90), caldel(d0, +in0))
exit


ph1=0 2 2 0 1 3 3 1 
ph2=0 2 0 2 1 3 1 3
ph3=2 0 2 0 3 1 3 1
ph4=0 2 0 2 1 3 1 3
ph5=2 0 2 0 3 1 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl18: f1 channel - power level for 3-9-19-pulse (watergate)
;pl27: f1 channel - power level for pulsed ROESY-spinlock
;p0 : f1 channel -  90 degree pulse at pl18
;                      use for fine adjustment
;p1 : f1 channel -  90 degree high power pulse
;p15: f1 channel - pulse for ROESY spinlock
;p16: homospoil/gradient pulse
;p25: f1 channel - 180 degree pulse at pl27
;p27: f1 channel -  90 degree pulse at pl18
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;l4: loop for spinlock = p15 / p25*2
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;use gradient ratio:	gp 1 : gp 2
; 		          30 :   30

;for z-only gradients:
;gpz1: 30%
;gpz2: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


;Processing

;PHC0(F1): 180
;PHC1(F1): -180
;FCOR(F1): 1



;$Id:$
