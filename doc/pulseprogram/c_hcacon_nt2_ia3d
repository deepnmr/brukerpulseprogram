;c_hcacon_nt2_ia3d
;avance-version (21/09/15)
;HCaCON -15N T2
;3D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(H) -> F1(Ca) -> F1(C=O)
;            -> F3(N,T2,t2) -> F1(C=O,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t2)
;using semi-constant time in t2
;using IPAP scheme for virtual decoupling
;with temperature compensation
;as pseudo3D
;(use parameterset )
;
;W. Bermel, I. Bertini, I.C. Felli, R. Peruzzini &R. Pierattelli,
;   ChemPhysChem 11, 689-695 (2010)
;W. Bermel, I. Bertini,L. Duma, I.C. Felli, L. Emsley,  R. Pierattelli,
;   P.R. Vasos, Angew. Chem. Int. Ed. 44, 2-5 (2005)
;(;L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


define list<loopcounter> cpmglist=<$VCLIST>

define loopcounter vc_max

define loopcounter COUNTER1
define loopcounter COUNTER2


"p4=p3*2"
"p22=p21*2"

"d11=30m"
"d12=20u"

"d3=1.1m"
"d4=1.8m"
"d22=4.5m"
"d23=16.6m"

"d21=450u"

"d31=(p15*16+d21*32)"


"d29=3u"
"d10=d23/2-p12/2"
"d30=d23/2+p12/2+d29"

"in10=inf2/4"

"FACTOR2=d30*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in10 ) { in29 = 0; } else { in29=in10-INCR2; }"
"if ( INCR2 > in10 ) { in30 = in10; } else { in30 = INCR2; }"


"DELTA1=d22-d3-p4"
"DELTA2=d23-d22-p12"
"DELTA3=d23-p12-4u"
"DELTA4=d23/2-p12/2"
"DELTA5=d23-p21*2/3.1416+4u"
"DELTA6=d21-p4/2"

"TAU=d1"


"l0=1"
"l3=td1"
"l11=0"
"l31=0"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs28=0"


aqseq 312


1 ze
  d11 pl12:f2 pl16:f3

  "vc_max = 0"

9 20u
  if "cpmglist > vc_max"
     {
     20u
     "vc_max=cpmglist"
     }

  3m cpmglist.inc
  lo to 9 times l3

  3m cpmglist.res

2 d11 do:f2 do:f3
3 d11 fq=cnst22(bf ppm):f1
  d12 pl2:f2 pl23:f3

  20u
  "l31=cpmglist[l11]"
  20u
  "COUNTER1=l31"
  20u
  "COUNTER2=vc_max-l31"

  20u
  "TAU=d1-((p15*16+d21*32)*COUNTER1)"

  20u pl23:f3

8 d21
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  DELTA6
  (p4 ph1):f2
  DELTA6
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  d21*2
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  DELTA6
  (p4 ph9):f2
  DELTA6
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  d21
  lo to 8 times COUNTER2

  TAU pl3:f3
  50u UNBLKGRAD

  (p3 ph3):f2
  d4
  (center (p12:sp24 ph1) (p4 ph1):f2 )
  d4
  (p3 ph2):f2

  p16:gp1
  d16

  (p11:sp23 ph1)
  d3 
  (p4 ph6):f2
  DELTA1
  (p12:sp26 ph6)
  4u 
  (p25:sp28 ph1)
  d22
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph1)

  p16:gp2
  d16 fq=cnst21(bf ppm):f1

  (p11:sp23 ph5)
  d22
  (p12:sp27 ph1)
  DELTA2
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  DELTA3
  (p12:sp27 ph1)
  4u
  (p11:sp25 ph1)

  p16:gp5
  d16

  (p21 ph1):f3
  DELTA5
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d23 pl23:f3

5 d21
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  DELTA6
  (p4 ph1):f2
  DELTA6
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  d21*2
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  DELTA6
  (p4 ph9):f2
  DELTA6
  (p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8 d21*2 p15 ph8):f3
  d21
  lo to 5 times COUNTER1
 
  4u pl3:f3
  (p21 ph2):f3

  p16:gp3
  d16 pl12:f2
  (p26 ph2):f2
  20u cpd2:f2 ph1
   
  (p21 ph4):f3
  d10 
  (p12:sp27 ph1)
  d10
  (p12:sp24 ph1)
  d29
  (p12:sp27 ph1)
  d29
  (p22 ph1):f3
  d30
  (p12:sp27 ph1)
  d30
  (p21 ph2):f3

  4u do:f2
  (p26 ph7):f2
  4u
  p16:gp4
  d16
  (p26 ph2):f2
  20u cpd2:f2 ph1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph1)
     DELTA4
     (p12:sp27 ph1)
     DELTA4
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA4
     (p12:sp27 ph1)
     DELTA4 pl16:f3
     }
  else
     {
     (p11:sp23 ph7)
     d22
     (p12:sp27 ph1)
     DELTA2
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA4
     DELTA4 pl16:f3
     (p12:sp27 ph1)
     }

  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f2 do:f3 mc #0 to 2 
     F1QF(calclc(l11, 1))
     F2I(iu0, 2)
     F2PH(calph(ph4, +90), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30))

  d31
exit


ph1=0
ph2=1
ph3=0 0 0 0 2 2 2 2
ph4=0 0 2 2
ph5=0 2
ph6=0
ph7=3
ph8=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph9=2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;pl23: f3 channel - power level for TOCSY-spinlock
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p15: f3 channel - 180 degree pulse at pl23
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;p26: f2 channel -  90 degree pulse at pl12
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [1.1 msec]
;d4 : 1/(4J(HCa))                                      [1.8 msec]
;d10: incremented delay (F2 in 3D): d23/2-p12/2
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: echo delay                                       [450 usec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCO))                                      [16.6 msec]
;d29: incremented delay (F2 in 3D)                     [3 usec]
;d30: decremented delay (F2 in 3D): d23/2+p12/2+d29
;d31: length of single cpmg loop
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf2: 1/SW(N) = 2 * DW(N)
;in10: 1/(4 * SW(N)) = (1/2) DW(N)
;nd10: 4
;in29: = (1 - k) * in10
;in30: = k * in10
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 30%
;gpz3: 19%
;gpz4: 13%
;gpz5: 23%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



;use AU-program splitcombipap3d to process data



