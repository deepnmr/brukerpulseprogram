;hxdeptmlph
;avance-version (12/01/11)
;2D heteronuclear shift correlation
;using DEPT sequence
;with homonuclear Hartman-Hahn transfer using MLEV17 sequence
;   for mixing
;using one power level for excitation and spinlock
;phase sensitive
;
;H. Kessler, G. Gemmecker, M. Koeck, R. Osowski & P. Schmieder,
;   Magn. Reson. Chem. 28, 62 - 67 (1990)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"p5=p6*.667"
"p7=p6*2"
"d2=1s/(cnst2*2)"
"d11=30m"
"d12=20u"


"p0=p3*cnst12"


"d0=3u"

"in0=inf1/2"


"DELTA=d0*2+p2+d12"


"SCALEF=p10*2/p8"
"FACTOR1=((d9-p20*2)/(p9*64+p8))/SCALEF"
"l1=FACTOR1*SCALEF"


1 ze 
2 d11
3 d1 do:f2 
  d12 pl2:f2
  (p3 ph1):f2
  DELTA
  (p4 ph5):f2
  d0
  p2 ph3
  d0
  d12 pl15:f2
  (p20 ph26):f2
						;begin MLEV17
4 (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph22 p10 ph23 p9 ph22):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p9 ph24 p10 ph25 p9 ph24):f2
  (p8 ph23):f2
  lo to 4 times l1 
						;end MLEV17
  (p20 ph26):f2
  d2
  (p10 ph2):f2 (p1 ph4)
  d2
  (p0 ph2):f2 (p2 ph4)
  d2 pl12:f2
  go=2 ph31 cpd2:f2
  d11 mc #0 to 2 F1PH(calph(ph1, +90) & calph(ph5, +90), caldel(d0, +in0))
  d2 do:f2
exit 
  

ph1= 0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph2= 0
ph3= 0
ph4= 0 2 1 3 0 2 1 3 2 0 3 1 2 0 3 1
ph5= 1
ph22=3 3 3 3 1 1 1 1 3 3 3 3 1 1 1 1
ph23=0 0 0 0 2 2 2 2 0 0 0 0 2 2 2 2
ph24=1 1 1 1 3 3 3 3 1 1 1 1 3 3 3 3
ph25=2 2 2 2 0 0 0 0 2 2 2 2 0 0 0 0
ph26=0 0 0 0 2 2 2 2 0 0 0 0 2 2 2 2
ph31=0 2 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl15: f2 channel - power level for TOCSY-spinlock
;p0 : f2 channel :  p3 * cnst12
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p8 : f2 channel -  60 degree low power pulse
;p9 : f2 channel -  90 degree low power pulse
;p10: f2 channel - 180 degree low power pulse
;p20: f2 channel - trim pulse                             [2.5 msec]
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(XH))
;d9 : TOCSY mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;cnst2: = J(XH)
;cnst12: for multiplicity selection
;           0.5 ( 45 degree pulse) - all positive
;           1.0 ( 90 degree pulse) - XH only
;           1.5 (135 degree pulse) - XH, XH3 positive, XH2 negative
;l1: loop for MLEV cycle: (((p9*64) + p10) * l1) + (p20*2) = mixing time
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/(2 * SW(H)) = DW(H)
;nd0: 2
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence



