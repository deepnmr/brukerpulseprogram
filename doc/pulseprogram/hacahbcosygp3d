;hacahbcosygp3d
;avance-version (21/09/15)
;HaCaHb-COSY
;3D sequence with
;   inverse correlation using multiple inept transfer and
;
;      F1(Ha) -> F2(Ca,HMQC,t1/2) -> F1(H,t2) 
;			-> F2(Ca,HMQC,t1/2) -> F1(Ha,t3)
;
;for determination of 3J HaHb (Chi1) using quantitative J
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;(use parameterset HACAHBCOSYGP3D)
;
;S. Grzesiek, H. Kuboniwa, A.P. Hinck & A. Bax,
;   J. Am. Chem. Soc. 117, 5312-5315 (1995)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d2=3.4m"
"d23=8.7m"


"p19=2m"


"d0=3u"
"d10=3u"

"in0=inf1/4"
"in10=inf2/4"


"DELTA=d10*4+p14+larger(p14,p22)*2"
"DELTA1=d2-p16-d16"
"DELTA2=d23-d2-p13-p16-d16"
"DELTA3=d23-p16-d16"
"DELTA4=d23-d2/2-p1*1.5-p13/2-p14*3-d10-d0-p16-d16"
"DELTA5=d23-d2/2+p1*2.5-p13/2-p14*1.5-d10-d0-p16-d16"
"DELTA6=d23-d2-p13-p16-d16-p14*2-8u"


"CEN_CN2=(larger(p14,p22)-p22)/2"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


aqseq 321


1 d11 ze
  d11 pl12:f2
2 d11 do:f2
3 d12 pl9:f1
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1
  50u UNBLKGRAD

  p19:gp8
  d16*4

  (p1 ph3)
  p16:gp1
  d16
  DELTA1

  (p13:sp2 ph4):f2
  p16:gp2
  d16
  (DELTA2 p2 ph3 DELTA3):f1 (d0 p14:sp5 ph1 DELTA4 p14:sp3 ph1):f2 (d0 CEN_CN2 p22 ph1):f3
  p16:gp3
  d16

  (p1 ph3)
  d10
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d10
  (p14:sp3 ph5):f2
  d10
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d10
  (p2 ph1)
  DELTA
  (p1 ph6)

  p16:gp4
  d16
  (DELTA3 p2 ph1 DELTA6):f1 (d0 p14:sp5 ph1 DELTA5 p14:sp3 ph1):f2 (d0 CEN_CN2 p22 ph1):f3
  4u
  (p14:sp5 ph1):f2
  4u
  (p14:sp5 ph1):f2
  p16:gp5
  d16
  (p13:sp8 ph1):f2

  DELTA1
  p16:gp6
  d16
  (p1 ph1)

  p16:gp7
  d16 pl12:f2
  4u BLKGRAD

  (p1 ph1)
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d0, +in0)) 
     F2PH(calph(ph3, +90) & calph(ph29, +90), caldel(d10, +in10))
exit


ph1=0
ph2=1
ph3=0 0 2 2
ph4=0
ph5=0 1 2 3
ph6=0 0 0 0 2 2 2 2
ph29=0
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl12: f2 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [500 usec]
;p19: gradient pulse 2                                 [2 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(CH))                                       [3.4 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d23: 1/(4J'(HaHb))                                    [8.7 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(C) = 2 * DW(C)
;inf2: 1/SW(H) = 2 * DW(H)
;in0: 1/(4 * SW(C)) = (1/2) DW(C)
;nd0: 4
;in10: 1/(4 * SW(H)) = (1/2) DW(H)
;nd10: 4
;ns: 16 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:
;        gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6 : gp 7 : gp 8
;          13 :   21 :   34 :  -28 :  -41 :   13 :    9 :   50

;for z-only gradients:
;gpz1: 13%
;gpz2: 21%
;gpz3: 34% : gpz1 + gpz2
;gpz4: -28% : gpz5 + gpz6
;gpz5: -41%
;gpz6: 13% : = gpz1
;gpz7: 9%
;gpz8: 50%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



