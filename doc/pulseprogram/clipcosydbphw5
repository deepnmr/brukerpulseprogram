;clipcosydbphw5
;avance-version (20/07/28)
;Clean In-phase COSY NOESY-WaterControl
;2D H-1/H-1 correlation using in-phase transfer
;phase sensitive
;water suppression using watergate W5 pulse sequence with gradients
;using double echo
;
;J. Chen, A.M. Torres, G. Zheng & W.S. Price  
;   J. Biomol. NMR 74, 333-340 (2020)
;A.M. Torres, G. Zheng & W.S. Price, J. Biomol. NMR 67, 233-241 (2017)
;M.R.M. Koos, G. Kummerloewe, L. Kaltschnee, C.M. Thiele & B. Luy, 
;   Angew. Chem. Int. Ed. 55, 7655-7659 (2016)
;T.-L. Hwang & A.J. Shaka, J. Magn. Reson.,
;   Series A 112 275-279 (1995)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d4=1s/(cnst1*4)"
"d11=30m"

"p30=3m"


"in0=inf1"

"d0=in0/2-p1*4/PI"


"DELTA=50u+p1*2/PI-de"


"d25=d15-p1*2-p16*2-p30-d16*3-p27*4.77-d19*10-150u-DELTA"


"acqt0=0"
baseopt_echo


1 ze 
2 d11
3 d1
  "d25=d15-p1*2-p16*2-p30-d16*3-p27*4.77-d19*10-150u-DELTA"
  20u pl1:f1
  50u UNBLKGRAD

  p1 ph1
  d0
  p1 ph2

  10u gron0
  (p32:sp29 ph3):f1
  20u groff
  d16 pl1:f1

  p1 ph4
  d4
  p2 ph5
  d4
  p1 ph5
  d4
  p2 ph6
  d4

  50u pl18:f1
  p16:gp1
  d16
  p27*0.231 ph7
  d19*2
  p27*0.692 ph7
  d19*2
  p27*1.462 ph7
  d19*2
  p27*1.462 ph8
  d19*2
  p27*0.692 ph8
  d19*2
  p27*0.231 ph8

  p16:gp2
  d16 pl1:f1
  50u

  p1 ph9

  50u
  p30:gp3
  d16
  50u BLKGRAD

  d25

  p1 ph10

  50u UNBLKGRAD

  p16:gp1
  d16 pl18:f1

  p27*0.231 ph11
  d19*2
  p27*0.692 ph11
  d19*2
  p27*1.462 ph11
  d19*2
  p27*1.462 ph12
  d19*2
  p27*0.692 ph12
  d19*2
  p27*0.231 ph12

  p16:gp2
  d16

  DELTA BLKGRAD

  go=2 ph31 
  d11 mc #0 to 2 
     F1PH(calph(ph1, +90), caldel(d0, +in0))
  d15
exit 

ph1=0 2
ph2=0
ph3=0
ph4=0
ph5=1
ph6=3
ph7=1 1 3 3
ph8=3 3 1 1
ph9=0
ph10=2
ph11=1 1 1 1 3 3 3 3
ph12=3 3 3 3 1 1 1 1
ph31=0 2


;pl1 : power level for pulse (default)
;pl18: f1 channel - power level for 3-9-19-pulse (watergate)
;sp29: f1 channel - shaped pulse (adiabatic)
;p1 : 90 degree high power pulse
;p2 : 180 degree high power pulse
;p16: homospoil/gradient pulse                                 [1 msec]
;p27: f1 channel -  90 degree pulse at pl18
;p30: crusher gradient                                         [3 msec]
;p32: f1 channel - 180 degree shaped pulse (adiabatic)         [20 msec]
;     smoothed chirp (sweepwidth, 20% smoothing, 10000 points)
;p40: f1 channel - 180 degree shaped pulse (Squa100.1000)      [2 msec]
;d0 : incremented delay (2D) = in0/2-p1*4/PI
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(HH))
;d11: delay for disk I/O                                       [30 msec]
;d15: diffusion time for WaterControl (BigDelta)               [15-50 msec]
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;cnst1: > J(HH)                                                [30 Hz]
;l8: number of relay steps
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/(1 * SW(H)) = 2 * DW(H)
;nd0: 1
;ns: 2 * n
;ds: 32
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;for z-only gradients:
;gpz0: ca. 11% 
;gpz1: 97%
;gpz2: 97%
;gpz3: 73.13%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


;for sweepwidth of adiabatic shape and adjusting gpz0
;   see supplementary material of M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



