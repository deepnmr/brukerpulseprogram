;onepulse30
;
;derived from zg30
;version 17/03/28
;written and checked: VDec 17/03/28

;1D sequence using 30 degree flip angle
;

;Avance version
;parameters:
;p1 : f1 90 pulse length at pl1 for pulsecal
;pl1 : f1 90 pulse power for pulsecal
;d1 : recycle delay, 1-5 * T1
;ns : 4 (full: 8), 1 * n, total number of scans: NS * TD0


;$CLASS=Solids
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$RECOMMEND=y

prosol relations=<solids_default>

#include <Avance.incl>


"acqt0=-p1*0.66/3.1416"


Prepare, ze

;######################################################
;#           Start of Active Pulse Program            #
;######################################################

Start, 30m
  d1

  (p1*0.33 pl1 ph1):f1

;#######################################################
;#                     Acquisition                     #
;#######################################################

  go=Start ph31
  30m mc #0 to Start F0(zd)

HaltAcqu, 1m
Exit, exit

;#####################################
;#             Phase Cycle           #
;#####################################

ph1= 0 2 2 0  1 3 3 1       ; f1 hard pulse
ph31=0 2 2 0  1 3 3 1       ; receiver

;######################################################



