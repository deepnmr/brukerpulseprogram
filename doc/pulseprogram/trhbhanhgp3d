;trhbhanhgp3d
;avance-version (21/09/15)
;TROSY-HBHANH
;3D sequence with
;   inverse correlation for triple resonance using 
;      TROSY and inept transfer steps 
;
;      F1(H,t1) -> F2(Caliph. -> Ca) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho (t2)
;using semi-constant time in t1
;using constant time in t2
;(use parameterset TRHBHANHGP3D)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include<Avance.incl>
#include<Grad.incl>
#include<Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=2.2m"
"d4=1.8m"
"d21=12.4m"
"d22=3.6m"
"d26=2.3m"
"d27=11.0m"


"d0=d4"
"d10=3u"
"d20=3u"
"d28=d4+p14+d20"
"d30=d21-p11-8u-p1"

"in0=inf1/2"
"in10=inf2/2"

"FACTOR1=d28*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = 0; } else { in20=in0-INCR1; }"
"if ( INCR1 > in0 ) { in28 = in0; } else { in28 = INCR1; }"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d22-d3"
"DELTA2=d21-d10-p14-p21*4/3.1416"
"DELTA3=d26-p16-d16"
"DELTA4=d26-p11-p16-d16-8u"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


"cnst62=-(bf1*cnst20-(o1*1000000))"
"cnst63=(bf1*cnst20-(o1*1000000))*(inf1/1000000)*360.0"


"o1_F1=bf1*cnst20/1000000"


"TAU9=abs(cnst62+cnst63)/100000"


"l0=1"


aqseq 321


1 ze
2 d11
3 d11
  d1
  50u UNBLKGRAD
  d12 pl1:f1 pl3:f3

  (p1 ph3):f1
  d0
  (p14:sp3 ph1):f2
  d20
  (p2 ph1):f1 
  d28
  (p1 ph2):f1

  (p13:sp2 ph6):f2
  d3 pl19:f1
  DELTA1 cpds1:f1 ph2
  (p14:sp3 ph1):f2
  d22
  (p13:sp8 ph1):f2

  4u
  d27
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d27
  4u
  (p13:sp2 ph1):f2

  4u do:f1
  (p26 ph9):f1
  p16:gp1
  d16

  if "l0 %2 == 1"
     {
     (p21 ph4):f3
     }
  else
     {
     (p21 ph5):f3
     }

  d10
  (p14:sp5 ph1):f2
  DELTA2
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d30
  (p11:sp1 ph1:r):f1
  4u
  4u pl1:f1

  (p1 ph7)
  p16:gp2
  d16
  DELTA3
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp2
  d16
  (center (p1 ph1) (p21 ph7):f3 )
  p16:gp3
  d16
  DELTA4
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph8:r):f1
  DELTA4
  p16:gp3
  d16 pl1:f1
  4u BLKGRAD
  (p21 ph1):f3
  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, +in20) & caldel(d28, -in28) & calph(ph3, cnst63)) 
     F2EA(calph(ph7, +180) & calclc(l0, 1), caldel(d10, +in10) & caldel(d30, -in30) & calph(ph4, +180) & calph(ph5, +180) & calph(ph31, +180))

TAU9
exit


ph1=0
ph2=1
ph3=0 0 0 0 2 2 2 2
ph4=1 3 0 2
ph5=1 3 2 0
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph7=3
ph8=2
ph9=0 0 0 0 2 2 2 2
ph31=1 3 2 0 3 1 0 2 3 1 0 2 1 3 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1 : f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D) = d4
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(CH)) : 1.1m-p14
;d4 : 1/(4J(CH))                                       [1.7 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: incremented delay (F1 in 3D)                     [3 usec]
;d21: 1/(4J(NCa)), T(N)                                [12.4 msec]
;d22: 1/(8J(CaCb)), T(C)                               [3.6 msec]
;d26: 1/(4J(NH))                                       [2.3 msec]
;d27: 1/(4J'(NCa))                                     [11 msec]
;d28: decremented delay (F1 in 3D) = d4+p14+d20
;d30: decremented delay (F2 in 3D) = d21-p11-8u-p1
;cnst20: H(ali) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;cnst62: offset for Hali region (Hz)
;cnst63: additional phase increment to center Hali region
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(Hab) = 2 * DW(Hab)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Hab)) = DW(Hab)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = (1 - k1) * in0
;in28: = k1 * in0
;in30: = in10
;ns: 16 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    	gp 1 : gp 2 : gp 3
;				  30 :   18 :   44

;for z-only gradients
;gpz1: 30%
;gpz2: 18%
;gpz3: 44%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



;Processing

;PHC0(F2): 90

;SR(F1): 1/4 SWH(F1)



