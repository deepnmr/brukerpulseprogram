;$Id:$
;HMQC
;pseudo 2D version
;1D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;no decoupling during acquisition
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"p2=p1*2"
"d2=1s/(cnst2*2)"

1 ze
2 30m
  d1
  p1 ph1
  d2
  p3:f2 ph3
  p2 ph2
  p3:f2 ph4
  d2
  go=2 ph31
  30m wr #0 if #0 zd
  lo to 2 times td1
exit

ph1=0
ph2=0
ph3=0 2
ph4=0 0 2 2
ph31=0 2 2 0

;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J)XH
;cnst2: = J(XH)
;NS: 2 * n, total number of scans: NS * TD0
;DS: >=8
