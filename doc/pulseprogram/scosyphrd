;scosyphrd
;avance-version (12/01/11)
;soft 2D COSY using shaped pulse for excitation
;phase sensitive
;O1 in the middle of the region to be excited during t1 and t2
;with refocussing to prevent large phase-correction constants
;   in f1
;
;R. Brueschweiler, J.C. Madsen, C. Griesinger, O.W. Sorensen &
;   R.R. Ernst, J. Magn. Reson. 73, 380 - 385 (1987)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


"p2=p1*2"
"d12=20u"


"in0=inf1"

"d0=3u"


"DELTA=p11*cnst17+d12-d0-p0*2/3.1416+4u"


1 ze
2 d1
3 d12 
  p11:sp1:f1 ph1
  4u
  d12  pl1:f1
  p2 ph2
  d20
  d0
  p0 ph3
  go=2 ph31
  d1 mc #0 to 2 F1PH(calph(ph1, +90) & calph(ph2, +90), caldel(d0, +in0))
exit


ph1=0 0 2 2 1 1 3 3
ph2=0 0 2 2 1 1 3 3 2 2 0 0 3 3 1 1
ph3=0 2 2 0 1 3 3 1
ph31=0 0 2 2 1 1 3 3


;pl1 : f1 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse
;p0 : f1 channel - 20 to 90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;d20: d20 = p11/2 + d12
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;cnst17: = factor to compensate for coupling evolution during 
;             a pulse (usually between 0 and 2/pi)
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ



;$Id:$
