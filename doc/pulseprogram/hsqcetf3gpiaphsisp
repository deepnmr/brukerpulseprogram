;hsqcetf3gpiaphsisp
;avance-version (21/09/15)
;HSQC - IPAP
;2D H-1/X correlation via double inept transfer
;phase sensitive
;with decoupling during acquisition
;using f3 - channel
;water suppression using watergate sequence
;using selective proton pulses
;
;L. Yao, J. Ying & A, Bax, J. Biomol. NMR 43, 161-170 (2009)
;(M.Ottiger, F. Delaglio & A. Bax, J. Magn. Reson. 131, 373-378 (1998) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"


"d0=10u"

"in0=inf1/4"


"DELTA=p8+d0*4+16u"
"DELTA1=d26-p16-d16"
"DELTA2=p16+d16-p1*0.78+de+8u"
"DELTA3=d26/2-p16-d16"

"TAU=p11"


"spoffs38=bf1*(cnst20/1000000)-o1"


"l0=1"


"acqt0=0"
baseopt_echo


1 ze 
  d11 pl16:f3
2 d11 do:f3
  4u
3 d1 pl1:f1 pl3:f3
  50u UNBLKGRAD
  (p21 ph1):f3
  p16:gp3
  d16

  (p1 ph1)
  p16:gp4
  d16
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1
  p16:gp4
  d16
  (p1 ph2)

  if "l0 %2 == 1"
     {
     2u
     (p11:sp1 ph1):f1
     (p21 ph1):f3
     p16:gp6
     d16 pl1:f1
     DELTA1
     (p2 ph1)
     DELTA1
     p16:gp6
     d16
     (p22 ph1):f3
     p16:gp6
     d16
     DELTA1
     (p2 ph3)
     DELTA1
     p16:gp6
     d16
     (p21 ph1):f3
     }
  else
     {
     TAU
     (p21 ph4):f3
     p16:gp4
     d16
     DELTA1
     (center (p2 ph1) (p22 ph4):f3 )
     DELTA1
     p16:gp4
     d16
     (p1 ph3) (p21 ph1):f3
     }

  p16:gp5
  d16

  (p21 ph5):f3
  d0 gron0*-1
  d0 gron0
  10u groff
  (p8:sp13 ph1):f2
  (p55:sp38 ph3):f1
  d0 gron0
  d0 gron0*-1
  10u groff
  p16:gp1*EA
  d16
  (p22 ph6):f3
  p16:gp1*EA*-1
  d16
  DELTA
  (p55:sp38 ph1):f1
  2u
  2u pl1:f1 pl2:f2

  (center (p1 ph1) (p21 ph7):f3 )
  p16:gp4
  d16
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1
  p16:gp4
  d16
  (center (p1 ph2) (p21 ph8):f3 )
  p16:gp4
  d16
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1
  p16:gp4
  d16
  (center (p1 ph1) (p21 ph2):f3 )
  DELTA2
  (p2 ph1) (p3 ph1):f2
  4u
  p16:gp2
  d16 pl16:f3
  4u BLKGRAD

  go=2 ph31 cpd3:f3

  d11 do:f3 mc #0 to 2 
     F1I(iu0, 2)
     F1EA(calgrad(EA) & calph(ph8, +180), caldel(d0, +in0) & calph(ph5, +180) & calph(ph31, +180))

exit 
  

ph1=0
ph2=1
ph3=2
ph4=3
ph5=0
ph6=0 1 2 3
ph7=0 0 0 0 2 2 2 2
ph8=1
ph31=0 2 0 2 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp38: f1 channel - shaped pulse 180 degree (Iburp2.1000)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p55: f1 channel - 180 degree shaped pulse for inversion
;                      Iburp2                    (1.3ms at 600.13 MHz)
;d0 : incremented delay (2D)                         [10 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J)NH                                       [2.5 msec]
;cnst4 : = J(NH)
;cnst20: H(ali) chemical shift (offset, in ppm)
;l0: flag to switch between inphase and antiphase 
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(4 * SW(X)) = (1/2) DW(X)
;nd0: 4
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: 2%
;gpz1: 80%
;gpz2: 16.2%
;gpz3: 23%
;gpz4: 11%
;gpz5: 31%
;gpz6: 5.5%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100


;use AU-program split [ipap 2] to split data



