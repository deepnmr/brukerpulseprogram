;c_hncanco_ia3d
;avance-version (21/09/15)
;(H)N(Ca)NCO
;3D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(H) -> F3(N,t1) -> F1(Ca) -> F3(N,t2) -> F1(C=O,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using constant time in t1
;using constant time in t2
;(use parameterset )
;
;W. Bermel, I. Bertini, V. Csizmok, I. C. Felli, R. Pierattelli & 
;   P. Tompa, J. Magn. Reson. 198, 275-281 (2009)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d21=5.5m"
"d22=4.5m"
"d23=12m"
"d24=12.5m"
"d26=2.3m"
"d27=16.0m"


"d0=d23/2-p12/2"
"d10=d23"
"d20=d23/2-p12/2"
"d28=d23/2-p12/2-d21-4u"
"d30=d27"

"in0=inf1/4"
"in10=inf2/2"

"in20=in0"
"in28=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d27-d10-p12"
"DELTA2=d27/2-p12/2"
"DELTA3=d27-d22-p12"


"l0=1"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs28=0"


aqseq 312


1 d11 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph1):f2
  d26
  (center (p4 ph1):f2 (p22 ph1):f3 )
  d26
  (p3 ph2):f2
  
  p16:gp1
  d16

  (p21 ph3):f3
  d21 pl12:f2
  4u cpd2:f2
  d28 
  (p12:sp26 ph1)
  d0
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d20
  (p12:sp26 ph1)
  d20
  (p21 ph1):f3

  (p11:sp23 ph4) 
  d24
  (p12:sp26 ph1)
  d24
  (center (p25:sp28 ph1) (p22 ph1):f3 )
  d24
  (p12:sp26 ph1)
  d24
  (p11:sp25 ph1)

  4u do:f2
  p16:gp2
  d16 fq=cnst21(bf ppm):f1
  20u cpd2:f2

  (p21 ph5):f3
  d10
  (p12:sp27 ph1)
  DELTA1
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d30
  (p21 ph1):f3

  4u do:f2
  p16:gp2
  d16
  20u cpd2:f2

  if "l0 %2 == 1"
     {
     (p11:sp23 ph6)
     DELTA2
     (p12:sp27 ph1)
     DELTA2
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA2
     (p12:sp27 ph1)
     DELTA2 pl16:f3
     }
  else
     {
     (p11:sp23 ph7)
     d22
     (p12:sp27 ph1)
     DELTA3
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA2
     DELTA2 pl16:f3
     (p12:sp27 ph1)
     }
  
  4u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2

#   ifdef LABEL_F2
  F2I(iu0, 2)
#   else
  F1I(iu0, 2)
#   endif /*LABEL_F2*/

  F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28))
  F2PH(calph(ph5, +90), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph7=3 3 3 3 3 3 3 3 1 1 1 1 1 1 1 1
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;d0 : incremented delay (F1 in 3D) = d23/2-p12/2
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D) = d23
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d23/2-p12/2
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCa)                                       [12 msec]
;d24: 1/(4J`(NCa)                                      [12.5 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d27: 1/(4J(NCO))                                      [16.0 msec]
;d28: incremented delay (F2 in 3D) = d23/2-p12/2-d21-4u
;d30: decremented delay (F2 in 3D) = d27
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(Ca)) = (1/2) DW(Ca)
;nd0: 4
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = in0
;in28: = in0
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_F2: to do ipap in F2 start experiment with
;             option -DLABEL_F2 (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] to process data



