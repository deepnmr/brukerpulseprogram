; gemstones
; Single-Scan Ultraselective NMR Experiments with Preserved Sensitivity
; using wavemaker to create shaped pulses

;P. Kiraly, N. Kern, M.P. Plesniak, M. Nilsson , D.J. Procter, G.A. Morris & R.W. Adams Angew. Chem. Int. Ed., 60, 666-669 (2021)
;M. Bazzoni, R. Mishra & J.-N. Dumez, Angew. Chem. Int. Ed. 2023, e202314598

;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=Selective Experiments
;$COMMENT=Single-Scan Ultraselective NMR Experiments with Preserved Sensitivity, run wvm -q before zg or launch with xaua


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define list<gradient> EAg = { 1.00 -1.00 1.00 -1.00 1.00 -1.00}
define list<gradient> gl2 = { 1.00 1.20 0.50 0.75 0.90 1.30}


"d11=30m"
"d11=30m+1s/(1+cnst50)"
"d11=30m+1s/(1+cnst51)"
"d11=30m+1s/(1+cnst52)"
"d11=30m"

"cnst53=cnst52/l5"

create_shape(sp41, cawurst, powerIndex=80, name= CSSF_ad1, length=$cnst53 ms, stepSize= 5.0 us, bandwidth= $cnst51 Hz, Q=11, sweepDirection=lowToHigh)
create_shape(sp42, cawurst, powerIndex=80, name= CSSF_ad2, length=$cnst53 ms, stepSize= 5.0 us, bandwidth= $cnst51 Hz, Q=11, sweepDirection=highToLow)
create_shape(sp22, rsnob, name= CSSF_sel, stepSize= 10.0 us, bandwidth= $cnst50 Hz)




"acqt0=0.0"
baseopt_echo


1 ze
2 30m
  "l0=1"
  50u BLKGRAMP	
  50u LOCKH_OFF 
  d1 pl1:f1
  50u LOCKH_ON 
  50u UNBLKGRAMP


  (p1 ph1):f1


3 d16
  (center (p41:sp41 ph3):f1 (p41:gp11*EAg))
  d16

  p16:gp1*gl2
  d16
 if "l0 == 1" 		
  { 

   p22:sp22:f1 ph2 
  }
  else 
  {
   p22:sp22:f1 ph3 
  }
	
  p16:gp1*gl2
  d16 

  d16
  (center (p42:sp42 ph4):f1 (p42:gp12*EAg) )	
  d16 pl1:f1
  
  "l0=l0+1"
  igrad gl2
  igrad EAg
lo to 3 times l5 

  go=2 ph31
  30m mc #0 to 2 F0(zd)

50u BLKGRAD

exit

ph1 = 0 
ph2 = 0 1  
ph3 = 0 0 
ph4 = 0 0
ph31 = 2 0  

;pl1 : f1 channel - power level for pulse (default)
;sp22: f1 channel - shaped pulse
;sp41: f1 channel - shaped pulse (adiabatic)
;sp42: f1 channel - shaped pulse (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p22: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                            [1 msec]
;p41: f1 channel - 180 degree adiabatic pulse
;p42: f1 channel - 180 degree  reverse sweep adiabatic pulse  
;d1 : relaxation delay; 1-5 * T1
;d16: delay for homospoil/gradient recovery
;ns: 2 * n, total number of scans: NS * TD0
;ds: 4
;cnst50: band-width of the band-selective RSNOB pulse in Hz
;cnst51: sweep-width of the adiabatic pulse in Hz
;cnst52: duration of the adiabatic pulse in ms [t1max/2: 30-150]
;l0: loop couunter, changes during run time
;l5: gemstone steps [1-6]

;for z-only gradients:
;gpz1:   15%
;gpz2:   17%
;gpz11: 0.5% (0.5-2.5%)
;gpz12:-0.5%  (-gpz11%)

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam11: RECT.1
;gpnam12: RECT.1

;launch with xaua or run wvm -q before zg
