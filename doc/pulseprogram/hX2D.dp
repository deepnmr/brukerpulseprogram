;hX2D.dp
;avance-version (23/01/12)
;JOS
;checked 2.7.2020 krgr
;fixed  diydec JOS August2024
;version: 2.0/ TS4.4.0 05/04/2024

;getting ready for ICONNMR - pulse calculation

;$COMMENT= single pulse excitation, acquisition without decoupling
;$CLASS=BioSolids
;$DIM=1D
;$TYPE=direct polarization
;$SUBTYPE=

prosol relations=<solids_ICON>

#include <Delay.incl>
#include <trigg.incl>
#include <Decoup_Solids.incl>
"d31=1s/cnst31"

"DELTA=d20-((d1+aq)*(ns+ds))-30m"
"acqt0=-p1*2/3.1416"


Prepare, ze
d31
#ifndef nodec
Start, 30m do:f2
#else 
Start, 30m
#endif
  DELTA
3  d1
#ifndef lacq
#include <acq_prot.incl>
        ;Max. 50 ms acquisition time
#endif
 trigg
;######################################################
;#           Start of Active Pulse Program            #
;######################################################

#ifndef nodec
 (p1 pl1 ph1):f1 (1u pl12):f2
 go=3 ph31 cpds2:f2 finally do:f2
1m do:f2
#else
  (p1 pl1 ph1):f1
 go=3 ph31 
#endif
;#######################################################
;#                     Acquisition                     #
;#######################################################

  10m mc #0 to Start F1QF()
  
HaltAcqu, 1m
Exit, exit

;#####################################
;#             Phase Cycle           #
;#####################################

ph1= 0 2 1 3		; C hard pulse

ph31=0 2 1 3		; receiver

;#######################################################


;Avance NEO / III version
;parameters:
;p1  : C 90 at pl1
;pl1 : C pulse power
;pl12: H dec power
;cnst31 : MAS rate in Hz 
;cnst32  : 1H decoupling power correction factor in %
;d1  : recycle delay
;pcpd2   : not used, instead p31 is H dec pulse cpdprg2 (calculated)
;cpdprg2 : Decoupling file cw, tppm (at pl12)
;ZGOPTNS : -Dnodec
;ns: 4 (full:4)



;$Id: hX2D.dp,   JOS $
