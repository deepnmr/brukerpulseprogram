;noesygpphzs_psyche
;avance-version (18/12/03)
;2D homonuclear correlation via dipolar coupling 
;dipolar coupling may be due to noe or chemical exchange.
;phase sensitive
;with gradient/rf spoil pulse in mixing time
;broadband homodecoupling using psyche element in F1
;
;M. Foroozandeh, R.W. Adams, P. Kiraly, M. Nilsson and G.A. Morris,
;   Chem. Commun. , x-x (2015)
;M. Foroozandeh, R.W. Adams, M. Nilsson & G.A. Morris, 
;   J. Am. Chem. Soc. 136, 11867-9 (2014)
;M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)
;(J. Jeener, B.H. Meier, P. Bachmann & R.R. Ernst, J. Chem. Phys. 71,
;   4546-4553 (1979) )
;(R. Wagner & S. Berger, J. Magn. Reson. 123 A, 119-121 (1996) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define delay BETA
define pulse P_in


"p31=5m"


"in0=inf1/2"

"d0=in0/2"


"cnst62=(cnst61/360)*sqrt((2*cnst60)/(p49/2000000))"
"P_in = 1000000.0 / (cnst62*4)"
"BETA = cnst62 / (2.27 * 2) "
"cnst63= (P_in/p1) * (P_in/p1)"
"spw37=plw1/cnst63"


"TAU=d8-p32-p31-d16-12u"


"acqt0=-p1*2/3.1416"


1 ze
2 d1
  50u UNBLKGRAD
  4u pl1:f1

  (p1 ph1)
  4u
  (p44:sp30 ph4):f1
  d0

  p16:gp1
  d16

  (p44:sp30 ph4):f1

  p16:gp1
  d16
  p16:gp2
  d16
  (p49:sp37 ph5):f1 (p49:gp0)
  4u
  p16:gp2
  d16 pl1:f1
  d0

  (p1 ph2)
  4u
  (p32:sp29 ph4):f1 (p32:gp10)
  4u
  p31:gp3
  d16 pl1:f1
  4u BLKGRAD
  TAU
  (p1 ph3)
  go=2 ph31
  d1 mc #0 to 2 
     F1PH(calph(ph1, -90), caldel(d0, +in0))
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2
ph4=0
ph5=0 0 0 0 1 1 1 1
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;sp29: f1 channel - shaped pulse (adiabatic)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp37: f1 channel - shaped pulse 180 degree for psyche element (Crp_psyche.20)
;spnam37: Crp_psyche.20
;p1 : f1 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                              [1 msec]
;p31: gradient pulse 5                                  [5 msec]
;p32: f1 channel - 180 degree shaped pulse (adiabatic)  [20 msec]
;     smoothed chirp (sweepwidth, 20% smoothing, 10000 points)
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;p49: f1 channel - 180 degree shaped pulse for psyche element  [30 msec]
;                      Crp_psyche.20
;d0 : incremented delay (2D) = in0/2
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d16: delay for homospoil/gradient recovery
;cnst60: sweepwidth of single chirp element in Crp_psyche.20   [10000 Hz]
;cnst61: desired flip angle (ca. 20 degree)
;cnst62: gammaB1/2PI value for p49:sp37 (in Hz)
;cnst63: scaling factor for power (sp37)
;BETA: flip angle (ca. 20 degree)
;inf1: 1/SW = 2 * DW
;in0: 1/(2 * SW) = DW
;nd0: 2
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;for z-only gradients:
;gpz0: 2%
;gpz1: 49%
;gpz2: 77%
;gpz3: 40%
;gpz10: ca. 11%

;use gradient files:   
;gpnam0: RECT.1
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam10: RECT.1



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



;for sweepwidth of adiabatic shape and adjusting gpz0
;   see supplementary material of M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)



