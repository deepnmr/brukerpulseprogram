;dipsi2gpphzs_spe
;avance-version (21/09/15)
;homonuclear Hartman-Hahn transfer using DIPSI2 sequence
;   for mixing
;phase sensitive
;using single perfect echo
;with zero quantum suppression
;
;B. Baishya & A. Verma, J. Magn. Reson. 252, 41-48 (2015)
;M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"d0=3u"
"d20=3u"


"in0=inf1"

"in20=in0/2"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"spoffs29=0"


"acqt0=-p1*2/PI"


1 ze
2 d1
  20u pl1:f1
  50u UNBLKGRAD

  4u
  p16:gp1
  d16

  (p1 ph3):f1
  4u
  (p44:sp30 ph1):f1
  d20
  8u
  p16:gp2
  d16
  (p44:sp30 ph1):f1
  4u
  p16:gp2
  d16 pl1:f1
  d20
  (p1 ph4):f1

  d0

  4u
  p16:gp3
  d16
  (p44:sp30 ph1):f1
  8u
  p16:gp3
  d16

  (p44:sp30 ph1):f1
  4u
  (p1 pl1 ph5):f1

  10u gron0
  (p32:sp29 ph1):f1
  20u groff
  d16 pl10:f1

                                                ;begin DIPSI2
4 (p6*3.556 ph23):f1
  (p6*4.556 ph25):f1
  (p6*3.222 ph23):f1
  (p6*3.167 ph25):f1
  (p6*0.333 ph23):f1
  (p6*2.722 ph25):f1
  (p6*4.167 ph23):f1
  (p6*2.944 ph25):f1
  (p6*4.111 ph23):f1
  
  (p6*3.556 ph25):f1
  (p6*4.556 ph23):f1
  (p6*3.222 ph25):f1
  (p6*3.167 ph23):f1
  (p6*0.333 ph25):f1
  (p6*2.722 ph23):f1
  (p6*4.167 ph25):f1
  (p6*2.944 ph23):f1
  (p6*4.111 ph25):f1
 
  (p6*3.556 ph25):f1
  (p6*4.556 ph23):f1
  (p6*3.222 ph25):f1
  (p6*3.167 ph23):f1
  (p6*0.333 ph25):f1
  (p6*2.722 ph23):f1
  (p6*4.167 ph25):f1
  (p6*2.944 ph23):f1
  (p6*4.111 ph25):f1
 
  (p6*3.556 ph23):f1
  (p6*4.556 ph25):f1
  (p6*3.222 ph23):f1
  (p6*3.167 ph25):f1
  (p6*0.333 ph23):f1
  (p6*2.722 ph25):f1
  (p6*4.167 ph23):f1
  (p6*2.944 ph25):f1
  (p6*4.111 ph23):f1
  lo to 4 times l1
						;end DIPSI2

  p16:gp4
  d16

  10u gron0*1.333
  (p32*0.75:sp29 ph1):f1
  20u groff
  d16 pl1:f1
  4u BLKGRAD
  (p1 ph1):f1
  go=2 ph31

  d1 mc #0 to 2
     F1PH(calph(ph5, -90), caldel(d0, +in0) & caldel(d20, +in20))
 
exit


ph1=0
ph2=1
ph3=0 2
ph4=1 1 1 1 3 3 3 3
ph5=0 0 2 2

ph23=0
ph25=2

ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;sp29: f1 channel - shaped pulse (adiabatic)
;sp30: f1 channel - shaped pulse for broadband inversion
;p1 : f1 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p16: homospoil/gradient pulse                              [1 msec]
;p32: f1 channel - 180 degree shaped pulse (adiabatic)      [20 msec]
;     smoothed chirp (sweepwidth, 20% smoothing, 10000 points)
;p44: f1 channel - 180 degree shaped pulse for broadband inversion
;d0 : incremented delay (2D)                                [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d16: delay for homospoil/gradient recovery
;d20: incremented delay (2D)                                [3 usec]
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;in20: = in0/2
;ns: 8 * n
;ds: 32
;td1: number of experiments
;FnMODE: States-TPPI


;for z-only gradients:
;gpz0: ca. 11%
;gpz1: 80%
;gpz2: 51%
;gpz3: 31%
;gpz4: 41%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



;for sweepwidth of adiabatic shape and adjusting gpz0
;   see supplementary material of M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)




