;hsqct2etf3gpsitc3d.3
;avance-version (23/03/23)
;3D 1H/15N correlation via double inept transfer
;   using sensitivity improvement
;for measuring 15N T2 relaxation times in unfolded proteins
;using CPMG relaxation delay with 1H CPD decoupling
;with temperature compensation
;as pseudo3D
;
; Experiment is intended for unfolded proteins, 1H decoupling during 
; relaxation delay minimizes effects of amide proton/water exchange on 
; relaxation times. Relaxation delays are given via a vc list, each 
; relaxation delay corresponds to d31 * vc list entry.  Residual  
; water magentization is purged before d1 to ensure indetical starting 
; magnetization for all scans. For measurements at increased pH  (> ~7)
; and temperature (> ~25 C) relaxation times will be influenced by H/D 
; exchange, use lower D2O concentration or D2O in inset to prevent this
; (see Yuwen et al.).
;
;(use parameterset HSQCT2ETF3GPSITC3D.3)
;
;T. Yuwen & N.R. Skrynnikov, J. Magn. Reson., 241, 155-169 (2014)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

prosol relations=<triple>

#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define list<loopcounter> cpmglist=<$VCLIST>

define loopcounter vc_max
define loopcounter COUNTER1
define loopcounter COUNTER2


"p2=p1*2"
"p22=p21*2"
"p6=1s/(4*cnst60)"
"plw19=pow(p1/p6,2)*plw1"
"d11=30m"
"d25=2.75m"
"d26=2.25m"

"d31=(115.112*p6)*4*cnst61"
"d21=(d31-4*p22)/8"

"d10=3u"
"in10=inf2/2"

"DELTA1=d25-p16-d16-d10*2-4u"
"DELTA2=p16+d16-p1*2/PI+de+8u"
"DELTA3=d21-p44/2"
"DELTA4=d25-p16-d16"
"DELTA5=d26-p16-d16"
"DELTA6=d26-p16-d16"
"DELTA7=d25-p16-d16-p44"
"DELTA8=d25-p16-d16-p21*2/PI"
"DELTA9=d25-p16-d16-4u"

"l3=td1"
"l11=0"
"l31=0"

"spoffs1=0"
"spoffs13=bf2*((cnst21+cnst22)/2000000)-o2"
"spoffs30=0"

"acqt0=0"
baseopt_echo

aqseq 312

1 ze
  d11
  
  if "td1 != cpmglist.len" 
     {
     2u
     print "Warning: td1 is not equal to the number of vc list entries"
     }
  20u
  "vc_max = 0"

; determine maximum vc list entry from the first td1 entries  
9 20u
  if "cpmglist > vc_max"
     {
     20u
     "vc_max=cpmglist"
     }
  
  3m cpmglist.inc
  lo to 9 times l3

  3m cpmglist.res
  
  20u
  "l31=cpmglist[l11]"
  
2 d11 do:f3 

; calculate COUNTER for temperature compensation and CPMG relaxation delay
  20u
  "COUNTER2=vc_max-l31"
  20u
  "l31=cpmglist[l11]"
  20u
  "COUNTER1=l31"

; temperature compensation for previous scan
  20u pl19:f1 pl3:f3
  4u cpd1:f1 ph1
8 (d21 p22 ph1 d21*2 p22 ph1 d21*2 p22 ph2 d21*2 p22 ph4 d21):f3 
  lo to 8 times COUNTER2
  4u do:f1
  
; purge water magnetization
  4u pl11:f1
  (5mp ph1):f1
  (2.5mp ph2):f1
  p16:gp9
  d16 pl1:f1
  p1 ph1
  p16:gp10
  
;recycle delay + purge 15N magnetization  
  d1 pl1:f1 pl3:f3
  4u UNBLKGRAD
  (p21 ph1):f3
  p16:gp1
  d16
  
; H->N transfer first INEPT
  (p1 ph1)
  p16:gp2
  d16
  DELTA6
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p16:gp2
  d16
  (p1 ph2)
  p16:gp3
  d16
  
; H->N transfer second INEPT
  (p21 ph9):f3
  p16:gp4
  d16
  DELTA8 
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA9 pl19:f1
  p16:gp4
  d16 fq=cnst54 (bf ppm):f1
  4u cpds1:f1 ph1
  
; CPMG relaxation delay
6 (d21 p22 ph1 d21*2 p22 ph1 d21*2 p22 ph2 d21*2 p22 ph4 d21):f3 
  lo to 6 times COUNTER1

  (p21 ph7):f3
  4u do:f1
  p16:gp5
  d16 
  4u cpds1:f1 ph1
  (p21 ph8):f3

; chemical shift evolution, gradient encoding and 15N inphase to antiphase
#   ifdef LABEL_CN
  if "d10*2 > p8"
     {
     (center (d10*2)(p8:sp13 ph1):f2)
     }
  else
     {
     d10*2
     }     
#   else
  d10*2
#   endif /*LABEL_CN*/

  4u do:f1
  p16:gp6*EA
  d16 fq=0:f1
  DELTA1 pl1:f1
  (center (p22 ph6):f3 (p2 ph1):f1)
  p16:gp6*-1*EA
  d16
  DELTA4 
  
; N->H transfer using sensitivity enhancement
  (center (p1 ph1) (p21 ph3):f3 )
  p16:gp7
  d16
  DELTA5
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA5
  p16:gp7
  d16
  (center (p1 ph2) (p21 ph5):f3 )
  p16:gp8
  d16
  DELTA6
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p16:gp8
  d16
  (p1 ph3)
  DELTA2
  (p2 ph1)
  4u
  p16:gp9
  d16 pl16:f3
  4u  BLKGRAD
  
; detection
  go=2 ph31 cpd3:f3
  
  d11 do:f3 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calgrad(EA) & calph(ph5, +180), caldel(d10, +in10) & calph(ph8, +180) & calph(ph31, +180))

  d31
exit
   

ph1=0 
ph2=1
ph3=2
ph4=3
ph5=1 
ph6=1 1 2 2 3 3 4 4
ph7=3
ph8=1
ph9=0 2 
ph31=0 2 2 0
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl11: f1 channel - power level for trim pulse
;plw19: f1 channel - power level for DIPSI decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p6: f1 channel - 90 degree pulse for DIPSI decoupling
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d1 : relaxation delay; [~2 s]
;d10 : incremented delay                             [3 usec]
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: CPMG echo delay                                     
;d25: 1/(4J)NH 
;d26: < 1/(4J)NH 
;d31: length of single CPMG loop
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst54: Center of H(N) region (offset, in ppm) [~8]
;cnst60: Field strength for 1H decoupling during CPMG delay in Hz [4000]
;cnst61: DIPSI cycles per CPMG element (tau - 180 pulse - tau) [1-2]
;vc : variable loop-coounter for T2 delay, taken from vc-list
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 64
;td1: number of delays in vc-list
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2
;cpd1: dipsi2.p6
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence

;for z-only gradients:
;gpz1: 9%
;gpz2: 3.5%
;gpz3: 36%
;gpz4: 7%
;gpz5: 45%
;gpz6: 80%
;gpz7: 15%
;gpz8: 10%
;gpz9: 16.2%
;gpz10: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100
;gpnam9: SMSQ10.100
;gpnam10: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for 13C and 15N labeled samples start experiment with option -DLABEL_CN (eda: ZGOPTNS)
;                                         ;preprocessor-flags-end



;$Id: $
