;$Id:$
;1D sequence
;using p0 for any flip angle
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"p0=cnst10*p1/90"
"acqt0=-p0*2/3.1416"

1 ze
2 30m
  d1
  p0 ph1
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit

ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;p0 : for any flip angle
;cnst10: = flip angle in degree
;d1 : relaxation delay; 1-5 * T1
;NS: 1 * n, total number of scans: NS * TD0
