;zgcpfqpr
;avance-version (19/07/19)
;1D sequence with presaturation
;using composite pulse
;setting frequency via first entry of frequency-list
;with variable flip angle
;
;A. Bax, J. Magn. Reson. 65, 142-145 (1985)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"d12=20u"

"p0=p1*cnst12"


"acqt0=-p1*6.3/PI"


1 ze
2 30m
  d12 fq=fq1:f1 pl9:f1 
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1
  p1 ph1
  p1 ph2
  p1 ph3
  p0 ph4
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=1 3 3 1 2 0 0 2
ph2=2 0 2 0 3 1 3 1
ph3=3 1 1 3 0 2 2 0
ph4=0 2 0 2 1 3 1 3
ph29=0
ph31=0 2 0 2 1 3 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p1 :  90 degree transmitter high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;cnst12: as multiplier for flip angle (1 = 90o)            [1]
;ns: 1 * n, total number of scans: NS * TD0

;define FQ1LIST for presaturation frequency



