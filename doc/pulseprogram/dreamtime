;dreamtime
;1D spin echo with gradients
;using selective refocussing with phase modulated arbitrary excitation  
;adjustable to 1/2J
;with double quantum filter
;with Z filter and  zero quantum suppression
;with optional TOCSY mixing 
;with optional presaturation 
;using wavemaker to create shaped pulses

;set zgoptns to -D_PR to apply presaturation
;set zgoptns to -D_TOCSY to apply TOCSY mixing
;set zgoptns to -D_pkl to read peaks from a peaklist saved in a 1D proton spectrum and copied to the current dataset with "copy_pl"

;A. Jenne, W. Bermel, C.A. Michal, O. Gruschke, R. Soong, R. Ghosh Biswas, M. Bastawrous & A.J. Simpson,
; Angew. Chem. Int. Ed. 61, 19, e202110044 (2022)
;X. Miao & R. Freeman, J. Magn. Reson. A 116, 273-276 (1995) 
;M.J. Thrippleton & J. Keeler, Angew. Chem. Int. Ed. 42, 3938-3941 (2003)
;M. Liu, X. Mao, C. He, H. Huang, J.K. Nicholson & J.C. Lindon, J. Magn. Reson. 132, 125 - 129 (1998)
;F. Loaiza., A. McCoy, S.L. Hammes & W.S. Warren, J. Magn. Reson. 77, 175 - 1181 (1998)
;R. Adams, C. Holroyd, J. Aguilar, M. Nilsson & G. Morris, Chem. Commun. 49 (2013), 358-360.
;A. Jones, G. Lloyd-Jones & D. Uhrin, Anal. Chem. 89, 1001310021 (2017)

;$CLASS=HighRes
;$DIM=1D
;$TYPE=Selective Experiments
;$SUBTYPE=
;$COMMENT=DREAMTIME experiment, run wvm -q before zg or launch with xaua


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>

"d20=1/(cnst11*4)"
"DELTA1=d20-p16-d16-p12/2" 
"td0=1"

"l0=0"

"p2=p1*2"
"d11=30m"
"p29=300u"

"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"

"spoffs29=0"
"spoffs30=0"
"spoffs35=0"

"TAU=p1*2/PI+de"

"p27=p1"
"plw18=plw1"

#   ifdef _pkl
create_shape(sp2, gaus180r, name= dreamtime_list, stepSize= 10.0 us, bandwidth= $cnst50 Hz, peakList= PL.xml)
#   else 
create_shape(sp2, gaus180r, name= dreamtime_sel, stepSize= 10.0 us, bandwidth= $cnst50 Hz, offset= $cnst51 ppm)
merge_shape(sp2, gaus180r, name= dreamtime_sel, stepSize= 10.0 us, bandwidth= $cnst50 Hz, offset= $cnst52 ppm)

"d11=30m"
"d11=30m+1s/(1+cnst51)"
"d11=30m+1s/(1+cnst52)"
"d11=30m"
#   endif

"d11=30m"
"d11=30m+1s/(1+cnst50)"
"d11=30m"


1 ze
2 30m 
20u 
#   ifdef _PR 
  20u pl9:f1 BLKGRAD 
  d1 cw:f1 ph29
  4u do:f1
  20u pl1:f1
#   else 
  d1
  20u pl1:f1
#   endif /*_PR*/

3  50u UNBLKGRAD 

  p1 ph1

  DELTA1
  p16:gp1
  d16 pl0:f1

  p12:sp2:f1 ph2:r

  p16:gp1
  d16
  DELTA1 pl1:f1
  p1 ph1

  p1 ph3

  DELTA1
  p16:gp2
  d16 pl0:f1

  p12:sp2:f1 ph1:r

  p16:gp2
  d16 pl1:f1
  DELTA1

  p1 ph4
  
  10u gron0
  (p32:sp29 ph4):f1
  20u groff
  d16 ;pl10:f1


#   ifdef _TOCSY
  4u pl10:f1
               ;begin DIPSI2
4 p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  lo to 4 times l1

               ;end DIPSI2
#   else

#   endif /*_TOCSY*/ 


  p16:gp3
  d16 pl10:f1
  10u gron0*1.333
  (p32*0.75:sp29 ph4):f1
  20u groff
 
  4u pl1:f1
  p1 ph4

 go=2 ph31 
 30m mc #0 to 2 F0(zd)
 20u BLKGRAD
exit

 
ph1=0 
ph2=0 1 0 1 0 1 0 1 2 3 2 3 2 3 2 3
ph3=0 0 3 3 2 2 1 1
ph4=0 0 1 1 
ph23=1 1 2 2
ph25=3 3 0 0
ph29=0
ph31=0 2 3 1 2 0 1 3 

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl10: f1 channel - power level for TOCSY-spinlock
;sp2: f1 channel - shaped pulse - phase modulated DREAMTIME waveform
;sp29: power level for shaped pulse (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse (TOCSY) (25-35 us)
;p12: f1 channel - 180 phase modulated DREAMTIME waveform
;p16: homospoil/gradient pulse                            [1 msec] 
;p32: f1 channel - 180 degree chrip for zero quantum sup.   [20 msec]
;     smoothed chirp (sweep width, 20% smoothing, 10000 points)
;cnst11 JHH coupling
;cnst50 bandwidth of selective pulse in Hz
;cnst51 frequency of first signal in ppm
;cnst52 frequency of second signal in ppm
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;d20: Calculated automatically at runtime 
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d16: delay for homospoil/gradient recovery

;ns: 8 * n, total number of scans: NS * TD0
;ds: 8


;for z-only gradients:
;gpz0: ca. 1% 
;gpz1: 17% 
;gpz2: 11% 
;gpz3: 31% 

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100

;for sweep width of adiabatic shape and adjusting gpz0:
;   see supplementary material of M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)

