;cpNCCXsel3D  
;avance-version (20/12/01)
;
; Version 1.0 TS3.0 /9/1/2011
;
; NCC 3D experiment with optional DARR CC mixing 1H-->15N(t1)-->13CA(t2)-->13CX(t3)
; JOS 10/2008 
; tested on 7/9/2011 on Avance III console
; revised and checked for consistency JOS 8/1/2011
;
; Reference:
; Lichi S, Peng X, Mumdooh AMA, Edwards D, Brown LS, Ladizhansky V, 
; Resolution enhancement by homonuclear J-decoupling: application to 
; three-dimensional solid-state magic angle spinning NMR spectroscopy; J. Biomol NMR (2008) 41:9-15
;
;
;Parameters:
;pl12 : f2 -  90 degree proton power level for p3 (default)
;p3 : f2  -  90 degree proton pulse length at pl12
;sp0 : f2 -  H1 ramp, 1H-15N CP 
;spnam0: f2 - ramped amplitude modulation 
;pl3 : f3-  N15, 1H-15N CP
;p15: f2,f3 - H1-N15 CP contact 
;pl11: f1 -  90 degree carbon power level for p1
;p1 : f1  - 90 degree carbon pulse length at pl11
;sp1 : f1 - rf power 13CA, 15N->13CA CP
;spnam1: f1 - ramp or tangential amplitude modulation for 15N-13C CP step
;spoffs1: f1 - offset fro DCP on Ca
;pl5 :f3 -  N15, 15N->13CA CP
;p16: f3,f1 - N15-CA13 CP contact
;sp9 : f1 - selective Pi pulse (rSNOB)
;spnam9: f1 - selective Shape - rSNOB
;spoffs9: f1 - selective pulse offset between 10000 and 30000
;p20: =(l29+0.5)/cnst31 f1  - selective pulse (rSNOB)
;l20: = length for selective pulse 
;pl22: f3 -  90 degree nitrogen power level for p21
;p21 :  f3 -  90 degree nitrogen pulse length at pl20
;zgoptns : -Dlacq, -Dlcp15, or blank to disable protection
;
;
;pl15: f2 -  cw proton decoupling power level during second CP step
;l0: =L0/cnst31 - DARR mixing time
;pl14: f2 -  proton decoupling during CC mixing
;pl13: f2 - proton decoupling during N CS evolution
;cpdprg2: f2 - decoupling during N15 CS evolution
;pl12: f2 -  proton decoupling during acquisition
;cpdprg2:f2 -  decoupling during acquisition, using pl12
;
;d1 : relaxation delay: 1.25 * T1(H1), but > 50 * aq
;NS: 2 * n
;DS: dummy scan
;
;
;$COMMENT=NCACX 3D EXPERIMENT
;$CLASS=BioSolids
;$DIM=3D
;$TYPE=double cross polarisation
;$SUBTYPE=simple 3D with j-decoupling


prosol relations=<solids_cp>

#include <trigg.incl>	/*10 usec trigger pulse at TCU connector I cable 6 */

#include <Avance.incl>


#ifdef fslg
#include <lgcalc.incl>
;cnst20 : RF field achieved at pl13
;cnst21 : on resonance, usually = 0
;cnst22 : positive LG offset
;cnst23 : negative LG offset
;cnst24 : additional LG-offset
#endif /* fslg */
;cnst11 : to adjust t=0 for acquisition, if digmod = baseopt
"acqt0=1u*cnst11"

define pulse pic
"pic=p1*2"

"l0=0"
#ifdef seldec
"p20=(l20+0.5)*1s/cnst31"
#else
"p20=(l20)*1s/cnst31"
#endif
"d31=1s/cnst31"
"l1=d8/d31"
define delay darrmix
define pulse mixing
"mixing=l1*1s/cnst31"
"darrmix=mixing"
"d20=p20"
"d0=0.5u"
"in0=inf1"
"d10=p20"
"in10=inf2"
"cnst21=0"
aqseq 321

1 ze
  darrmix
2 1m  do:f2
  d1 do:f2
#ifndef lcp15
#include <p15_prot.incl>
			;make sure p15 does not exceed 10 msec 
			;let supervisor change this pulseprogram if 
			;more is needed
#endif

#ifndef lacq		
			;disable protection file for long acquisition change decoupling power !!! or you risk probe damage
			;if you set the label lacq (ZGOPTNS -Dlacq), the protection is disabled

#include <aq_prot.incl>	
			;allows max. 50 msec acquisition time, supervisor
			;may change  to max. 1s at less than 5 % duty cycle
			;and reduced decoupling field
#endif
trigg
 1u fq=cnst21:f2
  (p3 pl12 ph1):f2                    	  	; 90 H1 pulse

  (p15 pl3 ph3):f3 (p15:sp0 ph2):f2    	; H1-->N15 CP
if "l0==1" 
 		{
    "d0=in0-3u"
		}
if "l0>0"
		{
   1u cpds2:f2     			  	; set decoupling for N15 evolution
                              			; t1/2 N15 evolution
(center (d0) (pic pl11 ph6):f1)          	; pi pulse refocuses CN J-coupling
                  		  		; t1/2 N15 evolution
   1u do:f2 
  
   }
1u fq=cnst10(bf ppm):f1
5 (p16:sp1 ph5):f1 (p16 pl5 ph4):f3 (p16 pl13 ph0):f2     ; N15--> 13CA CP, ph4 phased for TPPI in t1
1u cpds2:f2
d20 
(pic pl11 ph7):f1
1u  									                            			; t2/2 13CA (CO) evolution
(center  (d10) (p20:sp8 ph8):f4  (p21*2 pl22 ph9):f3 )  ;C13 gaussian 180 soft pulse on CO (Ca) to refocus CO-CA J-coupling
                              			; t2/2 13CA (CO) evolution


			  
(p1 pl11 fq=cnst9(bf ppm) ph10):f1 (1u do):f2        	; flip-up C13 for contact, ph10 phased for TPPI in t2

(mixing pl14 ph0):f2

(p1 pl11 ph11):f1 (p1 pl12 ph0):f2       	;C13 flip-down for detection
                         		; start decoupling in t3 (direct) dimension
go=2 ph31 cpds2:f2 

1m do:f2
 

 1m mc #0 to 2	  		  	; write file
  
  F1PH(rd10 & ip3, id0 & iu0)     			; reset d10, ph4 incremented for TPPI in t1, d0 incremented
  F2PH(ip10, id10) 		  		; inner loop, ph10 incremented for TPPI in t2, d10 incremented
HaltAcqu, 1m					;jump address for protection files 
exit

ph0=0
ph1=0   
ph2=3
ph3=0 2
ph4=0
ph5=0 0 1 1 2 2 3 3 
ph6=1
ph7=0 0 1 1 2 2 3 3   
ph8=0 0 1 1 2 2 3 3 
ph9=1 
ph10=1 1 2 2 3 3 0 0 
ph11=3 3 0 0 1 1 2 2
ph31=0 2 1 3 2 0 3 1  



;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2



