;cpredor2d (TopSpin 3.0)
;
; TS3 / 03.06.2011
;
; checked by SEWE 02.08.2011
;
;2d REDOR  experiment 
;interleaved acquisition of S and S0 signal
;written by STE 26.11.2002
;
;Avance III version
;parameters:
;pl1 : X power level for contact
;pl2 : =0W, not used
;pl3 : Y power level for 180
;pl11 : X power level for 180
;pl12 : proton power level for decoupling
;pl13 : e.g. used in spinal64_13
;pl22 : =0W (no recoupling pulses)
;sp0 : proton power level during contact
;p2 : X 180 degree pulse at pl11
;p3 : proton 90 at power level pl12
;p12 : Y 180 degree pulse at pl3
;p15 : contact time at pl1 (f1) and pl2 (f2)
;pcpd2 : pulse length in decoupling sequence
;cpdprg2 : cw, tppm (at pl12), 
;cnst31 : spin rate >1 kHz
;l0 : 1,3.... must be odd for rotor sync
;d1 : recycle delay
;d31 : used to check spin rate
;spnam0 : file name for variable amplitude CP
;
;
;$CLASS=Solids
;$DIM=pseudo 2D
;$TYPE=cross polarisation
;$SUBTYPE=heteronuclear recoupling
;$COMMENT=REDOR  experiment, cp for excitation, interleaved acquisition of S and S0 signals

prosol relations=<solids_cp>


"plw22=0"				;make sure reference exp. has no recoupling pulses (TS 3.0)

define delay del25		;calculate sync. delays
"del25=(0.25s/cnst31)"
define delay del26
"del26=(0.25s/cnst31)-(p12/2)"
define delay del27
"del27=(0.25s/cnst31)-(p2/2)"
define loopcounter nfid
"nfid=td1/2"
"d31=1s/cnst31"
"acqt0=0"

1 ze
  d31
2 10m do:f2
  d1
#include <p15_prot.incl>	
			;make sure p15 does not exceed 10 msec	
			;let supervisor change this pulseprogram if 
			;more is needed
#include <aq_prot.incl>	
			;allows max. 50 msec acquisition time, supervisor
			;may change  to max. 1s at less than 5 % duty cycle
			;and reduced decoupling field
#include <rot_prot.incl>	
			;protect against misset cnst31, must be >1000
  2u rpp9
  2u rpp8
  (p3 pl12 ph1):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
  del25  cpds2:f2
3 del26 
  (p12 pl3 ph8^):f3
  del26
  lo to 3 times l0
  del27
  (p2 pl11 ph4):f1
  del27
4 del26
  (p12 ph9^):f3
  del26
  lo to 4 times l0
  del25	
  go=2 ph31
  1m do:f2
  30m wr #0 if #0 zd

12 10m do:f2 
  d1
  2u rpp9
  2u rpp8
  (p3 pl12 ph1):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
  del25  cpds2:f2
13 del26 
  (p12 pl22 ph8^):f3
  del26
  lo to 13 times l0
  del27
  (p2 pl11 ph4):f1
  del27
14 del26
  (p12 ph9^):f3
  del26
  lo to 14 times l0
  del25	
  go=12 ph31
  1m do:f2
  30m wr #0 if #0 zd
  10u iu0
  10u iu0
  lo to 2 times nfid
HaltAcqu, 1m
exit

ph1= 1 3
ph2= 0 0 1 1 2 2 3 3
ph4= 0 0 1 1 0 0 1 1
ph8= 0 1 0 1 1 0 1 0
ph9= 0 1 0 1 1 0 1 0
ph10= 0
ph31= 0 2 1 3 2 0 3 1



