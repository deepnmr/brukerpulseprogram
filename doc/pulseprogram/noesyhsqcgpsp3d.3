;noesyhsqcgpsp3d.3
;avance-version (23/02/26)
;NOESY-13C-HSQC
;3D sequence 
;   for recording an HCH-NOESY spectrum 
;   1H/13C correlation via double inept transfer
;   using cnst22 as center of spectrum (1H, F1 dimension)
;   using cnst23 as carbon center of spectrum (13C, F2 dimension) but o2p as transmitter frequency
;optimized for large 13C bandwidth (broadband shaped pulses for all purposes on 13C)
;allows for aliasing of aromatic signals into aliphatic spectral region, while keeping the 
;    transmitter frequecy in the center of both regions (~75 ppm)
;optional presaturation and trim pulse for water suppression. Trim pulse leads to weak COSY
;   artifacts, e.g. crosspeaks between HN/Ca due to HN/Ha coupling, omit for samples in D2O.
;using delayed sampling in both indirect dimensions
;(use parameterset NOESYHSQCGPSP3D.3 for proteins or NA_NOESYHSQCGPSP3D.3 for RNA)
;
; S. Asami, W. Kallies, J.C. Guenther, M. Stavropoulou, S.J. Glaser & M. Sattler,
;   Angew. Chem. Int. Ed. Engl. 57(44), 14498-14502 (2018)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

prosol relations=<triple>

#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

require "TopSpin 4.1.0"

"p2=p1*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d12=20u"

"p28=1m"

"in0=inf1/2"
"in10=inf2"

"if ( td1 == 1 ) { d0 = 4u; } else { d0=in0/2-p1*2/PI-6u; }"

"cnst63=(bf2*cnst23-(o2*1000000))*(inf2/1000000)*360.0"

"o1_F1=bf1*cnst22/1000000"
"o1_F2=bf2*cnst23/1000000"

"DELTA1=d4-p16-d16-p35/2-4u"
"DELTA3=d4-p16-d16-p35/2-p1*2/PI-4u"

"p13=30u"
"spnam2='Ram-COOP1_100.300'"
"if ( (p3*totrot2)/(p13*90.0*integfac2) > 1 ) { spw2 = plw2; p13 = (p3*totrot2)/(90*integfac2); } else { spw2=plw2*pow((p3*totrot2)/(p13*90.0*integfac2),2);}"
"spoffs2=0"
"spoal2=1"
"spnam8='Ram-COOP2_100.300'"
"spw8=spw2"
"spoffs8=0"
"spoal8=0"

"p35=192u"
"spnam41='Bip1382,250,15.1000'"
"if ( (p3*totrot41)/(p35*90.0*integfac41) > 1 ) { spw41 = plw2; p35 = (p3*totrot41)/(90*integfac41); } else { spw41=plw2*pow((p3*totrot41)/(p35*90.0*integfac41),2);}"
"spoal41=0.5"

"spoffs30=0"
"spoffs39=0"
"spoffs41=0"

#ifdef LABEL_CN
"TAU1=larger(p35,p56)/2-p1-d0/2"
#else
"TAU1=larger(p35/2-p1-d0/2,0)"
#endif /*LABEL_CN*/
"TAU=(d8-p16-d16-TAU1*2-12u)/2"

"if ( td2 == 1 ) { cnst61 = 0; } else { if ( in10/2 >= p13*0.529*2 ) { cnst61=(90.0+cnst63/2)*-1; } else { cnst61=cnst63*-1; } }"
"if ( in10/2 >= p13*0.529*2 ) { cnst60=0.5; } else { cnst60=1; } "
"if ( td2 == 1 ) { d10 = 0; } else { d10 = in10*cnst60-(p13*0.529*2); }"

"acqt0=0"

#ifdef TRIMP
  "DELTA4=d4-p16-d16-p35/2-4u"
#else
  "DELTA4=d4-p16-d16-p35/2-4u-de"
  baseopt_echo
#endif /*TRIMP*/

aqseq 321

1 ze
  d11 pl12:f2
  1u ip9+cnst61
2 d11 do:f2
 4u BLKGRAD

#ifdef PRESAT
3 d12 pl32:f1
  d1 cw:f1
  4u do:f1
#else
3 d12
  d1 
#endif /*PRESAT*/
  
  d12 pl1:f1 fq=cnst22 (bf ppm):f1
  50u UNBLKGRAD
 
  (p13:sp2 ph1):f2
  
  p16:gp1
  d16

#ifdef LABEL_CN
  (center (TAU1 p1 ph5 d0 gron0 6u groff d0 gron0*-1 6u groff p1 ph8 TAU1 gron0):f1 (p35:sp41 ph1):f2 (p56:sp39 ph1):f3)
#else
  (center (TAU1 p1 ph5 d0 gron0 6u groff d0 gron0*-1 6u groff p1 ph8 TAU1 gron0):f1 (p35:sp41 ph1):f2)
#endif /*LABEL_CN*/
  
  TAU 
  6u groff
  TAU gron0*-1
  TAU1
  6u groff
  p16:gp2
  d16 fq=0:f1  

  (p1 ph7)
  4u
  p16:gp3
  d16
  DELTA1
  (center (p2 ph1):f1 (p35:sp41 ph1):f2)
  DELTA1
  4u
  p16:gp3
  d16
  (p1 ph2)

  4u 
  p16:gp4
  d16 

#ifdef LABEL_CN
  (center (p44:sp30 ph1):f1 (p13:sp2 ph4 d10 p13:sp8 ph9):f2 (p56:sp39 ph1):f3)
#else
  (center (p44:sp30 ph1):f1 (p13:sp2 ph4 d10 p13:sp8 ph9):f2)
#endif /*LABEL_CN*/

  4u pl1:f1
  p16:gp5
  d16 

  (p1 ph2)
  4u 
  p16:gp6
  d16 
  DELTA3
  (center (p2 ph1):f1 (p35:sp41 ph1):f2 )
  DELTA4
  4u
  p16:gp6
  d16 pl12:f2

#ifdef TRIMP
  (p28 ph2)
#endif /*TRIMP*/

  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph8, -90), caldel(d0, +in0)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10) & calph(ph4, cnst63))
exit
   

ph1=0 
ph2=1
ph3=2
ph4=0 2
ph5=0 0 2 2
ph6=1
ph7=0 0 0 0 2 2 2 2
ph8=(8) 1 
ph9=0 
ph31=2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for weak presaturation
;sp14: f2 channel - short pulse for bi-level adiabatic decoupling 
;sp31: f2 channel - long pulse for bi-level adiabatic decoupling 
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp41: f2 channel - shaped pulse 180 degree (Bip720,100,10.1)
;spnam41: Bip720,100,10.1
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p28: f1 channel - trim pulse                        [1 msec]
;p35: f2 channel - 180 degree shaped pulse
;p44: f1 channel - 180 degree shaped pulse
;p56: f3 channel - 180 degree shaped pulse
;p63: f2 channel - pulse for bi-level adiabatic decoupling 
;d0 : incremented delay (F1 in 3D) = in0/2-p1*4/PI
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d8 : NOESY mixing time
;d10: incremented delay (F2 in 3D) = in10/2-p3*4/PI
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d29: incremented delay (F2 in 3D) = in29/2 -p21*4/PI
;cnst2: = J(CH) (~160 for proteins, ~180 for nucleic acids)
;       these values are a compromise between aromatic and aliphatic coupling constants  
;cnst22: Center for indirect proton dimension (F1)  
;cnst23: Center for carbon dimension (F2)
;cnst60: Sampling in F2 is delayed by cnst60 increments
;cnst63: TPPI phase shift to shift center of spectrum relative to 13C carrier
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(C) = 2 * DW(C)
;in0: 1/SW(H) = 2 * DW(H)
;in10: 1/SW(C) = 2 * DW(C)
;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI in F1
;FnMODE: States-TPPI in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: 1%
;gpz1: 40%
;gpz2: 15%
;gpz3: 19%
;gpz4: -25%
;gpz5: 70%
;gpz6: 30%



;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100

                                          ;preprocessor-flags-start

;the following options are available (eda: ZGOPTNS)
;PRESAT: to use presaturation for water suppression use option -DPRESAT
;LABEL_CN: to enable 15N decoupling for 15N/13C labeled molecules use option -DLABEL_CN
;TRIMP: to use trim pulse for water suppression use option -DTRIMP

                                          ;preprocessor-flags-end

;Processing

;PHC0(F1): 135
;PHC1(F1): -180
;FCOR(F1): 1


;Processing in F2 depends on inf2:
;  If inf2 < p13*2.116 sampling is delayed by 1 increment (cnst60=1). First point needs to be backpredicted. 
;    Set: PHC0(F2) 0, PHC1(F2) 0, FCOR(F2) 0.5, MW_mod LPbc(F2), TDoff(F2) -2, NCOEFF(F2) 64
;
;  If inf2 >= p13*2.116 sampling is delayed by 1/2 increment (cnst60=0.5).
;    Set: PHC0(F2) 0, PHC1(F2) -180, FCOR(F2) 1, MW_mod(F2) no, TDoff(F2) 0, NCOEFF(F2) 0


;$Id: $
