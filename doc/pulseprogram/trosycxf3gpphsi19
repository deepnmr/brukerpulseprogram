;trosycxf3gpphsi19
;avance-version (16/10/05)
;2D H-1/X correlation via TROSY
;   using sensitivity improvement
;phase sensitive using Echo/Antiecho method
;using f3 - channel
;water suppression using watergate sequence
;using CLEANEX_PM filter for exchanging protons
;(use parameterset )
;
;T.L. Hwang, P.C.M. van Zijl & S. Mori, J. Biomol. NMR 11, 221-226 (1998)
;(G. Hernandez & D.M. LeMaster, Magn. Reson. Chem. 41, 699-702 (2003) )
;(M. Czisch & R. Boelens, J. Magn. Reson. 134, 158-160 (1998) )
;(K. Pervushin, G. Wider & K. Wuethrich, J. Biomol. NMR 12, 
;   345-348 (1998) )
;(A. Meissner, T. Schulte-Herbrueggen, J. Briand & O.W. Sorensen, Mol. Phys. 96,
;   1137-1142 (1998) )
;(J. Weigelt, J. Am. Chem. Soc. 120, 10778-10779 (1998) )
;(M. Rance, J.P. Loria & A.G. Palmer III, J. Magn. Reson. 136, 91-101 (1999) )
;(G. Zhu, X.M. Kong & K.H. Sze, J. Biomol. NMR 13, 77-81 (1999) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple2>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"


"d0=6u"

"in0=inf1/2"


"l1=(d29/(p10*8.11))"
"d31=p10*8.11*l1"


"DELTA1=d26-p16-d16-4u"
"DELTA2=d26-p1-p16-d16-4u"
"DELTA3=d26-p16-d16-p27*2.385-d19*5-4u"
"DELTA4=d19-p22/2"
"DELTA5=d26-p16-d16-p27*2.154-p0*0.231-d19*5-p21-4u"


"l0=1"


1 ze 
2 d11
3 d1 pl1:f1
  50u UNBLKGRAD
  (p1 ph6)

  6u
  p16:gp4
  d16 pl0:f1
  p7:sp21:f1 ph9:r
  p16:gp4
  d16 pl27:f1
  6u gron0
                                                 ;begin CLEANEX_PM
4 (p10*1.500 ph21)
  (p10*1.333 ph23)
  (p10*1.222 ph21)
  (p10*1.222 ph23)
  (p10*1.333 ph21)
  (p10*1.500 ph23)
  lo to 4 times l1
                                                 ;end CLEANEX_PM
  10u groff

  p16:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2) (p22 ph1):f3 )
  10u
  DELTA1
  p16:gp1
  d16
  (p1 ph8) 

  if "l0 %2 == 1"
     {
     (p21 ph3):f3
     }
  else
     {
     (p21 ph4):f3
     }

  d0 gron0
  d0 gron0*-1
  2u groff
  (p1 ph5)
  4u
  p16:gp2
  d16
  DELTA2 pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  DELTA1
  p16:gp2
  d16
  (center (p1 ph10) (p21 ph2):f3 )

  4u
  p16:gp3
  d16
  DELTA3 pl18:f1

  p27*0.231 ph1
  d19*2
  p27*0.692 ph1
  d19*2
  p27*1.462 ph1
  DELTA4
  (p22 ph1):f3
  DELTA4
  p27*1.462 ph6
  d19*2
  p27*0.692 ph6
  d19*2
  p0*0.231 ph6

  DELTA5
  p16:gp3
  d16
  4u BLKGRAD

  (p21 ph7):f3
  go=2 ph31
  d11 mc #0 to 2 F1EA(calph(ph5, +180) & calph(ph7, +180) & calclc(l0, 1), caldel(d0, +in0) & calph(ph3, +180) & calph(ph4, +180) & calph(ph31, +180))
  d31
exit 
  

ph1=0
ph2=1
ph3=1 3 2 0
ph4=3 1 2 0
ph5=1 1 1 1 3 3 3 3
ph6=2
ph7=0
ph8=3
ph9=0 0 0 0 1 1 1 1
ph10=0 0 0 0 2 2 2 2
ph21=0
ph23=2
ph31=0 2 3 1


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl18: f1 channel - power level for 3-9-19-pulse (watergate)
;pl27: f1 channel - power level for CLEANEX spinlock
;sp21: f1 channel - shaped pulse 180 degree (H2O on resonance)
;p0 : f1 channel -  90 degree pulse at pl18
;                      use for fine adjustment
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p7 : f1 channel - 180 degree shaped pulse (H2O on resonance)  [7.5 ms]
;p10: f1 channel -  90 degree low power pulse (CLEANEX spinlock)
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p27: f1 channel -  90 degree pulse at pl18
;d0 : incremented delay (2D)                         [6 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;d26: 1/(4J)YH
;d29: mixing time for CLEANEX spinlock
;d31: length of CLEANEX spinlock as used
;cnst4: = J(YH)
;l1: loop for CLEANEX spinlock: (p10 * 8.11 * l1) = mixing time
;inf1: 1/SW = 2 * DW
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho


;use gradient ratio:    gp 0 : gp 1 : gp 2 : gp 3 : gp 4
;                        0.2 :   30 :   45 :   50 :   19

;for z-only gradients:
;gpz0: 0.2%
;gpz1: 30%
;gpz2: 45%
;gpz3: 50%
;gpz4: 19%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



