;lc1pncw
;avance-version (12/01/11)
;1D version of noesyprph using presaturation during relaxation delay 
;   and mixing time
;with cw-decoupling on f2 - channel during acquisition
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>


"d11=30m"
"d12=20u"
"d13=4u"


"acqt0=-p1*2/3.1416"


1 ze
  d12 pl21:f2
2 30m do:f2
  d12 pl9:f1
  d1 cw:f1 ph29
  d13 do:f1
  d12 pl1:f1
  p1 ph1
  d13
  p1 ph2
  d12 pl9:f1
  d8 cw:f1
  d13 do:f1
  d12 pl1:f1
  p1 ph3
  go=2 ph31 cw:f2
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1=0 2 
ph2=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3=0 0 2 2 1 1 3 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl21: f2 channel - power level for decoupling
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1                  [ca. 1-2sec]
;d8 : mixing time                                [ca. 80 msec]
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                     [4 usec]
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4



;$Id:$
