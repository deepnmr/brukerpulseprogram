;n_hntrosy_f2ig
;avance-version (19/02/05)
;2D 1H/15N correlation
;phase sensitive
;(use parameterset )
;
;R. Schnieders, C. Richter, S. Warhaut, V. de Jesus, S. Keyhani, 
;   E. Duchardt-Ferner, H. Keller, J. Woehnert, L.T. Kuhn, A.L. Breeze,
;   W. Bermel, H. Schwalbe & B. Fuertig, J. Biomol. NMR 69, 31-44 (2017)
;K. Takeuchi, H. Arthanari, I. Shimada & G. Wagner, J. Biomol. NMR 63, 1-9 (2015)
;K. Takeuchi, H. Arthanari, M. Imai & G. Wagner, J. Biomol. NMR 64, 143-151 (2016)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"
"d26=1s/(cnst4*4)"


"in0=inf1"

"d0=in0/2-p21*4/PI"


"DELTA1=d26-p16-d16"
"DELTA2=d26-p16-d16-p1*2/PI"
"DELTA3=d26-p16-d16-de"


"cnst62=-((bf3*cnst19)-(o3*1000000))"
"cnst63=-(cnst62*inf1/1000000)*360.0"


"l0=0"


"o1_F1=bf3*cnst19/1000000"


"acqt0=0"
baseopt_echo


1 ze
2 d11 do:f2
3 d1 
  d12 pl1:f1 pl12:f2 pl3:f3
  50u UNBLKGRAD

  if "l0 %2 == 1"
     {
     (p21 ph3):f3
     }
  else
     {
     (p21 ph4):f3
     }
  d0

  (p1 ph5):f1
  DELTA1
  p16:gp1
  d16
  4u
  (center (p2 ph1):f1 (p22 ph1):f3 )
  4u
  p16:gp1
  d16
  DELTA1
  (p1 ph1):f1

  (p21 ph2):f3
  DELTA2
  p16:gp2
  d16
  4u
  (center (p2 ph1):f1 (p22 ph1):f3 )
  4u
  p16:gp2
  d16
  DELTA3
  4u BLKGRAD
  (p21 ph6):f3

  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1EA(calph(ph5, +180) & calph(ph6, +180) & calclc(l0, 1), caldel(d0, +in0) & calph(ph3, cnst63) & calph(ph4, cnst63))
exit


ph1=0
ph2=1
ph3=1 3 0 2
ph4=3 1 0 2
ph5=3
ph6=2
ph31=0 2 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D) = in0/2-p21*4/PI
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(NH))
;cnst4: = J(NH)
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst62: offset for H(N) region (Hz) (SR)
;cnst63: additional phase increment to center H(N) region
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/SW(H) = 2 * DW(H)
;nd0: 1
;ns: 2 * n
;ds: >=32
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 31%
;gpz2: 19%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



