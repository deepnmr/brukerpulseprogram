;seqtrhncaetgp3d
;avance-version (21/09/15)
;seq. TROSY-HNCA
;3D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N) -> F2(Ca,t1) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1
;using constant time in t2
;uncompensated version d25=d26
;(use parameterset SEQTRHNCAETGP3D)
;
;A. Meissner & O.W. Sorensen, J. Magn. Reson. 150,
;   100 - 104 (2001)
;T. Schulte-Herbrueggen & O.W. Sorensen, J. Magn. Reson. 144,
;   123 - 128 (2000)
;(M. Salzmann, G. Wider, K. Pervushin, H. Senn & K. Wuethrich,
;   J. Am. Chem. Soc. 121, 844-848 (1999))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA3 = { 0.8750 1.0000}
define list<gradient> EA5 = { 1.0000 0.6667}
define list<gradient> EA7 = { 0.6595 1.0000}


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d22=4.5m"
"d23=12m"
"d25=2.3m"
"d26=2.3m"
"d27=13.3m"


"d0=3u"
"d10=3u"
"d20=d27/2-p14/2-2u"
"d30=d23/2-d25/2-p14/2-p16/2-d16/2-2u"

"in0=inf1/4"
"in10=inf2/4"

"in20=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA=d27-d22-p14/2"
"DELTA1=d26-p16-d16"
"DELTA2=d23-p16-d16-p14-4u"
"DELTA3=d23-p16-d16"
"DELTA4=d23/2-d25/2-p14/2-d10+p21*2/3.1416"
"DELTA5=d23/2-d25/2-p14/2-d10-p16-d16-p11+p21*2/3.1416-8u"
"DELTA6=d25-p16-d16"
"DELTA7=d26-p11-p16-d16-8u"
"DELTA8=d22-larger(p2,p22)-p14/2-d0*2"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


aqseq 321


1 d11 ze
2 d11
3 d1 pl1:f1
  50u UNBLKGRAD

  4u pl0:f1
  (p11:sp1 ph2:r):f1
  4u
  4u pl1:f1

  (p1 ph3):f1
  p16:gp1
  d16
  DELTA1
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA1
  p16:gp1
  d16
  (p1 ph2):f1 

  (p21 ph1):f3
  p16:gp2
  d16
  DELTA2
  (p14:sp5 ph1):f2
  4u
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA3
  p16:gp2
  d16
  (p21 ph1):f3

  (p13:sp2 ph6):f2
  d0
  d0
  (center (p2 ph1):f1 (p22 ph1):f3 )
  DELTA8
  (p14:sp5 ph1):f2 
  DELTA
  (p14:sp3 ph1):f2
  d20
  d20
  (p14:sp5 ph1):f2
  4u
  (p2 ph1):f1 (p13:sp8 ph2):f2

  (p21 ph5):f3
  d30
  (p14:sp5 ph1):f2
  d30
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA4
  d10
  (p14:sp5 ph1):f2
  d10
  DELTA5
  p16:gp3*EA3
  d16 pl0:f1
  (p11:sp1 ph3:r):f1
  4u
  4u pl1:f1

  (p1 ph7)
  p16:gp4
  d16
  DELTA6
  (center (p2 ph2) (p22 ph2):f3 )
  DELTA6
  p16:gp4
  d16
  (p1 ph1) 

  p16:gp5*EA5
  d16
  4u

  (p21 ph1):f3
  p16:gp6
  d16
  DELTA7 pl0:f1
  (p11:sp1 ph4:r):f1
  4u
  4u pl1:f1
  (center (p2 ph2) (p22 ph2):f3 )
  4u pl0:f1
  (p11:sp1 ph4:r):f1
  4u
  DELTA7
  p16:gp6
  d16 pl1:f1
  (p21 ph8:r):f3

  p16:gp7*EA7
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph6, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2EA(calgrad(EA3) & calgrad(EA5) & calgrad(EA7) & calph(ph7, +180) & calph(ph8, +180), caldel(d10, +in10) & caldel(d30, -in30) & calph(ph5, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 2
ph6=0 0 2 2
ph7=3
ph8=3
ph31=0 2 2 0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d27/2-p14/2-2u
;d22: 1/(4J(CaCO))                                     [4.5 msec]
;d23: 1/(4J(NCa), T(N)                                 [12 msec]
;d25: 1/(4J'(NH)                                       [2.3 msec]
;d26: 1/(4J(NH)                                        [2.3 msec]
;d27: 1/(2J(CaCb), T(C)                                [13.3 msec]
;d30: decremented delay (F2 in 3D) = d23/2-d25/2-p14/2-p16/2-d16/2-2u
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(Cali)) = (1/2) DW(Cali)
;nd0: 4
;in10: 1/(4 * SW(N)) = (1/2) DW(N)
;nd10: 4
;in20: = in0
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6 :  gp 7
;                          2 :    3 :  -80 :    5 :   30 :   45 : 30.13

;for z-only gradients:
;gpz1: 2%
;gpz2: 3%
;gpz3: -80%
;gpz4: 5%
;gpz5: 30%
;gpz6: 45%
;gpz7: 30.13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100



;Processing

;F1 reverse: true



