;c_hnco_iarc_nh
;avance-version (21/09/15)
;IPAP-J-(H)NCO
;2D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(H) -> F3(N,J,t1) -> F1(C=O,t2)
;
;for determination of 1J(1D) NH
;   splitting in F1:  1J NH    (IPAP)
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using semi-constant time in t1
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;W. Bermel, I. Bertini, V. Csizmok, I. C. Felli, R. Pierattelli & 
;   P. Tompa, J. Magn. Reson. 198, 275-281 (2009)
;(W. Bermel, I. Bertini, I.C. Felli, R. Peruzzini & R. Pierattelli,
;   Chemphyschem. 11, 689-95 (2010) )
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d22=4.5m"
"d23=12.4m"
"d26=2.3m"


"d28=3u"
"d0=d23/2-p12/2"
"d20=d23/2+p12/2+d28"

"in0=inf1/4"

"FACTOR1=d20*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in28 = 0; } else { in28=in0-INCR1; }"


"DELTA1=d23/2-p12/2"
"DELTA2=d23-d22-p12"
"DELTA3=d21/2-p16-d16"

"TAU=p4"


"l0=1"
"l10=1"


"spoffs23=0"
"spoffs24=0"
"spoffs26=bf1*(cnst22/1000000)-o1"


1 ze
  d11 pl12:f2 pl16:f3 
2 d11 do:f2 do:f3
3 d1 pl2:f2 pl3:f3 
  50u UNBLKGRAD

  (p3 ph3):f2
  d26
  (center (p4 ph1):f2 (p22 ph1):f3 )
  d26
  (p3 ph2):f2 

  p16:gp1
  d16

  if "l10 %2 == 1"
     {
     (p21 ph4):f3
     p16:gp2
     d16
     DELTA3
     (center (p4 ph1):f2 (p22 ph4):f3 )
     DELTA3
     p16:gp2
     d16
     }
  else
     {
     (p21 ph8):f3
     p16:gp2
     d16
     DELTA3
     (center (TAU) (p22 ph8):f3 )
     DELTA3
     p16:gp2
     d16
     }

  d0
  (p12:sp26 ph1)
  d0
  (p12:sp24 ph1)
  d28
  (p12:sp26 ph1)
  d28
  (p22 ph1):f3
  d20
  (p12:sp26 ph1)
  d20
  (p21 ph1):f3

  p16:gp3
  d16 pl12:f2
  20u cpd2:f2 ph1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph5)
     DELTA1
     (p12:sp26 ph1)
     DELTA1
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA1
     (p12:sp26 ph1)
     DELTA1 pl16:f3
     }
  else
     {
     (p11:sp23 ph6)
     d22
     (p12:sp26 ph1)
     DELTA2
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA1
     DELTA1 pl16:f3
     (p12:sp26 ph1)
     }


  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f2 do:f3 mc #0 to 2 
     F1I(iu0, 2, iu10, 2)
     F1PH(calph(ph4, +90) & calph(ph8, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28))
exit


ph1=0
ph2=1 
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=3 3 3 3 1 1 1 1
ph7=3
ph8=3 3 1 1
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp26: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0: incremented delay (F1 in 2D) = d23/2-p12/2
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: incremented delay (F1 in 2D) = d23/2+p12/2+d28 
;d21: 1/(2J(NH))                                       [5.5 msec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCO))                                      [12.4 msec]
;d26: 1/(4J(NH))                                       [2.3 msec]
;d28: incremented delay (F2 in 3D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase (F2)
;l10: flag to switch between inphase and antiphase (F1)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(4 * SW(N)) = (1/2) DW(N)
;nd0: 4
;in20: = (d20 * 8 / td1) or in0
;in28: = in0 - in20
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1 * 4
;FnMODE: States-TPPI (or TPPI) in F1
;cpds2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 11%
;gpz3: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



;use AU-program splitcombipap2d_rdc to process data



