;troesyph
;avance-version (12/01/11)
;2D off-resonance ROESY with cw spinlock for mixing
;with compensation to reduce offset effects
;phase sensitive
;
;H. Desvaux, P. Berthault, N.Birlirakis, M. Goldman & M. Piotto
;   J. Magn. Reson. A 113, 47-52 (1995).
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


define list<frequency> roesylist=<$FQ1LIST>


"d11=30m"
"d12=20u"
"d13=4u"


"in0=inf1"

"d0=in0/2-p1*4/3.1416"


1 ze
  d11 roesylist:f1
  3m roesylist.inc
2 d1   
3 d12 pl1:f1
  p1 ph1
  d0 
  p1 ph3
  d13
  d12 roesylist:f1
  d12 roesylist.inc
  d12 pl0:f1
  p15:sp10:f1 ph2:r
  d13
  d12 roesylist:f1
  d12 roesylist.inc
  d12 pl1:f1
  p1 ph4
  go=2 ph31
  d1 mc #0 to 2 F1PH(calph(ph1, +90), caldel(d0, +in0))
exit


ph1=0 2
ph2=0 0 0 0 2 2 2 2
ph3=0
ph4=0 0 2 2
ph31=0 2 2 0


;pl0 : 0W
;pl1: f1 channel - power level for pulse (default)
;sp10: f1 channel - shaped pulse for ROESY-spinlock
;p1 : f1 channel -  90 degree high power pulse
;p15: f1 channel - pulse for ROESY spinlock
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;define FQ1LIST (list has to be stored in "/u/exp/stan/nmr/lists/f1")
;     set on resonance for first part and detection and off resonance
;     for spinlock


