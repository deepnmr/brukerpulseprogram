;hsqctretf3gpsitc3d.3
;avance-version (23/07/14)
;2D 1H/15N correlation via inept transfer
;   using sensitivity improvement
;for measuring 15N T1rho relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;using two 1H 180o pulses during T1rho relaxation for suppression of cross corr. relaxation
;temperature compensated 
;as pseudo3D
;(use parameterset HSQCTRETF3GPSITC3D.3)

; This pulse sequence performs a HSQC 15N T1rho relaxation experiment.

; Relaxation delay lengths (i.e. 15N spinlock durations) are given via a vdlist. Spinlock 
; offset (in Hz, relative to o3p) and spinlock fieldstrength (in Hz) are set via cnst30 
; and cnst27. The spinlock powerlevel (pl25) is calculated based on cnst27 and pl21/pl3.
; The magnetization is aligned with the effective spinlock field using Gaussian ramps (see 
; Mulder et al.) with a duration of 3 ms (p33, must be set manually). The Gaussion ramps 
; use the same fieldstrength as the spinlock. The appropriate shape for the Gaussion ramps 
; (sp36/sp37) is set automatically depending on the sign of the spinlock offset (cnst30).  
; To ensure equal RF heating in all experiments, a heating compensation element is 
; included before the recycle delay d1.
;

;N.-A. Lakomek, J. Ying & A. Bax, J. Biomol. NMR 53, 209-221 (2013)
;F.A.A. Mulder, R A. de Graaf, R. Kaptein & R. Boelens, J. Mag. Res. 131, 351-357 (1998)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

prosol relations=<triple>

#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define list<delay> vd_list=<$VDLIST>
define delay vd_max

"p0=p1*7/3"
"p2=p1*2"
"p4=p3*2"
"p22=p21*2"
"p25=0"
"p52=0"

"d11=30m"
"d26=2.65m"
"d31=0"

"cnst31=50000"

"d10=3u"
"in10=inf2/4"

"DELTA=d1-p52"
"DELTA1=d26-p16-d16+d10*4+p2+2u"
"DELTA2=d26-p16-d16-2u"
"DELTA3=d26-p16-d16-4u"
"DELTA4=de+10u-p1*2/PI"
"DELTA5=d26-d16-2u"

"l3=td1"
"l11=0"

"plw0=0"
"plw25=plw3*pow((p21*cnst27*4/1000000),2)"

"spnam36 = 'Gaussramp+down.1'"
"spnam37 = 'Gaussramp+up.1'"
" if (cnst30<0) {spnam36 = 'Gaussramp-down.1';}"
" if (cnst30<0) {spnam37 = 'Gaussramp-up.1';}"

"spoffs13=0"
"spoffs36=0"
"spoffs37=0"
"spoal36=0"
"spoal37=0"

aqseq 312

"acqt0=0"
baseopt_echo

1 ze

  if "td1 != vd_list.len" 
     {
     2u
     print "Warning: td1 is not equal to the number of relaxation delays in the vdlist"
     }

9 20u
  if "vd_list > vd_max"
       {
       20u
       "vd_max = vd_list"
       }

  3m vd_list.inc
  lo to 9 times l3
  3m vd_list.res

2 d11 do:f3

  if "d31 < vd_max"
     {
     4u pl25:f3
     }
  else
     {
     4u pl0:f3
     }
  (p52 ph1):f3

  20u 
  "DELTA=d1-p52"
  20u
  "d31=vd_list[l11]"
  20u
  "p25=d31"
  20u
  "DELTA6=(d31/2-p44)"
  20u
  "p52=vd_max-d31"
  20u

#   ifdef LABEL_CN
  "TAU1=d31/4-p8/2-p44/2-2u"
  20u
  "TAU2=p8"
#   else
  "TAU1=d31/4-p44/2-2u"
#   endif /*LABEL_CN*/

  DELTA pl1:f1 pl3:f3
  50u UNBLKGRAD
  (p21 ph1):f3
  4u
  p16:gp0
  d16

  (p1 ph1)
  d26 gron1
  2u groff
  (center (p2 ph1) (p22 ph1):f3 )
  d26 gron1
  2u groff
  (lalign (p1 ph2) (p21 ph1):f3 )
  d26 gron2
  2u groff
  (center (p2 ph1) (p22 ph1):f3 )
  d26 gron2
  2u groff
  (ralign (p1 ph3) (p21 ph4):f3 )
  4u
  p19:gp3
  d16 fq=cnst30(sfo hz):f3
  2u pl25:f3
  
#   ifdef LABEL_CN
  (p33:sp36(currentpower) ph1):f3
  (center (p44:sp30 ph1 DELTA6 p44:sp30 ph1):f1 (p25 ph1):f3 (p8:sp13 ph1):f2 (TAU1 gron10 2u groff TAU2 TAU1 gron10*-1 2u groff))
  (p33:sp37(currentpower) ph1):f3
#   else
  (p33:sp36(currentpower) ph1):f3
  (center (p44:sp30 ph1 DELTA6 p44:sp30 ph1):f1 (p25 ph1):f3 (2u TAU1 gron10 TAU1 gron10*-1 2u groff))
  (p33:sp37(currentpower) ph1):f3
#   endif /*LABEL_CN*/

  p19:gp9
  d16 fq=0:f3 pl1:f1
  2u pl3:f3
  (p21 ph5):f3
  2u
  p16:gp4*EA*-1
  d16 pl1:f1
  DELTA1
  (center (p2 ph1):f1 (p22 ph5):f3 )
  2u
  p16:gp4*EA
  d16 
  DELTA2

#   ifdef LABEL_CN
    if "4*d10+p2>p8"
      {
      (center (d10 gron8 d10 gron8*-1 2u groff p2 ph1 d10*2 2u):f1 (p8:sp13 ph1):f2)
      }
    else
      {
      (d10 gron8 d10 gron8*-1 2u groff p2 ph1 d10*2 2u):f1
      }
#   else
  (d10 gron8 d10 gron8*-1 2u groff p2 ph1 d10*2 2u):f1
#   endif /*LABEL_CN*/
  
  (lalign (p1 ph1) (p21 ph1):f3 )
  4u
  p16:gp5
  d16
  DELTA3
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp5
  d16
  4u
  (ralign (p1 ph2) (p21 ph6):f3 )
  4u
  p16:gp6
  d16
  DELTA3
  (center (p2 ph1):f1 (p22 ph1):f3 )
  DELTA3
  4u
  p16:gp6
  d16
  (p1 ph1)
  p16:gp11
  d16 
  DELTA4
  (p2 ph1)
  p16:gp7
  d16 pl16:f3
  10u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calgrad(EA) & calph(ph6, +180), caldel(d10, +in10) & calph(ph5, +180) & calph(ph31, +180))
exit 
  

ph1=0
ph2=1
ph3=2
ph4=1 1 3 3
ph5=1 3
ph6=3
ph31=1 3 3 1

;plw0 : 0 W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling 
;plw25: f3 channel - power level for spinlock (calculated based on cnst27 and plw3)
;sp1 : f1 channel - shaped pulse 180 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp30: f1 channel - shaped pulse for inversion 
;spnam30: Bip720,50,20.1
;sp36: f3 channel - shaped pulse for adiabatic ramp down 
;spnam36: Gaussramp+down.1 or Gaussramp-down.1  (set internally)
;sp37: f3 channel - shaped pulse for adiabatic ramp up 
;spnam37: Gaussramp+up.1 or Gaussramp-up.1 (set internally)
;p0 : f1 channel - 210 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                              [1 msec]
;p19: homospoil/gradient pulse  2                           [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: spinlock duration, set internally
;p33: f3 channel - shaped pulse for adiabatic ramp   [3 msec]
;p44: f1 channel - 180 degree shaped pulse for inversion
;p52: heating compensation, set internally
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay                                     [3 usec]
;d11: delay for disk I/O                                    [30 msec]
;d16: delay for homospoil/gradient recovery
;d26 : 1/(4J)NH                                             [2.65 msec]
;d31 : used for internal calculations
;cnst27: T1rho spinlock field strength (in Hz, at plw25) [~ 1500-2500]
;cnst30: T1rho spinlock offset (in Hz, relativ to sfo)
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 64
;td1: number of delays in vd-list
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2

;for z-only gradients:
;gpz0: 23%
;gpz1: 3.5%
;gpz2: 2%
;gpz3: -23%
;gpz4: 80%
;gpz5: 11%
;gpz6: 7%
;gpz7: 32.2%
;gpz8: 1%
;gpz9: 25%
;gpz10: 0.4%
;gpz11: 16%

;use gradient files:
;gpnam0: SMSQ10.100
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam9: SMSQ10.50
;gpnam11: SMSQ10.100

                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end