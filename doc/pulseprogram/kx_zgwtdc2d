;kx_zgwtdc2d
;avance-version (19/09/26)
;pseudo 2D sequence for kinetics experiments
;WET solvent suppression with shape pulse
;using variable flip angle read pulse
;with C-13 low power decoupling on f2 during WET and AQ
;with FLAG_TRIG option (trigger pulse from InisgthXpress unit)
;using delay d21 to shift t=0 between different pseudo2d experiments
;use wetdc0 for setup
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define delay WETWAIT


"d11=30m"
"d16=2m"


"WETWAIT=10m-d16"


"p0=p1*cnst18/90.0"


"DELTA=d1+p11*4+p16*4+d16*4+WETWAIT+p0+de+aq+90u"
"DELTA1=d20-((DELTA)*(ns+ds))-30.024m"


"acqt0=-p0*2/PI"


1 ze
  d11 pl14:f2

#   ifdef FLAG_TRIG
  1m trigpe1
#   endif /*FLAG_TRIG*/

  d21

2 20u
3 20u do:f2 BLKGRAD
  d1

  50u UNBLKGRAD
  4u cpd2:f2
  (p11:sp7 ph2):f1
  4u
  p16:gp21
  d16
  (p11:sp8 ph3):f1
  4u
  p16:gp22
  d16
  (p11:sp9 ph3):f1
  4u
  p16:gp23
  d16
  (p11:sp10 ph3):f1
  4u do:f2
  p16:gp24
  d16
  WETWAIT pl1:f1
  p0 ph1
  go=3 ph31 cpd2:f2
  4u do:f2
  30m wr #0 if #0 ze
  DELTA1
  lo to 2 times td1

  20u BLKGRAD			
exit


ph1=1 3 3 1 2 0 0 2
ph2=0
ph3=1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl14: f2 channel - power level for low power decoupling
;sp1: f1 channel - shaped pulse powerlevel for 90 degree pulse
;sp7: f1 channel - shaped pulse
;sp8: f1 channel - shaped pulse
;sp9: f1 channel - shaped pulse
;sp10: f1 channel - shaped pulse
;p0 : for any flip angle
;p1 : f1 channel -  90 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [2msec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30msec]
;d16: delay for homospoil/gradient recovery
;d20: delay between start of different 1D spectra
;d21: shift delay for the first increment
;cnst18: flip angle in degree
;ns: 8 * n, total number of scans: NS * TD0
;ds: 16


;for z-only gradients:
;gpz21: 80%
;gpz22: 40%
;gpz23: 20%
;gpz24: 10%

;use gradient files:   
;gpnam21: SMSQ10.100
;gpnam22: SMSQ10.100
;gpnam23: SMSQ10.100
;gpnam24: SMSQ10.100


;use power levels               sp7        sp8        sp9        sp10
;                       sp1     +0.87      -1.04      +2.27      -5.05



                                          ;preprocessor-flags-start
;FLAG_TRIG: to use the trigger pulse from InsigtXpress
;             start experiment with option -DFLAG_TRIG (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



