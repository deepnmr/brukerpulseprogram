;$Id:$
;pulse program for B1 homogeneity determination on lockchannel

;$CLASS=HighRes HWT
;$DIM=2D
;$HIDE=y

#include <Avance.incl>

define list<pulse> Plist = <npt_b1meas>

"d11=30m"
"d12=20u"

1 ze
  d11 LOCKDEC_ON
2 d1
  d20 H2_PULSE
  d12
  (Plist ph1):f1
  d12 H2_LOCK
  go=2 ph31
  d12 Plist.inc
  d20
  d1 mc #0 to 2 F1QF()
  d11 LOCKDEC_OFF
exit

ph1=0
ph31=0

;pl1 : f1 channel - power level for Plist pulse (default)
;vplist: determines flip angle on F1 channel, generated by au program
;d1 : relaxation delay; 1-5 * T1
;nd0: 1
;NS: 1
;DS: 4
;td1: number of experiments
;FnMODE: QF
