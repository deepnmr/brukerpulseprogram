;decp902hf4
;avance-version (12/01/11)
;calibration of H-2 90 degree pulse on f4 channel 
;using 2H lockswitch unit or BSMS 2H-TX board
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>


"d4=1s/(cnst5*4)"
"d11=30m"
"d12=20u"


1 ze
  d11 LOCKDEC_ON
  50u LOCKH_ON
  d11 H2_PULSE

2 30m
  30m H2_LOCK 
  6m LOCKH_OFF
  d1
  50u LOCKH_ON
  d12 H2_PULSE 
  p1 ph1
  d4
  (center (p1 ph3):f1 (p23 ph2):f4 )
  go=2 ph31
  30m mc #0 to 2 F0(zd)

  d11 H2_LOCK 
  d11 LOCKH_OFF
  d11 LOCKDEC_OFF
exit


ph1=0 2 2 0 1 3 3 1
ph2=0 2 2 0 1 3 3 1
ph3=2 0 0 2 3 1 1 3
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl4 : f4 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p23: f4 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(XD))
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;cnst5: = J(XD)
;ns: 1 * n, total number of scans: NS * TD0



