;hacanhgpsm3d
;avance-version (21/09/15)
;(HA)CANH/(HN)NCAHA
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(Ha) -> F3(Ca,t1) -> F3(N,t2) -> F1(NH,t3)
;      and
;      F1(NH) -> F3(N,t1) -> F2(Ca,t2) -> F1(Ha,t3)
;
;on/off resonance pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1
;using constant time in t2
;(use parameterset )
;
;D.P. Frueh, H. Arthanari & G. Wagner, J. Biomol. NMR 33, 187-196 (2005)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d4=1.6m"
"d21=5.54m"
"d23=12m"
"d26=2.4m"


"d0=3u"
"d10=3u"
"d28=3u"
"d29=3u"
"d20=d23+d0"
"d30=d23+d10"

"in0=inf1/4"
"in10=inf2/4"

"in20=in0"
"in30=in10"

"in28=in31/4-in0"
"in29=in31/4-in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d26-d4-p14"
"DELTA2=d4+d26-p51/2"
"DELTA3=d21-d4-d26-p51/2-2u"
"DELTA4=d23-d21-p26"
"DELTA5=d28*2+p14+p13/2-larger(p13,p21)/4+p21/PI"
"DELTA6=d29+p14/2+p13/4-larger(p13,p21)/8+p21/(2*PI)+p16/2+d16/2"
"DELTA7=d23-d21-p26+p16*2+d16*2-4u"
"DELTA8=d21-d4-d26-p51/2-p16-d16-2u"
"DELTA9=d4+d26-p51/2-p16-d16"
"DELTA10=d26/2+d4/2-p22-p3*2/PI"
"DELTA11=d26/2-d4/2-p14"
"DELTA12=d26/2+d4/2"
"DELTA13=d26/2-d4/2-p14-p3-larger(p1,p21)/2+p1/2"
"DELTA14=p16+d16-p1*2/PI+de+8u" 


"TAU1=p22"



"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"
"spoffs35=bf1*(cnst53/1000000)-o1"


"acqt0=0"
baseopt_echo


aqseq 321


1 d11 ze
  d11 pl12:f2 pl16:f3 
2 d11 do:f2 do:f3
3 d1 pl1:f1 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p1 ph1)
  d4
  (p14:sp3 ph1):f2
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (p1 ph4):f1 

  p16:gp4
  d16

  (p21 ph5):f3
  TAU1
  d28
  (center (p2 ph1) (p14:sp5 ph1):f2 )
  d28
  (p14:sp3 ph1):f2
  d28
  (center (p2 ph3) (p14:sp5 ph1):f2 )
  d28
  (p13:sp2 ph6):f2
  DELTA2
  (p51:sp35 ph1):f1
  2u
  DELTA3 pl19:f1
  (p26 ph2):f1
  DELTA4 cpds1:f1 ph1
  d0
  (p14:sp5 ph1):f2
  d23
  d0
  (p22 ph1):f3
  DELTA5
  (p14:sp3 ph1):f2
  d20
  DELTA5
  (p14:sp5 ph1):f2
  d20
  TAU1

  (center (p13:sp8 ph7):f2 (p21 ph8):f3 )

  TAU1
  d30
  DELTA6
  (p14:sp5 ph1):f2
  DELTA6
  d30
  (p14:sp3 ph1):f2
  DELTA6
  DELTA6
  (p22 ph1):f3
  d10
  d23
  (p14:sp5 ph1):f2
  d10
  DELTA7
  4u do:f1
  (p26 ph4):f1
  DELTA8
  (p51:sp35 ph1):f1
  2u
  DELTA9 pl1:f1
  p16:gp1*EA
  d16
  d29
  (center (p2 ph1) (p14:sp5 ph1):f2 )
  d29
  (p14:sp3 ph1):f2
  d29
  (center (p2 ph3) (p14:sp5 ph1):f2 )
  d29
  p16:gp2*EA
  d16

  (p13:sp2 ph9):f2
  TAU1
  (center (p1 ph1) (p21 ph9):f3 )
  DELTA10
  (p14:sp3 ph1):f2
  DELTA11
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA12
  (p14:sp3 ph1):f2
  DELTA11 pl2:f2
  (center (p1 ph2) (p21 ph10):f3 )
  (p3 ph11):f2
  DELTA12
  (p14:sp3 ph1):f2
  DELTA13
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA12
  (p14:sp3 ph1):f2
  DELTA11
  (p1 ph3)
  DELTA14
  (p2 ph1)
  4u
  p16:gp3
  d16 pl12:f2 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3 
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph5, +90) & calph(ph6, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28)) 
     F2EA(calgrad(EA) & calph(ph10, +180) & calph(ph11, +180), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph7=0 2
ph8=0 0 0 0 2 2 2 2
ph9=0 0 2 2
ph10=1 1 3 3
ph11=3 3 1 1
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;sp35: f1 channel - shaped pulse 180 degree  (off res. at cnst53)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;p51: f1 channel - 180 degree shaped pulse (sp35)
;                      (Reburb.1000: 645us at 600.13 MHz)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4:  1/(4J(CH)                                        [1.6 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d23+d0
;d21: 1/(2J(NH)                                        [5.54 msec]
;d23: 1/(4J(NCa)                                       [12 msec]
;d26: 1/(4J'(NH)                                       [2.4 msec]
;d28: incremented delay (F1 in 3D)                     [3 usec]
;d29: incremented delay (F2 in 3D)                     [3 usec]
;d30: decremented delay (F2 in 3D) = d23+d10
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst53: Halpha chemical shift (offset, in ppm)        [3.7 ppm]
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;in0: 1/(4 * SW(Ca)) =  (1/2) DW(Ca)
;nd0: 4
;in10: 1/(4 * SW(Ca)) =  (1/2) DW(Ca)
;nd10: 4
;in20: = in0
;in28: = in31/4-in0
;in29: = in31/4-in10
;in30: = in10
;in31: 1/SW(N) = 2 * DW(N)
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 65.8%
;gpz2: 29.9%
;gpz3: 9.7%
;gpz4: 50%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



