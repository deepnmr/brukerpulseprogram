;c_hcaconcanco_ia4d
;avance-version (21/09/15)
;(HaCa)CON(Ca)NCO
;4D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(Ha) -> F1(Ca) -> F1(CO,t1) -> F3(N,t2)
;                -> F1(Ca) -> F3(N,t3) -> F1(C=O,t4)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;using constant time in t1
;using constant time in t3
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;P. Dziekanski, K. Grudziaz, P. Jarvoll, W. Kozminski & A. Zawadzka-Kazimierczuk,
;   J. Biomol. NMR 62, 179-190 (2015)
;D. Pantoja-Uceda & J. Santoro, J. Biomol. NMR 59, 43-50 (2014)
;(W. Bermel, I. Bertini,L. Duma, I.C. Felli, L. Emsley,  R. Pierattelli,
;   P.R. Vasos, Angew. Chem. Int. Ed. 44, 2-5 (2005) )
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=2.2m"
"d4=1.85m"
"d22=4.55m"
"d23=14.0m"
"d27=14.3m"
"d28=3.15m"


"d31=3u"
"d32=3u"
"d33=d23-larger(p8,p22)/2"
"d41=d23-p12-4u"
"d43=d23-larger(p8,p22)/2"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"in41=in31"
"in43=in33"


"td1=tdmax(td1,d41*2,in41)"
"td3=tdmax(td3,d43*2,in43)"


"DELTA=d32*2+p8"
"DELTA1=d4-larger(p4,p21)/2"
"DELTA2=d28-d3-p26"
"DELTA3=d23-d31-p12"
"DELTA4=d27-d22-p12"
"DELTA5=d27-p12-4u"
"DELTA6=d23/2-p12/2"
"DELTA7=d23-d22-p12"


"l0=1"


"spoffs13=bf1*((cnst22-cnst21)/2000000)"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs28=0"


"o1_F1=bf1*cnst21/1000000"


1 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph1):f2
  DELTA1
  (center (p12:sp24 ph1) (p4 ph1):f2 )
  DELTA1
  (p3 ph2):f2

  p16:gp1
  d16 pl12:f2

  (p11:sp23 ph1)
  d3
  (p26 ph2):f2
  DELTA2 cpd2:f2 ph1
  (p12:sp26 ph1)
  4u
  (p25:sp28 ph1)
  d28
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph1)
  
  4u fq=cnst21(bf ppm):f1

  (p11:sp23 ph3)
  d31
  (p12:sp27 ph1)
  DELTA3
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d41
  (p12:sp27 ph1)
  4u
  (p11:sp25 ph2)

  4u do:f2
  (p26 ph6):f2
  p16:gp2
  d16
  (p26 ph2):f2
  20u cpd2:f2 ph1

  (p21 ph4):f3
  d32
  (p8:sp13 ph1)
  d32
  (p22 ph1):f3
  DELTA
  (p21 ph1):f3

  4u do:f2
  (p26 ph6):f2
  p16:gp3
  d16 fq=cnst22(bf ppm):f1
  (p26 ph2):f2
  20u cpd2:f2 ph1

  (p11:sp23 ph7)
  d22
  (p12:sp26 ph1)
  DELTA4
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  DELTA5
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph2)

  4u do:f2
  (p26 ph6):f2
  p16:gp4
  d16 fq=cnst21(bf ppm):f1
  (p26 ph2):f2
  20u cpd2:f2 ph1

  (p21 ph5):f3
  d33
  (center (p8:sp13 ph1) (p22 ph1):f3 )
  d43
  (p21 ph1):f3

  4u do:f2
  (p26 ph6):f2
  p16:gp5
  d16
  20u cpd2:f2 ph1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph1)
     DELTA6
     (p12:sp27 ph1)
     DELTA6
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA6
     (p12:sp27 ph1)
     DELTA6 pl16:f3
     }
  else
     {
     (p11:sp23 ph6)
     d22
     (p12:sp27 ph1)
     DELTA7
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA6
     DELTA6 pl16:f3
     (p12:sp27 ph1)
     }

  4u BLKGRAD

  go=2 ph31 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
  
#   ifdef LABEL_F1
     F1I(iu0, 2)
#   else

#   ifdef LABEL_F2
     F2I(iu0, 2)
#   else
     F3I(iu0, 2)
#   endif /*LABEL_F2*/

#   endif /*LABEL_F1*/

     F1PH(calph(ph3, +90), caldel(d31, +in31) & caldel(d41, -in41))
     F2PH(calph(ph4, +90), caldel(d32, +in32))
     F3PH(calph(ph5, +90), caldel(d33, +in33) & caldel(d43, -in43))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=3
ph7=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp13: f1 channel - shaped pulse 180 degree  (adiabatic)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f1 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;p26: f2 channel -  90 degree pulse at pl12
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [2.2 msec]
;d4 : 1/(4J(HCa))                                      [1.85 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa))                                     [4.55 msec]
;d23: 1/(4J(NCO))                                      [14.0 msec]
;d27: 1/(4J(NCa))                                      [14.3 msec]
;d28: 1/(4J'(COCa))                                    [3.15 msec]
;d31: incremented delay (F1 in 4D)                     [3 usec]
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D) = d23-larger(p8,p22)/2
;d41: decremented delay (F1 in 4D) = d23-p12-4u
;d43: decremented delay (F3 in 4D) = d23-larger(p8,p22)/2
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(CO)) =  DW(CO)
;nd31: 2
;in32: 1/(2 * SW(N)) =  DW(N)
;nd32: 2
;in33: 1/(2 * SW(N)) =  DW(N)
;nd33: 2
;in41: = in31
;in43: = in33
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3 * 2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 39%
;gpz2: 29%
;gpz3: 19%
;gpz4: 15%
;gpz5: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



                                           ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
;             only to be used for F1F4 plane
;LABEL_F2: to do ipap in F2 start experiment with
;             option -DLABEL_F2 (eda: ZGOPTNS)
;             only to be used for F2F4 plane
                                           ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] to process data



