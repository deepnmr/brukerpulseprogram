;artsyf3gpphrc
;avance-version (21/09/15)
;ARTSY
;2D H/N correlation via TROSY
;for determination of 1J/1D HN using quantitative J
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;uncompensated version d25=d26
;(use parameterset )
;
;N.C. Fitzkee & A. Bax, J. Biomol. NMR  (2010)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>



"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d23=10.75m"
"d25=2.71m"
"d26=2.71m"


"d0=3u"

"in0=inf1/2"


"DELTA3=d23/4-d16-p1*2/PI-p21*2.1667-10u"
"DELTA4=d26-p16-d16-p11-4u"
"DELTA5=d26-p16-d16"
"DELTA6=d26-p16-d16-p11+p19/2+p22/2-p2/2+d16/2-p1/PI+de/2-2u"

"TAU1=p21*4.3333"
"TAU2=p1*2/PI+p21*2.1667"

#   ifdef LABEL_CN
"DELTA=d0*2+p21*4/PI+p8"
#   else
"DELTA=d0*2+p21*4/PI"
#   endif /*LABEL_CN*/


"spoffs1=0"
"spoffs13=bf2*(cnst26/1000000)-o2"


"l0=0"


"acqt0=0"
baseopt_echo


1 ze 
2 d11
3 d1 pl1:f1

  50u UNBLKGRAD
  (p21 ph1):f3
  p16:gp3
  d16

  (p11:sp1 ph4):f1
  2u
  2u pl1:f1
  (p1 ph5)
  5u gron4
  DELTA3
  5u groff
  d16
  TAU1
  5u gron4
  DELTA3
  5u groff
  d16
  TAU2
  (p2 ph1)

  if "l0 %2 == 0"
     {
     5u gron4
     DELTA3
     5u groff
     d16
     TAU2
     (p21 ph1 p21*2.3333 ph2 p21 ph1):f3
     }
  else
     {
     (p21 ph1 p21*2.3333 ph2 p21 ph1):f3
     5u gron4
     DELTA3
     5u groff
     d16
     TAU2
     }

  5u gron4
  DELTA3
  5u groff
  d16
  (p1 ph2) 

  p19:gp5
  d16

  (p21 ph6):f3
  d0

#   ifdef LABEL_CN
  (p8:sp13 ph1):f2
#   else
#   endif /*LABEL_CN*/

  d0
  p19:gp1*EA
  d16
  (p22 ph6):f3
  p19:gp1*EA*-1
  d16

  DELTA

  (p1 ph7)
  4u
  (p11:sp1 ph8):f1
  p16:gp6
  d16 pl1:f1
  DELTA4
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p16:gp6
  d16
  (p11:sp1 ph1):f1
  2u
  2u pl1:f1
  (p1 ph1)

  (p21 ph9):f3
  p16:gp7
  d16
  (
   refalign (DELTA6 p11:sp1 ph3 2u 2u pl1 p2 ph1 4u p11:sp1 ph3) 
   lalign (DELTA5 p22 ph7 DELTA5):f3
  )
  p16:gp7
  d16
  (p21 ph10):f3
  p19:gp2
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1I(iu0, 2)
     F1EA(calgrad(EA) & calph(ph7, +180) & calph(ph8, +180) & calph(ph10, +180), caldel(d0, +in0) & calph(ph6, +180) & calph(ph31, +180))
exit 
  

ph1=0
ph2=1
ph3=2
ph4=3
ph5=0 2
ph6=1 1 3 3
ph7=3
ph8=1
ph9=0 0 0 0 2 2 2 2
ph10=1 1 1 1 3 3 3 3
ph31=1 3 3 1 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp13: f2 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse           [1 msec]
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d23 : 1/(J)NH                                       [10.75 msec]
;d25 : 1/(4J')NH                                     [2.71 msec]
;d26 : 1/(4J)NH                                      [2.71 msec]
;cnst4: = J(NH)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) = DW(N)
;nd0: 2
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho


;for z-only gradients:
;gpz1: 40%
;gpz2: 8.1%
;gpz3: 41%
;gpz4: 1%
;gpz5: -17%
;gpz6: 5%
;gpz7: 11%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100



;use AU-program split [2] to process data

;$Id: $
