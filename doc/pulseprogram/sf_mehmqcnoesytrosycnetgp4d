;sf_mehmqcnoesytrosycnetgp4d
;avance-version (25/01/29)
;4D SOFAST-(13C)HMQC - NOESY - BEST-(15N)TROSY seqence 
;
; H(Methyl)(H,t1) -> C(Methyl)(C,t2) -> H(Methyl) -> NOE -> HN -> (N,t3) -> HN(H,t4) 
;
; using cnst56 as center of spectrum (1H, F1 dimension) and center of bandselective 
;   H(Methyl) 1H pulses.
; using H(Methyl) selective 1H pulses before NOESY step and H(N) selective 1H pulses 
;   after NOESY step. Bandwith and offset of these pulses is set by cnst54-57.
; using Echo/Antiecho gradient selection in TROSY step
; using delayed sampling in F1 and F2 dimensions
;
; (use parameterset SF_MEHMQCNOESYTROSYCNETGP4D)
;
;(P. Rossi, Y. Xia, N. Khanra & G. Veglia & G. Kalodimos, J. Biomol. NMR 66, 259 (2016))
;(E. Lescop, T. Kern & B. Brutscher, J. Magn. Reson. 203 190-198 (2010))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>

#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

define list<gradient> EA3 = { 1.0000 0.8750 }
define list<gradient> EA5 = { 0.6667 1.0000 }
define list<gradient> EA7 = { 1.0000 0.6595 }

"p2=p1*2"
"d2=1s/(cnst2*2)"
"p4=p3*2"
"p19=500u"
"p29=250u"
"d11=30m"
"d12=20u"
"d25=1s/(cnst4*4)"
"d26=1s/(cnst4*4)"

#   ifdef CALC_SP
"cnst41=0.529"
"cnst43=0.69"
"cnst44=1.172"
"cnst45=1.426"

"p41=(bwfac25/(cnst55*cnst44*bf1))*1000000" ;PC9 HN
"spw25=plw1*pow((p1*totrot25)/(p41*90.0*integfac25),2)"
"spw27=plw1*pow((p1*totrot27)/(p41*90.0*integfac27),2)"
"spoal25=1"
"spoal27=0"
"spoffs25=bf1*(cnst54/1000000)-o1"
"spoffs27=bf1*(cnst54/1000000)-o1"

"p42=(bwfac26/(cnst55*cnst45*bf1))*1000000" ;Reburp HN
"spw26=plw1/(((p42*90.0)/(p1*totrot26))*((p42*90.0)/(p1*totrot26))*(integfac26*integfac26))"
"spoal26=0.5"
"spoffs26=bf1*(cnst54/1000000)-o1"

"p43=(bwfac28/(cnst55*bf1))*1000000" ;Eburp HN
"spw28=plw1/(((p43*90.0)/(p1*96))*((p43*90.0)/(p1*96))*(integfac28*integfac28))"
"spw29=plw1/(((p43*90.0)/(p1*96))*((p43*90.0)/(p1*96))*(integfac29*integfac29))"
"spoal28=1"
"spoal29=0"
"spoffs28=bf1*(cnst54/1000000)-o1"
"spoffs29=bf1*(cnst54/1000000)-o1"

"p50=(bwfac22/(cnst57*cnst44*bf1))*1000000" ;PC9 HC
"spw22=plw1/(((p50*90.0)/(p1*totrot22))*((p50*90.0)/(p1*totrot22))*(integfac22*integfac22))"
"spoal22=1"
"spoffs22=0"
"spnam23=spnam22"
"spw23=plw1/(((p50*90.0)/(p1*totrot23))*((p50*90.0)/(p1*totrot23))*(integfac23*integfac23))"
"spoal23=0"
"spoffs23=0"

"p51=(bwfac35/(cnst57*cnst45*bf1))*1000000" ;Reburp HC
"spw35=plw1/(((p51*90.0)/(p1*totrot35))*((p51*90.0)/(p1*totrot35))*(integfac35*integfac35))"
"spoal35=0.5"
"spoffs35=0"

#   endif /*CALC_SP*/

"spoal39=0.5"
"spoal40=0.5"
"spoffs39=0"
"spoffs40=0"

"in31=inf1"
"in32=inf2"
"in33=inf3"

"d31=in31/2"
"d32=in32/2-p3*4/PI"
"d33=3u"

"DELTA1=d2-p16-d16-p50*cnst41"
"DELTA2=d26-p29-d16-larger(p56,p42)/2-p41*cnst41"
"DELTA3=d33+p21*4/PI+de+4u"
"DELTA4=d25-p29-d16-larger(p56,p42)/2-p43*cnst43"
"DELTA5=de+4u"
"DELTA6=d26-p16-d16-larger(p57,p42)/2"
"TAU=d8-p3-p16-d16"

"o1_F1=bf1*cnst56/1000000"

"acqt0=0"
baseopt_echo

1 d11 ze
2 d11
3 d12
  
  d1 pl2:f2 pl3:f3

  50u UNBLKGRAD fq=cnst56 (bf ppm):f1
  (p21 ph1):f3
  (p3 ph1):f2
  p16:gp10
  d16

  (p50:sp22 ph13) 
  (lalign (d31) (p4 ph1 d31*0.5 p4 ph1):f2)
  p16:gp22
  d16
  (center (p51:sp35 ph16):f1 (DELTA1 p3 ph17 d32 p3 ph15 DELTA1):f2 )
  p16:gp22
  d16 
  (p50:sp23 ph1)

  TAU 
  (p21 ph1):f3

  p16:gp12
  d16 fq=0:f1 

  (p41:sp25 ph1)
  p29:gp1
  d16
  DELTA2
  (center (p42:sp26 ph1) (p56:sp39 ph1):f3 )
  DELTA2
  p29:gp1
  d16

  (p41:sp27 ph2):f1

  p29:gp2
  d16 pl3:f3

  (p21 ph5):f3

if "d33>p8"
  {
    (center (d33) (p8:sp13 ph1):f2)
  }
else
  {
    d33
  }

  (p56:sp39 ph1):f3
  DELTA3

  p19:gp3*EA3
  d16

  (p43:sp29 ph6)
  p29:gp4
  d16
  DELTA4
  (center (p42:sp26 ph1) (p56:sp39 ph1):f3 )
  DELTA4
  p29:gp4
  d16
  (p43:sp28 ph1)

  p19:gp5*EA5
  d16 pl3:f3
  DELTA5

  (p21 ph2):f3
  p16:gp6
  d16
  DELTA6
  (center (p42:sp26 ph1) (p57:sp40 ph1):f3 )
  DELTA6
  p16:gp6
  d16 pl3:f3
  (p21 ph7:r):f3

  p19:gp7*EA7
  d16
10  4u BLKGRAD

  go=2 ph31
  3m mc #0 to 2 
     F1PH(calph(ph13, +90), caldel(d31, +in31))
     F2PH(calph(ph17, +90), caldel(d32, +in32))
     F3EA(calgrad(EA3) & calgrad(EA5) & calgrad(EA7) & calph(ph6, +180) & calph(ph7, +180), caldel(d33, +in33) & calph(ph5, +180) & calph(ph31, +180))  
exit

ph13=0 
ph15=0 
ph16=0 
ph17=0 0 2 2

ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 2
ph6=3
ph7=2
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse 
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse (water flipback/watergate)
;p16: homospoil/gradient pulse   [1 msec]
;p19: homospoil/gradient pulse 2  [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p41: f1 channel -  90 degree shaped pulse for excitation of H(N) (PC9)
;p42: f1 channel - 180 degree shaped pulse for refocussing of H(N) (Reburp)
;p43: f1 channel - 90 degree shaped pulse for excitation of HN (Eburp2/Eburp2tr)
;p50: f1 channel -  90 degree shaped pulse for excitation of H(Methyl) (PC9)
;p51: f1 channel - 180 degree shaped pulse for refocussing of H(Methyl) (Reburp)
;p56: f3 channel - 180 degree shaped pulse for inversion
;p57: f3 channel - 180 degree shaped pulse for refocussing (Reburp)
;
;sp1 : f1 channel - shaped pulse for water flipback (Sinc1.1000)
;sp13: f2 channel - shaped pulse 180 degree (Ca and C=O, adiabatic)
;sp22: f1 channel - shaped pulse 90 degree H(Methyl) (PC9)
;sp23: f1 channel - shaped pulse 90 degree H(Methyl) (PC9)
;sp25: f1 channel - shaped pulse 90 degree H(N) (PC9)
;sp26: f1 channel - shaped pulse 180 degree H(N) (Reburp)
;sp27: f1 channel - shaped pulse 90 degree H(N) (PC9)
;sp28: f1 channel - shaped pulse 90 degree H(N) (Eburp2.1000)
;sp29: f1 channel - shaped pulse 90 degree (Eburp2tr.1000)
;sp35: f1 channel - shaped pulse 180 degree H(Methyl) (Reburp)
;sp39: f3 channel - 180 degree shaped pulse for inversion 
;sp40: f3 channel - 180 degree shaped pulse for refocussing (Reburp.1000)
;
;d1 : relaxation delay,[250-800 ms]
;d8: NOESY mixing time                          
;d10 : incremented delay (F2)                [3usec]
;d11: delay for disk I/O                     [30 msec]
;d12: delay for power switching              [20 usec]
;d16: delay for homospoil/gradient recovery  [200 usec]
;d25: 1/(4J'(NH)                             [2.7 msec]
;d26: 1/(4J(NH)                              [2.7 msec]
;d31: incremented delay (t1) 
;d32: incremented delay (t2)                  
;d33: incremented delay (t3)  
;
;cnst2: = J(CH) (~130)
;cnst4: = J(NH) (~93)
;cnst41: compensation of chemical shift evolution during p41 and p50
;           Pc9_4_90.1000: 0.529
;cnst43: compensation of chemical shift evolution during p43
;           Eburp2.1000: 0.69
;cnst51: scaling factor for p41 to compensate for transition region
;           Pc9_4_90.1000: 1.172
;cnst52: scaling factor for p42 to compensate for transition region
;           Reburp.1000: 1.426
;cnst53: scaling factor for p43 to compensate for transition region
;           Eburp2.1000: 1.000
;cnst54: H(N) chemical shift (offset, in ppm)
;cnst55: H(N) bandwidth of pulses (in ppm)
;cnst56: H(C) chemical shift (offset, in ppm)
;cnst57: H(C) bandwidth of pulses (in ppm)

;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(N) = 2 * DW(N)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(SW(N)) = 2 * DW(N)
;in32: 1/(SW(N)) = 2 * DW(N)
;in33: 1/(SW(N)) = 2 * DW(N)

;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F2
;FnMODE: States-TPPI in F1
;FnMODE: States-TPPI in F2
;FnMODE: echo-antiecho in F3


;for z-only gradients:
;gpz1: 2%
;gpz2: 21%
;gpz3: -80%
;gpz4: 5%
;gpz5: 30%
;gpz6: 45%
;gpz7: 30.13%
;gpz10: 40%
;gpz12: 7%
;gpz22: -67%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.100
;gpnam10: SMSQ10.100  
;gpnam11: SMSQ10.100
;gpnam12: SMSQ10.100
;gpnam13: SMSQ10.100
;gpnam22: SMSQ10.100
                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54-57
;             option -DCALC_SP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end
										  

