;trhncacbgpwg4d
;avance-version (21/09/15)
;TROSY-HNCACB
;4D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(Ca -> Cb,t1 -> Ca,t2) -> F3(N,t3) -> F1(H,t4)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive using Echo/Antiecho (t3)
;using constant time in t2
;using semi-constant time in t3
;water suppression using watergate sequence
;(use parameterset )
;
;(M. Wittekind & L. Mueller, J. Magn. Reson. B 101, 201-205 (1993))
;(D.R. Muhandiram & L.E. Kay, J. Magn. Reson. B 103, 203-216 (1994))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA3 = { 1.0000 0.8750 }
define list<gradient> EA5 = { 0.6667 1.0000 }
define list<gradient> EA7 = { 1.0000 0.6595 }


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d23=12.4m"
"d25=2.4m"
"d26=2.4m"
"d28=7.2m"


"d31=3u"
"d32=3u"
"d33=3u"
"d53=3u"
"d42=d28-p14-4u"
"d43=d23-d26-d25+p21*4/PI-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"FACTOR3=d43*10000000*2/td3"
"INCR3=FACTOR3/10000000"

"if ( INCR3 > in33 ) { in53 = 0; } else { in53=in33-INCR3; }"
"if ( INCR3 > in33 ) { in43 = in33; } else { in43 = INCR3; }"

"in42=in32"

"td2=tdmax(td2,d42*2,in42)"


"DELTA1=d23-d26-p44"
"DELTA2=d31*2+larger(p14,p44)-p14-4u"
"DELTA3=d26-p16-d16-p11-12u"
"DELTA5=d28-d32-larger(p14,p44)"
"DELTA6=d23-d33-p14*2-d53-d25-p16-d16-de"
"DELTA7=d25-p1-p16-d16-larger(p14,p22)/2"
"DELTA8=d26-p11-p16-d16-4u"
"DELTA9=d26-p11-4u"
"DELTA10=d26-p44-p16-d16-p11-4u"

"TAU1=de"
"TAU2=p1*2/PI"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


"acqt0=0"
baseopt_echo


1 ze
2 d11 
3 d1 pl1:f1

  (p1 ph1)
  2u
  (p11:sp1 ph3):f1
  2u
  DELTA9 pl1:f1 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA9 UNBLKGRAD
  (p11:sp1 ph4):f1
  2u
  2u pl1:f1
  (p1 ph4):f1 

  4u
  p16:gp1
  d16

  (p21 ph5):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA1
  (p44:sp30 ph1):f1
  d26
  (p21 ph1):f3
  (p44:sp30 ph1):f1

  (p13:sp2 ph6):f2
  d28
  (p14:sp3 ph1):f2
  d28
  (p13:sp8 ph2):f2

  d31
  (center (p44:sp30 ph1):f1 (p14:sp5 ph1):f2 (p22 ph8):f3 )
  d31
  (p14:sp3 ph1):f2
  DELTA2
  (p14:sp5 ph1):f2
  4u

  (p13:sp2 ph9):f2
  d32
  (center (p44:sp30 ph1):f1 (p14:sp5 ph1):f2 (p22 ph8):f3 )
  DELTA5
  (p14:sp3 ph10):f2
  d42
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph11):f2

  4u
  p16:gp2
  d16

  (p44:sp30 ph1):f1
  (p21 ph7):f3
  d33
  (p14:sp5 ph1):f2
  DELTA6
  (p14:sp3 ph1):f2
  d53
  (p22 ph8):f3
  d43

  (p44:sp30 ph1):f1
  DELTA10
  p16:gp3*EA3
  d16
  (p11:sp1 ph3:r):f1
  2u
  2u pl1:f1

  (p1 ph12)
  p16:gp4
  d16
  DELTA7
  (center (p2 ph2) (p14:sp3 ph1):f2 (p22 ph2):f3 )
  DELTA7
  p16:gp4
  d16
  (p1 ph1) 

  p16:gp5*EA5*-1
  d16
  TAU1

  (p21 ph1):f3
  p16:gp6
  d16
  DELTA8
  (p11:sp1 ph4:r):f1
  2u
  2u pl1:f1
  (center (p2 ph2) (p22 ph2):f3 )
  4u
  (p11:sp1 ph4:r):f1
  DELTA8
  p16:gp6
  d16 pl1:f1
  (p21 ph13:r):f3

  p16:gp7*EA7*-1
  d16
  TAU2 BLKGRAD

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph9, +90) & calph(ph10, +90) & calph(ph11, +90), caldel(d31, +in31))
     F2PH(calph(ph11, +90), caldel(d32, +in32) & caldel(d42, -in42))
     F3EA(calgrad(EA3) & calgrad(EA5) & calgrad(EA7) & calph(ph12, +180) & calph(ph13, +180), caldel(d33, +in33) & caldel(d43, -in43) & caldel(d53, +in53) & calph(ph7, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph6=0
ph7=1 1 3 3
ph8=0 0 2 2
ph9=3 1
ph10=0
ph11=0 2 0 2 2 0 2 0
ph12=3
ph13=1
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (Cali on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Cali on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Cali on resonance)
;                  for time reversed pulse
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NCa)                                       [12.4 msec]
;d25: 1/(4J'(NH)                                       [2.4 msec]
;d26: 1/(4J'(NH)                                       [2.4 msec]
;d28: 1/(4J(CaCb)                                      [7.2 msec]
;d31: incremented delay (F1 in 4D)                     [3 usec]
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D)                     [3 usec]
;d42: decremented delay (F2 in 4D) = d28-p14-4u
;d43: decremented delay (F3 in 4D) = d23-d26-d25+p21*4/PI-4u
;d53: incremented delay (F3 in 4D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(Cb) = 2 * DW(Cb)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;inf3: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(Cb)) =  DW(Cb)
;in32: 1/(2 * SW(Ca)) =  DW(Ca)
;in33: 1/(2 * SW(N)) = DW(N)
;in42: = in32
;in43: = k3 * in33
;in53: = (1 - k3) * in33
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: echo-antiecho in F3


;for z-only gradients:
;gpz1: 70%
;gpz2: 10%
;gpz3: 80%
;gpz4: -3%
;gpz5: 30%
;gpz6: 45%
;gpz7: 30.13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



