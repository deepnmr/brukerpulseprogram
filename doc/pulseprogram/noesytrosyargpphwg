;noesytrosyargpphwg
;avance-version (21/09/15)
;NOESY-TROSY - for aromatic residues
;3D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange
;   H-1/X correlation via TROSY
;phase sensitive (t1)
;phase sensitive (t2)
;constant time version
;water suppression using watergate sequence
;(use parameterset )
;
;(K. Pervushin, R. Riek, G. Wider & K.Wuethrich,
;   J. Am. Chem. Soc. 120, 6394-6400 (1998))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"d4=1s/(cnst2*4)"
"d11=30m"


"d23=8.8m"


"p19=500u"
"d16=100u"


"d0=6u"
"d10=d23-d4/2"
"d30=d23-d4/2"

"in0=inf1/2"
"in10=inf2/2"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d4-p16-d16"
"DELTA2=d4/2-p19-d16"
"DELTA3=d4-p19-d16-p11-8u"

#   ifdef LABEL_CN
"DELTA4=d0*2+larger(p8,p22)+4u"
#   else
"DELTA4=d0*2+p22+4u"
#   endif /*LABEL_CN*/


"TAU=d8-p16-d16-p11-4u"


"spoffs13=bf2*(cnst26/1000000)-o2"


aqseq 321


1 ze
  d11 pl12:f2
2 d11 do:f2
3 d12 pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1 pl2:f2
  50u UNBLKGRAD

  (p1 ph8)
  DELTA4
  (p2 ph9)
  d0 gron0
  2u groff

#   ifdef LABEL_CN
  (center (p8:sp13 ph1):f2 (p22 ph1):f3 )
#   else
  (p22 ph1):f3
#   endif /*LABEL_CN*/

  d0 gron0*-1
  2u groff
  (p1 ph1)
  TAU
  p16:gp1
  d16 pl2:f2

  (p11:sp1 ph2):f1
  2u
  2u pl1:f1
  (p1 ph1)
  p16:gp2
  d16
  DELTA1
  (center (p2 ph1) (p4 ph1):f2 )
  DELTA1
  p16:gp2
  d16
  (center (p1 ph2) (p3 ph3):f2 )

  p19:gp3
  d16
  DELTA2
  (center (p2 ph1) (p4 ph1):f2 )
  DELTA2
  p19:gp3
  d16
  (p3 ph4):f2
  4u
  (p3 ph7):f2
  d10
  (p4 ph1):f2
  d30
  (p3 ph5):f2

  p16:gp4
  d16

  (p1 ph1) 
  4u
  p19:gp5
  d16
  DELTA3
  (p11:sp1 ph6:r):f1
  2u
  2u pl1:f1
  (center (p2 ph1) (p4 ph1):f2 )
  4u
  (p11:sp1 ph6:r):f1
  DELTA3
  p19:gp5
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph8, +90) & calph(ph9, +90) & calph(ph29, +90), caldel(d0, +in0))
     F2PH(calph(ph5, +90), caldel(d10, +in10) & caldel(d30, -in30))
exit 
  

ph1=0
ph2=3
ph3=(8) 1 5
ph4=0 1
ph5=3 3 1 1
ph6=2
ph7=2 1
ph8=0 0 0 0 2 2 2 2
ph9=1
ph29=0
ph31=0 0 2 2 2 2 0 0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp1: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)                     [6 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J)CH
;d8 : mixing time
;d10: incremented delay (F2 in 3D) : d23-d4/2
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d23: constant time delay                              [8.8 msec]
;d30: decremented delay (F2 in 3D) : d23-d4/2
;cnst2: = J(XH)
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(C) = 2 * DW(C)
;in0: 1/(2 * SW(H)) = DW(H)
;nd0: 2
;in10: 1/(2 * SW(C)) = DW(C)
;nd10: 2
;in30: = in10
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2      td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 0 : gp 1 : gp 2 : gp 3 : gp 4 : gp 5
;                          3 :  -45 :   11 :   18 :   80 :   50

;for z-only gradients:
;gpz0: 3%
;gpz1: -45%
;gpz2: 11%
;gpz3: 18%
;gpz4: 80%
;gpz5: 50%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.50



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



