prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"d11=30m"
"d12=20u"

"d22=4.5m"
"d27=3.6m"


"d0=3u"

"in0=inf1/2"


"FACTOR1=(d9/(p6*188.448))"
"l1=FACTOR1"


"DELTA=d0*2"
"DELTA1=d27-p12/2"
"DELTA2=d27+d22/2-p12/2"
"DELTA3=d27-d22/2-p12/2"


"l0=0"


"spoffs23=0"
"spoffs26=bf1*((cnst21-cnst23)/1000000)"
"spoffs27=bf1*((cnst21-cnst22)/1000000)"
"spoffs28=0"
"spoffs29=bf1*((cnst23-cnst22)/1000000)"


"o1_F1=bf1*cnst23/1000000"


1 ze 
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 pl1:f1 fq=cnst23(bf ppm):f1
  50u UNBLKGRAD
  d12 cpd2:f2 cpd3:f3

  (p1 ph3)
  d0
  (p12:sp26 ph1)
  d0
  4u pl1:f1
  (p2 ph1)
  DELTA
  (p12:sp26 ph1)
  2u
  2u pl1:f1
  (p1 ph4)

  4u do:f2 do:f3
  p16:gp1
  d16 pl10:f1
