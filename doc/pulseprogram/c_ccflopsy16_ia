  p16:gp2
  d16 fq=cnst22(bf ppm):f1 
  20u cpd2:f2 cpd3:f3
  4u BLKGRAD

  if "l0 %4 == 0"
     {
     (p11:sp23 ph5)
     4u
     (p12:sp29 ph1)
     DELTA1
     (p12:sp27 ph1)
     DELTA1
     4u
     (p25:sp28 ph1)
