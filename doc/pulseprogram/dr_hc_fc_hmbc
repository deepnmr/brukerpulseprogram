;cnst2: = J(HC)                                        [170Hz]
;cnst5: = J(FC)                                        [255Hz]
;cnst13: = J(HC) and J(FC) long range                  [10 Hz]
;l3 : loop for 2D experiment = td1
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;ns: 4 * n
;ds: 32
;td1: number of experiments
