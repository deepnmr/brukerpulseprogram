;$Id:$
;calibration of 90 degree pulse on f2 channel
;1D sequence for 2D dataset
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"d2=1s/(cnst2*2)"

1 ze
2 30m
  d1
  p1 ph1
  d2
  p3:f2 ph2
  go=2 ph31
  30m mc #0 to 2 F1QF()
exit

ph1=0 2 2 0 1 3 3 1
ph2=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(XH))
;cnst2: = J(XH)
;NS: 1 * n, total number of scans: NS * TD0
