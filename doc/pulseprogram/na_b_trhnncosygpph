;na_b_trhnncosygpph
;avance-version (21/11/23)
;best-TROSY HNN-COSY
;2D H-1/N-15 correlation via multiple inept transfer
;for direct observation of hydrogen bonds in nucleic acid
;   base pairs by internucleotide 2J(N,N) couplings
;
;   for UA:
;      F1(H3) -> F3(N3) -> F3(N1,t1) -> F3(N3) -> F1(H3,t2)
;
;   for GC:
;      F1(H1) -> F3(N1) -> F3(N3,t1) -> F3(N1) -> F1(H1,t2)
;
;phase sensitive
;using shaped 180 degree pulses on f3
;(use parameterset NA_B_TRHNNCOSYGPPH)
;
;J. Farjon, J. Boisbouvier, P. Schanda, A. Pardi, J.-P. Simorre & B. Brutscher
;  J. Am. Chem. Soc. 131, 8571-8577 (2009)
;(A.J. Dingley & S. Grzesiek,
;   J. Am. Chem. Soc. 120, 8293-8297 (1998) )
;(M. Hennig & J.R. Williamson,
;   Nucleic Acids Res. 28, 1585-1593 (2000) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_na>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p22=p21*2"
"d11=30m"
"d12=20u"

"d26=2.7m"

"p29=250u"


#   ifdef CALC_SP
"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1/(((p42*90.0)/(p1*totrot26))*((p42*90.0)/(p1*totrot26))*(integfac26*integfac26))"
"spoal26=0.5"

"p43=(bwfac28/(cnst55*cnst53*bf1))*1000000"
"spw28=plw1/(((p43*90.0)/(p1*totrot28))*((p43*90.0)/(p1*totrot28))*(integfac28*integfac28))"
"spw29=plw1/(((p43*90.0)/(p1*totrot29))*((p43*90.0)/(p1*totrot29))*(integfac29*integfac29))"
"spoal28=1"
"spoal29=0"
#   endif /*CALC_SP*/


"in0=inf1"
"d0=in0/2-p21*4/PI"


"DELTA1=d26-p19-d16-larger(p22,p42)/2"
"DELTA2=d26-p29-d16-larger(p22,p42)/2-p43*cnst43"
"DELTA3=d26-p16-d16-larger(p22,p42)/2"
"DELTA4=de"
"DELTA5=d27/2-p16-d16-p32/2-4u"

"TAU=p21*4/PI+4u"


"spoffs13=0"
"spoffs14=0"

"spoffs26=bf1*(cnst54/1000000)-o1"
"spoffs28=bf1*(cnst54/1000000)-o1"
"spoffs29=bf1*(cnst54/1000000)-o1"


"acqt0=0"
baseopt_echo


1 d11 ze
2 d11
3 d12

  (p22 ph1):f3
  d1 pl1:f1
  50u UNBLKGRAD

  (p43:sp28 ph1)
  p19:gp1
  d16
  DELTA1
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA1
  p19:gp1
  d16
  (p43:sp29 ph2)

  p16:gp2
  d16

  (p21 ph3):f3
  4u
  DELTA5
  p16:gp5
  d16
  (p32:sp14 ph7):f3
  4u
  p16:gp5
  d16
  DELTA5
  TAU
  DELTA5
  p16:gp5
  d16
  (p32:sp14 ph7):f3
  4u
  p16:gp5
  d16 pl3:f3

#   ifdef LABEL_CN
  (center (p8:sp13 ph1):f2 (DELTA5 p21 ph4 d0 p21 ph5 DELTA5):f3 )
#   else
  (DELTA5 p21 ph4 d0 p21 ph5 DELTA5):f3
#   endif /*LABEL_CN*/

  4u
  p16:gp6
  d16
  (p32:sp14 ph1):f3
  4u
  p16:gp6
  d16
  DELTA5
  TAU
  DELTA5
  p16:gp6
  d16
  (p32:sp14 ph1):f3
  4u
  p16:gp6
  d16 pl3:f3
  DELTA5

  (p43:sp29 ph6)
  p29:gp4
  d16
  DELTA2
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA2
  p29:gp4
  d16
  (p43:sp28 ph1)

  DELTA4
  (p21 ph1):f3
  4u
  p16:gp3
  d16
  DELTA3
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp3
  d16
  4u BLKGRAD
  (p21 ph6):f3

  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph3, +90) & calph(ph4, +90), caldel(d0, +in0))
exit


ph1=0
ph2=1 
ph3=0 3 2 1
ph4=1 2 3 0
ph5=3 0 1 2
ph6=3
ph7=1
ph31=0 3 2 1


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp13: f2 channel - shaped pulse 180 degree (Ca and C=O, adiabatic)
;sp14: f3 channel - shaped pulse 180 degree (adiabatic)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp28: f1 channel - shaped pulse  90 degree (Eburp2.1000)
;sp29: f1 channel - shaped pulse  90 degree (Eburp2tr.1000)
;                   for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                                 [250 usec]
;p32: f3 channel - 180 degree shaped pulse for inversion (adiabatic)
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.4ms at 600.13 MHz)
;p43: f1 channel -  90 degree shaped pulse for excitation
;                      Eburp2.1000/Eburp2tr.1000 (1.7ms at 600.13 MHz)
;d0 : incremented delay (F1)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(NH))                                       [2.7 msec]
;d27: 1/(4J(NN))                                       [15 msec]
;
;cnst43: compensation of chem. shift evolution during p43 [Eburp: 0.69]
;cnst52: scaling factor for excitation bandwith p42 [Reburp: 1.426]
;cnst53: scaling factor for excitation bandwith p43 [Eburp2: 1.0]
;cnst54: H(N) chemical shift (offset, in ppm)
;cnst55: H(N) excitation bandwidth (in ppm)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/SW(N) = 2 * DW(N)
;nd0: 1
;ns: 4 * n
;ds: >= 16
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI)


;for z-only gradients:
;gpz1: 30%
;gpz2: 60%
;gpz3: 44%
;gpz4: 18%
;gpz5: 5%
;gpz6: 3%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.32
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



                                          ;preprocessor-flags-start
;CALC_SP: for calculation of all bandselective Proton pulses based on cnst54 and cnst55
;             option -DCALC_SP (eda: ZGOPTNS)
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end
										  


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1
										  


