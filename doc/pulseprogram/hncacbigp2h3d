;hncacbigp2h3d
;avance-version (21/09/15)
;intra-HNCACB
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N) -> F2(C=O) -> F2(Ca -> Cb,t1)
;            -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1
;using constant time in t2
;with H-2 decoupling - requires lockswitch unit or BSMS 2H-TX board
;with suppression of protonated carbons
;(use parameterset HNCACBIGP2H3D)
;
;D.Nietlispach, Y. Ito & E.D. Laue, 
;   J. Am. Chem. Soc. 124, 11199-11207 (2002)
;(T. Yamazaki, W. Lee, C.H. Arrowsmith, D.R. Muhandiram & L.E. Kay,
;   J. Am. Chem. Soc. 116, 11655-11666 (1994))
;(B. Brutscher, J. Magn. Reson. 156, 155-159 (2002))
;(P. Permi, J. Biomol. NMR 23, 201.209 (2002))
;(M. Wittekind & L. Mueller, J. Magn. Reson. B 101, 201-205 (1993))
;(D.R. Muhandiram & L.E. Kay, J. Magn. Reson. B 103, 203-216 (1994))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d4=1.7m"
"d21=5.5m"
"d22=4.2m"
"d23=26m"
"d25=16.5m"
"d24=13.3m"
"d26=2.3m"
"d27=15.8m"

#   ifdef LABEL_CB
"d28=7.2m"
#   else
"d28=3.6m"
#   endif /*LABEL_CB*/


"d0=3u"
"d10=d27/2"
"d20=d24-p14-4u"
"d29=d27/2-p26-d21-4u"
"d30=d27/2"

"in0=inf1/2"
"in10=inf2/4"

"in20=in0"
"in29=in10"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=p16+d16+8u" 
"DELTA2=d25-d21-p26"
"DELTA3=d23-d25-p14"
"DELTA4=d22-p14-4u"
"DELTA5=d24-d0-d4-p2"
"DELTA6=d21-p16-d16-p13*2-8u"
"DELTA7=d4-larger(p14,p22)"


"spoffs2=0"
"spoffs3=0"
"spoffs4=bf2*((cnst21-cnst23)/1000000)"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst23)/1000000)"
"spoffs8=0"
"spoffs13=bf2*((cnst26-cnst23)/1000000)"


"o1_F1=bf2*cnst23/1000000"


aqseq 321


1 d11 ze
  d11 LOCKDEC_ON
  50u LOCKH_ON
  d11 H2_PULSE
  d11 pl16:f3 pl17:f4

2 d11 do:f3
3 d11 H2_LOCK
  6m LOCKH_OFF
  d1 pl1:f1 fq=cnst23(bf ppm):f2
  50u LOCKH_ON
  d12 H2_PULSE

  (p1 ph1)
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAMP
  (p1 ph2):f1 

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph1):f3
  d21 pl19:f1
  (p26 ph2):f1
  DELTA2 cpds1:f1 ph1
  (p14:sp7 ph1):f2
  DELTA3
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph1):f3

  4u
  30u fq=cnst21(bf ppm):f2

  (p13:sp2 ph3):f2
  4u
  (p14:sp5 ph1):f2
  DELTA4
  (p14:sp3 ph1):f2
  4u
  (p14:sp5 ph1):f2
  DELTA4
  (p13:sp8 ph2):f2

  4u do:f1
  (p26 ph2):f1
  30u fq=cnst23(bf ppm):f2
  20u cpd4:f4

  (p13:sp2 ph4):f2
  d28
  (p14:sp3 ph1):f2
  d28
  (p13:sp8 ph2):f2

  d0
  (center (p14:sp7 ph1):f2 (p22 ph8):f3 )
  DELTA7 pl1:f1
  (p2 ph1):f1
  DELTA5
  (p14:sp3 ph1):f2
  d20 pl19:f1
  (p14:sp7 ph1):f2
  4u

  (p13:sp2 ph9):f2
  d28
  (p14:sp3 ph1):f2
  d28
  (p13:sp8 ph10):f2

  4u do:f4
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph2):f3
  d30
  d30
  (center (p8:sp13 ph1):f2 (p22 ph8):f3 )
  d10
  d29
  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2*EA
  d16 
  DELTA6 pl1:f1
  (p13:sp2 ph1):f2
  4u
  (p13:sp4 ph1):f2

  (center (p1 ph1) (p21 ph5):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (center (p1 ph2) (p21 ph6):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26
  (p1 ph1)
  DELTA1
  (p2 ph1)
  4u
  p16:gp3
  d16 pl16:f3
  4u BLKGRAMP
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph9, -90) & calph(ph10, -90), caldel(d0, +in0) & caldel(d20, -in20) & calph(ph9, +180)) 
     F2EA(calgrad(EA) & calph(ph6, +180), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30))

  d11 H2_LOCK
  d11 LOCKH_OFF
  d11 LOCKDEC_OFF

exit


ph1=0
ph2=1 
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0
ph5=0 0 2 2
ph6=3 3 1 1
ph7=3
ph8=0 0 2 2
ph9=3 1
ph10=0 2 0 2 2 0 2 0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0



;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl17: f4 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1 : f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2 : f2 channel - shaped pulse  90 degree  (on resonance)
;sp3 : f2 channel - shaped pulse 180 degree  (on resonance)
;sp4 : f2 channel - shaped pulse  90 degree  (C=O off resonance)
;sp5 : f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7 : f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8 : f2 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp13: f2 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse             [2 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4:  1/(4J(CH)                                        [1.7 msec]
;d10: incremented delay (F2 in 3D) =  d27/2
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d24-p14-4u
;d21: 1/(2J(NH))                                       [5.5 msec]
;d22: 1/(4J(COCa))                                     [4.2 msec]
;d23: 1/(4J(NCa))                                      [26 msec]
;d24: 1/(2J(CaCb), T(C)                                [13.3 msec]
;d25: 1/(4J(NCO))                                      [16.5 msec]
;d26: 1/(4J'(NH))                                      [2.3 msec]
;d27: 1/(4J'(NCa)) and 1/(4J'(NCO))                    [15.8 msec]
;d28: 1/(8J(CaCb))                                     [3.6 msec]
;d29: incremented delay (F2 in 3D) = d27/2-p26-d21-4u
;d30: decremented delay (F2 in 3D) = d27/2
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Cali)) =  DW(Cali)
;nd0: 2
;in10: 1/(4 * SW(N)) = (1/2) DW(N)
;nd10: 4
;in20: = in0
;in29: = in10
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1       td1 max = 2 * d20 / in20
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;cpd4: decoupling according to sequence defined by cpdprg4
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence
;pcpd4: f4 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3
;                         30 :   80 :  8.1

;for z-only gradients:
;gpz1: 30%
;gpz2: 80%
;gpz3: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_CB: for Cb only start experiment with
;             option -DLABEL_CB (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



