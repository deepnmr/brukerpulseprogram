;hsqcexf3gpwgph
;avance-version (21/09/15)
;2D H-1/X correlation via double inept transfer
;   using sensitivity improvement
;for measuring N-15 exchange
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using f3 - channel
;using flip-back pulse
;using semi-constant time in t1
;(use parameterset HSQCEXF3GPWGPH)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d25=1s/(cnst4*cnst12)"
"d26=1s/(cnst4*4)"


"d28=3u"

#   ifdef LABEL_CN
"d0=d26-larger(p2,p8)/2"
"d20=d26+larger(p2,p8)/2+d28"
#   else
"d0=d26-p2/2"
"d20=d26+p2/2+d28"
#   endif /*LABEL_CN*/

"in0=inf1/2"

"FACTOR1=d20*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in28 = 0; } else { in28=in0-INCR1; }"


"DELTA2=d26-p16-d16-p11-12u"
"DELTA3=2.5m-p2/2"
"DELTA4=2.5m-p2/2-p16-d16-4u"


"COUNTER=( d7 / 10m )"


"spoffs1=0"
"spoffs13=bf2*((cnst21+cnst22)/2000000)-o2"


1 ze
  d11 pl16:f3
2 d11 do:f3 
3 d1 pl1:f1 pl3:f3
  (p1 ph1)
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2)

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16 pl1:f1

  (p21 ph8):f3
  d0

#   ifdef LABEL_CN
  (center (p2 ph9) (p8:sp13 ph1):f2  )
#   else
  (p2 ph9)
#   endif /*LABEL_CN*/

  d28
  (p22 ph6):f3
  d20
  (p21 ph1):f3

  DELTA3
  (p2 ph5):f1
  DELTA3

4 DELTA3
  (p2 ph1):f1
  DELTA3
  DELTA3
  (p2 ph5):f1
  DELTA3
  lo to 4 times COUNTER

  DELTA3
  (p2 ph1):f1
  4u
  p16:gp2
  d16
  DELTA4

  (p21 ph3):f3
  d25 
  (center (p2 ph1) (p22 ph1):f3  )
  d25
  (p21 ph4):f3

  p16:gp3
  d16 pl0:f1
  (p11:sp1 ph5):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA2 pl0:f1
  (p11:sp1 ph5):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph5):f1
  4u
  DELTA2
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph8, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28))

exit
   

ph1=0 
ph2=1
ph3=1 1 1 1 3 3 3 3 
ph4=0 0 2 2
ph5=2
ph6=0
ph7=3
ph8=1 3 
ph9=0 0 2 2
ph31=0 2 2 0 2 0 0 2
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1 : f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D) = d26-p/2
;d1 : relaxation delay; 1-5 * T1
;d7 : delay for exchange
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d26+p/2+d28 
;d25: 1/(4J)NH for NH
;     1/(8J)NH for all multiplicities
;d26: 1/(4J(NH))
;d28: incremented delay (2D)                         [3 usec]
;cnst4: = J(NH)
;cnst12: for multiplicity selection = 4 for NH, 8 for all multiplicities
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) = DW(N)
;nd0: 2
;in20: = k1 * in0
;in28: = (1 - k1) * in0
;ns: 2 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: States-TPPI (or TPPI)
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



