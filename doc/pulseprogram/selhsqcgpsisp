;selhsqcgpsisp
;avance-version (21/09/15)
;selective 1D-HSQC
;1D H-1/X correlation via double inept transfer
;   using sensitivity improvement
;with decoupling during acquisition
;using trim pulses in inept transfer
;using shaped pulses for inversion on f2 - channel
;
;A.G. Palmer III, J. Cavanagh, P.E. Wright & M. Rance, J. Magn.
;   Reson. 93, 151-170 (1991)
;L.E. Kay, P. Keifer & T. Saarinen, J. Am. Chem. Soc. 114,
;   10663-5 (1992)
;J. Schleucher, M. Schwendinger, M. Sattler, P. Schmidt, O. Schedletzky,
;   S.J. Glaser, O.W. Sorensen & C. Griesinger, J. Biomol. NMR 4,
;   301-306 (1994)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d4=1s/(cnst2*4)"
"d11=30m"


"DELTA1=p16+d16+8u"
"DELTA2=d4-larger(p2,p14)/2"
"DELTA3=d4*2-p16-d16-4u"
"DELTA4=d24-cnst17*p24/2-4u"


#   ifdef CALC_SPOFFS
"spoffs26=bf2*(cnst22/1000000)-o2"
#   else
#   endif /*CALC_SPOFFS*/


1 ze
  d11 pl12:f2
2 d11 do:f2 
3 d1

  (p1 ph1)
  DELTA2 pl0:f2
  4u
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  4u
  DELTA2 pl2:f2 UNBLKGRAD

#   ifdef TRIMP
  p28 ph1
#   endif /* TRIMP */

  (p1 ph2) 

  p16:gp3
  d16 pl19:f1

  (p3 ph3):f2

  p16:gp1
  d16
  DELTA3
  4u cpds1:f1
  (p36:sp26 ph1:r):f2
  4u do:f1
  DELTA3
  p16:gp1*-1
  d16 pl1:f1 pl2:f2
  
  (center (p1 ph1) (p3 ph4):f2 )
  4u
  DELTA4
  (center (p2 ph1) (p24:sp7 ph1):f2 )
  4u
  DELTA4 pl2:f2
  (center (p1 ph2) (p3 ph5):f2 )
  DELTA2 pl0:f2
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA2
  (p1 ph1)
  DELTA1
  (p2 ph1)
  4u
  p16:gp2
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 F0(zd)
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 2 2
ph5=1 1 3 3
ph31=0 2 2 0
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse 180 degree for inversion
;spnam3: Crp60,0.5,20.1
;sp7: f2 channel - shaped pulse 180 degree for refocussing
;spnam7: Crp60comp.4 or bandselective pulse
;sp26: f2 channel - shaped pulse 180 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;p28: f1 channel - trim pulse
;p36: f2 channel - 180 degree shaped pulse
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J)XH
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d24: 1/(8J)XH for all multiplicities
;     1/(4J)XH for XH
;cnst2: = J(XH)
;cnst17: = -0.5 for Crp60comp.4
;cnst22: chemical shift for selective pulse (offset, in ppm)
;ns: 2 * n, total number of scans: NS * TD0
;ds: >= 16
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 40.2%
;gpz3: 50%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


                                          ;preprocessor-flags-start
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



