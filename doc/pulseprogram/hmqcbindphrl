;hmqcbindphrl
;avance-version (12/01/11)
;HMQC-COSY
;2D relayed H-1/X correlation via heteronuclear zero and double
;   quantum coherence using BIRD sequence
;phase sensitive
;no decoupling during acquisition
;
;L. Lerner & A. Bax, J. Magn. Reson. 69, 375-380 (1986)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"p2=p1*2"
"p4=p3*2"
"d2=1s/(cnst2*2)"


"d0=3u"

"in0=inf1/2"


1 ze 
2 d1
3 p1 ph1
  d2
  (center (p2 ph1) (p4 ph4):f2 )
  d2 
  p1 ph2
  d7
  p3:f2 ph5
  p1 ph1
  d2
  p3:f2 ph6
  d0
  p2 ph3
  d0
  p3:f2 ph7
  d2
  p1 ph8
  go=2 ph31 
  d1 mc #0 to 2 F1PH(calph(ph6, +90), caldel(d0, +in0))
exit 
  

ph1=0 
ph2=2 
ph3=0 
ph4=0 
ph5=0 0 0 0 2 2 2 2
ph6=0 2
ph7=0 0 2 2 
ph8=1
ph31=0 2 2 0

  
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;d0 : incremented delay (2D)                  [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J)XH
;d7 : delay for inversion recovery
;     optimize to give null for protons bound to C-12
;cnst2: = J(XH)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ



