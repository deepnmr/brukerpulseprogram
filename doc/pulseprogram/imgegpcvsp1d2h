;imgegpcvsp1d2h
;avance-version (12/01/11)
;1D Gradient Echo for gradshim-procedure 
;using 2H lockswitch unit or BSMS 2H-TX board
;   and selective pulse
;with convection compensation  
;
;C.-L. Evans, G.A. Morris & A.L. Davis,
;   J. Magn. Reson. 154, 325-328, 2002
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include<Avance.incl>
#include<Grad.incl>
#include<De.incl>
#include<Sysconf.incl>


"d11=30m"
"d12=20u"


1 ze
  d11 LOCKDEC_ON
  d11 UNBLKGRAMP
  d11 H2_PULSE

2 d1 
  4u reset:f1
  d12 reset:D
  (p11:sp1 ph1):D

#   ifdef LABEL_NOCOMP
  d27 gron1
  5u groff 
  d15
#   else
  d27 gron1*-1
  5u groff 
  d15*0.5				
  d27*2 gron1
  5u groff
  d15*0.5				
#   endif /*LABEL_NOCOMP*/

  d21 gron2
  ACQ_START(ph30,ph31)
  aq DWELL_GEN:f1
  5u groff
  rcyc=2
  400m wr #0

  d11 H2_LOCK
  d11 BLKGRAMP
  d11 LOCKDEC_OFF
exit


ph1=0 2 1 3
ph30=0
ph31=0 2 1 3


;pl_ : f_ channel - power level for pulse (default)
;sp1: f_ channel - shaped pulse (10-15 degree)
;spnam1: Gaus1.1000
;p11: f_ channel -  small flip angle (10-15 degree)    [20 msec]
;d1 : relaxation delay
;d11: delay for disk I/O                               [30 msec]
;d15: echo time
;d21: gradient stabilisation delay
;d27: length of dephasing gradient (phase encode time)
;ns: 1 * n
;ds: 2


;define channel number in Sysconf.incl (default is f1)


;for 20msec Gaussian pulse of 10-15 degree sp1 corresponds
;      to a power level of a 74ms rectangular 90deg pulse) 
;p11:sp1 is not prosol compatible in this context



                                          ;preprocessor-flags-start
;LABEL_NOCOMP: switch off convection compensation for trouble 
;                 shooting purpose
;                 option -DLABEL_NOCOMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



