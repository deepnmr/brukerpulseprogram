;ereticgppn
;avance-version (12/01/11)
;1D version of noesyprph for quantitative measurements
;using f2 channel for Eretic signal
;with presaturation during relaxation delay and mixing time
;   and spoil gradient
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>


"p62=aq"
"d12=20u"


1 ze
  d12 pl25:f2
2 30m do:f2
  d12 pl9:f1
  d1 cw:f1 ph29
  4u do:f1
  50u UNBLKGRAD
  p16:gp1
  d16 pl1:f1
  4u reset:f1
  4u reset:f2
  p1 ph1
  4u
  p1 ph2
  d12 pl9:f1
  d8 cw:f1
  4u do:f1
  p16:gp2
  d16 pl1:f1
  4u BLKGRAD
  p0 ph3
  4u cpds2:f2 ph5:r
  go=2 ph31
  30m do:f2 mc #0 to 2 F0(zd)
exit


ph1= 0 2 
ph2= 0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph3= 0 0 2 2 1 1 3 3
ph5= 0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3
ph29=0
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl25: f2 channel - power level for eretic pulse
;sp15 : eretic shape pulse
;p0 : for any flip angle
;p1 : f1 channel -  90 degree high power pulse
;p62 : eretic pulse (exponential decay)
;p16: homospoil/gradient pulse
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4
;cpds2: decoupling according to sequence defined by cpdprg2


;phcor5:phase difference between eretic signal and spectrum


;use CPD program eretic


;use gradient ratio:    gp 1 : gp 2
;                         50 :  -10

;for z-only gradients:
;gpz1: 50%
;gpz2: -10%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



