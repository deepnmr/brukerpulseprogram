;mlevphpp_zshd
;avance-version (16/11/30)
;homonuclear Hartman-Hahn transfer using MLEV17 sequence
;   for mixing
;using two power levels for excitation and spinlock
;phase sensitive
;using purge pulses before d1
;uses instant 1H broadband homodecoupling during acquisition
;   with a Zangger-Sterk element
;
;N.H. Meyer & K. Zangger, Angew. Chem. Int. Ed. 52, 7143-7146 (2013)
;A. Bax & D.G. Davis, J. Magn. Reson. 65, 355-360 (1985)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>


"p5=p6*.667"
"p7=p6*2"
"d11=30m"
"d12=20u"


"d62=aq/l0"
"d63=d62/2"


"in0=inf1"

"d0=in0/2-p1*2/PI-4u"


"SCALEF=p7*2/p5"
"FACTOR1=((d9-p17*2)/(p6*64+p5))/SCALEF"
"l1=FACTOR1*SCALEF"

"l2=l0-1"


"DELTA3=p16+d16+de+5u"


"acqt0=0"
baseopt_echo


1 ze
2 d11

3 d12 pl10:f1
  4u BLKGRAD

  p17 ph2
  p17*2 ph3
  d1 pl1:f1
  50u UNBLKGRAD

  p1 ph1
  d0
  4u pl10:f1
  (p17 ph26)
						;begin MLEV17
4 (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph22 p7 ph23 p6 ph22)
  (p6 ph24 p7 ph25 p6 ph24)
  (p6 ph24 p7 ph25 p6 ph24)
  (p5 ph23)
  lo to 4 times l1 
						;end MLEV17
  (p17 ph26) 

  4u
  (p44:sp30 ph2):f1

  4u
  p16:gp1*0.5
  d16

  (p44:sp30 ph2):f1

  p16:gp1*-0.5
  d16
  DELTA3
  (p48:sp36 ph4):f1 (p48:gp0)
  5u
  p16:gp1*-1.0
  d16

  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d63
  0.1u REC_BLK
  0.05u DWELL_HOLD

  p16:gp2
  d16 pl1:f1
  p2 ph4
  p16:gp2 
  d16 
   
  p16:gp3
  d16
  5u
  (p48:sp36 ph5):f1 (p48:gp0)
  5u
  p16:gp3
  d16 

5 0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK
  
  p16:gp2
  d16 pl1:f1
  p2 ph4
  p16:gp2 
  d16 
 
  p16:gp3
  d16
  5u
  (p48:sp36 ph5):f1 (p48:gp0)
  5u
  p16:gp3
  d16 

  lo to 5 times l2

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62*2
  0.05u DWELL_HOLD
  0.1u REC_BLK

  rcyc=2

  d11 mc #0 to 2 
     F1PH(calph(ph1, +90), caldel(d0, +in0))
exit


ph1=0 2
ph2=0
ph3=1
ph4=0 0 2 2
ph5=2 2 0 0 

ph22=3
ph23=0
ph24=1
ph25=2
ph26=0

ph30=0
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp36: f1 channel - shaped pulse 180 degree for Zangger-Sterk element
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p5 : f1 channel -  60 degree low power pulse
;p6 : f1 channel -  90 degree low power pulse
;p7 : f1 channel - 180 degree low power pulse
;p16: homospoil/gradient pulse                              [1 msec]
;p17: f1 channel - trim pulse                               [2.5 msec]
;p44: f1 channel - 180 degree shaped pulse for refocussing
;p48: f1 channel - 180 degree shaped pulse for Zangger-Sterk element
;d0 : incremented delay (2D) = in0/2-p1*4/PI-4u
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d11: delay for disk I/O                                    [30 msec]
;d12: delay for power switching                             [20 usec]
;d16: delay for homospoil/gradient recovery
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;l1: loop for MLEV cycle: (((p6*64) + p5) * l1) + (p17*2) = mixing time
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;for z-only gradients:
;gpz0: ca. 2%
;gpz1: 19%
;gpz2: 7%
;gpz3: 5%

;use gradient files:
;gpnam0: RECT.1
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


;Processing

;PHC0(F1): 180
;PHC1(F1): -180
;FCOR(F1): 1



