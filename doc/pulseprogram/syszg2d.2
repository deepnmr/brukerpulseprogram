;syszg2d.2
;avance-version (00/12/12)
;2D sequence for experiments with DS >0 or NS > 1
;for temperature calibration and stability test
;
;$CLASS=HighRes HWT
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$HIDE=y


#include <Avance.incl>


1 ze
  d31
2 d1
  p1 ph1
  go=2 ph31
  30m wr #0 if #0
  lo to 1 times td1
exit


ph1=0
ph31=0


;d1 : relaxation delay; 1-5 * T1
;d31: delay between consecutive 1D spectra
;NS: 1 * n
;td1: number of experiments


;use testab for acquisition
;use proc_testab for processing and evaluation
;       (or xf2 for processing only)



