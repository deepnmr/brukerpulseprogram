;lpr_hmqcnoesyf3gpph19
;avance-version (21/09/15)
;L-PROSY HMQC-NOESY
;2D sequence with
;   homonuclear correlation via dipolar coupling 
;   dipolar coupling may be due to noe or chemical exchange.
;   H-1/X correlation via double inept transfer
;phase sensitive (t1)
;with decoupling during acquisition
;water suppression using 3-9-19 pulse sequence with gradients
;using L-PROSY steps
;(use parameterset )
;
;M. Novakovic, S.F. Cousin, M.J. Jaroszewicz, R. Rosenzweig & L. Frydman,
;   J. Magn. Reson. 294, 169-180 (2018)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d21=1s/(cnst4*2)"


"p41=(bwfac25/(cnst55*cnst51*bf1))*1000000"
"spw25=plw1*pow((p1*totrot25)/(p41*90.0*integfac25),2)"
"spw27=plw1*pow((p1*totrot27)/(p41*90.0*integfac27),2)"
"spoal25=1"
"spoal27=0"

"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1*pow((p1*totrot26)/(p42*90.0*integfac26),2)"
"spoal26=0.5"


"in0=inf1"

"d0=in0/2-p21*4/PI"


"DELTA1=d21-p19-d16-p41*cnst41-p42*cnst42-4u"
"DELTA2=(p0-p27)*0.231+de"
"DELTA3=p1*2/PI"

"TAU=d8-p16-d16"


"spoffs25=0"
"spoffs26=0"
"spoffs27=0"


"acqt0=0"
baseopt_echo


1 ze
  d11 pl16:f3

#   ifdef LABEL_CN
  4u pl12:f2
2 d11 do:f2 do:f3
#   else
2 d11 do:f3
#   endif /*LABEL_CN*/

3 d1 pl1:f1 pl3:f3
  50u UNBLKGRAD
  20u fq=cnst54(bf ppm):f1

  p16:gp4
  d16

4 (p41:sp25 ph1):f1
  4u
  p19:gp1
  d16

#   ifdef LABEL_CN
  (center (p42:sp26 ph1):f1 (p8:sp13 ph1):f2 (DELTA1 p21 ph3 d0 p21 ph4 DELTA1):f3 )
#   else
  (center (p42:sp26 ph1):f1 (DELTA1 p21 ph3 d0 p21 ph4 DELTA1):f3 )
#   endif /*LABEL_CN*/

  4u
  p19:gp1
  d16
  (p41:sp27 ph1):f1

  TAU
  p16:gp2
  d16
  lo to 4 times l9

  20u fq=cnst18(bf ppm):f1

  (p29:sp11 ph5):f1

  2u
  2u pl1:f1
  (p1 ph6):f1

  DELTA2
  4u
  p16:gp3
  d16 pl18:f1
  p27*0.231 ph7
  d19*2
  p27*0.692 ph7
  d19*2
  p27*1.462 ph7
  d19*2
  p27*1.462 ph8
  d19*2
  p27*0.692 ph8
  d19*2
  p0*0.231 ph8
  DELTA3
  p16:gp3

#   ifdef LABEL_CN
  d16 pl12:f2 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
#   else
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
#   endif /*LABEL_CN*/

     F1PH(calph(ph3, +90), caldel(d0, +in0)) 
exit


ph1=0 
ph3=0 2
ph4=0 0 2 2 
ph5=2 2 0 0 
ph6=0 0 2 2 
ph7=0 0 2 2 
ph8=2 2 0 0 
ph31=0 2 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;pl18: f1 channel - power level for 3-9-19-pulse (watergate)
;sp11: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp25: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp27: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;                   for time reversed pulse
;p0 : f1 channel -  90 degree pulse at pl18
;                      use for fine adjustment
;p1 : f1 channel -  90 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                               [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p27: f1 channel -  90 degree pulse at pl18
;p29: f1 channel -  90 degree shaped pulse (flipback pulse)
;p41: f1 channel -  90 degree shaped pulse for excitation
;                      Pc9_4_90.1000             (2.2ms at 600.13 MHz)
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.4ms at 600.13 MHz)
;d0 : incremented delay (F1 in 3D): in0/2-p21*4/PI
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;d21: 1/(2J)NH
;cnst4: = J(NH)
;cnst18: H2O chemical shift (offset, in ppm)
;cnst41: compensation of chemical shift evolution during p41
;           Pc9_4_90.1000: 0.529
;cnst42: compensation of chemical shift evolution during p42
;           Reburp.1000: 0.5
;cnst51: scaling factor for p41 to compensate for transition region
;           Pc9_4_90.1000: 1.172
;cnst52: scaling factor for p42 to compensate for transition region
;           Reburp.1000: 1.426
;cnst54: H(N) chemical shift (offset, in ppm)
;cnst55: H(N) bandwidth (in ppm)
;l9: number of L-PROSY blocks
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/(1 * SW(H)) = 2 * DW(H)
;nd0: 1
;ns: 8 * n
;ds: 32
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 21%
;gpz2: 80%
;gpz3: 31%
;gpz4: 60%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



