;ht_dipsi2gpphpr
;avance-version (17/08/18)
;homonuclear Hartman-Hahn transfer using DIPSI2 sequence
;   for mixing
;based on dipsi2gpphpr
;using spoil gradient
;
;E. Kupce & R. Freeman, J. Magn. Reson. 162, 300-310 (2003)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;
;Experiment Setup:
;(1) use had_pl au-program to get the peak list
;(2) execute the 'wvm -a' command
;(3) start the experiment
;(4) use proc_had au-program for processing


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


define list<shape> SPL=<$VALIST>


"d11=30m"
"d12=20u"
"d20=2m"
"d21=3m-p16-d16"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"acqt0=-p1*2/PI"


1 ze 
2 d11
3 d12 pl9:f1
  d1 cw:f1 ph29
  4u do:f1
  50u UNBLKGRAD
  (p34:SPL ph1):f1
  d20 pl10:f1
  p16:gp1*0.77
  d16
						;begin DIPSI2
4 p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  
  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph25
  p6*4.556 ph23
  p6*3.222 ph25
  p6*3.167 ph23
  p6*0.333 ph25
  p6*2.722 ph23
  p6*4.167 ph25
  p6*2.944 ph23
  p6*4.111 ph25

  p6*3.556 ph23
  p6*4.556 ph25
  p6*3.222 ph23
  p6*3.167 ph25
  p6*0.333 ph23
  p6*2.722 ph25
  p6*4.167 ph23
  p6*2.944 ph25
  p6*4.111 ph23
  lo to 4 times l1
						;end DIPSI2

  d21 pl1:f1
  p16:gp1
  d16
  4u BLKGRAD
  p1 ph2
  go=2 ph31
  d11 mc #0 to 2 F1QF(SPL.inc)
exit 
  

ph1=0 
ph2=0 2
ph23=3
ph25=1
ph29=0
ph31=0 2


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;pl10: f1 channel - power level for TOCSY-spinlock
;p1 : f1 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p16: homospoil/gradient pulse
;p34: f1 channel - 180 degree shaped pulse for Hadamard experiment
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: first z-filter delay                           [2 msec]
;d21: second z-filter delay                          [3 msec]
;cnst22: bandwidth for Hadamard encoding pulses
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;ns: 1 * n
;ds: 4
;td1: size of Hadamard matrix, power of 2 (> # of peaks);
;FnMODE: QF


;for z-only gradients (optional):
;gpz1: 50%

;use gradient files (optional):
;gpnam1: SMSQ10.100



;WaveMaker shapes
;use 'wvm -a' command to create the necessary shape files
;SPL:wvm:HTinv: gaus180(cnst22 Hz, PL, had) 
;gp1:wvm:gwurst.100: wurst_g(20 G/cm, 1 ms)



