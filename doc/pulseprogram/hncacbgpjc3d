;hncacbgpjc3d
;avance-version (21/09/15)
;HNCACB-E.COSY
;3D sequence with
;   inverse correlation for triple resonance using inept transfer steps 
;      and correlation via heteronuclear zero and double quantum coherence
;
;      F1(H) -> F3(N,t2/2), HMQC(Ca) - F2(Cali,t1), F3(N,t2/2) -> F1(H,t3)
;
;for determination of 3J CbC' (Phi) using E.COSY
;   splitting in F1:  NC'
;   splitting in F2:  CbC'
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho-TPPI gradient selection (t2)
;using constant time in t1
;using constant time in t2
;(use parameterset HNCACBGPJC3D)
;
;F. Loehr & H. Rueterjans, J. Biomol. NMR 13, 263-274 (1999)
;J.-S. Hu & A. Bax, J. Biomol. NMR 11, 199-203 (1998)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include<Avance.incl>
#include<Grad.incl>
#include<Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d21=5.5m"
"d22=17.6m"
"d23=6.7m"
"d26=2.3m"
"d28=2.1m"


"d0=3u"
"d10=3u"
"d30=d22+d10"

"in0=inf1/2"
"in10=inf2/4"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA=d0*2+p22"
"DELTA1=d22*2+d10*2+p22-d21-p26-4u"
"DELTA2=d22-p16-d16"
"DELTA3=d22-d28"
"DELTA4=p14+p22+d0*2"
"DELTA5=p16+d16+8u"


"spoffs2=0"
"spoffs3=0"
"spoffs8=0"
"spoffs15=bf2*(cnst21/1000000)-o2"


aqseq 321


1 ze
  d11 pl28:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 pl1:f1
  (p1 ph1):f1
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1

  4u pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph3):f3
  (d21 pl19 p26 ph2 cpds1 ph1):f1 (d10 DELTA3 p14:sp3 ph1):f2 (d10 d22 p22 ph1 d30):f3
  (p22 ph1):f3
  DELTA4

  (p13:sp2 ph4):f2
  d23
  (p14:sp3 ph1):f2
  d23
  (p13:sp8 ph2):f2

  d0
  (p22 ph7):f3
  d0
  (p14:sp3 ph5):f2
  DELTA

  (p13:sp2 ph5):f2
  d23
  (p14:sp3 ph1):f2
  d23
  (p13:sp8 ph6):f2

  (DELTA1 4u do p26 ph10):f1 (d30 d28 p14:sp3 ph1):f2 (d30 p22 ph1 d10 DELTA2):f3
  p16:gp2*EA
  d16 pl1:f1

  (center (p1 ph1):f1 (p21 ph8):f3 )
  d26
  (center (p2 ph1):f1 (p22 ph1):f3 )
  d26
  (center (p1 ph2):f1 (p21 ph9):f3 )
  d26
  (center (p2 ph1):f1 (p22 ph1):f3 )
  d26
  (p1 ph1):f1

  DELTA5
  (p2 ph1):f1
  4u
  p16:gp3
  d16 pl28:f2 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph5, +90) & calph(ph6, +90), caldel(d0, +in0) & calph(ph5, -180)) 
     F2EA(calgrad(EA) & calph(ph8, +180), caldel(d10, +in10) & caldel(d30, -in30) & calph(ph3, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph5=3 3 1 1
ph6=0 0 2 2
ph7=0 0 0 0 2 2 2 2
ph8=0
ph9=3
ph10=3
ph31=0 2 2 0 0 2 2 0 2 0 0 2 2 0 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;pl28: f2 channel - power level for selective Ca or CO decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (Cali on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Cali on resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Cali on resonance)
;                  for time reversed pulse
;sp15: f2 channel - shaped pulse 180 degree for decoupling
;                                           (C=O off resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [2 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;p31: f2 channel - 180 degree pulse for decoupling sequence
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: T(N)                                             [17.6 msec]
;d23: 1/(4J(CaCb)                                      [6.7 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d28: T(N) - [1/(4J(NCa)opt]                           [2.1 msec]
;d30: decremented delay (F2 in 3D) = d22+d10
;cnst21: CO chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Cali)) =  DW(Cali)
;nd0: 2
;in10: 1/(4 * SW(N)) = DW(N)
;nd10: 4
;in30: = in10
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2 : mlevsp180.p31
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3
;                         50 :   80 :  8.1

;for z-only gradients:
;gpz1: 50%
;gpz2: 80%
;gpz3: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



