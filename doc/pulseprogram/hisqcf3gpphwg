;hisqcf3gpphwg
;avance-version (14/08/08)
;HISQC
;2D H-1/X correlation via double inept transfer
;phase sensitive
;with decoupling during acquisition
;using f3 - channel
;water suppression using watergate sequence
;
;J. Iwahara, Y.S. Jung & G.M. Clore, J. Am. Chem. Soc. 129, 2971-2980 (2007)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


prosol relations=<triple>


"p2=p1*2"
"d11=30m"

"d25=1.3m"
"d26=2.7m"

"p29=300u"


"d0=3u"

"in0=inf1"


"DELTA1=d26-p16-d16-larger(p2,p52)/2"
"DELTA2=d25-p29-d16-larger(p2,p52)/2"
"DELTA3=d25-p29-d16-larger(p2,p52)/2-d0-p26-4u"
"DELTA4=d26-p16-d16-p11-p1*2/PI-4u"
"DELTA5=d26-p16-d16-p11-de-4u"


"acqt0=0"
baseopt_echo


1 ze 
  d11 pl16:f3
2 d11 do:f3
3 d1 pl1:f1 pl3:f3
  50u UNBLKGRAD 
  (p21 ph1):f3
  p16:gp1
  d16

  (p1 ph1)
  p16:gp2
  d16
  DELTA1
  (center (p2 ph5) (p52:sp34 ph1):f3 )
  DELTA1
  p16:gp2
  d16 pl3:f3
  (center (p1 ph5) (p21 ph1):f3 )
  p29:gp3
  d16
  DELTA2
  (center (p2 ph2) (p52:sp34 ph1):f3 )
  DELTA2
  p29:gp3
  d16 pl3:f3
  (center (p1 ph3) (p21 ph2):f3 )

  p16:gp4
  d16 pl19:f1
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph6):f3
  d0
  4u do:f1
  (p26 ph2):f1

  p29:gp5
  d16 pl1:f1
  DELTA3
  (center (p2 ph1) (p52:sp34 ph1):f3 )
  DELTA2
  p29:gp5
  d16 pl3:f3
  (p21 ph7):f3

  p16:gp6
  d16

  (p11:sp1 ph3):f1
  2u
  2u pl1:f1
  (p1 ph1) 
  DELTA4
  p16:gp7
  d16
  (center (p11:sp1 ph3 2u 2u pl1 p2 ph1 4u p11:sp1 ph3):f1 (p52:sp34 ph1):f3 )
  p16:gp7
  d16 pl16:f3
  DELTA5
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph6, +90), caldel(d0, +in0))
exit 
  

ph1=0
ph2=1
ph3=2
ph4=3
ph5=1 1 3 3
ph6=1 3
ph7=0 0 0 0 2 2 2 2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp34: f3 channel - shaped pulse 180 degree (Q3.1000)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [2 msec]
;p16: homospoil/gradient pulse
;p21: f3 channel -  90 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;p29: gradient pulse 3                                 [300 usec]
;p52: f3 channel - 180 degree shaped pulse
;                      Q3.1000               (1.4ms at 600.13 MHz)
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d25: 1/(8J'(NH)                                       [1.3 msec]
;d26: 1/(4J'(NH)                                       [2.7 msec]
;cnst4: = J(NH)
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/(1 * SW(N)) = 2 * DW(N)
;nd0: 1
;ns: 4 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 15%
;gpz3: -27%
;gpz4: 40%
;gpz5: 27%
;gpz6: 60%
;gpz7: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.50
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100



