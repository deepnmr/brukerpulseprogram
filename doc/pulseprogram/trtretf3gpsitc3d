;trtretf3gpsitc3d
;avance-version (21/09/15)
;3D H-1/X correlation via TROSY and inept transfer
;   using sensitivity improvement
;for measuring N-15 T1rho relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;using flip-back pulse
;as pseudo3D
;with temperature compensation
;(use parameterset )
;
;(K.T. Dayie & G. Wagner, J. Magn. Reson. A 111, 121-126 (1994) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<delay> vd_list=<$VDLIST>

define delay vd_max

define loopcounter COUNTER1
define loopcounter COUNTER2


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d25=1s/(cnst4*cnst12)"
"d26=1s/(cnst4*4)"

"p25=4m"

"cnst30=0"
"d31=0"



"d10=3u"

"in10=inf2/2"


"DELTA1=d26-p16-d16"
"DELTA2=d25-p16-d16-larger(p22,p44)/2-p21*2/PI"
"DELTA3=d25-p16-d16-larger(p22,p44)/2"
"DELTA4=p25/4-p44/2"
"DELTA5=d26-p11-p19-d16-8u"
"DELTA6=d26-p11-p19-d16-p21*2/PI-8u"
"DELTA7=d26-p11-p21-p19-d16-p1*2/PI-12u"
"DELTA8=d26-p11-p21-p19-d16-de-12u"

#   ifdef LABEL_CN
"DELTA=d10*2+p8"
"TAU=0"
#   else
"TAU=d10*2"
#   endif /*LABEL_CN*/



"l0=1"
"l3=td1"
"l11=0"


"spoffs1=0"
"spoffs13=bf2*((cnst21+cnst22)/2000000)-o2"
"spoffs30=0"


"acqt0=0"
baseopt_echo


aqseq 312


1 ze

  "vd_max = 0"

9 20u
  if "vd_list > vd_max"
     {
     20u
     "vd_max = vd_list"
     }

  3m vd_list.inc
  lo to 9 times l3

  3m vd_list.res

2 d11

  20u
  "d31=vd_list[l11]"
  20u
  "COUNTER1=( d31 / p25 )"
  20u
  "COUNTER2=( (vd_max - d31) / p25 )"

  20u pl25:f3

8 (DELTA4 p44:sp30 ph1 DELTA4 DELTA4 p44:sp30 ph8 DELTA4):f1 (p25 ph1):f3
  lo to 8 times COUNTER2

  d1 pl1:f1 pl3:f3

  50u UNBLKGRAD
  (p21 ph1):f3
  p16:gp1
  d16

  (p1 ph1)
  p16:gp2
  d16
  DELTA1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA1
  p16:gp2
  d16
  (p1 ph2)

  4u
  (p11:sp1 ph8:r):f1
  4u
  p16:gp3
  d16 pl1:f1

  if "l0 %2 == 1"
     {
     (p21 ph3):f3
     }
  else
     {
     (p21 ph4):f3
     }

  p16:gp4
  d16
  DELTA2 
  (center (p44:sp30 ph1) (p22 ph5):f3 )
  DELTA3
  p16:gp4
  d16 pl25:f3

  if "l0 %2 == 1"
     {
6    (DELTA4 p44:sp30 ph1 DELTA4 DELTA4 p44:sp30 ph8 DELTA4):f1 (p25 ph3):f3
     lo to 6 times COUNTER1
     }
  else
     {
7    (DELTA4 p44:sp30 ph1 DELTA4 DELTA4 p44:sp30 ph8 DELTA4):f1 (p25 ph4):f3
     lo to 7 times COUNTER1
     }

#   ifdef LABEL_CN
  DELTA pl3:f3
  (p22 ph5):f3
  d10
  (p8:sp13 ph1):f2
  d10 pl1:f1
#   else
  d10
  d10 pl1:f1
#   endif /*LABEL_CN*/

  (p1 ph6)
  4u
  (p11:sp1 ph6):f1
  4u
  p19:gp5
  d16 pl1:f1 pl3:f3
  DELTA5
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA6
  p19:gp5
  d16
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1
  (p1 ph1)

  TAU
  (p21 ph2):f3
  4u
  p19:gp6
  d16
  DELTA7
  (p11:sp1 ph8:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph8:r):f1
  DELTA8
  p19:gp6
  d16 pl1:f1
  4u
  4u BLKGRAD
  (p21 ph7):f3
  TAU

  go=2 ph31
  d11 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calph(ph6, +180) & calph(ph7, +180) & calclc(l0, 1), caldel(d10, +in10) & calph(ph3, +180) & calph(ph4, +180) & calph(ph5, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
#   ifdef LABEL_CN
ph3=2 0 3 1
ph4=0 2 3 1
#   else
ph3=0 2 3 1
ph4=2 0 3 1
#   endif /*LABEL_CN*/
ph5=1 1 3 3
ph6=1
ph7=0
ph8=2
ph31=0 2 3 1
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl25: f3 channel - power level for spinlock
;sp1: f1 channel - shaped pulse  90 degree
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f3 channel - pulse for T1rho spinlock at pl25    [4 msec]
;p44: f1 channel - 180 degree shaped pulse
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay                                [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d25: 1/(4J)YH for YH
;     1/(8J)YH for all multiplicities
;d26: 1/(4J(YH))
;vd : variable delay, taken from vd-list
;cnst4: = J(YH)
;cnst12: for multiplicity selection = 4 for NH, 8 for all multiplicities
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 32
;td1: number of delays in vd-list
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz1: 30%
;gpz2: 3%
;gpz3: 50%
;gpz4: 5%
;gpz5: 10%
;gpz6: 25%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.50
;gpnam6: SMSQ10.50


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id: $
