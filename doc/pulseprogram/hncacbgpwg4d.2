;hncacbgpwg4d.2
;avance-version (21/09/15)
;HNCACB
;4D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N,t1) -> F2(Ca -> Cb,t2 -> Ca,t3) -> F3(N) -> F1(H,t4)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;using semi-constant time in t1
;using constant time in t3
;water suppression using watergate sequence
;(use parameterset )
;
;(M. Wittekind & L. Mueller, J. Magn. Reson. B 101, 201-205 (1993))
;(D.R. Muhandiram & L.E. Kay, J. Magn. Reson. B 103, 203-216 (1994))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d23=12.4m"
"d26=2.3m"
"d28=7.2m"

#   ifdef LABEL_GLY
"d29=6.8m"
#   else
#   endif /*LABEL_GLY*/


"d31=3u"
"d32=3u"
"d33=3u"
"d51=3u"
"d41=d23-d21-p26"
"d43=d28-p14-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"
"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"

"in43=in33"

"td3=tdmax(td3,d43*2,in43)"


"DELTA1=d23-d21-p26-4u"
"DELTA2=d32*2+larger(p14,p22)-p14"
"DELTA3=d26-p16-d16-p11-12u"
"DELTA4=d23-d31-p14*2-d51"
"DELTA5=d28-d33-larger(p14,p22)"

#   ifdef LABEL_GLY
"DELTA6=d28-d29-p26*2-4u"
#   else
#   endif /*LABEL_GLY*/


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs8=0"


1 ze
  d11 pl16:f3 
2 d11 do:f3
3 d1 pl1:f1

  (p1 ph1)
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  4u
  (p11:sp1 ph1:r):f1
  4u
  p16:gp1
  d16

  (p21 ph3):f3
  d21 pl19:f1
  (p26 ph2):f1
  d41 cpds1:f1 ph1
  (p22 ph8):f3
  d51
  (p14:sp3 ph1):f2
  DELTA4
  (p14:sp5 ph1):f2
  d31
  (p21 ph1):f3

  (p13:sp2 ph4):f2

#   ifdef LABEL_GLY
  4u do:f1
  (p26 ph7):f1
  d29
  (p26 ph2):f1
  DELTA6 cpds1:f1 ph1
#   else
  d28
#   endif /*LABEL_GLY*/

  (p14:sp3 ph1):f2
  d28
  (p13:sp8 ph2):f2

  d32
  (center (p14:sp5 ph1):f2 (p22 ph8):f3 )
  d32
  4u
  (p14:sp3 ph1):f2
  DELTA2
  (p14:sp5 ph1):f2
  4u

  (p13:sp2 ph9):f2
  d33
  (center (p14:sp5 ph1):f2 (p22 ph8):f3 )
  DELTA5
  (p14:sp3 ph10):f2
  d43
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph11):f2

  4u do:f1
  (p26 ph7):f1
  4u
  p16:gp2
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph5):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA1
  4u do:f1
  (p26 ph7):f1
  d21
  (p21 ph1):f3

  p16:gp3
  d16
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA3
  (p11:sp1 ph6):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph6):f1
  4u
  DELTA3
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph3, -90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51))
     F2PH(calph(ph9, +90) & calph(ph10, +90) & calph(ph11, +90), caldel(d32, +in32))
     F3PH(calph(ph11, +90), caldel(d33, +in33) & caldel(d43, -in43))
exit


ph1=0
ph2=1 
ph3=0 0 2 2
ph4=0
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph6=2
ph7=3
ph8=0 0 2 2
ph9=3 1
ph10=0
ph11=0 2 0 2 2 0 2 0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0



;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (Cali on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Cali on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Cali on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: 1/(2J(NH)                                        [5.5 msec]
;d23: 1/(4J(NCa)                                       [12.4 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d28: 1/(4J(CaCb)                                      [7.2 msec]
;d29: 1/(8J(CaHa))                                     [6.8 msec]
;d31: incremented delay (F1 in 4D)                     [3 usec]
;d32: incremented delay (F2 in 4D)                     [3 usec]
;d33: incremented delay (F3 in 4D)                     [3 usec]
;d41: decremented delay (F1 in 4D) = d23-d21-p26
;d43: decremented delay (F3 in 4D) = d28-p14-4u
;d51: incremented delay (F1 in 4D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o2p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(N) = 2 * DW(N)
;inf2: 1/SW(Cb) = 2 * DW(Cb)
;inf3: 1/SW(Ca) = 2 * DW(Ca)
;in31: 1/(2 * SW(N)) = DW(N)
;in32: 1/(2 * SW(Cb)) =  DW(Cb)
;in33: 1/(2 * SW(Ca)) =  DW(Ca)
;in41: = k1 * in31
;in43: = in33
;in51: = (1 - k1) * in31
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_GLY: for Gly signals with same sign as Cb signals start experiment with
;             option -DLABEL_GLY (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id: $
