;hnnhdigp3d
;avance-version (15/02/27)
;(H)NNH-TOCSY
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps N-N DIPSI3 spinlock
;
;      F1(H) -> F3(N,t1) -> F3(N,t2) -> F1(H,t3)
;
;for determination of 3J NN (Psi) using quantitative J
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using semi-constant time in t1
;using semi-constant time in t2
;(use parameterset HNNHDIGP3D)
;
;F. Loehr & H. Rueterjans, J. Magn. Reson. 132, 130-137 (1998)
;K. Theis, A.J. Dingley, A. Hoffmann, J.G. Omichinski &
;   S. Grzesiek, J. Biomol. NMR 10, 403-408 (1997)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d13=4u"

"d25=2.75m"
"d26=2.3m"


"d31=(p25*54.33*4)*l1"


"d0=3u"
"d10=3u"
"d20=d25+d0+d28+p2+p8"
"d28=3u"
"d29=3u"
"d30=d25+d10+d29+p2+p8"

"in0=inf1/2"
"in10=inf2/2"

"FACTOR1=d20*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = in0; } else { in20 = INCR1; }"
"if ( INCR1 > in0 ) { in28 = 0; } else { in28=in0-INCR1; }"

"FACTOR2=d30*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in10 ) { in29 = 0; } else { in29=in10-INCR2; }"
"if ( INCR2 > in10 ) { in30 = in10; } else { in30 = INCR2; }"


"DELTA1=d25-p16-d16"
"DELTA2=d26-p16-d16"
"DELTA3=p16+d16+d13+4u" 


aqseq 321


1 d11 ze
  d31 pl16:f3 
2 d11 do:f3
3 d1 pl1:f1
  p1 ph1
  d26 pl3:f3
  (center (p2 ph1) (p22 ph1):f3 )
  d26 UNBLKGRAD
  (p1 ph2):f1 

  p16:gp1
  d16

  (p21 ph3):f3
  d0
  (p8:sp13 ph4):f2
  d25
  (p2 ph4):f1
  d28
  (p22 ph5):f3
  d20
  (p21 ph2):f3

  p16:gp1
  d16

  (p1 ph6):f1
  p16:gp2
  d16 pl27:f3

						;begin DIPSI3
4 (p25*2.722 ph21):f3
  (p25*4.389 ph23):f3
  (p25*2.778 ph21):f3
  (p25*3.056 ph23):f3
  (p25*0.333 ph21):f3
  (p25*2.556 ph23):f3
  (p25*4.000 ph21):f3
  (p25*2.722 ph23):f3
  (p25*4.111 ph21):f3
  (p25*3.778 ph23):f3
  (p25*3.889 ph21):f3
  (p25*2.889 ph23):f3
  (p25*3.000 ph21):f3
  (p25*0.333 ph23):f3
  (p25*2.500 ph21):f3
  (p25*4.050 ph23):f3
  (p25*2.830 ph21):f3
  (p25*4.389 ph23):f3
  (p25*2.722 ph23):f3
  (p25*4.389 ph21):f3
  (p25*2.778 ph23):f3
  (p25*3.056 ph21):f3
  (p25*0.333 ph23):f3
  (p25*2.556 ph21):f3
  (p25*4.000 ph23):f3
  (p25*2.722 ph21):f3
  (p25*4.111 ph23):f3
  (p25*3.778 ph21):f3
  (p25*3.889 ph23):f3
  (p25*2.889 ph21):f3
  (p25*3.000 ph23):f3
  (p25*0.333 ph21):f3
  (p25*2.500 ph23):f3
  (p25*4.050 ph21):f3
  (p25*2.830 ph23):f3
  (p25*4.389 ph21):f3
  (p25*2.722 ph23):f3
  (p25*4.389 ph21):f3
  (p25*2.778 ph23):f3
  (p25*3.056 ph21):f3
  (p25*0.333 ph23):f3
  (p25*2.556 ph21):f3
  (p25*4.000 ph23):f3
  (p25*2.722 ph21):f3
  (p25*4.111 ph23):f3
  (p25*3.778 ph21):f3
  (p25*3.889 ph23):f3
  (p25*2.889 ph21):f3
  (p25*3.000 ph23):f3
  (p25*0.333 ph21):f3
  (p25*2.500 ph23):f3
  (p25*4.050 ph21):f3
  (p25*2.830 ph23):f3
  (p25*4.389 ph21):f3
  (p25*2.722 ph21):f3
  (p25*4.389 ph23):f3
  (p25*2.778 ph21):f3
  (p25*3.056 ph23):f3
  (p25*0.333 ph21):f3
  (p25*2.556 ph23):f3
  (p25*4.000 ph21):f3
  (p25*2.722 ph23):f3
  (p25*4.111 ph21):f3
  (p25*3.778 ph23):f3
  (p25*3.889 ph21):f3
  (p25*2.889 ph23):f3
  (p25*3.000 ph21):f3
  (p25*0.333 ph23):f3
  (p25*2.500 ph21):f3
  (p25*4.050 ph23):f3
  (p25*2.830 ph21):f3
  (p25*4.389 ph23):f3
  lo to 4 times l1
						;end DIPSI3

  4u pl3:f3
  (p21 ph7):f3
  d30
  (p22 ph1):f3
  d29
  (p2 ph1):f1
  DELTA1
  p16:gp3*EA
  d16 pl1:f1
  (p8:sp13 ph1):f2
  d10

  (center (p1 ph10) (p21 ph8):f3 )
  p16:gp4
  d16
  DELTA2
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA2
  p16:gp4
  d16
  (center (p1 ph2) (p21 ph9):f3 )
  p16:gp5
  d16
  DELTA2
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA2
  p16:gp5
  d16
  (p1 ph1)
  DELTA3
  (p2 ph1)
  d13
  p16:gp6
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, +in28)) 
     F2EA(calgrad(EA) & calph(ph9, +180), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30) & calph(ph7, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=0 2
ph4=0 0 1 1
ph5=0 0 2 2 1 1 3 3
ph6=2 2 0 0
ph7=1 1 3 3
ph8=0
ph9=3
ph10=2
ph21=0
ph23=2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl27: f3 channel - power level for TOCSY-spinlock
;sp13: f2 channel - shaped pulse 180 degree  (Ca and C=O, adiabatic
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse (Ca and C=O, adiabatic)
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f3 channel -  90 degree low power pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d13: short delay                                      [4 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d25+d0+d28+p2+p8
;d25: 1/(4J(NH)                                        [2.75 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d28: incremented delay (F1 in 3D)                     [3 usec]
;d29: incremented delay (F2 in 3D)                     [3 usec]
;d30: decremented delay (F2 in 3D) = d25+d10+d29+p2+p8
;d31: length of DIPSI-3 cycle as executed = (p25*54.33*4)*l1
;l1: loop for DIPSI cycle:
;       mixing time = ((p25*54.33*4) * l1)              
;inf1: 1/SW(N) = 2 * DW(N)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(N)) =  DW(N)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = d20 * 2 / td1
;in28: = in0 - in20
;in29: = in10 - in30
;in30: = d30 * 2 / td2
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1       td1 min = 2 * d20 / in0
;td2: number of experiments in F2       td2 min = 2 * d30 / in10
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4 : gp 5 : gp 6
;                         17 :   30 :   80 :    3 :   -2 :  8.1

;for z-only gradients:
;gpz1: 17%
;gpz2: 30%
;gpz3: 80%
;gpz4: 3%
;gpz5: -2%
;gpz6: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100



