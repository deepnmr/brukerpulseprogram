;cosydfphpp
;avance-version (12/01/11)
;2D homonuclear shift correlation
;phase sensitive
;with double quantum filter
;using purge pulses before d1
;
;phasecycle: A. Derome & M. Williamson, J. Magn. Reson. 88,
;               177 - 185 (1990)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"d11=30m"
"d12=20u"


"in0=inf1"

"d0=in0/2-p1*4/3.1416"


1 ze
2 d11

3 d12 pl10:f1
  p17 ph4
  p17*2 ph5
  d1 pl1:f1

  p1 ph1
  d0
  p1 ph2
  4u
  p1 ph3
  go=2 ph31
  d11 mc #0 to 2 F1PH(calph(ph1, +90), caldel(d0, +in0))
exit


ph1=1 1 1 1 0 0 0 0
ph2=0 0 0 0 1 1 1 1
ph3=1 2 3 0 2 3 0 1
ph4=0
ph5=1
ph31=0 3 2 1 3 2 1 0


;pl1 : f1 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;p1 : f1 channel -  90 degree high power pulse
;p17: f1 channel - trim pulse                        [2.5 msec]
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



