;asap_cosy
;avance-version (19/02/18)
;ASAP-COSY
;with optional adiabatic mixing to equalize amplitude variations 
;   due to non-uniform magnetization recovery 
;   activated by setting d9 > 0
;WaveMaker supported version
;
;E. Kupce & T.D.W. Claridge, Chem. Commun. 54, 7139 - 7142 (2018)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"


"d0=3u"

"in0=inf1"


"l1=(d9/(p45*20))"


1 ze
2 d11 pl1:f1 
  d1

  if "d9 > 1m"
  {
    50u UNBLKGRAD  
    p16:gp0*1.77
    d16
    4u BLKGRAD  
						
                                                ;begin mixing
9   (p45:sp45 ph10):f1
    (p45:sp45 ph12):f1
    (p45:sp45 ph11):f1
    (p45:sp45 ph12):f1
    (p45:sp45 ph10):f1
    (p45:sp45 ph10):f1
    (p45:sp45 ph12):f1
    (p45:sp45 ph11):f1
    (p45:sp45 ph12):f1
    (p45:sp45 ph10):f1
    (p45:sp45 ph13):f1
    (p45:sp45 ph15):f1
    (p45:sp45 ph14):f1
    (p45:sp45 ph15):f1
    (p45:sp45 ph13):f1
    (p45:sp45 ph13):f1
    (p45:sp45 ph15):f1
    (p45:sp45 ph14):f1
    (p45:sp45 ph15):f1
    (p45:sp45 ph13):f1
    
    lo to 9 times l1
                                                ;end mixing
    4u pl1:f1
  }

  50u UNBLKGRAD 
  p16:gp0
  d16
  2m

  (p1 ph1)
  d0        
  4u
  p16:gp1*EA
  d16
  (p1 ph3)   
  4u
  p16:gp2
  d16
  4u BLKGRAD
  go=2 ph31    
  d11 mc #0 to 2 F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph1, +180) & calph(ph31, +180))
exit


ph1=0 2 2 0 
ph3=0 2 

ph10=(360) 0
ph11=(360) 60
ph12=(360) 150
ph13=(360) 180
ph14=(360) 240
ph15=(360) 330

ph31=0 2 2 0 


;pl1 : f1 channel - power level for pulse (default)
;sp45: f1 channel - shaped pulse 180 degree CAWURST-2
;p1 : f1 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p45: f1 channel - 180 degree shaped pulse CAWURST-2
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d9 : ASAP mixing duration [0 (no mixing) or 40-60 ms]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;l1 : loop for spinlock cycle (p45*20 * l1)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 2 * n
;ds: 16
;td1: number of increments
;FnMODE: echo-antiecho


;for z-only gradients:
;gpz0: 23%
;gpz1: 30%
;gpz2: 30%

;use gradient files:
;gpnam0: SMSQ10.100
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100


;Processing
;use xfb and xf2m + abs1



;WaveMaker shapes (optional)
;use 'wvm -a' command to create the necessary shape files
;sp45:wvm:wumix: cawurst-2(30 ppm, 1.0 ms; Q=3)  



