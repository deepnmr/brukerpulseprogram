;hr_p3b1hom2d
;avance-version
;pulse program for B1 homogeneity determination on f2 channel
;using inverse method decp90

;$CLASS=HighRes HWT
;$DIM=2D
;$HIDE=y

#include <Avance.incl>

define list<pulse> Plist = <npt_b1meas>

"d2=1s/(cnst2*2)"

"d12=20u"

1 ze
2 d1
3 p1 ph1
  d2
  (Plist ph2):f2
  go=2 ph31
  d12 Plist.inc
  d1 mc #0 to 2 F1QF()
exit

ph1=0 2 2 0 1 3 3 1
ph2=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for Plist pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;vplist: determines flip angle on F2 channel, generated by au program
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(XH))
;cnst2: = J(XH)
;nd0: 1
;NS: 1
;DS: 4
;td1: number of experiments
;FnMODE: QF
