;hccconhgpwg5d
;avance-version (21/09/15)
;HCCCONH
;5D sequence with
;   inverse correlation for triple resonance using 
;      dipsi2 and inept transfer steps 
;
;      F1(H,t1) -> F2(Caliph.,t2 -> Ca) -> 
;                  F2(C=O,t3) -> F3(N,t4) -> F1(H,t5)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;phase sensitive (t4)
;using semi-constant time in t1
;using semi-constant time in t3
;using semi-constant time in t4
;water suppression using watergate sequence
;(use parameterset )
;
;(G.T. Montelione, B.A. Lyons, S.D. Emerson & M. Tashiro, 
;   J. Am. Chem. Soc. 114, 10974-75 (1992))
;(S. Grzesiek, J. Anglister & A. Bax, J. Magn. Reson. 101 B, 114-9 (1993))
;(B.A. Lyons & G.T. Montelione, J. Magn. Reson. 101 B, 206-9 (1993))
;(T.M. Logan, E.T. Olejniczak, R.X. Xu & S.W. Fesik, 
;   J. Biomol. NMR 3, 225-31 (1993))
;(R.T. Clowes, W. Boucher, C.H. Hardman, P.J. Domaille & E.D. Laue, 
;   J. Biomol. NMR 3, 349-354 (1993))
;(T. Carlomagno, M. Maurer, M. Sattler, M.G. Schwendinger, S.J. Glaser
;   & C. Griesinger, J. Biomol. NMR 8, 161-170 (1996))
;
;$CLASS=HighRes
;$DIM=5D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include<Avance.incl>
#include<Grad.incl>
#include<Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=1.1m"
"d4=1.7m"
"d22=4.4m"
"d23=12.4m"
"d25=5.5m"
"d26=2.3m"
"d28=3.6m"


"d32=3u"
"d34=3u"
"d51=3u"
"d53=3u"
"d54=3u"
"d31=d4"
"d33=d22"
"d41=d4+p14+d51"
"d43=d23-p14-4u"
"d44=d23-d25-p26-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"
"in34=inf4/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"
"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"

"FACTOR3=d43*10000000*2/td3"
"INCR3=FACTOR3/10000000"

"if ( INCR3 > in33 ) { in43 = in33; } else { in43 = INCR3; }"
"if ( INCR3 > in33 ) { in53 = 0; } else { in53=in33-INCR3; }"

"FACTOR4=d44*10000000*2/td4"
"INCR4=FACTOR4/10000000"

"if ( INCR4 > in34 ) { in44 = in34; } else { in44 = INCR4; }"
"if ( INCR4 > in34 ) { in54 = 0; } else { in54=in34-INCR4; }"


"l1=(d15/(p9*115.112))"


"DELTA1=d3+p2+d32*2+larger(p14,p22)-p14-4u"
"DELTA2=d23-d33-p14-p22-d53"
"DELTA3=d26-p16-d16-p11-12u"
"DELTA4=d23-d34-p14*2-d54"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst23)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"
"spoffs9=bf2*((cnst22-cnst23)/1000000)"


"cnst62=-(bf1*cnst20-(o1*1000000))"
"cnst63=(bf1*cnst20-(o1*1000000))*(inf1/1000000)*360.0"


"o1_F1=bf1*cnst20/1000000"
"o1_F2=bf2*cnst23/1000000"
"o1_F3=bf2*cnst21/1000000"


"TAU9=abs(cnst62+cnst63)/100000"


1 ze
  d11 pl16:f3
2 d11 do:f3
3 d11 fq=cnst23(bf ppm):f2
  d12 pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1 pl3:f3
  50u UNBLKGRAD

  (p1 ph3):f1
  d31
  (p14:sp3 ph1):f2
  d51
  (p2 ph1):f1
  d41
  (p1 ph2):f1

  4u
  p16:gp1
  d16

  (p13:sp2 ph4):f2
  d32
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d3
  (p2 ph1):f1 
  d32
  (p14:sp3 ph1):f2
  DELTA1
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2

  4u
  4u pl15:f2

						;begin DIPSI2
7 (p9*3.556 ph23):f2
  (p9*4.556 ph25):f2
  (p9*3.222 ph23):f2
  (p9*3.167 ph25):f2
  (p9*0.333 ph23):f2
  (p9*2.722 ph25):f2
  (p9*4.167 ph23):f2
  (p9*2.944 ph25):f2
  (p9*4.111 ph23):f2
  
  (p9*3.556 ph25):f2
  (p9*4.556 ph23):f2
  (p9*3.222 ph25):f2
  (p9*3.167 ph23):f2
  (p9*0.333 ph25):f2
  (p9*2.722 ph23):f2
  (p9*4.167 ph25):f2
  (p9*2.944 ph23):f2
  (p9*4.111 ph25):f2

  (p9*3.556 ph25):f2
  (p9*4.556 ph23):f2
  (p9*3.222 ph25):f2
  (p9*3.167 ph23):f2
  (p9*0.333 ph25):f2
  (p9*2.722 ph23):f2
  (p9*4.167 ph25):f2
  (p9*2.944 ph23):f2
  (p9*4.111 ph25):f2

  (p9*3.556 ph23):f2
  (p9*4.556 ph25):f2
  (p9*3.222 ph23):f2
  (p9*3.167 ph25):f2
  (p9*0.333 ph23):f2
  (p9*2.722 ph25):f2
  (p9*4.167 ph23):f2
  (p9*2.944 ph25):f2
  (p9*4.111 ph23):f2
  lo to 7 times l1
						;end DIPSI2

  d12 pl19:f1
  (p26 ph1):f1
  d12 cpds1:f1 ph2

  (p13:sp2 ph2):f2
  4u
  (p14:sp5 ph1):f2
  d28 
  (p24:sp9 ph1):f2
  4u
  (p14:sp5 ph1):f2
  d28
  (p13:sp8 ph1):f2

  4u
  4u do:f1
  (p26 ph10):f1
  4u
  p16:gp5
  d16 fq=cnst21(bf ppm):f2
  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p13:sp2 ph5):f2
  d33
  (p14:sp7 ph1):f2
  DELTA2
  (p22 ph8):f3
  d53
  (p14:sp3 ph1):f2
  d43
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u
  4u do:f1
  (p26 ph10):f1
  4u
  p16:gp2
  d16
  (p26 ph2):f1
  4u cpds1:f1 ph1

  (p21 ph6):f3
  d34
  (p14:sp7 ph1):f2
  DELTA4
  (p14:sp3 ph1):f2
  d54
  (p22 ph1):f3
  d44
  4u do:f1
  (p26 ph9):f1
  d25
  (p21 ph1):f3

  p16:gp3
  d16
  (p11:sp1 ph7):f1
  4u
  4u pl1:f1

  (p1 ph1) 
  4u
  p16:gp4
  d16
  DELTA3
  (p11:sp1 ph7):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  (p11:sp1 ph7):f1
  4u
  DELTA3
  p16:gp4
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51) & calph(ph3, cnst63))
     F2PH(calph(ph4, +90), caldel(d32, +in32)) 
     F3PH(calph(ph5, +90), caldel(d33, +in33) & caldel(d43, -in43) & caldel(d53, +in53))
     F4PH(calph(ph6, +90), caldel(d34, +in34) & caldel(d44, -in44) & caldel(d54, +in54))

TAU9
exit


ph1=0
ph2=1
ph3=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=0 2
ph7=2
ph8=0
ph9=3
ph10=2
ph23=0
ph25=2
ph29=0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl15: f2 channel - power level for TOCSY-spinlock
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for presaturation
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp9: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;     sp9 might require higher selectivity than sp3
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p9 : f2 channel -  90 degree low power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (sp9)
;p26: f1 channel -  90 degree pulse at pl19
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(CH)                                        [1.1 msec]
;d4:  1/(4J(CH)                                        [1.7 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d15: TOCSY mixing time                                [12 msec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(2J(CaCO)                                      [4.4 msec]
;d23: 1/(4J(NCO)                                       [12.4 msec]
;d25: 1/(2J(NH))                                       [5.5 msec]
;d26: 1/(4J(NH))                                       [2.3 msec]
;d28: 1/(2J'(CaCO))                                    [3.6 msec]
;d31: incremented delay (F1 in 5D) = d4
;d32: incremented delay (F2 in 5D)                     [3 usec]
;d33: incremented delay (F3 in 5D) = d22
;d34: incremented delay (F4 in 5D)                     [3 usec]
;d41: decremented delay (F1 in 5D) = d4+p14+d51
;d43: decremented delay (F3 in 5D) = d23-p14-4u
;d44: decremented delay (F3 in 5D) = d23-d25-p26-4u
;d51: incremented delay (F1 in 5D)                     [3 usec]
;d53: incremented delay (F3 in 5D)                     [3 usec]
;d54: incremented delay (F3 in 5D)                     [3 usec]
;cnst20: H(ali) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;cnst62: offset for Hali region (Hz)
;cnst63: additional phase increment to center Hali region
;o2p: Caliphatic chemical shift (cnst23)
;l1: loop for DIPSI2 cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW(Hali) = 2 * DW(Hali)
;inf2: 1/SW(Cali) = 2 * DW(Cali)
;inf3: 1/SW(CO) = 2 * DW(CO)
;inf4: 1/SW(N) = 2 * DW(N)
;in31: 1/(2 * SW(Hali)) = DW(Hali)
;in32: 1/(2 * SW(Cali)) = DW(Cali)
;in33: 1/(2 * SW(CO)) = DW(CO)
;in34: 1/(2 * SW(N)) = DW(N)
;in41: = k1 * in31
;in43: = k3 * in33
;in44: = k4 * in34
;in51: = (1 - k1) * in31
;in53: = (1 - k3) * in33
;in54: = (1 - k4) * in34
;ns: 16 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2
;td3: number of experiments in F3
;td4: number of experiments in F4
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;FnMODE: States-TPPI (or TPPI) in F4
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%
;gpz3: 60%
;gpz4: 30%
;gpz5: 20%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



