#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
#include <De.incl>


"p2=p1*2"
"p4=p3*2"
"d2=1s/(cnst2*2)"
"d5=1s/(cnst5*2)"
"d11=30m"


"d0=3u"

"in0=inf1/2"


"DELTA1=d2-p16-d16-12u"
"DELTA2=d5-p16-d16-12u"
"DELTA3=p16+d16+d0+p4/2"
"DELTA4=p16+d16+d0+larger(p2,p4)/2"


"l3=td1/2"


1 ze1
  ze2
2 61.004m do:f3
3 3m 
4 3m UNBLKGRAD
  p16:gp4
  d16
  20u pl2:f2
  (p3 ph1):f2
  p16:gp4*-1.44
  d16
  50u BLKGRAD
  d1 pl3:f3

  (p3 ph1):f2
  d5 UNBLKGRAD
  (p21 ph2):f3
  DELTA3 pl0:f3
  (p58:sp42 ph1):f3
  p16:gp1*EA
  d16 
  d0
  (p4 ph6):f2
  d0
  p16:gp1*EA
  d16 
  (p58:sp42 ph1):f3
  DELTA3 pl3:f3
  (p21 ph4):f3
  4u
  p16:gp3
  d16
  DELTA2 pl16:f3  
  4u BLKGRAD
  4u cpd3:f3
  ACQ_START2(ph28,ph31)
  1u DWELL_GEN2
  (aq2)  
  eoscnp2			                	
  4u do:f3 
  

  20u pl1:f1 pl3:f3 
  d1

  (p1 ph1):f1
  d2 UNBLKGRAD
  (p21 ph3):f3
  DELTA4 pl0:f3
  (p58:sp42 ph1):f3
  p16:gp1*EA
  d16 
  d0
  (center (p2 ph6):f1 (p4 ph6):f2)
  d0
  p16:gp1*EA
  d16 
  (p58:sp42 ph1):f3
  DELTA4 pl3:f3
  (p21 ph4):f3
  p16:gp2
  d16
  DELTA1 pl16:f3  
  4u BLKGRAD
  4u pl12:f2
  4u cpd2:f2 cpd3:f3
  ACQ_START1(ph29,ph30)
  1u DWELL_GEN1 
  (aq1) 
  rcyc=2

  4u do:f2 do:f3
  30m wr1 #0 if1 #0 zd1
  30m wr2 #1 if2 #1 zd2

  1m igrad EA
  lo to 3 times 2

  1m id0
  1m ip3*2
  1m ip29*2
  lo to 4 times l3  

exit 


ph1=0
ph2=0 2
ph3=0 2
ph4=0 0 2 2
ph5=0
ph6=0 0 0 0 2 2 2 2
ph28=0 2 2 0
ph29=0 2 2 0
ph30=0
ph31=0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp42: f2 channel - shaped pulse 180 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p58: f3 channel - 180 degree shaped pulse for inversion
;d0 : incremented delay (2D)                           [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(HC))
;d5 : 1/(2J(FC))
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(HC)                                        [~170 Hz]
;cnst5: = J(FC)                                        [~250 Hz]
;l3 : loop for 2D experiment = td1/2
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;ns: 1 * n
;ds: 32
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;          garp4 or p5m4sp180.2 (for adiabatic decouling)
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;cpd3: decoupling according to sequence defined by cpdprg3
;          garp4 or p5m4sp180.p62 (for adiabatic decouling)
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 40.0%
;gpz2: 20.1%
;gpz3: 21.38%
;gpz4: 33%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



;WARNING: high C-13 and F-19 decoupling power may cause detuning which 
;         in turn may lead to severe lineshape distortions



;WaveMaker shapes (optional)
;use 'wvm -a' command to create the necessary shape files
;sp42:wvm:ad180C13: cawurst-20(300 ppm, 0.5 ms) 
;sp31(p63,pl12):wvm:wurstHF:f2 cawurst-20(100 ppm, 4.0 ms; Q=3)
;sp15(p62,pl16):wvm:wurstCH:f3 cawurst-20(100 ppm, 1.4 ms; Q=2)
 


