;noemul
;avance-version (20/10/12)
;1D sequence with presaturation to irradiate different frequencies
;   within one multiplett
;ONLY to be used by au-program (e.g. "noemult")
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


define list<frequency> noelist=<$FQ2LIST>


"d11=30m"
"d12=20u"


1 ze
  d11 pl14:f2
2 30m
  d1
3 d12 noelist:f2 
  d12 noelist.inc
  d20 cw:f2
  lo to 3 times l4
  d12 do:f2
  p1 ph1
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl14: f2 channel - power level for cw decoupling
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d20: irradiation time per frequency
;l4 : overall irradiation time: d20 * l4
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4


;define FQ2LIST (list has to be stored in one of the directories 
;                    specified in "Manage Source Directories")



