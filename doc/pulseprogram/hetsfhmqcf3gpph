;hetsfhmqcf3gpph
;avance-version (21/09/15)
;Het-SOFAST HMQC
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;phase sensitive
;with decoupling during acquisition
;
;P.Schanda, V. Forge & B. Brutscher, 
;   Magn. Reson. Chem. 44, S177-S184 (2006)
;(P.Schanda & B. Brutscher, J. Am. Chem. Soc. 127, 8014 (2005) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d21=1s/(cnst4*2)"


"in0=inf1"

"d0=in0/2-p21*4/PI"


"DELTA1=d21-p16-d16-p39*cnst39"
"DELTA2=d21-p16-d16-de-4u"
"DELTA3=d1-p49-p16-d16"


"spoffs23=bf1*(cnst19/1000000)-o1"
"spoffs24=bf1*(cnst19/1000000)-o1"


"acqt0=0"
baseopt_echo


1 ze 
  d11 pl26:f3
2 3m do:f3
3 d12 pl3:f3
  50u UNBLKGRAD

  (p49:sp32 ph1):f1
  p16:gp3
  d16
  DELTA3

  p16:gp2
  d16

  (p39:sp23 ph1):f1
  p16:gp1
  d16
  DELTA1

#   ifdef LABEL_CN
  (center (p40:sp24 ph2):f1 (p8:sp13 ph1):f2 (p21 ph3 d0 p21 ph4):f3 )
#   else
  (center (p40:sp24 ph2):f1 (p21 ph3 d0 p21 ph4):f3 )
#   endif /*LABEL_CN*/


  DELTA2 
  p16:gp1
  d16 pl26:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  3m do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0))
exit 
  

ph1=0 
ph2=0 
ph3=0 2
ph4=0 0 2 2 
ph31=0 2 2 0


;pl3 : f3 channel - power level for pulse (default)
;pl26: f3 channel - power level for CPD/BB decoupling (low power)
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp23: f1 channel - shaped pulse 120 degree 
;                   (Pc9_4_120.1000 or Q5.1000)
;sp24: f1 channel - shaped pulse 180 degree (Rsnob.1000)
;sp32 : f1 channel - shaped pulse 180 degree (p49)
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                       [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p39: f1 channel - 120 degree shaped pulse for excitation
;                      Pc9_4_120.1000 (120o)    (3.0ms at 600.13 MHz)
;                  (or Q5.1000 (90o)            (2.0ms at 600.13 MHz) )
;p40: f1 channel - 180 degree shaped pulse for refocussing
;                      Rsnob.1000               (1.0ms at 600.13 MHz)
;p49: f1 channel - 180 degree shaped pulse for 
;                      inversion of water signal 
;                         Gaus1_180i.1000       (100ms at 600.13 MHz)
;                      or
;                      inversion of aliphatic protons
;                         Isnob.1000            (1.88ms at 600.13 MHz)
;d0 : incremented delay (2D) = in0/2-p21*4/PI
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d21 : 1/(2J)NH
;cnst4: = J(NH)
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst39: compensation of chemical shift evolution during p39
;           Pc9_4_120.1000: 0.529
;           Q5.1000: -0.07
;inf1: 1/SW(N) = 2 * DW(N)
;in0: 1/SW(N) = 2 * DW(N)
;nd0: 1
;ns: 2 * n
;ds: 16
;aq: <= 50 msec
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEC
;cpd3: decoupling according to sequence defined by cpdprg3: garp4.p62
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence
;          use pulse of >= 350 usec
;cpdprg3: garp4.p62


;for z-only gradients:
;gpz1: 11%
;gpz2:  7%
;gpz3: 13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



