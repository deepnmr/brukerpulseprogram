;$Id:$
;calibration of 90 degree pulse on f2 channel based on SOFAST HMQC
;with decoupling during acquisition
;
;P.Schanda and B. Brutscher, J. Am. Chem. Soc. 127, 8014 (2005)
;
;$CLASS=HighRes
;$DIM=1D
;$HIDE=y


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d2=1s/(cnst2*2)"
"d19=1s/(4*(o1-cnst54*bf1/1000000))"

"DELTA1=d2-p16-d16-p1-d19"
"DELTA2=p1*2+d19-de-4u"
"acqt0=0"

1 ze 
  d11 pl14:f2
2 d1 do:f2
3 d12 pl1:f1 pl2:f2
  50u UNBLKGRAD

  p16:gp2
  d16

  (p1 ph1):f1
  d19
  (p1 ph2):f1
  p16:gp1
  d16

  (center (p1 ph1 d19*2 p1 ph2):f1 (DELTA1 p3*2 ph3 3u p3 ph4 DELTA1):f2 )

  DELTA2
  p16:gp1
  d16 pl14:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d1 do:f2 mc #0 to 2 F0(zd) 
exit 
  

ph1=0 
ph2=2 
ph3=0 2
ph4=0 0 2 2
ph31=0 2 2 0


;pl2 : f2 channel - power level for pulse (default)
;pl14: f2 channel - power level for CPD/BB decoupling
;p3: f2 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;d1 : relaxation delay
;d2 : 1/(2J)CH
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(CH)
;cnst54: H(C) chemical shift (offset, in ppm)
;ns: 4 * n
;ds: 16
;cpd2: low power cpd decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 11%
;gpz2:  7%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100

