;noesyhsqcgp3d.3
;avance-version (23/02/26)
;NOESY-HSQC
;3D sequence with
;   for recording an HCH-NOESY spectrum 
;   1H/13C correlation via double inept transfer
;   using cnst22 as center of spectrum (1H, F1 dimension)
;   using cnst23 as center of spectrum (13C, F2 dimension) but o2p as transmitter frequency 
;allows for aliasing of aromatic signals into aliphatic spectral region, while keeping the 
;transmitter frequecy in the center of both regions (~75 ppm)
;at >700 MHz use noesyhsqcgpsp3d.3 instead which includes broad band carbon pulses
;optional presaturation (for enhanced water suppression use ZGOPTNS -Dpresat)
;using shaped pulses for inversion on f2 - channel
;using trim pulse for water suppression
;using delayed sampling
;(use parameterset NOESYHSQCGP3D.3 for proteins or NA_NOESYHSQCGP3D.3 for RNA)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d12=20u"

"p28=1m"


"in0=inf1"
"in10=inf2"

"d0=in0/2-p1*4/PI"

"cnst63=(bf2*cnst23-(o2*1000000))*(inf2/1000000)*360.0"

"if ( td2 == 1 ) { d10 = 0; } else { d10 = in10/2-p3*4/PI; }"
"if ( td2 == 1 ) { cnst61 = 0; } else { cnst61=(90.0+cnst63/2)*-1; }"

"o1_F1=bf1*cnst22/1000000"
"o1_F2=bf2*cnst23/1000000"


"DELTA1=d4-p16-d16-p35/2-4u"
"DELTA3=d4-p16-d16-p35/2-p1*2/PI-4u"
"DELTA4=d4-p16-d16-p35/2-4u"

"TAU1=larger(p35,p56)/2-p1-d0/2"
"TAU=d8-p16-d16-TAU1"

"spoffs30=0"
"spoffs39=0"
"spoffs41=0"

"acqt0=0"

aqseq 321


1 ze
  d11 pl12:f2
  1u ip9+cnst61
2 d11 do:f2
  4u BLKGRAD
  
#ifdef presat
3 d12 pl32:f1
  d1 cw:f1
  4u do:f1
#else
3 d12
  d1 
#endif
  
  d12 pl1:f1 pl2:f2 fq=cnst22 (bf ppm):f1
  50u UNBLKGRAD

  (p3 ph1):f2
  
  p16:gp1
  d16

  (center (TAU1 p1 ph5 d0 p1 ph8 TAU1):f1 (p35:sp41 ph1):f2 (p56:sp39 ph1):f3)

  TAU  
  p16:gp2
  d16 fq=0:f1

  (p1 ph7)
  4u
  p16:gp3
  d16
  DELTA1
  (center (p2 ph1):f1 (p35:sp41 ph1):f2)
  DELTA1
  4u
  p16:gp3
  d16
  (p1 ph2)

  4u pl2:f2 
  p16:gp4
  d16 

  (center (p44:sp30 ph1):f1 (p3 ph4 d10 p3 ph9):f2 (p56:sp39 ph1):f3)

  4u pl1:f1
  p16:gp5
  d16 

  (p1 ph2)
  4u 
  p16:gp6
  d16 
  DELTA3
  (center (p2 ph1):f1 (p35:sp41 ph1):f2 )
  DELTA4
  4u
  p16:gp6
  d16 pl12:f2
  (p28 ph2)

  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph8, -90), caldel(d0, +in0)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10) & calph(ph4, cnst63))
exit
   

ph1=0 
ph2=1
ph3=2
ph4=0 2
ph5=0 0 2 2 
ph6=1
ph7=0 0 0 0 2 2 2 2
ph8=0
ph9=0
ph31=2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default) 
;pl12: f2 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for weak presaturation
;sp14: f2 channel - short pulse for bi-level adiabatic decoupling 
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp31: f2 channel - long pulse for bi-level adiabatic decoupling 
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp41: f2 channel - shaped pulse 180 degree (Bip720,100,10.1)
;spnam41: Bip720,100,10.1
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p28: f1 channel - trim pulse                        [1 msec]
;p35: f2 channel - 180 degree shaped pulse
;p44: f1 channel - 180 degree shaped pulse
;p56: f3 channel - 180 degree shaped pulse
;d0 : incremented delay (F1 in 3D) = in0/2-p1*4/PI
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d8 : NOESY mixing time
;d10: incremented delay (F2 in 3D) = in10/2-p3*4/PI
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(CH) (~160 for proteins, ~180 for nucleic acids)
;cnst22: Center for indirect proton dimension (F1)  
;cnst23: Center for carbon dimension (F2)
;cnst63: TPPI phase shift ( PHC0(F2) = 90 + (cnst63 % 360)/2 )
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(C) = 2 * DW(C)
;in0: 1/SW(H) = 2 * DW(H)
;in10: 1/SW(C) = 2 * DW(C)
;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence



;for z-only gradients:
;gpz1: 40%
;gpz2: 65%
;gpz3: 19%
;gpz4: -25%
;gpz5: 50%
;gpz6: 30%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100

                                          ;preprocessor-flags-start
;presat: to use presaturation for water suppression in addition to trim pulse use option -Dpresat (eda: ZGOPTNS)
                                          ;preprocessor-flags-end

;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 0
;PHC1(F2): -180
;FCOR(F2): 1



