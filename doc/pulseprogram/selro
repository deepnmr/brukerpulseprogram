;selro
;avance-version (21/09/15)
;1D ROESY using selective excitation with a shaped pulse
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


#   ifdef CALC_SPOFFS
"spoffs1=bf1*(cnst21/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/


1 ze
2 30m
  d1 
  4u pl0:f1
  p11:sp1:f1 ph1:r
  4u
  d14  pl11:f1
  p15 ph2
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=1 3 3 1 2 0 0 2
ph2=0 2 0 2 1 3 1 3
ph31=0 2 2 0 1 3 3 1


;pl0 : 0W
;pl11: f1 channel - power level for ROESY-spinlock
;sp1: f1 channel - shaped pulse
;p1 : f1 channel -  90 degree high power pulse
;p11: f1 channel -  90 (or 270) degree shaped pulse
;p15: f1 channel - pulse for ROESY spinlock
;d1 : relaxation delay; 1-5 * T1
;d14: delay for evolution after shaped pulse: 
;               for 90 deg pulse               (p11)/2 + d14 ~ 1/(J)
;               for self-refocussing pulse     20 usec
;cnst21: chemical shift for selective pulse (offset, in ppm)
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4


;phcor 1 : phasedifference between power levels sp1 and pl11 

;choose p11 according to desired selectivity
;the flip-angle is determined by the amplitude
;set O1 on resonance on the multiplet to be excited or use spoffs



