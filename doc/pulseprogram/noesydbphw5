;noesydbphw5
;avance-version (20/07/28)
;NOESY-WaterControl
;2D homonuclear correlation via dipolar coupling
;dipolar coupling may be due to noe or chemical exchange.
;phase sensitive
;water suppression using watergate W5 pulse sequence with gradients
;using double echo
;
;A.M. Torres, G. Zheng & W.S. Price, J. Biomol. NMR 67, 233-241 (2017)
;(M. Liu, X. Mao, C. He, H. Huang, J.K. Nicholson & J.C. Lindon,
;   J. Magn. Reson. 132, 125 - 129 (1998) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"

"p30=3m"


"in0=inf1"

"d0=in0/2-p1*4/PI"


1 ze
2 d11
  20u
  "d25=d15-p1*2-p16*2-p30-d16*3-p27*5.95-d19*18-200u"
3 d1
  
  p1 ph1
  d0
  p1 ph2
  d8
  p1 ph3

  50u UNBLKGRAD 
  p16:gp1
  d16

  p27*0.087 ph6
  d19*2
  p27*0.206 ph6
  d19*2
  p27*0.413 ph6
  d19*2
  p27*0.778 ph6
  d19*2
  p27*1.491 ph6
  d19*2
  p27*1.491 ph7
  d19*2
  p27*0.778 ph7
  d19*2
  p27*0.413 ph7
  d19*2
  p27*0.206 ph7
  d19*2
  p27*0.087 ph7

  p16:gp2
  d16  
  50u BLKGRAD

  p1 ph4

  50u UNBLKGRAD 
  p30:gp3
  d16
  50u BLKGRAD

  d25

  p1 ph5

  50u UNBLKGRAD 
  p16:gp1
  d16
  p27*0.087 ph8
  d19*2
  p27*0.206 ph8
  d19*2
  p27*0.413 ph8
  d19*2
  p27*0.778 ph8
  d19*2
  p27*1.491 ph8
  d19*2
  p27*1.491 ph9
  d19*2
  p27*0.778 ph9
  d19*2
  p27*0.413 ph9
  d19*2
  p27*0.206 ph9
  d19*2
  p27*0.087 ph9
  p16:gp2
  d16  
  50u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2
     F1PH(calph(ph1, +90), caldel(d0, +in0))
  d15
exit


ph1=0 2  
ph2=0 
ph3=0 0 2 2
ph4=0 0 0 0 2 2 2 2
ph5=1 3 3 1 
ph6=0
ph7=2
ph8=1
ph9=3
ph31=1 1 1 1 3 3 3 3 


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel - 90 degree high power pulse
;p16: gradient pulse for WaterControl                      [1-3 msec]
;p27: f1 channel - 90 degree high power pulse for w5
;p30: crusher gradient                                     [3 msec]
;d0 : incremented delay (2D): in0/2-p1*4/PI 
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                                   [30 msec]
;d15: diffusion time for WaterControl (BigDelta)           [15-50 msec] 
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;inf1: 1/SW = 2 * DW
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 32
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ


;for z-only gradients:
;gpz1: 97%
;gpz2: 97%
;gpz3: 73.13%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam1: SMSQ10.100
;gpnam3: SMSQ10.100



