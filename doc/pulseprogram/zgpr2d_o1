;zgpr2d_o1
;avance-version (17/02/10)
;pseudo 2D sequence with f1 presaturation and jump-return
;for determination of o1 for water supression
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

"cnst1=1*cnst30"
"cnst2=2*cnst30"
"cnst3=3*cnst30"
"cnst4=4*cnst30"
"cnst5=5*cnst30"
"cnst6=6*cnst30"
"cnst7=7*cnst30"
"cnst20=20*cnst30"

define list<frequency> o1list={sfo hz, cnst20, -cnst7, -cnst6, -cnst5, -cnst4, -cnst3, -cnst2, -cnst1, 0, cnst1, cnst2, cnst3, cnst4, cnst5, cnst6, cnst7}

"d12=20u"
"p0=p1/9"

"d19=(cnst31/bf1)"

"acqt0=0"
baseopt_echo

1 ze
2 30m

  50u UNBLKGRAD
  p19:gp1
  d16
  d12 o1list:f1 pl9:f1
  d1 cw:f1 ph29
  2u do:f1
  d12 pl1:f1
  2u BLKGRAD
  p0 ph1
  d19
  p0 ph2
  go=2 ph31
  30m mc #0 to 2 F1QF(o1list.inc)
exit


ph1=0 2 2 0 1 3 3 1
ph2=2 0 0 2 3 1 1 3
ph29=0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p0 : f1 channel -  10 degree high power pulse
;p19: homospoil/gradient pulse                       [500 usec]
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d19: delay for bionomial water supression
;cnst1: internally used for frequency scaling
;cnst2: internally used for frequency scaling
;cnst3: internally used for frequency scaling
;cnst4: internally used for frequency scaling
;cnst5: internally used for frequency scaling
;cnst6: internally used for frequency scaling
;cnst7: internally used for frequency scaling
;cnst10: internally used for frequency scaling
;cnst30: o1 step size in Hz                          [0.1 - 2]
;cnst31: scaling factor for binomial supression      [100000]
;ns: 1 * n, total number of scans: NS * TD0
;td1: 16



