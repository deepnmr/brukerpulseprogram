;
;proton T1 inversion recovery with cp detection
;pulse program is for 2D acquisition
;uses mc syntax
;uses VDLIST for relaxation delay
;
;
;Avance Neo version
;parameters:
;pl1 : f1 channel power level
;pl2 : = 0 W, not used
;sp0 : f2 contact power level
;pl12 : f2 power level for 90 degree pulse and standard decoupling 
;pl13 : f2 power level for special decoupling e.g. spinal64_13
;p3 : f2 90 degree pulse at plw12
;p4 : f2 180 degree pulse at plw12
;p15 : contact time
;pcpd2 : pulse length in decoupling sequence
;d1 : recycle delay
;vdlist : list containing relaxation delays
;spnam0 : file name for variable amplitude CP
;cpdprg2 : sequence used for decoupling (e. g. SPINAL64, SWFTPPM, etc.)
;FnMODE : QF
;ZGOPTNS : -Dlacq and/or -Dlcp15 to switch off protection against long decoupling or long contact, resp., or blank
;
;
;$CLASS=Solids
;$DIM=pseudo 2D
;$TYPE=cross polarisation
;$SUBTYPE=T1/T2
;$COMMENT=proton T1 inversion recovery with X detection via cp

prosol relations=<solids_cp>

define list<delay> vd_list = <$VDLIST>

"acqt0=0"

1 ze
2 10m do:f2
  d1
#ifndef lcp15
#include <p15_prot.incl>
			;make sure p15 does not exceed 10 msec 
			;let supervisor change this pulseprogram if 
			;more is needed
#endif

#ifndef lacq		
			;disable protection file for long acquisition change decoupling power !!! or you risk probe damage
			;if you set the label lacq (ZGOPTNS -Dlacq), the protection is disabled

#include <aq_prot.incl>	
			;allows max. 50 msec acquisition time, supervisor
			;may change  to max. 1s at less than 5 % duty cycle
			;and reduced decoupling field
#endif
  (p4 pl12 ph4):f2	;inversion recovery
  vd_list
  (p3 pl12 ph1):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
  1u cpds2:f2		;pl12 is used here
  go=2 ph31 finally do:f2
  1m
  10m mc #0 to 2 F1QF(vd_list.inc)
HaltAcqu, 1m
exit

ph0= 0
ph1= 1 3
ph2= 0 0 2 2 1 1 3 3
ph4= 0 2
ph10= 0
ph31= 0 2 2 0 1 3 3 1



