;1D sequence with explicit programming of acquisition
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <De.incl>


1 ze
2 30m
  d1
  p1 ph1
  ACQ_START(ph30,ph31)
  aq DWELL_GEN:f1
  rcyc=2
  30m mc #0 to 2 F0(zd)
exit


ph1 =0 2 2 0 1 3 3 1
ph30=0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;ns: 1 * n, total number of scans: NS * TD0



