;hcaconhgprc3d
;avance-version (21/09/15)
;(H)CA(CO)NH
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept steps
;
;      F1(H) -> F2(Ca,t1, J(Ha)) -> F2(C=O) 
;                      -> F3(N,t2) -> F1(H,t3)
;
;for determination of 1J(1D) CaHa
;   splitting in F1:  1J CaHa (antiphase)
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1
;using constant time in t2
;(use parameterset )
;
;N. Tjandra & A. Bax, J. Am. Chem. Soc. 119, 9576-7 (1997)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d4=1.4m"
"d21=5.5m"
"d22=4.5m"
"d23=13.0m"
"d26=2.67m"
"d27=14.0m"
"d28=15.0m"


"if ( td1 == 1 ) { d0 = d4; } else { d0 = d22;}"

"d10=d28/2-p14/2"
"d20=d27-p16-d16-p14-8u"
"d29=d28/2-p14/2-p26-d21-4u"
"d30=d28/2-p14/2"

"in0=inf1/2"
"in10=inf2/4"

"in20=in0"
"in29=in10"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"if ( td1 == 1 ) { DELTA=d22-d4-p2; }"

"DELTA1=d27-d0-p14-p16-d16"
"DELTA2=d23-d22-p14"
"DELTA3=d23-p14-4u"
"DELTA4=d21-p16-d16-4u"
"DELTA5=d26-p16-d16"
"DELTA6=p16+d16-p1*2/PI+de+8u"


"TAU1=larger(p1,p21)/2-p1/2"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst22)/1000000)"
"spoffs7=bf2*((cnst22-cnst21)/1000000)"
"spoffs8=0"


"o1_F1=bf2*cnst22/1000000"


aqseq 321


"acqt0=0"
baseopt_echo


1 d11 ze
  d11 pl16:f3
2 d11 do:f3
3 d1 fq=cnst22(bf ppm):f2 
  20u pl1:f1 pl3:f3
  50u UNBLKGRAD

  (p1 ph1):f1
  d4
  (center (p2 ph2) (p14:sp3 ph1):f2 )
  d4
  (p1 ph3):f1

  p16:gp3
  d16 pl19:f1

  (p13:sp2 ph4):f2
  d0

  if "td1 == 1"
     {
     (p2 ph2)
     DELTA
     }

  (p14:sp5 ph1):f2
  DELTA1
  p16:gp4
  d16
  (p14:sp3 ph5):f2
  4u
  p16:gp4
  d16
  d20
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  p16:gp5
  d16 fq=cnst21(bf ppm):f2
  20u cpds1:f1 ph1

  (p13:sp2 ph6):f2
  d22
  (p14:sp7 ph1):f2
  DELTA2
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  DELTA3
  (p14:sp7 ph1):f2
  4u
  (p13:sp8 ph1):f2

  4u do:f1
  (p26 ph2):f1
  p16:gp6
  d16
  (p26 ph2):f1
  20u cpds1:f1 ph1

  (p21 ph9):f3
  d30
  (p14:sp7 ph1):f2
  d30
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d10
  (p14:sp7 ph1):f2
  d29
  4u do:f1
  (p26 ph8):f1
  4u
  p16:gp1*EA
  d16 
  DELTA4 pl1:f1

  (center (p1 ph1) (p21 ph1):f3 )
  p16:gp7
  d16
  DELTA5
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA5
  p16:gp7
  d16
  (center (p1 ph2) (p21 ph7):f3 )
  p16:gp8
  d16
  DELTA5
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA5
  p16:gp8
  d16
  TAU1
  (p1 ph1)
  DELTA6
  (p2 ph1)
  4u
  p16:gp2
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph4, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2EA(calgrad(EA) & calph(ph7, +180), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30) & calph(ph9, +180) & calph(ph31, +180))
99 1m
exit


ph1=0
ph2=1
ph3=1 1 1 1 3 3 3 3
ph4=0 2
ph5=0 0 1 1
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph7=3
ph8=3
ph9=0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl19: f1 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (CO off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f1 channel -  90 degree pulse at pl19
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(HCa))                                      [1.4 msec]
;d10: incremented delay (F2 in 3D) =  d28/2-p14/2
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d27-p16-d16-p14-8u
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: 1/(4J(CaCO)                                      [4.5 msec]
;d23: 1/(4J(NCO)                                       [13.0 msec]
;d26: 1/(4J(NH)                                        [2.67 msec]
;d27: 1/(2J(CaCb), T(C)                                [14.0 msec]
;d23: 1/(4J(NCO)                                       [15.0 msec]
;d29: incremented delay (F2 in 3D) = d28/2-p14/2-p26-d21-4u
;d30: decremented delay (F2 in 3D) = d28/2-p14/2
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Ca)) = DW(Ca)
;nd0: 2
;in10: 1/(4 * SW(N)) = (1/2) DW(N)
;nd10: 4
;in20: = in0
;in29: = in10
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1       td1 max = d20*2 / in20
;td2: number of experiments in F2       td2 max = d30*2 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 8.1%
;gpz3: 50%
;gpz4: 20%
;gpz5: 20%
;gpz6: 40%
;gpz7: 3%
;gpz8: -2%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100



;Processing

;PHC0(F1): 90



