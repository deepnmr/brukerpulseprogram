;hbcbcgcdhdgp4d
;avance-version (21/09/15)
;HbCb(Cg)CdHd
;4D sequence with
;   inverse correlation for triple resonance using inept transfer steps 
;
;      F1(Hb,t1) -> F2(Cb(aro),t2) -> F2(Cg, -> Cd,t3) -> F1(H,t4)
;
;on/off resonance Cbeta and C aro pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;using semi-constant time in t1
;using constant time in t2
;using constant time in t3
;water suppression using 3-9-19 sequence
;using additional phase incrementation to center Hb region
;(use parameterset )
;
;(T. Yamazaki, J.D. Forman-Kay & L.E. Kay, 
;   J. Am. Chem. Soc. 115, 11054-11055 (1993))
;
;$CLASS=HighRes
;$DIM=4D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"


"d3=1.8m"
"d4=1.7m"
"d21=1.25m"
"d22=4.4m"
"d23=2.7m"
"d25=2.6m"
"d27=1.6m"


"p19=500u"


"d51=3u"
"d31=d4-p19-d16-p14/2"
"d32=d22-d3-4u"
"d33=d27"
"d41=d4+p14/2+d51-p19-d16"
"d42=d22-p14-4u"
"d43=d25-p19-d16"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"
"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"


"in42=in32"
"in43=in33"

"td2=tdmax(td2,d42*2,in42)"
"td3=tdmax(td3,d43*2,in43)"


"DELTA=p27*2.385+d19*5-p14/2"
"DELTA2=d3-p14-4u"
"DELTA3=d23-p14-p16-d16-4u"
"DELTA5=d25-d33-p19-d16-larger(p2,p22)"
"DELTA6=d21-p19-d16-p27*2.385-d19*5"
"DELTA7=d21-p19-d16-p27*2.154-p0*0.231-d19*5"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst24-cnst30)/1000000)"
"spoffs7=bf2*((cnst30-cnst24)/1000000)"
"spoffs8=0"
"spoffs9=0"


"o1_F1=bf1*cnst56/1000000"
"o1_F2=bf2*cnst30/1000000"
"o1_F3=bf2*cnst24/1000000"


"cnst62=-(bf1*cnst56-(o1*1000000))"
"cnst63=(bf1*cnst56-(o1*1000000))*(inf1/1000000)*360.0"


"TAU9=abs(cnst62+cnst63)/100000"



1 d11 ze
  d11 pl12:f2
2 d11 do:f2
3 d12 pl32:f1 pl2:f2
  d1 cw:f1 ph29
  4u do:f1
  d12 pl1:f1
  50u UNBLKGRAD
  (p3 ph1):f2
  p16:gp1
  d16 fq=cnst30(bf ppm):f2

  (p1 ph7)
  p19:gp2
  d16
  d31
  (p14:sp3 ph1):f2
  d51
  (p2 ph1):f1
  d41
  p19:gp2
  d16
  (p1 ph2) 

  (p13:sp2 ph3):f2
  4u
  (p14:sp5 ph1):f2
  DELTA2 pl19:f1
  4u cpds1:f1 ph2
  d32
  (p24:sp9 ph4):f2
  4u
  (p14:sp5 ph1):f2 
  d42
  (p13:sp8 ph1):f2

  4u do:f1
  (p26 ph1):f1
  d12 fq=cnst24(bf ppm):f2

  d12 pl10:f1
  (p17*2 ph1):f1
  (p17 ph2):f1
  p16:gp3
  d16

  (p13:sp2 ph5):f2 
  4u
  (p14:sp7 ph1):f2
  p16:gp4
  d16
  DELTA3
  (p14:sp3 ph1):f2
  4u
  (p14:sp7 ph1):f2
  DELTA3
  p16:gp4
  d16

  (p13:sp8 ph1):f2

  p19:gp5
  d16
  d43
  (p14:sp3 ph1):f2
  DELTA5
  p19:gp5
  d16 pl1:f1
  (center (p2 ph1):f1 (p22 ph1):f3 )
  d33 
  (p13:sp2 ph8):f2

  p16:gp6
  d16
  (p11:sp1 ph1:r):f1
  4u
  4u pl1:f1

  (p1 ph1):f1
  4u
  p19:gp7
  d16
  DELTA6 pl18:f1
  
  (p27*0.231 ph1 d19*2 p27*0.692 ph1 d19*2 p27*1.462 ph1 d19*2 p27*1.462 ph6 d19*2 p27*0.692 ph6 d19*2 p0*0.231 ph6) (DELTA p14:sp3 ph1):f2

  DELTA7
  p19:gp7
  d16 pl12:f2 
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph7, +90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51) & calph(ph7, cnst63)) 
     F2PH(calph(ph3, +90), caldel(d32, +in32) & caldel(d42, -in42)) 
     F3PH(calph(ph8, -90), caldel(d33, +in33) & caldel(d43, -in43)) 

TAU9
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 1 1
ph5=0 0 0 0 2 2 2 2
ph6=2
ph7=0
ph8=0
ph29=0
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl12: f2 channel - power level for CPD/BB decoupling
;pl18: f1 channel - power level for 3-9-19-pulse (watergate)
;pl19: f1 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Caro off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (Cb off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (on resonance)
;                  for time reversed pulse
;sp9: f2 channel - shaped pulse 180 degree  (Cb on resonance)
;     sp9 requires higher selectivity than sp3 (Cb only)
;p0 : f1 channel -  90 degree pulse at pl18
;                      use for fine adjustment
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p17: f1 channel - trim pulse                          [2.5 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (sp9)
;p26: f1 channel -  90 degree pulse at pl19
;p27: f1 channel -  90 degree pulse at pl18
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(3J'(HbCb))                                    [1.8 msec]
;d4 : 1/(4J(HbCb))                                     [1.7 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d19: delay for binomial water suppression
;     d19 = (1/(2*d)), d = distance of next null (in Hz)
;d21: 1/(4J'(HeCe))                                    [1.25 msec]
;d22: 1/(4J(CbCg))                                     [4.4 msec]
;d23: 1/(4J'(CbCg)) and 1/(4J(CgCd))                   [2.7 msec]
;d25: 1/(4J'(CgCd))                                    [2.6 msec]
;d27: 1/(4J(HdCd))                                     [1.6 msec]
;d31: incremented delay (F1 in 4D) = d4-p19-d16-p14/2
;d32: incremented delay (F2 in 4D) = d22-d3-4u
;d33: incremented delay (F3 in 4D) = d27
;d41: decremented delay (F1 in 4D) = d4+p14/2+d51-p19-d16
;d42: decremented delay (F2 in 4D) = d22-p14-4u
;d43: decremented delay (F3 in 4D) = d25-p19-d16
;d51: incremented delay (F1 in 4D)                     [3 usec]
;cnst24: Caromatic chemical shift (offset, in ppm)
;cnst30: Cbeta chemical shift (offset, in ppm)
;cnst56: Hbeta chemical shift (offset, in ppm)
;cnst62: offset for Hbeta region (Hz)
;cnst63: additional phase increment to center Hbeta region
;inf1: 1/SW(Hb) = 2 * DW(Hb)
;inf2: 1/SW(Cb) = 2 * DW(Cb)
;inf3: 1/SW(Cd) = 2 * DW(Cd)
;in31: 1/(2 * SW(Hb)) = DW(Hb)
;in32: 1/(2 * SW(Cb)) = DW(Cb)
;in33: 1/(2 * SW(Cd)) = DW(Cd)
;in41: = k1 * in31
;in42: = in32
;in43: = in33
;in51: = (1 - k1) * in31
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td1 max = 2 * d42 / in42
;td3: number of experiments in F3       td1 max = 2 * d43 / in43
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;cpds1: decoupling according to sequence defined by cpdprg1
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd1: f1 channel - 90 degree pulse for decoupling sequence
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients
;gpz1: -50%
;gpz2: 5%
;gpz3: -40%
;gpz4: 20%
;gpz5: 5%
;gpz6: 80%
;gpz7: 31%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



