;c_hacaco_3d
;avance-version (21/09/15)
;HaCaCO
;3D sequence with
;   13C detected correlation for triple resonance using 
;      multiple inept transfer steps
;
;      F2(H,t1) -> F1(Ca,t2) -> F1(C=O, t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using constant time in t1
;using constant time in t2
;(use parameterset C_HACACO_3D)
;
;K. Pervushin & A. Eletsky, J. Biomol. NMR 25, 147-152 (2003)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d2=3.2m"
"d22=4.5m"


"d10=3u"
"d0=d22-d2-p11-p4/2"
"d20=d22-p4/2"
"d30=d22-p30/2"

"in0=inf1/2"
"in10=inf2/2"

"in20=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d22-d10-p30/2"


"spoffs19=bf2*(cnst19/1000000)-o2"
"spoffs20=bf2*(cnst19/1000000)-o2"
"spoffs23=0"
"spoffs25=0"
"spoffs30=bf1*((cnst21/2-cnst22/2)/1000000)"


"o1_F2=bf1*cnst22/1000000"


aqseq 312


1 ze
  d11 pl12:f2 pl16:f3
2 d11 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl1:f1 pl0:f2 pl3:f3

  (p13:sp19 ph1):f2
  4u
  4u pl2:f2
  (p3 ph3):f2
  d2
  (p11:sp23 ph4)

  (
   refalign (d30 p30:sp30 ph1 DELTA1 d10)
   lalign   (d0 p4 ph1 d20 p3 ph6 4u 4u pl0 p13:sp20 ph6):f2
   ralign   (p22 ph1 d10):f3 
  )

  (p11:sp25 ph5)

  4u
  d12 fq=cnst21(bf ppm):f1
  d12 pl16:f3

  (p11:sp23 ph7)


  go=2 ph31 cpd3:f3
  d11 do:f3 mc #0 to 2 
     F1PH(calph(ph6, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10) & caldel(d30, -in30))
exit


ph1=0
ph2=1
ph3=2
ph4=0 2
ph5=0 0 0 0 2 2 2 2
ph6=1 1 3 3
ph7=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp19: f2 channel - shaped pulse  90 degree  (H(N) off resonance)
;sp20: f2 channel - shaped pulse  90 degree  (H(N) off resonance)
;                   for time reversed pulse
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp30: f1 channel - shaped pulse 180 degree (Ca and CO)
;                   symetrically modulated
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p13: f2 channel -  90 degree shaped pulse
;p22: f3 channel - 180 degree high power pulse
;p30: f2 channel - 180 degree shaped pulse (Ca and CO, sp30)
;d0 : incremented delay (F1 in 3D) = d22-d2-p11-p4/2
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/(2J(HCa))                                      [3.2 msec]
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d22-p4/2
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d30: decremented delay (F2 in 3D) = d22-p30/2
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;inf1: 1/SW(Ha) = 2 * DW(Ha)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;in0: 1/(2 * SW(Ha)) =  DW(Ha)
;nd0: 2
;in10: 1/(2 * SW(Ca)) =  DW(Ca)
;nd10: 2
;in20: = in0
;in30: = in10
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1   td1 max = 2 * d20 / in20
;FnMODE: States-TPPI (or TPPI) in F2   td2 max = 2 * d30 / in30
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence



;Processing

;F2 reverse: true


;use AU-program combap to process data



