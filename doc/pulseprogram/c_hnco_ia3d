;c_hnco_ia3d
;avance-version (21/09/15)
;HNCO
;3D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(H,t1) -> F3(N,t2) -> F1(C=O,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using semi-constant time in t1
;using constant time in t2
;using IPAP scheme for virtual decoupling
;(use parameterset C_HNCO_IA3D)
;
;W. Bermel, I. Bertini,L. Duma, I.C. Felli, L. Emsley,  R. Pierattelli,
;   P.R. Vasos, Angew. Chem. Int. Ed. 44, 3089-3092 (2005)
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d22=4.5m"
"d23=12.4m"
"d26=2.3m"


"d0=d26"
"d10=d23/2-p12/2"
"d20=3u"
"d28=d26+p22+d20"
"d29=d23/2-p12/2-p26-d21-4u"
"d30=d23/2-p12/2"

"in0=inf1/2"
"in10=inf2/4"

"FACTOR1=d28*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = 0; } else { in20=in0-INCR1; }"
"if ( INCR1 > in0 ) { in28 = in0; } else { in28 = INCR1; }"

"in29=in10"
"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d23/2-p12/2"
"DELTA2=d23-d22-p12"


"l0=1"


"spoffs11=0"
"spoffs23=0"
"spoffs24=0"
"spoffs26=bf1*(cnst22/1000000)-o1"


"cnst62=-(bf2*cnst19-(o2*1000000))"
"cnst63=(bf2*cnst19-(o2*1000000))*(inf1/1000000)*360.0"


"TAU9=abs(cnst62+cnst63)/100000"


"o1_F1=bf2*cnst19/1000000"


aqseq 321


1 ze
  d11 pl12:f2 pl16:f3 
2 d11 do:f2 do:f3
3 d1 pl2:f2 pl3:f3 
  50u UNBLKGRAD

  (p3 ph3):f2
  d0
  (p22 ph1):f3
  d20
  (p4 ph1):f2
  d28
  (p3 ph2):f2 

  4u
  (p29:sp11 ph1:r):f2
  4u
  p16:gp1
  d16 pl12:f2

  (p21 ph4):f3
  d21
  (p26 ph2):f2
  4u cpds2:f2 ph1
  d29
  (p12:sp26 ph1)
  d10
  (center (p12:sp24 ph1) (p22 ph1):f3 )
  d30
  (p12:sp26 ph1)
  d30
  (p21 ph1):f3

  4u do:f2
  (p26 ph7):f2
  4u
  p16:gp2
  d16
  (p26 ph2):f2
  20u cpds2:f2 ph1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph5)
     DELTA1
     (p12:sp26 ph1)
     DELTA1
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA1
     (p12:sp26 ph1)
     DELTA1 pl16:f3
     }
  else
     {
     (p11:sp23 ph6)
     d22
     (p12:sp26 ph1)
     DELTA2
     (center (p12:sp24 ph1) (p22 ph1):f3 )
     DELTA1
     DELTA1 pl16:f3
     (p12:sp26 ph1)
     }


  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2

#   ifdef LABEL_F1
     F1I(iu0, 2)
#   else
     F2I(iu0, 2)
#   endif /*LABEL_F1*/

     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, +in20) & caldel(d28, -in28) & calph(ph3, cnst63)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30))

TAU9
exit


ph1=0
ph2=1 
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph6=3 3 3 3 1 1 1 1
ph7=3
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp11: f2 channel - shaped pulse  90 degree
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp26: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p26: f2 channel -  90 degree pulse at pl12
;p29: f2 channel -  90 degree shaped pulse (water flipback)
;d0 : incremented delay (F1 in 3D) = d26
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D) = d23/2-p12/2
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: incremented delay (F1 in 3D)                     [3 usec]
;d21: 1/(2J(NH))                                       [5.5 msec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCO))                                      [12.4 msec]
;d26: 1/(4J(NH))                                       [2.3 msec]
;d28: decremented delay (F1 in 3D) = d26+p22+d20
;d29: incremented delay (F2 in 3D) = d23/2-p12/2-p26-d21-4u
;d30: decremented delay (F2 in 3D) = d23/2-p12/2
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst62: offset for H(N) region (Hz)
;cnst63: additional phase increment to center H(N) region
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(H(N)) = 2 * DW(H(N))
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(H(N))) =  DW(H(N))
;nd0: 2
;in10: 1/(4 * SW(N)) = (1/2) DW(N)
;nd10: 4
;in20: = (1 - k) * in0
;in28: = k * in0
;in29: = in10
;in30: = in10
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2   td2 max = 2 * d30 / in30
;cpds2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 30%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] to process data



