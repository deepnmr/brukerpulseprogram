;atocsygpphpr
;avance-version (16/11/04)
;homonuclear Hartman-Hahn transfer using X_M16 sequence
;   for mixing
;MLEV16 cycle in pulseprogram, further cycling to be
;   encoded in shape
;phase sensitive
;with presaturation during relaxation delay
;allowing for presaturation during relaxation delay in cases
;   of radiation damping
;
;M. Piotto, V. Saudek & V. Sklenar, J. Biomol. NMR 2, 661 - 666 (1992)
;V. Sklenar, M. Piotto, R. Leppik & V. Saudek, J. Magn. Reson.,
;   Series A 102, 241 -245 (1993)
;E. Kupce, P. Schmidt, M. Rance & G. Wagner, J. Magn. Reson. 135,
;   361-367 (1998)
;W.Peti, C. Griesinger & W. Bermel, J. Biomol. NMR 18, 199 - 205 (2000)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d11=30m"
"d12=20u"
"d13=4u"


"in0=inf1"

"d0=in0/2-p1*4/3.1416"


"l1=d9/(p29*16)"


"acqt0=-p1*2/PI"


1 ze 
2 d11 

#   ifdef FLAG_BLK
  4u BLKGRAD
#   else
  4u
#   endif /*FLAG_BLK*/
  
  d12 pl9:f1
  d1 cw:f1 ph29
  d13 do:f1
  d12 pl1:f1

  p1 ph1
  d0
  p1 ph2
  d20 pl0:f1
  50u UNBLKGRAD
  p16:gp1
  d16
                                                ;begin X_M16
4 (p29:sp0 ph20):f1
  3u
  (p29:sp0 ph20):f1
  3u
  (p29:sp0 ph22):f1
  3u
  (p29:sp0 ph22):f1
  3u

  (p29:sp0 ph20):f1
  3u
  (p29:sp0 ph22):f1
  3u
  (p29:sp0 ph22):f1
  3u
  (p29:sp0 ph20):f1
  3u

  (p29:sp0 ph22):f1
  3u
  (p29:sp0 ph22):f1
  3u
  (p29:sp0 ph20):f1
  3u
  (p29:sp0 ph20):f1
  3u

  (p29:sp0 ph22):f1
  3u
  (p29:sp0 ph20):f1
  3u
  (p29:sp0 ph20):f1
  3u
  (p29:sp0 ph22):f1
  3u

  lo to 4 times l1
                                                ;end X_M16

  p16:gp2
  d16
  d21 pl1:f1
  p1 ph3

#   ifdef FLAG_BLK
  4u
#   else
  4u BLKGRAD
#   endif /*FLAG_BLK*/

  go=2 ph31
  d11 mc #0 to 2 F1PH(calph(ph1, +90) & calph(ph29, +90), caldel(d0, +in0))

#   ifdef FLAG_BLK
  4u BLKGRAD
#   else
  4u
#   endif /*FLAG_BLK*/

exit 
  

ph1=0 2
ph2=0 0 0 0 2 2 2 2
ph3=0 0 2 2 
ph4=0
ph5=2

ph20=0
ph22=2

ph29=0
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;sp0 : f1 channel - shaped pulse 180 degree (adiabatic spinlock)
;p0 : f1 channel -  90 degree pulse at pl18
;                      use for fine adjustment
;p1 : f1 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse
;p27: f1 channel -  90 degree pulse at pl18
;p29: f1 channel - 180 degree shaped pulse for spinlock (adiabatic)
;d0 : incremented delay (2D)
;d1 : relaxation delay; 1-5 * T1
;d9 : TOCSY mixing time
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;d16: delay for homospoil/gradient recovery
;d20: first z-filter delay                           [10 usec]
;d21: second z-filter delay                          [10 usec]
;l1: loop for MLEV16 cycle: ((p12*16) * l1) = mixing time
;inf1: 1/SW(H) = 2 * DW(H)
;in0: 1/(1 * SW) = 2 * DW
;nd0: 1
;ns: 8 * n
;ds: 16
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEQ
;zgoptns: -DFLAG_BLK


;for z-only gradients:
;gpz1: 22%
;gpz2: 31%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



                                          ;preprocessor-flags-start
;FLAG_BLK: for BLKGRAD before d1 rather than go
;             option -DFLAG_BLK (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;WaveMaker shapes (optional)
;use 'wvm -a' command to create the necessary shape files for MAS = 2.5 kHz
;sp0:wvm: cawurst-2(20 kHz, 0.4 ms; Q = 2.0)



