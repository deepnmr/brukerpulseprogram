"acqt0=-p1*2/3.1416"


1 ze
2 30m
  d1
  p1 ph1
  go=2 ph31
  30m wr #0
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
