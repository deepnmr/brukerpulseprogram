;t1_prot.incl

; List of Protections for t1 evolution

;$COMMENT=t1 Protections
;$CLASS=BioSolids INCL


;###################
;# Protections for #
;#  t1 evolution   #
;###################


if "d30<25m" goto Passd30
1u 
print "final t1 evolution (d30) too large.  Reduce inf1, td1, or cnst30"
goto HaltAcqu
Passd30, 1m

if "d0<25m" goto PrePassd0
1u 
print "initial t1 evolution (d0) too large. Reduce inf1"
goto HaltAcqu
PrePassd0, 1m



