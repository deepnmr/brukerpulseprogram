;b_trhncocannhgp3d
;avance-version (21/09/15)
;best-TROSY-(H)N(COCA)NNH
;3D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F1(H) -> F3(N,t1) -> F2 (C=O)
;                        -> F2(Ca) -> F3(N,t2) -> F1(H,t3)
;
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho gradient selection (t2)
;using constant time in t1 and t2
;(use parameterset )
;
;(P. Schanda, H. v. Melckebeke & B. Brutscher, 
;   J. Am. Chem. Soc. 128, 9042-9043 (2006))
;(E. Lescop, P. Schanda & B. Brutscher, 
;   J. Magn. Reson.  187 163-169 (2007))
;(R. Weisemann, H. Rueterjans & W. Bermel, J. Biomol. NMR 3,
;   113-120 (1993))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p22=p21*2"
"d11=30m"

"d21=5.5m"
"d22=4.5m"
"d23=14.5m"
"d26=2.3m"
"d27=12.5m"

"p29=300u"


#   ifdef CALC_SP
"p42=(bwfac26/(cnst55*cnst52*bf1))*1000000"
"spw26=plw1*pow((p1*totrot26)/(p42*90.0*integfac26),2)"
"spoal26=0.5"

"p43=(bwfac28/(cnst55*cnst53*bf1))*1000000"
"spw28=plw1*pow((p1*totrot28)/(p43*90.0*integfac28),2)"
"spw29=plw1*pow((p1*totrot29)/(p43*90.0*integfac29),2)"
"spoal28=1"
"spoal29=0"
#   endif /*CALC_SP*/


"d0=3u"
"d10=3u"
"d20=d23"
"d30=d23"

"in0=inf1/2"
"in10=inf2/2"

"in20=in0"
"in30=in10"

"td1=tdmax(td1,d20*2,in20)"
"td2=tdmax(td2,d30*2,in30)"


"DELTA=d23-d21/2-p44"
"DELTA1=d26-p19-d16-larger(p22,p42)/2"
"DELTA2=d23-d10-p14-p21*4/PI"
"DELTA3=d26-p29-d16-larger(p22,p42)/2-p43*cnst43"
"DELTA4=de"
"DELTA5=d21/2-p14-d0"
"DELTA6=d26-p19-d16-larger(p22,p42)/2"
"DELTA7=d27-d22"


"l0=1"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst22-cnst21)/1000000)"
"spoffs7=bf2*((cnst21-cnst22)/1000000)"
"spoffs8=0"
"spoffs9=0"

"spoffs26=bf1*(cnst19/1000000)-o1"
"spoffs28=bf1*(cnst19/1000000)-o1"
"spoffs29=bf1*(cnst19/1000000)-o1"
"spoffs30=0"


"acqt0=0"
baseopt_echo


aqseq 321


1 d11 ze
  d11
2 d11
3 d1 fq=cnst21(bf ppm):f2
  50u UNBLKGRAD

  (p43:sp28 ph1)
  p19:gp3
  d16
  DELTA1
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA1
  p19:gp3
  d16
  (p43:sp29 ph4):f1 

  p16:gp4
  d16

  (p21 ph5):f3
  d0
  (p14:sp5 ph1):f2
  DELTA5
  (p44:sp30 ph1) 
  DELTA
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d20
  (p21 ph1):f3

  (p44:sp30 ph1) 
  p16:gp5
  d16

  (p13:sp2 ph6):f2
  d22
  (p14:sp5 ph1):f2
  4u
  (p14:sp3 ph1):f2
  d22
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph2):f2

  p16:gp9
  d16 fq=cnst22(bf ppm):f2

  (p13:sp2 ph1):f2
  d22
  d27
  (p14:sp7 ph1):f2
  DELTA7
  (center (p24:sp9 ph1):f2 (p22 ph1):f3 )
  d27
  (p14:sp7 ph1):f2
  d27
  (p13:sp8 ph2):f2

  p16:gp6
  d16

  if "l0 %2 == 1"
     {
     (p21 ph7):f3
     }
  else
     {
     (p21 ph8):f3
     }

  d10
  (p14:sp7 ph1):f2
  DELTA2
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d30

  (p43:sp29 ph9) 
  p29:gp7
  d16
  DELTA3
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA3
  p29:gp7
  d16
  (p43:sp28 ph1)

  DELTA4 

  (p21 ph9):f3
  4u
  p19:gp8
  d16
  DELTA6
  (center (p42:sp26 ph1) (p22 ph1):f3 )
  DELTA6
  p19:gp8
  d16
  4u BLKGRAD
  (p21 ph1):f3


  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph5, +90), caldel(d0, +in0) & caldel(d20, -in20)) 
     F2EA(calph(ph9, +180) & calclc(l0, 1), caldel(d10, +in10) & caldel(d30, -in30) & calph(ph7, +180) & calph(ph8, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph6=0 0 0 0 2 2 2 2
ph7=1 3 0 2
ph8=1 3 2 0
ph9=3
ph31=1 3 2 0 3 1 0 2 3 1 0 2 1 3 2 0


;pl3 : f3 channel - power level for pulse (default)
;sp2: f2 channel - shaped pulse  90 degree  (C on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp7: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;sp9: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;     sp9 requires higher selectivity - refocussing Calpha only
;sp26: f1 channel - shaped pulse 180 degree (Reburp.1000)
;sp28: f1 channel - shaped pulse  90 degree (Eburp2.1000)
;sp29: f1 channel - shaped pulse  90 degree (Eburp2tr.1000)
;                   for time reversed pulse
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p19: gradient pulse 2                                 [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p24: f2 channel - 180 degree shaped pulse (Ca, selective)
;p29: gradient pulse 3                                 [300 usec]
;p42: f1 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (2.0ms at 600.13 MHz)
;p43: f1 channel -  90 degree shaped pulse for excitation
;                      Eburp2.1000/Eburp2tr.1000 (1.92ms at 600.13 MHz)
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 3D) = d23
;d21: 1/(2J(NH)                                        [5.5 msec]
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J(NCa)                                       [14.5 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d27: 1/(4J'(NCa)                                      [12.5 msec]
;d30: decremented delay (F2 in 3D) = d23-p43
;cnst19: H(N) chemical shift (offset, in ppm)
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst40: compensation of chemical shift evolution during p42
;           Reburp.1000: 0.5
;           compensate to the extend the other delays allow
;cnst41: compensation of chemical shift evolution during p41
;           Pc9_4_90.1000: 0.529
;cnst42: compensation of chemical shift evolution during p42
;           Reburp.1000: 0.5
;cnst43: compensation of chemical shift evolution during p43
;           Eburp2.1000: 0.5
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(Ca)) =  DW(Ca)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in20: = in0
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz3: 30%
;gpz4: 60%
;gpz5: 50%
;gpz6: 30%
;gpz7: 18%
;gpz8: 44%
;gpz9: 11%

;use gradient files:   
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.50
;gpnam8: SMSQ10.32
;gpnam9: SMSQ10.100



;Processing

;PHC0(F2): -90


