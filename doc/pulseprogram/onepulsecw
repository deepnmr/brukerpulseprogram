;onepulsecw (TopSpin 3.0)
;
; TS3, TS4 / 30.07.2017
;
;
;Avance version
;parameters:
;pl1 : f1 power level for excitation pulse
;pl17: f2 powerlevel for cw decoupling
;p1 : excitation pulse length
;d1 : recycle delay
;acqt0 is used to backpredict the t=0 fid point
;
;
;$CLASS=Solids
;$DIM=1D
;$TYPE=direct excitation
;$SUBTYPE=simple 1D
;$COMMENT=single pulse excitation, cw(f2) decoupling during relaxation delay and AQ


prosol relations=<solids_ICON_QN>

"plw17=plw0*pow((4*p0/(1000)),2)"

"acqt0=-p1/2"


1 ze
  1u pl17:f2
  1u cw:f2
2 d1
  (p1 pl1 ph1):f1
  go=2 ph31
  wr #0
  1u do:f2
exit

ph1= 0 2 1 3
ph31=0 2 1 3



