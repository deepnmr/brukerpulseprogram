;sf_metrosygpph
;avance-version (21/09/15)
;SOFAST Methyl Trosy
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence
;phase sensitive
;with decoupling during acquisition
;
;C. Amero, P. Schanda, M. Asuncion Dura, I. Ayala, D. Marion, B. Franzetti,
;   B. Brutscher & J. Boisbouvier, J. Am. Chem. Soc. 131, 3448-9 (2009)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"d11=30m"
"d12=20u"
"d2=1s/(cnst2*2)"

"p19=200u"


"in0=inf1"

"d0=in0/2-p3*4/3.1416"


"DELTA1=d2-p19-d16-p50*cnst50"
"DELTA2=d2-p19-d16+de-4u"


"spoffs22=bf1*(cnst49/1000000)-o1"
"spoffs30=0"


1 ze 
  d11 pl29:f2
2 d1 do:f2
3 d12 pl2:f2
  50u UNBLKGRAD

  p19:gp1
  d16

  (p50:sp22 ph1):f1
  p19:gp2
  d16
  DELTA1
  (center (p44:sp30 ph1):f1 (p3 ph3 d0 p3 ph4):f2 )
  DELTA2 pl29:f2
  p19:gp2
  d16
  4u BLKGRAD
  (p44:sp30 ph2):f1
  go=2 ph31 cpd2:f2
  d1 do:f2 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0))
exit 
  

ph1=0 
ph2=2 
ph3=0 2
ph4=0 0 2 2 
ph31=0 2 2 0


;pl2 : f2 channel - power level for pulse (default)
;pl29: f2 channel - power level for CPD/BB decoupling (low power)
;sp22: f1 channel - shaped pulse  90 degree (Pc9_4_90.1000)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;p3 : f2 channel -  90 degree high power pulse
;p19: homospoil/gradient pulse                       [200 usec]
;p44: f1 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;p50: f1 channel - shaped pulse for excitation   Pc9_4_90.1000
;                     (6ms at 600.13 MHz)
;                     p50*cnst50 must be smaller than d2 (1/(cnst2*2))
;d0 : incremented delay (2D) = in0/2-p3*4/3.1416
;d1 : relaxation delay
;d2 : 1/(2J)CH
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(CH)
;cnst49: Hme chemical shift (offset, in ppm)
;cnst50: compensation of chemical shift evolution during p50
;           Pc9_4_90.1000: 0.529
;o2p: Cme chemical shift
;inf1: 1/SW(Cme) = 2 * DW(Cme)
;in0: 1/ SW(Cme) = 2 * DW(Cme)
;nd0: 1
;ns: 2 * n
;ds: 16
;aq: <= 50 msec
;td1: number of experiments
;FnMODE: States-TPPI, TPPI, States or QSEC
;cpd2: decoupling according to sequence defined by cpdprg2: garp4.p60
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;          use pulse of >= 350 usec
;cpdprg2: garp4.p60


;for z-only gradients:
;gpz1: 11%
;gpz2: 7%

;use gradient files:   
;gpnam1: SMSQ10.32
;gpnam2: SMSQ10.32



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1



