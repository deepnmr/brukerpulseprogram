;noesycngp3d
;avance-version (21/09/15)
;NOESY-HSQC
;3D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange.
;   H-1/X correlation via double inept transfer
;      using sensitivity improvement
;
;      F1(H) -> F2(C,t1) -> F1(H) -> F3(N,t2) -> F1(H,t3)
;
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho-TPPI gradient selection (t2)
;with decoupling during acquisition
;using shaped pulses for inversion on f2 - channel
;(use parameterset NOESYCNGP3D)
;
;T. Diercks, M. Coles & H. Kessler, J. Biomol. NMR, 15,
;   177-180 (1999)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"p22=p21*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d13=4u"
"d26=1s/(cnst4*4)"


"d0=3u"
"d10=3u"

"in0=inf1/2"
"in10=inf2/2"


"DELTA1=d4-larger(p2,p8)/2"
"DELTA2=d0*2+larger(p14,p22)-p14"
"DELTA3=p16+d16+larger(p2,p8)+d10*2"
"DELTA4=d13+p16+d16+4u"

"TAU=d8-p16-d16-p11-8u"


"spoffs5=bf2*(cnst21/1000000)-o2"
"spoffs13=bf2*(cnst26/1000000)-o2"


aqseq 321


1 ze
  d11 pl16:f3
2 d1 do:f3
3 (p1 ph1)
  DELTA1
  (center (p2 ph2) (p8:sp13 ph7):f2 )
  DELTA1 UNBLKGRAD
  (p1 ph2)

  p16:gp1
  d16 pl2:f2 pl3:f3

  (p3 ph3):f2
  d0
  (center (p2 ph8) (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d0
  4u pl2:f2
  (p4 ph1):f2
  DELTA2
  (p14:sp5 ph1):f2
  2u
  2u pl2:f2
  (p3 ph1):f2

  p16:gp1
  d16

  (p1 ph2)
  DELTA1
  (center (p2 ph2) (p8:sp13 ph1):f2 )
  DELTA1
  (p1 ph9)

  TAU
  p16:gp2
  d16 pl0:f1

  (p11:sp1 ph2):f1
  4u
  4u pl1:f1

  (p1 ph1)
  d26
  (center (p2 ph1) (p22 ph10):f3 )
  d26
  (p1 ph2) 

  p16:gp3
  d16

  (p21 ph4):f3
  d10 
  (center (p2 ph8) (p8:sp13 ph1):f2 )
  d10
  p16:gp4*EA
  d16
  (p22 ph5):f3
  DELTA3

  (center (p1 ph1) (p21 ph5):f3 )
  d24
  (center (p2 ph2) (p22 ph1):f3 )
  d24
  (center (p1 ph2) (p21 ph6):f3 )
  d26
  (center (p2 ph2) (p22 ph1):f3 )
  d26
  (p1 ph1)
  DELTA4
  (p2 ph1)
  d13
  p16:gp5
  d16 pl16:f3
  4u BLKGRAD
  go=2 ph31 cpd3:f3
  d1 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0))
     F2EA(calgrad(EA) & calph(ph6, +180), caldel(d10, +in10) & calph(ph4, +180) & calph(ph10, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=0 0 2 2
ph4=0 2
ph5=0 0 0 0 2 2 2 2
ph6=3 3 3 3 1 1 1 1
ph7=0
ph8=1 1 1 1 1 1 1 1 3 3 3 3 3 3 3 3
ph9=2
ph10=0
ph31=0 2 2 0 2 0 0 2
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp1: f1 channel - shaped pulse  90 degree
;sp5: f2 channel - shaped pulse 180 degree   (C=O off resonance)
;sp13: f2 channel - shaped pulse 180 degree  (adiabatic)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J)CH
;d8 : mixing time
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d13: short delay                                      [4 usec]
;d16: delay for homospoil/gradient recovery
;d24: 1/(4J)NH for NH
;     1/(8J)NH for all multiplicities
;d26: 1/(4J(NH))
;cnst2: = J(CH)
;cnst4: = J(NH)
;cnst21: CO chemical shift (offset, in ppm)
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;inf1: 1/SW(C) = 2 * DW(C)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(C)) = DW(C)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:	gp 1 : gp 2 : gp 3 : gp 4 : gp 5
;			   5 :   50 :   30 :   80 :  8.1

;for z-only gradients:
;gpz1: 5%
;gpz2: 50%
;gpz3: 30%
;gpz4: 80%
;gpz5: 8.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100



