;$Id:$
;1D sequence with homodecoupling
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"p0=cnst10*p1/90"
"d12=20u"
"acqt0=-p0*2/3.1416"

1 ze
  d12 pl24:f2
2 30m do:f2
  4u hd:f2
  d1 
  4u do:f2
  d12 pl24:f2
  p0 ph1
  go=2 ph31 hd:f2
  30m do:f2 mc #0 to 2 F0(zd)
exit

ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl24: f2 channel - power level for hd/hc decoupling
;p0 : f1 channel -  for any flipangle - high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;NS: 1 * n, total number of scans: NS * TD0

;use AQMOD qsim
