;noesyhmqcfpgp3d
;avance-version (20/09/28)
;NOESY-HMQC
;3D sequence with
;   homonuclear correlation via dipolar coupling 
;   dipolar coupling may be due to noe or chemical exchange.
;   H-1/X correlation via heteronuclear zero and double quantum
;      coherence 
;phase sensitive (t1 and t2)
;with decoupling during acquisition
;with gradient/rf spoil pulse in mixing time
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p22=p21*2"
"d2=1s/(cnst2*2)"
"d11=30m"


"in0=inf1"
"in10=inf2"

"d0=in0/2-p1*4/PI"
"d10=in10/2-p3*4/PI"


"DELTA1=d2-p16-d16-p29-p2/2-p1*2/PI-4u"
"DELTA2=d2-p16-d16-p29-p2/2-de-8u"
"DELTA3=p29+p2/2+4u"

"TAU=d8-p16-d16*3-p54-p29-p32*1.75-20u"


"acqt0=0"
baseopt_echo


aqseq 312


1 d11 ze
2 d11 do:f2
  d1
  50u UNBLKGRAD
  
  (
  center
  (p54:sp33 ph7 2u 2u pl1 p1 ph3 d0 p1 ph1 p54:sp33 ph6):f1
  (p14:sp3 ph1):f2
  (p22 ph1):f3
  )

  TAU

  10u gron0
  (p32:sp29 ph1):f1
  d16 groff

  10u gron0*1.333
  (p32*0.75:sp29 ph1):f1
  d16 groff

  p16:gp1
  d16

  (p29:sp11 ph6):f1
  (p1 pl1 ph1):f1
  p16:gp2
  d16 pl2:f2
  DELTA1 
  (
  center
  (p29:sp11 ph6 2u 2u pl1 p2 ph1 4u p29:sp11 ph6):f1
  (DELTA3 p3 ph4 d10 p3 ph5 DELTA3):f2
  (p22 ph1):f3
  )

  DELTA2
  p16:gp2
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph3, +90) & calph(ph7, +90), caldel(d0, +in0)) 
     F2PH(calph(ph4, +90), caldel(d10, +in10))
exit


ph1=0
ph2=1
ph3=0 0 2 2
ph4=0 2
ph5=0 0 0 0 2 2 2 2
ph6=2
ph7=2 2 0 0
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse (180degree inversion)
;spnam3: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;sp11: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp29: f1 channel - shaped pulse (adiabatic)
;sp33: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;p16: homospoil/gradient pulse                              [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: f1 channel -  90 degree shaped pulse (flipback pulse) [1 msec]
;p32: f1 channel - 180 degree shaped pulse (adiabatic)      [20 msec]
;p54: f1 channel -  90 degree shaped pulse (flipback pulse) [4 msec]
;d0 : incremented delay (F1 in 3D) = in0/2-p1*4/PI
;d1 : relaxation delay; 1-5 * T1
;d2 : 1/((2J)XH)
;d8 : mixing time
;d10: incremented delay (F2 in 3D) = in10/2-p3*4/PI
;d11: delay for disk I/O                                    [30 msec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(XH)
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(X) = 2 * DW(X)
;in0: 1/SW(H) = 2 * DW(H)
;nd0: 1
;in10: 1/SW(X) = 2 * DW(X)
;nd10: 1
;ns: 4 * n
;ds: 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz0: ca. 11%
;gpz1: 50%
;gpz2: 31%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



;Processing

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1



;for sweepwidth of adiabatic shape and adjusting gpz0
;   see supplementary material of M.J. Thrippleton & J. Keeler,
;   Angew. Chem. Int. Ed. 42, 3938-3941 (2003)



