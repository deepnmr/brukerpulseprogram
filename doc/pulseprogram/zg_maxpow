;zg_maxpow	-*-pulsprog-*-

;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

; ATTENTION: this pulse program just pulses with the maximum possible
; transmitter power;
; it may be used for output power measurement 

#include <Avance.incl>

define list<power> maxPower = {dBo -6}

1 ze
2 30m maxPower:f1
  20u 
  d1 
  p1 ph1
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;$Id:$
