;Polariser4.incl
;for AV NEO
;avance-version (18/01/24)
;defines the commands to control the polariser V4
;
;$CLASS=Common Incl
;$COMMENT=


/*stop BPHP at the end of the event*/
#define STOP_BPHP						setrtp0|9|8|7|6

/*sample from polariser to collect vials*/ 
#define EMPTY								setrtp0|9|8|7^6

 /*start WASH*/
#define WASH								setrtp0|9|8^7|6

/*start WASH and EMPTY loop*/
#define L_WASH_EMPTY				setrtp0|9|8^7^6

/*start DRY 'N2 flush'*/
#define FLUSCH							setrtp0|9^8|7|6

/*sample from vials to polariser*/
#define LOAD								setrtp0|9^8|7^6 

/*No_Define_cmd */
#define No_Def_cmd					setrtp0|9^8^7|6

/*acknowledge command*/
#define ACK_CMD							setrtp0^9^8^7^6

/*end of acknowledge EPU*/
#define END_ACK							setrtp0|9^8^7^6

/*start regeneration*/
#define REGENERATE					setrtp0^9|8|7|6

/*sample from polasiser to probe*/
#define TRANSFER						setrtp0^9|8|7^6

/*second sample to probe*/
#define TRANSFER_NEXT				setrtp0^9|8^7|6

/*sample from probe to polariser*/
#define TRANSFER_BACK				setrtp0^9|8^7^6

/*Force IN_MIX_CHAMBER*/
#define F__IN_MIX_CHAMBER		setrtp0^9^8|7|6

/*Force IN_FLOWCELL*/
#define F_IN_FLOWCELL				setrtp0^9^8|7^6

/*Terminate or stop immediately*/
#define EMERGENCY_STOP			setrtp0^9^8^7|6


/*force to ipso*/
#define F_IPSO							No_Def_cmd



/*test '1' stat of trigger1*/
#define Valid_P_trg1 100u trigpl1

/*test '1' stat of trigger2*/    
#define Valid_P_trg2 100u trigpl2

/*test '0' stat of trigger1*/  
#define Valid_N_trg1 100u trignl1

/*test '0' stat of trigger2*/
#define Valid_N_trg2 100u trignl2       



;additional definitions to use the old pulse pograms with the 
;new polariser and the new AV-NEO definitions

subroutine IPSO_CMD()
{
  500m F_IPSO					;set to ipso mode
  500m ACK_CMD
}

subroutine MANUAL_CMD()
{
  500m EMERGENCY_STOP	;set to manual mode
}

subroutine INJECT_POLARISER()
{
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1

   LOAD
  
  Valid_N_trg2			;test '0' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_N_trg1			;test '0' stat of trigger1
  END_ACK						;end of acknowledge IPSO
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
}

subroutine EJECT_POLARISER()
{
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  
   EMPTY 
  
  Valid_N_trg2			;test '0' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_N_trg1			;test '0' stat of trigger1
  END_ACK						;end of acknowledge IPSO
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
}

subroutine INJECT_PROBE()
{
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  
   TRANSFER
  
  Valid_N_trg2			;test '0' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_N_trg1			;test '0' stat of trigger1
  END_ACK						;end of acknowledge IPSO
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
}

subroutine EJECT_PROBE()
{
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
 
   TRANSFER_BACK 
  
  Valid_N_trg2			;test '0' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_N_trg1			;test '0' stat of trigger1
  END_ACK						;end of acknowledge IPSO
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
}

subroutine BUBBLE_H2()
{
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  
   REGENERATE
  
  Valid_N_trg2			;test '0' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command
}

subroutine STOP_EVEN()
{
  Valid_N_trg2			;test '0' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
    
   STOP_BPHP 
 
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_N_trg1			;test '0' stat of trigger1
  END_ACK						;end of acknowledge IPSO
  Valid_P_trg2 			;test '1' stat of trigger2
  Valid_P_trg1 			;test '1' stat of trigger1
  ACK_CMD						;IPSO acknowledge command  
}



;$Id:$
