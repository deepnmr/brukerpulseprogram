;N.dp

;;version: 1.0/ TS3.2 /2015/08/05

;written for BioToolkit: SEWE August 2015
;double-checked: VEDA SEWE July 2015

;direct excitation and acquisition on C 


;Avance II / III version
;parameters:
;p21  : N 90 at pl21
;pl1 : =0W, not used here
;pl21 : N pulse power
;pl12: H dec power
;pl17: H dec low power
;d1  : recycle delay
;pcpd2   : H dec pulse cpdprg2
;cpdprg2 : Decoupling file cw, tppm (at pl12)
;ZGOPTNS : -Dlowpower : low power decoupling for long acquisition times
;ns: 4 (full:4)


;$COMMENT= single pulse excitation, acquisition without decoupling
;$CLASS=BioSolids
;$DIM=1D
;$TYPE=direct excitation
;$SUBTYPE=Setup


prosol relations=<biosolNHC>

#include <NHC_defs.incl>
        ; defines which channel corresponds to which nucleus
#include <trigg.incl>
        ; definition of external trigger output


"acqt0=-p21*2/3.1416"


                            ;##########################
;$EXTERN                    ;# Python insertion point #
                            ;##########################

Prepare, ze

;######################################################
;#               Protections: Pre-Check               #
;######################################################


;######################################################
;#           Start of Active Pulse Program            #
;######################################################

Start, 10m  do:H
  d1 do:H

  trigg
  1u pl12:H
  1u fq=0.0:N				;set 15N on resonance
#ifdef lowpower
   (p21 pl21 ph1):N (1u cw pl17):H
#else
   (p21 pl21 ph1):N (1u cpds2):H
#endif 
 
  
;#######################################################
;#                     Acquisition                     #
;#######################################################

  go=Start ph31
  1m do:H         
  10m mc #0 to Start F0(zd)
  
HaltAcqu, 1m
Exit, exit

;#####################################
;#             Phase Cycle           #
;#####################################

ph1= 0 2 1 3		; N hard pulse

ph31=0 2 1 3		; receiver

;#######################################################



;$Id:$
