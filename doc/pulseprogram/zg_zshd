;zg_zshd
;avance-version (16/11/30)
;1D sequence
;uses instant 1H broadband homodecoupling during acquisition
;   with a Zangger-Sterk element
;using random variation for artefact suppression
;
;N.H. Meyer & K. Zangger, Angew. Chem. Int. Ed. 52, 7143-7146 (2013)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <De.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d11=30m"

"d61=0"
"d62=aq/l0"
"d63=d62/2"


"l1=l0-1"


"DELTA3=p16+d16-p1*2/PI+de+5u"


1 ze
2 d11
  4u BLKGRAD
  d1 pl1:f1
  50u UNBLKGRAD

  (p1 ph1):f1
  4u
  (p44:sp30 ph1):f1

  4u
  p16:gp1*0.5
  d16

  (p44:sp30 ph1):f1

  p16:gp1*-0.5
  d16
  DELTA3
  (p48:sp36 ph4):f1 (p48:gp0)
  5u
  p16:gp1*-1.0
  d16

  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  "d61=random(d63,cnst62)"
  d61
  0.05u DWELL_HOLD
  0.1u REC_BLK

  p16:gp2
  d16 pl1:f1
  p2 ph2
  p16:gp2 
  d16 
   
  p16:gp3
  d16
  5u
  (p48:sp36 ph3):f1 (p48:gp0)
  5u
  p16:gp3
  d16 

4 0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  "d61=random(d62,cnst62)"
  d61
  0.05u DWELL_HOLD
  0.1u REC_BLK
  
  p16:gp2
  d16 pl1:f1
  p2 ph2
  p16:gp2 
  d16 
 
  p16:gp3
  d16
  5u
  (p48:sp36 ph3):f1 (p48:gp0)
  5u
  p16:gp3
  d16 

  lo to 4 times l1

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62*2
  0.05u DWELL_HOLD
  0.1u REC_BLK

  rcyc=2

  d11 mc #0 to 2 F0(zd)
exit


ph1=0 2 2 0 1 3 3 1
ph2=0 2
ph3=2 0
ph4=0 0 0 0 1 1 1 1
ph30=0
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;sp30: f1 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp36: f1 channel - shaped pulse 180 degree for Zangger-Sterk element
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse
;p44: f1 channel - 180 degree shaped pulse for refocussing
;p48: f1 channel - 180 degree shaped pulse for Zangger-Sterk element
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;cnst62: random variation of first chunk length in %  [5%]
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;ns: 1 * n, total number of scans: NS * TD0
;ds: 4


;for z-only gradients:
;gpz0: ca. 2%
;gpz1: 19%
;gpz2: 7%
;gpz3: 5%

;use gradient files:
;gpnam0: RECT.1
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100



