;lc2grdonflow
;avance-version (12/07/30)
;WET solvent suppression with shape pulse
;   and C-13 decoupling on f2 during WET and AQ
;with intermediate preparation scan into second dataset
;for LC gradient runs with updated shapes
;ONLY for usage with AU-program 'au_lcgrdonflow' and AVIII spectrometers
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<lcnmr>


#include <Avance.incl>
#include <Grad.incl>


define delay AQPORTC                    ;Wait for connection of AQ port


"d11=30m"
"d12=20u"
"d13=4u"
"d16=2m"
"d31=d1"


"AQPORTC=10s"


1 ze
d12 pl14:f2

                                        ;start zg and wait for resume from AU 
					;program for precise synchronisation

#   ifdef WAITFORSTART
  AQPORTC 
  autosuspend 
#   endif /*WAITFORSTART*/

2 d12

                                        ;run search spectrum into 2nd dataset, 
					;do NOT use for gs and rga

#   ifdef DOPREP
  d12 pl10:f1
  p0 ph29
  gosc ph29
  d30 wr #1 if #1 zd pl1:f1
  d1 resume_calc
  "d31=d12"                             ;reduce d31 for first loop of main experiment
  d11 stop_calc
#   endif /*DOPREP*/

                                        ;if running without lock, use BLKGRAMP only.
#   ifdef NOLOCK
3 d12 BLKGRAMP
#   else
3 d12 BLKGRAD
#   endif /*NOLOCK*/

  d31 do:f2                             ;first loop d31=d12
  "d31=d1"                              ;reset d31 to d1 for further loops

                                        ;if running without lock, use UNBLKGRAMP only.
#   ifdef NOLOCK
  50u UNBLKGRAMP
#   else
  50u UNBLKGRAD
#   endif /*NOLOCK*/

  d12 pl0:f1
  d13 cpd2:f2
  (p11:sp7 ph5):f1
  4u
  p16:gp21
  d16 pl0:f1
  (p11:sp8 ph6):f1
  4u
  p16:gp22
  d16 pl0:f1
  (p11:sp9 ph6):f1
  4u
  p16:gp23
  d16 pl0:f1
  (p11:sp10 ph6):f1
  4u do:f2
  p16:gp24
  d16 pl1:f1
  p1 ph1
  d13
  p1 ph2
  d13
  p1 ph3
  d13
  p1 ph4
  go=3 ph31 cpd2:f2
  d11 wr #0 if #0 zd do:f2
  lo to 2 times td1

                                        ;if running without lock, use BLKGRAMP only.
#   ifdef NOLOCK
  d12 BLKGRAMP
#   else
  d12 BLKGRAD
#   endif /*NOLOCK*/

exit


ph1=1 3 3 1 2 0 0 2
ph2=2 0 2 0 3 1 3 1
ph3=3 1 1 3 0 2 2 0
ph4=0 2 0 2 1 3 1 3
ph5=0
ph6=1
ph29=0
ph31=0 2 0 2 1 3 1 3


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl10: f1 channel - power level for search spectrum
;pl14: f2 channel - power level for low power decoupling
;sp1: f1 channel - shaped pulse powerlevel for 90 degree pulse 
;sp7: f1 channel - shaped pulse
;sp8: f1 channel - shaped pulse
;sp9: f1 channel - shaped pulse
;sp10:f1 channel - shaped pulse
;p0 : f1 channel -  low-flip angle observe pulse of 
;        for solvent search experiment [2 usec]
;p1 : f1 channel -  90 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [2 msec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d13: short delay                                    [4 usec]
;d16: delay for homospoil/gradient recovery          [2 msec]
;d30: delay for processing                           [600 msec]
;d31: variable relaxtion delay                       [d12 or d1]
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;ns: 4 * n
;ds: 16
;td1: number of increments along the chromatographic time axis
;        (number of experiments)


;use gradient ratio:	gp21 : gp22 : gp23 : gp24
;                         80 :   40 :   20 :   10

;for z-only gradients:
;gpz21: 80%
;gpz22: 40%
;gpz23: 20%
;gpz24: 10%

;use gradient files:   
;gpnam21: SMSQ10.100
;gpnam22: SMSQ10.100
;gpnam23: SMSQ10.100
;gpnam24: SMSQ10.100


;use power levels               sp7        sp8        sp9        sp10
;                       sp1     +0.87      -1.04      +2.27      -5.05


                                          ;preprocessor-flags-start
;DOPREP:       Start experiment with option -DOPREP (eda: ZGOPTNS)
;              Write single scan experiment in 2nd dataset for solvent search
;              Perform stop_calc/resume_calc to allow update of SP7..SP10
;              Attention, does not allow usage of GS or RGA.
;              Automatically set by AU program
;NOLOCK:       Start experiment with option -NOLOCK (eda: ZGOPTNS)
;              Performs UN/BLANKGRAMP instead of UN/BLANKGRAD
;              Allows to run experiment without lock
                                          ;preprocessor-flags-end



