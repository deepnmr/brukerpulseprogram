;c_hcaco_ctiare.2
;avance-version (21/09/15)
;(H)CaCO
;2D sequence with
;   13C detected correlation for triple resonance using
;      multiple inept transfer steps
;
;      F2(Ha) -> F1(Ca,t1) -> F1(C=O,t2)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using constant time in t1
;relaxation optimised (H-flip)
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;W. Bermel, I. Bertini, I.C. Felli & R. Pierattelli,
;   J. Am. Chem. Soc. 131, 15340-5 (2009)
;(W. Bermel, I. Bertini, V. Csizmok, I. C. Felli, R. Pierattelli &
;   P. Tompa, J. Magn. Reson. 198, 275-281 (2009) )
;(L. Duma, S. Hediger, A. Lesage & L. Emsley,
;   J. Magn. Reson. 164, 187-195 (2003) )
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"d11=30m"
"d12=20u"

"d3=1.1m"
"d4=1.8m"
"d22=4.5m"
"d27=13.3m"


"d0=3u"
"d20=d27-p12-4u"

"in0=inf1/2"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"DELTA2=p4+p23-p11"
"DELTA3=d3-p4/2"
"DELTA4=d3+p4/2"
"DELTA5=d22-d0-p3-p4"
"DELTA6=d27-d22-p12"


"l0=1"


"spoffs21=0"
"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst21-cnst22)/1000000)"
"spoffs27=bf1*((cnst22-cnst21)/1000000)"
"spoffs29=bf1*((cnst23-cnst22)/1000000)"


"o1_F1=bf1*cnst22/1000000"


1 ze
  d11 pl16:f3
2 d11 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl2:f2 cpd3:f3
  50u UNBLKGRAD

  (p3 ph1):f2
  d4 
  (center (p12:sp24 ph1) (p4 ph1):f2 )
  d4
  (p3 ph2):f2

  DELTA2

  (p11:sp23 ph1)
  DELTA3
  (p4 ph2):f2
  (p23:sp21 ph1)
  DELTA4

  (p3 ph8):f2
  d0
  (p4 ph1):f2
  DELTA5
  (p12:sp26 ph7)
  DELTA6
  (p12:sp29 ph1)
  d20
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph4)

  p16:gp1
  d16 fq=cnst21(bf ppm):f1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph5)
     4u
     (p12:sp27 ph1)
     d22
     (p12:sp24 ph1)
     4u
     (p12:sp27 ph1)
     d22 BLKGRAD
     }
  else
     {
     (p11:sp23 ph6)
     4u
     d22*0.5
     (p12:sp27 ph1)
     d22*0.5
     (p12:sp24 ph1)
     4u
     d22*0.5
     (p12:sp27 ph1)
     d22*0.5 BLKGRAD
     }

  go=2 ph31
  d11 do:f3 mc #0 to 2 
     F1I(iu0, 2)
     F1PH(calph(ph4, +90), caldel(d0, +in0) & caldel(d20, -in20))
exit


ph1=0
ph2=1
ph4=0 2
ph5=0 0 2 2
ph6=3 3 1 1
ph7=0 0 0 0 2 2 2 2
ph8=2
ph31=0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp21: f1 channel - shaped pulse 180 degree  (Ca on resonance, med. selectivity)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp29: f1 channel - shaped pulse 180 degree  (Cali off resonance)
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p23: f1 channel - 180 degree shaped pulse (Ca, sp21, med. selectivity)
;d0 : incremented delay (F1 in 2D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [1.1 msec]
;d4 : 1/(4J(HCa))                                      [1.8 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 2D) = d27-p12-4u
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d27: 1/(2J(CaCb)                                      [13.3 msec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;in0: 1/(2 * SW(Ca)) = DW(Ca)
;nd0: 2
;in20: = in0
;ns: 8 * n
;ds: >= 32
;td1: number of experiments in F1 * 2
;FnMODE: States-TPPI (or TPPI) in F1
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%

;use gradient files:
;gpnam1: SMSQ10.100



;use AU-program splitcomb [ipap 2] to process data



;$Id: $
