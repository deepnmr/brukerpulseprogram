;hsqcetf3gp_bshd
;avance-version (21/09/15)
;HSQC
;2D H-1/X correlation via double inept transfer
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;with decoupling during acquisition
;using trim pulses in inept transfer
;using f3 - channel
;with bandselective homodecoupling
;
;L. Castanar, P. Nolis A. Virgili & T. Parella, 
;   Chem. Eur. J. 19, 17283-17286 (2013)
;J. Ying, J. Roche & A. Bax, J. Magn. Reson. 241, 97-102 (2014)
;Davis et al., J. Magn. Reson. 98, 207 - (1992)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>
#include <De.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=1s/(cnst4*4)"

"p29=300u"


"d0=3u"

"in0=inf1/2"


"DELTA1=d26-p16-d16-de+p1*2/PI-8u"

#   ifdef LABEL_CN
"DELTA=p16+d16+larger(p2,p8)+d0*2"
#   else
"DELTA=p16+d16+p2+d0*2"
#   endif /*LABEL_CN*/


"d62=aq/(l0*2)"
"d63=d62/2"


#   ifdef CALC_SPOFFS
"spoffs35=bf1*(cnst53/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/


"acqt0=0"
baseopt_echo


1 ze
  d11 pl16:f3
2 d11 do:f3
  4u BLKGRAD
  4u pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  4u pl1:f1
  50u UNBLKGRAD

  (p1 ph1)
  d26 pl3:f3
  (center (p2 ph1) (p22 ph6):f3 )
  d26 UNBLKGRAD

#   ifdef TRIMP
  p28 ph1
#   endif /* TRIMP */

  (p1 ph2) 

  4u
  p16:gp5
  d16

  (p21 ph3):f3
  d0 

#   ifdef LABEL_CN
  (center (p2 ph5) (p8:sp13 ph1):f2 )
#   else
  (p2 ph5)
#   endif /*LABEL_CN*/

  d0
  p16:gp1*EA
  d16
  (p22 ph4):f3
  DELTA
  (ralign (p1 ph1) (p21 ph4):f3 )
  d26
  (center (p2 ph1) (p22 ph1):f3 )
  4u
  p16:gp2
  d16
  DELTA1 pl16:f3
  4u cpd3:f3

  ACQ_START(ph30,ph31)
  0.1u START_NEXT_SCAN

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d63
  0.05u DWELL_HOLD
  0.1u REC_BLK
   
4 10u do:f3
  p29:gp3
  d16 pl1:f1
  (p2 ph7):f1
  p29:gp3
  d16 
  10u

  p29:gp4
  d16
  5u
  (p51:sp35 ph8):f1
  5u
  p29:gp4
  d16 cpd3:f3

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK

  10u do:f3
  p29:gp3
  d16 pl1:f1
  (p2 ph7):f1
  p29:gp3
  d16 
  10u
 
  p29:gp4
  d16
  5u
  (p51:sp35 ph8):f1
  5u
  p29:gp4
  d16 cpd3:f3

  0.1u REC_UNBLK
  0.05u DWELL_RELEASE
  d62
  0.05u DWELL_HOLD
  0.1u REC_BLK

  lo to 4 times l0

  d62

  rcyc=2
  d11 do:f3 mc #0 to 2 
     F1EA(calgrad(EA), caldel(d0, +in0) & calph(ph3, +180) & calph(ph6, +180) & calph(ph31, +180))
exit


ph1=0 
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0
ph7=0 0 2 2
ph8=2 2 0 0
ph29=0
ph30=0
ph31=0 2 0 2 2 0 2 0
  

;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;pl32: f1 channel - power level for low power presaturation
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;sp35: f1 channel - shaped pulse 180 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8: f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p16: homospoil/gradient pulse                            [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p28: f1 channel - trim pulse                             [1 msec]
;p29: gradient pulse 3                                    [300 usec]
;p51: f1 channel - 180 degree shaped pulse                [20-80ms]
;d0 : incremented delay (2D)                              [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                                  [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J(YH))
;d62: length of block between decoupling pulses : = aq/l0 [< 20-25 msec]
;d63: = d62/2
;cnst4: = J(YH)
;cnst53: chemical shift for selective pulse (offset, in ppm)
;l0 : number of blocks during acquisition time
;        adjust to get d62 as required
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;ns: 1 * n
;ds: >= 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 20.1% for C-13, 8.1% for N-15
;gpz3: 7%
;gpz4: 5%
;gpz5: 30%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam3: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;set pl32 to 0W when presaturation is not required
;   use pl1 + 75 to 80dB to reduce radiation damping



