;hmbcacgplpndqf
;avance-version (12/01/11)
;CIGAR HMBC
;2D H-1/X correlation via heteronuclear zero and double quantum
;   coherence 
;optimized for long range couplings using accordion
;with two-fold low-pass J-filter to suppress one-bond correlations
;no decoupling during acquisition
;   to avoid losses due to T2 relaxation
;using gradient pulses for selection
;using shaped pulses for inversion on f2 - channel
;
;C.E. Hadden, G.E. Martin & V.V. Krishnamurthy, Magn. Reson. Chem. 38,
;   143-147 (2000)
;C.E. Hadden, G.E. Martin & V.V. Krishnamurthy, J. Magn. Reson. 140,
;   274-280 (1999)
;R. Wagner & S. Berger, Magn. Reson. Chem. 36, S44-S46 (1998)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"d11=30m"
"d13=4u"
"d28=3u"


"in0=inf1/2"

"FACTOR1=( (1s/(cnst14*2)) - (1s/(cnst15*2)) ) * 10000000 / td1"
"in6=FACTOR1/10000000"

"in28=in6/4 + (cnst16-1)*in0/2"

"d0=3u"
"d6=1s/(cnst14*2)"


"DELTA1=1s/(2 * (cnst6 + 0.146 * (cnst7-cnst6)) ) -p16-d16"
"DELTA2=1s/(2 * (cnst7 - 0.146 * (cnst7-cnst6)) ) -p16-d16"


1 ze
2 d11
3 50u UNBLKGRAD
  p16:gp4
  d16
  p1 ph1
  p16:gp4
  d16
  d1 BLKGRAD

  p1 ph1
  DELTA1 UNBLKGRAD
  p16:gp5
  d16
  p3:f2 ph3
  DELTA2
  p16:gp6
  d16
  p3:f2 ph3
  d13
  p16:gp7
  d16

  d28
  p2 ph1
  d28

  p16:gp8
  d16 pl0:f2
  (p14:sp3 ph1):f2
  d13
  p16:gp9
  d16 pl2:f2

  d28
  p2 ph6
  d28
  p16:gp10
  d16

  d6*0.5
  d13
  p16:gp11
  d16 pl0:f2
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  d13
  p16:gp11
  d16 pl2:f2
  d6*0.5

  p3:f2 ph4
  d0
  d13
  p16:gp1
  d16
  p2 ph2
  d13
  p16:gp2
  d16
  d0
  p3:f2 ph5

  d13
  p16:gp3
  d16
  go=2 ph31
  d11 mc #0 to 2 F1QF(caldel(d0, +in0) & caldel(d6, -in6) & caldel(d28, +in28))
  d11 BLKGRAD
  exit


  ph1=0
  ph2=0 0 0 0 2 2 2 2
  ph3=0 0 2 2
  ph4=0 2
  ph5=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
  ph6=2
  ph31=0 2 0 2 0 2 0 2 2 0 2 0 2 0 2 0


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;sp3: f2 channel - shaped pulse 180 degree
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;p16: homospoil/gradient pulse
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d6 : delay for evolution of long range couplings (d6max, 1/2Jlr)
;d11: delay for disk I/O                             [30 msec]
;d13: short delay                                    [4 usec]
;d16: delay for homospoil/gradient recovery
;d28: incremented delay                              [3 usec]
;cnst6: = J(XH)min
;cnst7: = J(XH)max
;cnst14: = J(XH) long range (min)
;cnst15: = J(XH) long range (max)
;cnst16: = J(scale) factor
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(2 * SW(X)) = DW(X)
;nd0: 2
;in6: (d6max - d6min)/td1                            [200msec-20msec]
;in28: = in6/4 + k*in0/2, k=J(scale) - 1
;in30: = in6
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: QF


;use gradient ratio:
;    gp 1:gp 2:gp 3:gp 4:gp 5:gp 6:gp 7:gp 8:gp 9:gp 10:gp 11
;      50:  30:40.1:   5:  60: -40: -13:  18: -20:   -9:   17   for C-13

;for z-only gradients:
;gpz1: 50%     for C-13
;gpz2: 30%
;gpz3: 40.1%   for C-13
;gpz4: 5%
;gpz5: 60%
;gpz6: -40%
;gpz7: -13%
;gpz8: 18%
;gpz9: -20%
;gpz10: -9%
;gpz11: 17%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.100
;gpnam7: SMSQ10.100
;gpnam8: SMSQ10.100
;gpnam9: SMSQ10.100
;gpnam10: SMSQ10.100
;gpnam11: SMSQ10.100



