;trtretf3gpsitc3d.3
;avance-version (21/09/15)
;3D H-1/X correlation via TROSY and inept transfer
;   using sensitivity improvement
;for measuring N-15 T1rho relaxation times
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using f3 - channel
;using H-1 180o pulses rather than cpd decoupling
;using flip-back pulse
;as pseudo3D
;with temperature compensation
;(use parameterset TRTRETF3GPSITC3D.3)

; This pulse sequence performs a TROSY 15N T1rho relaxation experiment.

; Relaxation delay lengths (i.e. 15N spinlock durations) are given via a vdlist.
; The 15N spinlock is performed at power level pl25, flanked by Gaussian ramps using 
; the same power level. cnst27 shows the nutation frequency in Hz that corresponds to
; the chosen spinlock power level pl25.

; Via cnst28, the desired tilt angle of the 15N T1rho spinlock (between the spinlock
; axis and the z axis, relative to the 15N carrier position SFO3) can be set 
; (in degrees; default is 45 degrees). cnst30 is the resultant offset of the 15N 
; carrier during the spinlock (in Hz, relative to SFO3). 
; Note that the effective field experienced by the spins will be different from cnst27
; depending on their offset from the spinlock carrier position SFO3+cnst30.

; To ensure equal RF heating in all experiments, a heat compensation element is 
; included before the recycle delay d1. Its duration (p52) is calculated as the
; difference between current and maximum spinlock durations.

;N.-A. Lakomek, J. Ying & A. Bax, J. Biomol. NMR 53, 209-221 (2013)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple2>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<delay> vd_list=<$VDLIST>

define delay vd_max


"p0=p1*7/3"
"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d26=2.65m"

"d31=0"

"cnst29=0"
"cnst31=50000"

"p25=0"
"p52=0"

"p19=500u"
"p29=250u"


"d10=3u"

"in10=inf2/2"


"DELTA3=d26-p11-p16-d16-4u"
"DELTA4=d26-p19-d16-p29/2-d16/2-2u"
"DELTA5=p29+d16+4u+de-p1*2/PI"

#   ifdef LABEL_CN
"DELTA1=d16+d10*2+p8-p21*4/PI+p1"
"DELTA2=d16"
#   else
"DELTA1=d16"
"DELTA2=d16+p21*4/PI-d10*2-p1"
#   endif /*LABEL_CN*/


"l0=1"
"l3=td1"
"l11=0"

"if (plw25 > 0) { cnst27=1s/(sqrt(plw3/plw25)*p21*4); } else {cnst27 = 0; }"
"cnst30=abs(cnst27/tan((cnst28*2*PI)/360.0))"


"spoffs13=0"
"spoffs19=0"
"spoffs20=0"


aqseq 312


"acqt0=0"
baseopt_echo


1 ze 

9 20u
  if "vd_list > vd_max"
       {
       20u
       "vd_max = vd_list"
       }

  3m vd_list.inc
  lo to 9 times l3

  3m vd_list.res


2 d11
  (p21 ph1):f3

  20u
  "d31=vd_list[l11]"
  20u
  "p25=d31"
  20u
  "DELTA6=(d31/2-p1*2-p0)"
  20u
  "p52=vd_max-d31"
  20u
  "DELTA=d1-d31"

  20u
#   ifdef LABEL_CN
  "TAU1=d31/4-p8/2-p1-p0/2-2u"
  "TAU2=p8"
#   else
  "TAU1=d31/4-p1-p0/2-2u"
#   endif /*LABEL_CN*/

  if "d31 < vd_max"
     {
     20u fq=cnst31(sfo hz):f3
     4u pl25:f3
     (p52 ph1):f3
     4u
     20u fq=cnst29(sfo hz):f3
     }

3 DELTA pl1:f1 pl3:f3
  50u UNBLKGRAD
  (p21 ph1):f3
  4u
  p16:gp0
  d16

  (p1 ph1)
  d26 gron1
  2u groff
  (center (p2 ph1) (p22 ph1):f3 )
  d26 gron1
  2u groff
  (lalign (p1 ph2) (p21 ph1):f3 )
  d26 gron2
  2u groff
  (center (p2 ph1) (p22 ph1):f3 )
  d26 gron2
  2u groff
  (ralign (p1 ph3) (p21 ph4):f3 )
  4u
  p29:gp3
  d16 fq=cnst30(sfo hz):f3
  2u pl25:f3
  
#   ifdef LABEL_CN

  (p39:sp19(currentpower) ph1):f3
  (center (p1 ph1 p0 ph2 p1 ph1 DELTA6 p1 ph1 p0 ph2 p1 ph1):f1 (p25 ph1):f3 (p8:sp13 ph1):f2 (TAU1 gron8 2u groff TAU2 TAU1 gron8*-1 2u groff))
  (p39:sp20(currentpower) ph1):f3

#   else

  (p39:sp19(currentpower) ph1):f3
  (center (p1 ph1 p0 ph2 p1 ph1 DELTA6 p1 ph1 p0 ph2 p1 ph1):f1 (p25 ph1):f3 (2u TAU1 gron8 TAU1 gron8*-1 2u groff))
  (p39:sp20(currentpower) ph1):f3

#   endif /*LABEL_CN*/

  p19:gp9
  d16 fq=cnst29(sfo hz):f3
  2u pl3:f3

  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     2u
     p19:gp4*EA*-1
     DELTA1
     (p22 ph5):f3
     2u
     p19:gp4*EA
     DELTA2 pl1:f1
     }
  else
     {
     (p21 ph6):f3
     2u
     p19:gp4*EA*-1
     DELTA1
     (p22 ph6):f3
     2u
     p19:gp4*EA
     DELTA2 pl1:f1
     }

#   ifdef LABEL_CN
  d10
  (p8:sp13 ph1):f2
  d10
#   else
  d10
  d10
#   endif /*LABEL_CN*/

  (p1 ph7)
  4u
  (p11:sp1 ph9):f1
  p16:gp5
  d16
  DELTA3 pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp5
  d16
  (p11:sp1 ph1):f1
  2u
  2u pl1:f1
  (p1 ph1) 
  (p21 ph7):f3

  4u
  p19:gp6
  d16
  (center (DELTA5 p11:sp1 ph8:r 2u 2u pl1 p2 ph1 4u p11:sp1 ph8:r):f1 (DELTA4 p22 ph1 DELTA4):f3 )
  4u
  p19:gp6
  d16
  (p21 ph1):f3
  p29:gp7
  d16
  4u BLKGRAD

  go=2 ph31
  d11 mc #0 to 2
     F1QF(calclc(l11, 1))
     F2EA(calgrad(EA) & calph(ph7, +180) & calph(ph9, +180) & calclc(l0, 1), caldel(d10, +in10) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))
exit 
  

ph1=0
ph2=1
ph3=2
ph4=1 1 1 1 3 3 3 3
ph5=1 0 3 2
ph6=1 2 3 0
ph7=1
ph8=2
ph9=3
ph31=1 2 3 0 3 0 1 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl25: f3 channel - power level for spinlock
;sp1 : f1 channel - shaped pulse 180 degree
;sp8 : f2 channel - shaped pulse 180 degree (adiabatic)
;sp19: f3 channel - shaped pulse for adiabatic ramp down (lowfield, positive offset)
;spnam19: Gaussramp+down.1
;sp20: f3 channel - shaped pulse for adiabatic ramp up (lowfield, positive offset)
;spnam20: Gaussramp+up.1
;p0 : f1 channel - 210 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                               [1 msec]
;p19: gradient pulse 2                                       [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                               [250 usec]
;p39: f3 channel - shaped pulse for adiabatic ramp           [3 msec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay                                      [3 usec]
;d11: delay for disk I/O                                     [30 msec]
;d16: delay for homospoil/gradient recovery
;d26 : 1/(4J)YH                                              [2.65 msec]
;cnst4: = J(YH)
;cnst27: used RF field strength (gammaB1) for T1rho spinlock at pl25
;cnst28: requested tilt angle for T1rho spinlock
;           (between axis of spinlock and z-axis)            [45 degree]
;cnst29: N on-resonance frequency (in Hz, relative to sfo)    [0] 
;cnst30: T1rho spinlock offset (in Hz, relative to sfo)
;cnst31: N off-resonance frequency (in Hz, relative to sfo)   [50000]
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 16
;td1: number of delays in vd-list
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz0: 23%
;gpz1: 0.5%
;gpz2: 0.3%
;gpz3: 55%
;gpz4: 40%
;gpz5: 11%
;gpz6: 47%
;gpz7: 16.2%
;gpz8: 0.4%
;gpz9: -37%


;use gradient files:
;gpnam0: SMSQ10.100
;gpnam3: SMSQ10.50
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.32
;gpnam9: SMSQ10.100


                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id: $
