;trhncot2f3gp
;avance-version (21/09/15)
;TROSY-HNCO-T2
;3D sequence with
;   inverse correlation for triple resonance
;      via TROSY and inept transfer steps
;
;      F1(H) -> F3(N:T2) -> F2(C=O,t1) -> F3(N,t2) -> F1(H,t3)
;
;for measuring N-15 T2 relaxation times
;on/off resonance Ca and C=O pulses using shaped pulse
;phase sensitive (t1)
;phase sensitive using Echo/Antiecho (t2)
;using constant time in t2
;(use parameterset )
;
;(M. Salzmann, K. Pervushin, G. Wider, H. Senn & K. Wuethrich, Proc.
;   Natl. Acad. Sci. USA 95, 13585-13590 (1998))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d23=12m"
"d25=2.75m"
"d26=2.3m"
"d28=450u"


"d0=3u"
"d10=3u"
"d30=d23-p11-8u-p1"

"in0=inf1/2"
"in10=inf2/2"

"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA=d0*2+larger(p14,p22)-p14"
"DELTA1=d26-p11-p16-d16-8u"
"DELTA2=d28-p2/2"
"DELTA3=d23-d10-p14-p21*4/3.1416"
"DELTA4=d26-p16-d16"


"COUNTER=l5*4"

"l4=d20/(p30*16+d28*32)"
"d31=(p30*16+d28*32)*l4"


"l0=1"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*(cnst22/1000000)-o2"
"spoffs8=0"


aqseq 321


1 d11 ze
2 d11
3 d12 pl1:f1 pl23:f3

4 d28
  (p30 ph1 d28*2 p30 ph1 d28*2 p30 ph1 d28*2 p30 ph1):f3
  d28
  lo to 4 times COUNTER

  d1
  50u UNBLKGRAD

  p1 ph1
  4u pl0:f1
  (p11:sp1 ph3:r):f1
  4u
  p16:gp1
  d16 pl1:f1
  DELTA1
  (center (p2 ph2) (p22 ph1):f3 )
  DELTA1
  p16:gp1
  d16 pl0:f1
  (p11:sp1 ph2:r):f1
  4u
  4u pl1:f1
  (p1 ph4):f1 

  (p21 ph1):f3
  4u
  d25
  (center (p2 ph1) (p22 ph9):f3 )
  d25 pl23:f3

5 d28
  (p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9):f3
  DELTA2
  (p2 ph1)
  DELTA2
  (p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9):f3
  d28*2
  (p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9):f3
  DELTA2
  (p2 ph3)
  DELTA2
  (p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9 d28*2 p30 ph9):f3
  d28
  lo to 5 times l4

  4u pl3:f3
  (p21 ph2):f3

  p16:gp4
  d16

  (p21 ph1):f3
  d23
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d23
  (p21 ph2):f3

  (p13:sp2 ph5):f2
  d0
  (center (p14:sp5 ph1):f2 (p22 ph1):f3 )
  d0
  4u
  (p14:sp3 ph1):f2
  DELTA
  (p14:sp5 ph1):f2
  4u
  (p13:sp8 ph1):f2

  if "l0 %2 == 1"
     {
     (p21 ph6):f3
     }
  else
     {
     (p21 ph7):f3
     }

  d10
  (p14:sp5 ph1):f2
  DELTA3
  (center (p14:sp3 ph1):f2 (p22 ph1):f3 )
  d30 pl0:f1
  (p11:sp1 ph1:r):f1
  4u
  4u pl1:f1

  (p1 ph8)
  p16:gp2
  d16
  DELTA4
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA4
  p16:gp2
  d16
  (center (p1 ph1) (p21 ph8):f3 )
  p16:gp3
  d16
  DELTA1 pl0:f1
  (p11:sp1 ph3:r):f1
  4u
  4u pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  4u pl0:f1
  (p11:sp1 ph3:r):f1
  DELTA1
  p16:gp3
  d16 pl1:f1
  4u BLKGRAD
  (p21 ph1):f3
  go=2 ph31
  d11 mc #0 to 2 
     F1PH(calph(ph5, +90), caldel(d0, +in0))
     F2EA(calph(ph8, +180) & calclc(l0, 1), caldel(d10, +in10) & caldel(d30, -in30) & calph(ph6, +180) & calph(ph7, +180) & calph(ph31, +180))
  d31
exit


ph1=0
ph2=1 
ph3=2
ph4=3
ph5=0 0 0 0 2 2 2 2
ph6=2 0 1 3
ph7=2 0 3 1
ph8=3
ph9=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=1 3 2 0 3 1 0 2


;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl23: f3 channel - power level for CPMG-spinlock
;sp1: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp2: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (C=O on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (Ca off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (C=O on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse             [1 msec]
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: f3 channel - 180 degree pulse at pl23
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: wanted T2 delay
;d23: 1/(4J(NCO)                                       [12 msec]
;d25: 1/(4J(NH)                                        [2.75 msec]
;d26: 1/(4J'(NH)                                       [2.3 msec]
;d28: echo delay                                       [450 usec]
;d30: decremented delay (F2 in 3D) = d23-p11-8u-p1
;d31: T2 delay as executed
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;o2p: CO chemical shift (cnst21)
;l4: loop for T2 delay
;l5: loop for compensation of heating effects = l4(max) - l4(current)
;inf1: 1/SW(CO) = 2 * DW(CO)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(2 * SW(CO)) =  DW(CO)
;nd0: 2
;in10: 1/(2 * SW(N)) = DW(N)
;nd10: 2
;in30: = in10
;ns: 8 * n
;ds: >= 16
;td1: number of experiments in F1
;td2: number of experiments in F2       td2 max = 2 * d30 / in30
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4
;                         30 :   18 :   44 :  -21

;for z-only gradients:
;gpz1: 30%
;gpz2: 18%
;gpz3: 44%
;gpz4: -21%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



