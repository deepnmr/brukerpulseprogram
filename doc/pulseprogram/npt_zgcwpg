;$Id:$
;1D sequence with power-gated CW decoupling
; created 22aug08, pgs
;$CLASS=HighRes HWT
;$DIM=1D
;$HIDE=y

#include <Avance.incl>

"d12=20u"
"d11=30m"

"acqt0=-p1*2/3.1416"

1 ze
  d11 pl28:f2
  d11 cw:f2
2 30m
  d1
  d12 do:f2
  d12 pl26:f2
  d11 cw:f2
  p1 ph1
  go=2 ph31
  30m mc #0 to 2 F0(zd)
  d11 do:f2
exit

ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl26: f2 channel - power level for cw decoupling during aq
;pl28: f2 channel - power level for cw decoupling during d1
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;NS: 1 * n, total number of scans: NS * TD0
