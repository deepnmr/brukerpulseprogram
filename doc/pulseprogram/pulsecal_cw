;pulsecal_cw
;avance-version (17/07/24)
;for single scan pulse calibration
;with f2 cw-decoupling for solids
;
;P.S.C.Wu & G. Otting, J. Magn. Reson. 176, 115-119 (2005)
;
;$CLASS=HighRes HWT
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=
;$HIDE=y

prosol relations=<solids_ICON_QN>

"plw17=plw0*pow((4*p0/(1000)),2)"



#include <Avance.incl>
#include <De.incl>


define delay dwdel1
define delay dwdel2
define delay dwdel3
define delay dwdel4
define delay dwdel5

define pulse dwpul

define loopcounter tdcount


"d12=20u"


"dwdel1=1u"
"dwdel2=5u"
"dwdel5=0.25u"
"dwpul=dw*2*cnst31/100"

"dwdel3=larger(de1,depa)+dwdel5"
"dwdel4=dw*2-dwpul-dwdel1-dwdel2-dwdel3"


"tdcount = td/2+2"


1 ze

  d12 pl29:f1 pl17:f2
  1u cw:f2

2 d1

  ACQ_START(ph30,ph31)

  0.1u REC_UNBLK
  0.1u START_NEXT_SCAN
  	
4 dwdel1 REC_BLK
  dwdel2
  (dwpul ph1):f1
  dwdel3
  dwdel4 REC_UNBLK
  lo to 4 times tdcount

  dwdel1 REC_BLK

  rcyc=2

  4u do:f2
  wr #0

exit


ph1=0
ph30=0
ph31=0 


;pl1 : f1 channel - power level for pulse (default)
;pl17: f2 channel - power level for cw decoupling (solids)
;         set pl17 to 1/4 of the MAS rate
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;NS: 1 * n, total number of scans: NS * TD0



