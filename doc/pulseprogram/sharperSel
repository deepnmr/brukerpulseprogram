;sharperSel
;1D Sequence
;selective pulses during acquisition
;using wavemaker to create shaped pulses

; Instructions for setting receiver phase, PH30:
;   1) Record spectrum with PHC0=0 and PHC1=0
;   2) Phase the spectrum using PHC0
;   3) Set PHCOR[30]=-PHC0 and PHC0=0
;   4) Reacquire and reprocess with PHC0=0; 

;Jones A.B., Lloyd-Jones G.C. & Uhrin D., Anal. Chem., 89, 10013 (2017)
;Dickson C.L., Peat G., Rossetto M., Halse M.E. & Uhrin D., Chem. Commun., 58, 5534-5537 (2022)

;$CLASS=HighRes 
;$DIM=1D 
;$TYPE=SHARPER
;$SUBTYPE= 
;$COMMENT=Sharper experiment with selective pulses during acquisition, run wvm -q before zg or launch with xaua

#include <Avance.incl> 
#include <Grad.incl> 
#include <Delay.incl> 
#include <De.incl> 


"l0=aq/(d62*2)" 

"p2=p1*2" 
"d11=30m" 
"p29=300u" 
"d63=d62/2" 
"d12=20u" 
"d11=30m" 
"d11=30m+1s/(1+cnst52)"
"d11=30m" 
"DELTA=d1-d11-4u-50u-d12" 

"TAU1=de"
"TAU2=p1*2/PI"

"acqt0=0"
baseopt_echo

create_shape(sp36, gaus180r, name= gaus180r, bandwidth= $cnst52 Hz)  

"COUNTER=(trunc((cnst31/100)*l0))+1" 
"l31=l0+COUNTER" 

1 ze 
2 d11 

  4u BLKGRAD 
  DELTA 
  50u UNBLKGRAD 

  d12 pl1:f1 
  (p1 ph1):f1 

   p16:gp1
   d16
   TAU1
  (p36:sp36 ph4):f1 
   p16:gp1
   d16 BLKGRAD
   TAU2

ACQ_START(ph30,ph31)
  0.05u DWELL_HOLD
  0.05u START_NEXT_SCAN

  0.1u REC_UNBLK 
  0.05u DWELL_RELEASE

  d63

  0.05u DWELL_HOLD
  0.1u REC_BLK 

4 0.05m
  (p36:sp36 ph2):f1 
  0.05m

  0.1u REC_UNBLK 
  0.025u DWELL_RELEASE

  d62 

  0.05u DWELL_HOLD
  0.1u REC_BLK 
 
  0.05m
  (p36:sp36 ph3):f1 
  0.05m

  0.1u REC_UNBLK 
  0.025u DWELL_RELEASE

  d62 

  0.05u DWELL_HOLD
  0.1u REC_BLK 

  lo to 4 times l31 

  d63 

  0.1u REC_BLK
  0.05u DWELL_RELEASE 
  rcyc=2 
  30m mc #0 to 2 F0(zd) 
exit

ph1=0 
ph2=1 3 
ph3=1 3 
ph4=1 3 2 0
ph30=(360) 0 
ph31=0 0 2 2 

;pl1 : f1 channel - power level for pulse (default) 
;sp36: f1 channel - shaped pulse 180 degree (refocussing)
;SPNAM36: Gaus1_180r.1000
;p1 : f1 channel - high power pulse 
;p2 : f1 channel - 180 degree high power pulse 
;p16: homospoil/gradient pulse [1 ms]
;p36: f1 channel - 180 degree shaped, refocussing [1-80ms]
;d1 : relaxation delay; 1-5 * T1 
;d11: delay for disk I/O [30 msec] 
;d16: delay for homospoil/gradient recovery 
;d62: length of block between decoupling pulses : = aq/l0 [< 10 msec] 
;d63: = d62/2 
;cnst52: band-width of the selective 180 refocusing pulse [Hz]
;cnst31: counter
;l0 : number of blocks during acquisition time 
;ns: 2 * n, total number of scans: NS * TD0 
;ds: 8


;use gradient ratio:    gp 1
;                        13

;for z-only gradients:
;gpz1: 13% (CTP gradient)

;use gradient files:
;gpnam1: SMSQ10.100

;run with XAUA or excecute wvm -a before zg
