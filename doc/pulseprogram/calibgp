;calibgp
;avance-version (12/01/11)
;calibration of gradient strength
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <De.incl>


define delay GR_LEN


"p2=p1*2"
"d11=30m"
"d12=20u"


"GR_LEN=aq*0.5"


1 ze
2 30m
  20u BLKGRAD
  d1
  50u UNBLKGRAD
  p1 ph1
  GR_LEN gron1
  d16 groff
  p2 ph2
  50u
  d16
  d21 gron1
  ACQ_START(ph30,ph31)
  aq DWELL_GEN:f1
  d12 groff
  rcyc=2
  30m mc #0 to 2 F0(zd)
  d11 BLKGRAD
exit


ph1=0
ph2=1 3
ph30=0
ph31=0


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p16: homospoil/gradient pulse : ca. aq/2
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;d21: gradient stabilisation delay                   [100 usec]
;ns: 2 * n, total number of scans: NS * TD0

;use gradient :		gp 1 

;this program can be used for dmx as well



