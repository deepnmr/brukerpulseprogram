;cpSARCOSY 
;
;version 2.0/ TS3  /  7/31/2011
;
;single quantum inadequate, j-evolution experiment 
;written by JOS 7/11/2004
;updated and prepared for release by JOS 7/31/2011
;
;Reference:
;D. Lee, J. Struppe, D.W. Elliott, L.J. Mueller, J.J. Titman, 
;Sensitivity absorptive scalar correlation NMR spectroscopy in solids, JCCP 11, 2009, 3547-3553
;
;Avance III version
;parameters:
;d0 : incremented delay (2D) [0 usec]
;d1 : recycle delay
;p1 : X 90 degree pulse
;p2 : X 180 degree decoupling pulse during t1 CS evolution of Y nucleus
;p3 : H 90 degree pulse
;p31 : decoupling pulse for spinal64.13
;p15 : contact time; plw3 (rf-channel f3) and spw0 (rf-channel f2)
;pl1 : rf-power contact pulse on X
;pl11 : rf-power on X for 90 and 180 degree pulses
;pl12 : rf-power for 1H pi/2 pulse p3 and standard proton decoupling during J-evolution
;pl13 : rf=power for cw decoupling on 1H during acquisition
;sp0 : rf-power for proton contact pulse, 50 -20% ramped amplitude modulation
;spnam0 : file name for variable amplitude CP
;cpdprg1 : sequence used for decoupling (spinal64.13)
;cpdprg2 : sequence used for decoupling (spinal64, tppm15, cw, etc.)
;pcpd2 : pulse length in decoupling sequence
;cnst31 : MAS spinning speed 
;NS : 32 * n                     
;l5 : rp's for J refocusing dtau1= 2.5ms for labeled, 3.5 - 5ms for natural abundance 50 -70 Hz coupling
;l7 : rp's for J refocusing dtau2= 2.5ms for labeled, 3.5 - 5ms for natural abundance
;l8 : rp's for z-filter short for natural abundance 2 - 5 ms for labeled systems
;in0 : = inf1 -> SWH in F1 = n*rotation rate
;FnMODE: States-TPPI, STATES, TPPI
;
;
;$CLASS=Solids
;$DIM=2D
;$TYPE=cross polarisation
;$SUBTYPE=homonuclear correlation
;$COMMENT=Scalar Coupling Driven DQF chemical shift correlation


prosol relations=<solids_cp>

#include <trigg.incl>

"d11=30m"
"d0=0u"

define delay dtau1
"dtau1=((1s/cnst31)*l5-2*p1)"
define delay dtau3
"dtau3=((1s/cnst31)*l7-2*p1)"
define pulse dtauz
"dtauz=((1s/cnst31)*l8-p1)"
"in0=inf1"
"acqt0=1u*cnst11"

1 ze
  
2 d11 do:f2
3 d1 do:f2 
  trigg
  10u
4 (p1 ph4):f1 (p3 pl12 ph1):f2						
  (p15 pl1 ph2):f1 (p15:sp0 ph3):f2
  dtau1	cpds2:f2  					;first  J-evolution period 
  (p1 ph5 pl11):f1
  (p1 ph5):f1
  dtau1 
  (p1 ph6):f1						;DQF
  (p1 ph9):f1
  d0 cpds1:f2						;t1 evolution
  (p1 ph11):f1						; second J-evolution period
  dtau3 cpds2:f2
  (p1 ph10):f1
  (p1 ph10):f1
  dtau3
  (p1 ph15):f1 (1u do):f2				;z-Filter
  (dtauz pl14):f2
  (p1 ph16):f1 (2u cpds1):f2				;observe pulse
  go=3 ph31 
  3m do:f2
  d11 mc #0 to 2 F1PH(calph(ph11) & calph(ph15), caldel(d0))
exit


ph1={1}*64 {3}*64
ph3=0
ph2=0 1 2 3
ph4=1 2 3 0
ph5=0 1 2 3 1 2 3 0 2 3 0 1 3 0 1 2
ph6=1 2 3 0
ph9=0  
ph10={1}*16 {2}*16 {3}*16 {0}*16
ph11=1
ph15=0   
ph16=2  
ph31= {{{{{{0 2 0 2}^2}*2}^2}*2}^2}

