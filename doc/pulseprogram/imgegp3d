;imgegp3d
;avance-version (12/01/11)
;3D Gradient Echo for gradshim-procedure
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include<Avance.incl>
#include<Grad.incl>
#include<De.incl>


"d11=30m"

"p0=2u"

"plw0=plw1/31.626"


lgrad r2d<2d> = td1
lgrad r3d<3d> = td2


aqseq 321


1 ze
  d11 UNBLKGRAD			
2 5m
3 10m
  d1 pl0:f1
  p0:f1 ph1
  5u              grad{ (0)+r3d(5.057) | (0)+r2d(5.057) | (3.112)  }
  d27
  5u              grad{ (0)            | (0)            | (0)      }
  d15
  5u              grad{ (0)            | (0)            | (-6.739) }
  d21
  ACQ_START(ph30,ph31)
  aq DWELL_GEN:f1
  5u              grad{ (0)            | (0)            | (0)      }
  rcyc=2
  5m st igrad r2d
  lo to 2 times td1
  5m zgrad r2d 
  5m igrad r3d
  lo to 3 times td2
  400m wr #0 if #0
  d11 BLKGRAD
exit


ph1=0
ph30=0
ph31=0


;pl0: f1 channel : pl1+15dB
;pl1 : f1 channel - power level for pulse (default)
;p0 : f1 channel -  small flip angle                 [2 usec]
;d1 : relaxation delay
;d11: delay for disk I/O                             [30 msec]
;d15: echo time
;d21: gradient stabilisation delay
;d27: length of dephasing gradient (phase encode time)
;ns: 1
;ds: 0
;NBL: = l1



;$Id:$
