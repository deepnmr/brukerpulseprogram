;n_hcan3d
;avance-version (21/09/15)
;3D sequence with
;   15N detected correlation for triple resonance using
;      inept transfer steps
;
;      F3(Ha,t1) -> F2(Ca,t2) -> F1(N,t3)
;
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;phase sensitive (t2)
;using semi-constant time in t1
;using constant time in t1
;(use parameterset )
;
;(M. Gal, K. A. Edmonds, A. G. Milbradt, K. Takeuchi & G. Wagner,
;   J Biomol NMR 51, 497-504 (2011))
;(K. Takeuchi, G. Heffron, Z.-Y. J. Sun, D. P. Frueh & G. Wagner,
;   J Biomol NMR 47, 271-282 (2010))
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p22=p21*2"
"d3=1s/(cnst2*cnst12)"
"d4=1s/(cnst2*4)"
"d11=30m"
"d12=20u"

"d23=11.3m"
"d27=14.3m"


"d20=3u"
"d0=d4"
"d10=d27/2-d3-p21"
"d28=d4+p14+d20"
"d29=d23-d27/2-p14/2-p1"
"d30=d27/2-larger(p14,p22)/2"

"in0=inf1/2"
"in10=inf2/4"

"FACTOR1=d28*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in0 ) { in20 = 0; } else { in20=in0-INCR1; }"
"if ( INCR1 > in0 ) { in28 = in0; } else { in28 = INCR1; }"

"in29=in10"
"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA1=d27-d23-p1"
"DELTA2=d3-p14/2-p21"
"DELTA3=d23/2-p14/2"
"DELTA4=d23/2-p14/2-d12-4u+p1*2/PI-de"


"spoffs2=0"
"spoffs3=0"
"spoffs5=bf2*((cnst21-cnst22)/1000000)"
"spoffs8=0"


"cnst24=cnst21/2+cnst22/2"


"o1_F2=bf2*cnst22/1000000"


"acqt0=0"
baseopt_echo


aqseq 321


1 ze
  d11 pl16:f3
2 d11 do:f2 do:f3
3 d11
  d1 pl1:f1 pl3:f3
  50u UNBLKGRAD
  (p1 ph1):f1
  p16:gp1
  d16 fq=cnst22(bf ppm):f2

  (p21 ph5):f3
  d0
  (p14:sp3 ph1):f2
  d20
  (p22 ph1):f3
  d28
  (p21 ph2):f3

  (p13:sp2 ph3):f2
  d30
  (center (p14:sp5 ph1):f2 (p22 ph1):f3)
  d30
  (p14:sp3 ph1):f2
  DELTA1
  (p2 ph1):f1
  d29
  (p14:sp5 ph1):f2
  DELTA2
  (p22 ph1):f3
  d10
  (p13:sp8 ph4):f2

  4u do:f2
  p16:gp2
  d16

  (p1 ph1):f1
  DELTA3
  (p14:sp5 ph1):f2
  DELTA3
  (center (p2 ph6):f1 (p14:sp3 ph1):f2)
  DELTA3
  (p14:sp5 ph1):f2
  DELTA4 fq=cnst24(bf ppm):f2
  d12 pl12:f2 pl16:f3
  4u BLKGRAD

  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2
     F1PH(calph(ph5, +90), caldel(d0, +in0) & caldel(d20, +in20) & caldel(d28, -in28))
     F2PH(calph(ph3, -90), caldel(d10, +in10) & caldel(d29, +in29) & caldel(d30, -in30))
  d11 do:f2 do:f3
exit


ph1=0
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=0 0 2 2
ph6=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph31=0 2 2 0 2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp2: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;sp3: f2 channel - shaped pulse 180 degree  (Ca on resonance)
;sp5: f2 channel - shaped pulse 180 degree  (C=O off resonance)
;sp8: f2 channel - shaped pulse  90 degree  (Ca on resonance)
;                  for time reversed pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p13: f2 channel -  90 degree shaped pulse
;p14: f2 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (F1 in 3D) = d4
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(n*J(CH)), n = cnst12
;d4 : 1/(4J(CH))
;d10: incremented delay (F2 in 3D) = d27/2-d3-p21
;d11: delay for disk I/O [30 msec]
;d12: delay for power switching [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 2D)                     [3 usec]
;d23: 1/(4J(CaN))                                      [11.3 msec]
;d27: 1/(2J(CaCb))                                     [14.3 msec]
;d28: decremented delay (F1 in 3D) = d4+p14+d20
;d29: decremented delay (F2 in 3D) = d23-d27/2-p14/2-p1
;d30: decremented delay (F1 in 3D) d27/2-larger(p14,p22)/2
;cnst2: = J(CH)                                        [145 Hz]
;cnst12: for multiplicity selection = 4 for all but Gly, 5 including Gly
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst24: center of Calpha and CO chemical shift (offset, in ppm)
;o2p: Calpha chemical shift (cnst22)
;inf1: 1/SW(Ha) = 2 * DW(Ha)
;inf2: 1/SW(Ca) = 2 * DW(Ca)
;in0: 1/(2 * SW(Ha)) = DW(Ha)
;nd0: 2
;in10: 1/(4 * SW(Ca)) = (1/2) DW(Ca)
;nd10: 4
;in20: = (1 - k1) * in0
;in28: = k1 * in0
;in29: = in10
;in30: = in10
;ns: 4 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 50%
;gpz2: 40%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100



