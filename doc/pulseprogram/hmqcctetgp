;hmqcctetgp
;avance-version (21/09/15)
;ct-HMQC
;2D H-1/X correlation 
;   via heteronuclear zero and double quantum coherence
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;using constant time
;using shaped pulses for inversion on f2 - channel
;(use parameterset )
;
;J.P. Marino, J.L. Diener, P.B. Moore & C. Griesinger, 
;   J. Am. Chem. Soc. 119, 7361-7366 (1997)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p2=p1*2"
"p4=p3*2"
"d4=1s/(cnst2*4)"
"d11=30m"

#   ifdef LABEL_CN
"p22=p21*2"
#   else
#   endif /*LABEL_CN*/


"d0=d23/2-p16-d16"
"d20=d23/2-p16-d16"

"in0=inf1/4"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"DELTA1=d4-p14/2-p16-d16"
"DELTA2=p16+d16"
"DELTA3=d4-p14/2"


"spoffs3=0"


1 ze 
2 d11 do:f2
3 d1

  50u UNBLKGRAD

  p1 ph1
  p16:gp3
  d16 pl2:f2
  DELTA1
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA1
  p16:gp4
  d16 pl2:f2

  (p3 ph3):f2

  DELTA2
  d20

#   ifdef LABEL_CN
  (center (p2 ph1) (p22 ph1):f3 )
#   else
  (p2 ph1)
#   endif /*LABEL_CN*/

  d20
  p16:gp1*-1*EA
  d16

  (p4 ph4):f2

  p16:gp1*EA
  d16
  d0

#   ifdef LABEL_CN
  (center (p2 ph1) (p22 ph1):f3 )
#   else
  (p2 ph1)
#   endif /*LABEL_CN*/

  d0
  DELTA2

  (p3 ph5):f2


  DELTA3
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA1
  p16:gp2
  d16 pl12:f2

  4u BLKGRAD
  go=2 ph31 cpd2:f2 
  d11 do:f2 mc #0 to 2 
     F1EA(calgrad(EA), caldel(d0, +in0) & caldel(d20, -in20) & calph(ph3, +180) & calph(ph31, +180))
exit 
  

ph1=0
ph3=0 2
ph4=0 0 2 2
ph5=0 0 0 0 2 2 2 2
ph31=0 2 0 2 2 0 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse 180 degree
;spnam3: Crp60,0.5,20.1
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse                         [1 msec]
;p22: f3 channel - 180 degree high power pulse
;d0 : incremented delay (2D) = d23/2-p16-d16
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(XH))
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D) = d23/2-p16-d16
;d23: d23 = T ,2T (constant time period) = n/J(CC)     [8.8 msec]
;cnst2: = J(XH)
;inf1: 1/SW(X) = 2 * DW(X)
;in0: 1/(4 * SW(X)) = (1/2) DW(X)
;nd0: 4
;in20: = in0
;ns: 2 * n
;ds: 16
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1 : gp 2 : gp 3 : gp 4
;                         80 : 55.2 :   -5 :   10

;for z-only gradients:
;gpz1: 80%
;gpz2: 55.2%
;gpz3: -5%
;gpz4: 10%

;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100



                                          ;preprocessor-flags-start
;LABEL_CN: for C-13 and N-15 labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



