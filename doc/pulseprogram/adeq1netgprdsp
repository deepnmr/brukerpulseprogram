;adeq1netgprdsp
;avance-version (21/08/04)
;1,1-ADEQUATE: 2D-HSQC-nJ(CC)-ADEQUATE
;   with refocussing of C chemical shift
;   using sensitivity improvement
;phase sensitive using Echo/Antiecho gradient selection
;with decoupling during acquisition
;using shaped pulses for 180degree pulses on f2 - channel
;with inversion of 1J(CC) correlations using double optimisation
;
;M. Reibarkh, R.T. Williamson, G.E. Martin & W. Bermel,
;   J. Magn. Reson. 236, 126-133 (2013)
;G.E. Martin, R.T. Williamson, P.G. Dormer & W. Bermel,
;   Magn. Reson. Chem. 50, 563-568 (2012)
;B. Reif, M. Koeck, R. Kerssebaum, H. Kang, W. Fenical & C. Griesinger
;   J. Magn. Reson. A118, 282-285 (1996).
;M. Koeck, R. Kerssebaum & W. Bermel, Magn. Reson. Chem. 41, 65-69 (2003)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"cnst30=-sfo2*3/sfo1"

define list<gradient> EA1 = { cnst30 -cnst30}


"p2=p1*2"
"d0=3u"
"d11=30m"

"p0=p3*1.333"
"d4=1s/(cnst2*4)"
"d24=1s/(cnst2*cnst11)"


"FACTOR1=trunc(cnst3/(cnst13*2))"
"cnst9=cnst3/(FACTOR1*2+1)"
"cnst10=cnst3/(FACTOR1*2-1)"
"d23=1s/(cnst9*4)"
"d25=1s/(cnst10*4)"

"FACTOR2=trunc(cnst4/(cnst14*2))"
"cnst7=cnst4/(FACTOR2*2+1)"
"cnst8=cnst4/(FACTOR2*2-1)"
"d26=1s/(cnst7*4)"
"d27=1s/(cnst8*4)"


"in0=inf1/2"

"in20=in0"
"in28=in0"

"d20=d25-p24/2-4u"
"d28=d27-p24/2-4u"

"td1=tdmax(td1,d20*2,in20)"


"DELTA1=p16+d16-p2-d0*2+4u"
"DELTA2=p16+d16+6u"
"DELTA3=d25-p24/2-p16-d16-4u-p2-d0"
"DELTA4=d4-p14/2-4u"
"DELTA5=d23-p24/2-4u"
"DELTA6=d24-cnst17*p24/2-4u"

"TAU3=d27-p24/2-p16-d16-4u-p2-d0"
"TAU5=d26-p24/2-4u"


"l0=1"


"td0=2"


1 ze
  d11 pl12:f2
2 d1 do:f2
3 (p1 ph1)
  4u
  DELTA4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  4u
  DELTA4 pl2:f2
  (p1 ph2)
  
  (p3 ph4):f2
  4u

  if "l0 %2 == 1"
     {
     DELTA5
     (p24:sp7 ph8):f2
     4u
     DELTA5 pl2:f2
     }
  else
     {
     TAU5
     (p24:sp7 ph8):f2
     4u
     TAU5 pl2:f2
     }

  (p3 ph9):f2

  d0
  (p2 ph1)
  d0
  DELTA1 UNBLKGRAD
  (p24:sp7 ph11):f2
  4u
  p16:gp1
  d16 pl2:f2

  (p0 ph10):f2
  4u

  if "l0 %2 == 1"
     {
     d20
     (p24:sp7 ph11):f2
     4u
     p16:gp1
     d16
     DELTA3 pl2:f2
     }
  else
     {
     d28
     (p24:sp7 ph11):f2
     4u
     p16:gp1
     d16
     TAU3 pl2:f2
     }

  (p2 ph1)
  d0

  (center (p1 ph1) (p3 ph5):f2 )
  4u
  DELTA6
  (center (p2 ph1) (p24:sp7 ph1):f2 )
  4u
  DELTA6 pl2:f2
  (center (p1 ph2) (p3 ph6):f2 )
  4u
  DELTA4
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  4u
  DELTA4
  (p1 ph1)
  DELTA2
  (p2 ph1)
  3u
  p16:gp1*EA1
  d16 pl12:f2 
  3u BLKGRAD
  go=2 ph31 cpd2:f2
  d1 do:f2 mc #0 to 2 
     F0(iu0 & zd)
     F1EA(calgrad(EA1) & calph(ph6, +180), caldel(d0, +in0) & caldel(d20, -in20) & caldel(d28, -in28))
;     F1EA(igrad EA1 & ip6*2, id0 & dd20 & dd28)
exit
   

ph1=0 
ph2=1
ph4=0 2
ph5=0 0 2 2 	
ph6=1 1 3 3
ph7=0
ph8=0
ph9=0 0 0 0 2 2 2 2
ph10=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph11=0
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse (180degree inversion)
;spnam3: Crp60,0.5,20.1 (Crp80,0.5,20.1)
;sp7: f2 channel - shaped pulse (180degree refocussing)
;spnam7: Crp60comp.4 (Crp80comp.4)
;p0 : f2 channel - 120 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;d0 : incremented delay (2D)                         [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/4J(CH)
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (2D): d25-p24/2-4u
;d23: ca. 1/(4J(CC)) (calcualted from cnst3 and cnst13)
;d24: 1/(4J(CH)) for CH
;     1/(8J(CH)) for all multiplicities
;d25: ca. 1/(4J(CC)) (calcualted from cnst3 and cnst13)
;d26: ca. 1/(4J(CC)) (calcualted from cnst4 and cnst14)
;d27: ca. 1/(4J(CC)) (calcualted from cnst4 and cnst14)
;d28: decremented delay (2D): d27-p24/2-4u
;cnst2 : J(CH) = 127 .. 160 Hz
;cnst3 : 1J(CC) = 35 .. 55 Hz                        [57 Hz]
;cnst4 : 1J'(CC) = 35 .. 55 Hz                       [64 Hz]
;cnst11: for multiplicity selection = 4 for CH, 8 for CHn
;cnst13: desired long range nJ(CH)                   [9.5 Hz]
;cnst14: desired long range nJ'(CH)                  [8 Hz]
;cnst17: = -0.5 for Crp60comp.4
;inf1: 1/SW(C) = 2 * DW(C)
;in0: 1/(2 * SW(C)) = DW(C)
;nd0: 2
;in20: = in0
;in28: = in0
;ns: 16 * n
;ds: >= 16
;td0: 2
;td1: number of experiments
;FnMODE: echo-antiecho
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: +80%

;use gradient files:
;gpnam1: SMSQ10.100


;cnst17: Factor to compensate for coupling evolution during a pulse
;       (usually +1). A positive factor indicates that coupling
;       evolution continues during the pulse, whereas a negative
;       factor is necessary if the coupling is (partially) refocussed.



