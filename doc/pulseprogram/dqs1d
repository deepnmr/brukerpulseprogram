;dqs1d
;avance-version (12/01/11)
;1D double quantum filter
;1D version of 2D correlation via double quantum coherence
;
;U. Piantini et al., J. Am. Chem. Soc. 104, 6800 (1982)
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"p2=p1*2"
"d4=1s/(cnst1*4)"
"d13=4u"


1 ze
2 30m
  d1
  p1 ph1
  d4
  p2 ph2
  d4
  p1 ph1
  d13
  p0 ph3
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 
ph2=0 2 0 2 0 2 0 2 2 0 2 0 2 0 2 0
ph3=0 0 2 2 3 3 1 1 
ph31=0 0 2 2 1 1 3 3


;pl1 : f1 channel - power level for pulse (default)
;p0 : f1 channel -  90 or 135 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J)
;cnst1: = J(HH)
;d13: short delay                                    [4 usec]
;ns: 8 * n, total number of scans: NS * TD0
;ds: 4



