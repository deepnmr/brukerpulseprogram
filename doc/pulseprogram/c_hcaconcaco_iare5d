;c_hcaconcaco_iare5d
;avance-version (21/09/15)
;(Ha)CaCONCaCO
;5D sequence with
;   inverse correlation for triple resonance using multiple
;      inept transfer steps
;
;      F2(Ha) -> F1(Ca,t1) -> F1(C=O,t2) -> F3(N,t3)
;                          -> F1(Ca,t4) -> F1(C=O,t5)
;
;on/off resonance 13C pulses using shaped pulse
;using selective Ca pulse in t1
;phase sensitive (t1)
;phase sensitive (t2)
;phase sensitive (t3)
;phase sensitive (t4)
;using semi-constant time in t1
;using semi-constant time in t2
;using semi-constant time in t3
;using constant time in t4
;relaxation optimised (H-flip)
;using IPAP scheme for virtual decoupling
;(use parameterset )
;
;J. Novacek, A. Zawadzka-Kazimierczuk, V. Papouskova, L. Zidek, H. Sanderova,
;   L. Krasny, W. Kozminski & V. Sklenar, J. Biomol. NMR 50, 1-11 (2011)
;
;$CLASS=HighRes
;$DIM=5D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


"p4=p3*2"
"p22=p21*2"
"d11=30m"
"d12=20u"

"d3=1.1m"
"d4=1.8m"
"d22=4.5m"
"d23=13.505m"
"d24=23.505m"
"d27=14.5m"


"d31=3u"
"d32=3u"
"d33=3u"
"d34=3u"
"d51=3u"
"d52=3u"
"d53=3u"
"d41=d22-p12/2-4u"
"d42=d27-p12+p22+d52-4u"
"d43=d24+p12/2+d53"
"d44=d23-p12-4u"

"in31=inf1/2"
"in32=inf2/2"
"in33=inf3/2"
"in34=inf4/2"

"FACTOR1=d41*10000000*2/td1"
"INCR1=FACTOR1/10000000"

"if ( INCR1 > in31 ) { in41 = in31; } else { in41 = INCR1; }"
"if ( INCR1 > in31 ) { in51 = 0; } else { in51=in31-INCR1; }"

"FACTOR2=d42*10000000*2/td2"
"INCR2=FACTOR2/10000000"

"if ( INCR2 > in32 ) { in42 = in32; } else { in42 = INCR2; }"
"if ( INCR2 > in32 ) { in52 = 0; } else { in52=in32-INCR2; }"

"FACTOR3=d43*10000000*2/td3"
"INCR3=FACTOR3/10000000"

"if ( INCR3 > in33 ) { in43 = in33; } else { in43 = INCR3; }"
"if ( INCR3 > in33 ) { in53 = 0; } else { in53=in33-INCR3; }"

"in44=in34"

"td4=tdmax(td4,d44*2,in44)"


"DELTA1=d4-p16-d16"
"DELTA2=d22-larger(p4,p22)-d31-p3-p12/2"
"DELTA4=d27-d32-p12"
"DELTA5=d27-d33-p44"
"DELTA6=d24-d27-p12*1.5"
"DELTA7=d22-d34-p44"
"DELTA8=d23-d22-p12"
"DELTA9=d3-p4/2"
"DELTA10=d3+p4/2"

"TAU1=p4+p25-p11"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*((cnst22-cnst21)/1000000)"
"spoffs27=bf1*((cnst21-cnst22)/1000000)"
"spoffs28=0"
"spoffs29=bf1*((cnst23-cnst22)/1000000)"


"o1_F1=bf1*cnst22/1000000"
"o1_F2=bf1*cnst21/1000000"
"o1_F4=bf1*cnst22/1000000"


"l0=1"


1 ze
  d11 pl16:f3
2 d11 do:f3
3 d1 fq=cnst22(bf ppm):f1
  d12 pl2:f2 pl3:f3
  50u UNBLKGRAD

  (p3 ph1):f2
  p16:gp1
  d16
  DELTA1
  (center (p25:sp28 ph1) (p4 ph1):f2 )
  DELTA1
  p16:gp1
  d16
  (p3 ph2):f2

  TAU1

  (p11:sp23 ph3)
  DELTA9
  (p4 ph2):f2
  (p25:sp28 ph1)
  DELTA10
  (p3 ph8):f2

  d31
  (center (p4 ph2):f2 (p22 ph1):f3 )
  DELTA2
  (p12:sp27 ph1)
  d51
  (p25:sp28 ph1)
  d41
  (p12:sp27 ph1)
  4u
  (p11:sp25 ph1)

  p16:gp3
  d16 fq=cnst21(bf ppm):f1

  (p11:sp23 ph4)
  d32
  (p12:sp26 ph1)
  DELTA4
  (p22 ph1):f3
  d52
  (p12:sp24 ph1)
  d42
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph2)

  p16:gp4
  d16 fq=cnst22(bf ppm):f1
  (p44:sp3 ph10):f2

  (p21 ph5):f3
  d33
  (p44:sp3 ph2):f2
  DELTA5
  (p12:sp27 ph1)
  DELTA6
  (p12:sp24 ph1)
  d53
  (p22 ph1):f3
  d43
  (p21 ph2):f3

  p16:gp5
  d16 
  (p44:sp3 ph10):f2

  (p11:sp23 ph6)
  d34
  (p44:sp3 ph2):f2
  DELTA7
  (p12:sp27 ph1)
  DELTA8
  (center (p12:sp29 ph1) (p22 ph1):f3 )
  d44
  (p12:sp27 ph1)
  4u
  (p11:sp25 ph1)

  p16:gp6
  d16 fq=cnst21(bf ppm):f1

  if "l0 %2 == 1"
     {
     (p11:sp23 ph7)
     4u
     (p12:sp26 ph1)
     d22 pl16:f3
     (p12:sp24 ph1)
     4u
     (p12:sp26 ph1)
     d22 BLKGRAD
     }
  else
     {
     (p11:sp23 ph9)
     4u
     d22*0.5
     (p12:sp26 ph1)
     d22*0.5
     (p12:sp24 ph1)
     4u
     d22*0.5 pl16:f3
     (p12:sp26 ph1)
     d22*0.5 BLKGRAD
     }  

  go=2 ph31 cpd3:f3 
  d11 do:f3 mc #0 to 2

#   ifdef LABEL_F1
     F1I(iu0, 2)
#   else

#   ifdef LABEL_F2
     F2I(iu0, 2)
#   else

#   ifdef LABEL_F3
     F3I(iu0, 2)
#   else
     F4I(iu0, 2)
#   endif /*LABEL_F3*/

#   endif /*LABEL_F2*/

#   endif /*LABEL_F1*/

     F1PH(calph(ph3, -90), caldel(d31, +in31) & caldel(d41, -in41) & caldel(d51, +in51))
     F2PH(calph(ph4, +90), caldel(d32, +in32) & caldel(d42, -in42) & caldel(d52, +in52))
     F3PH(calph(ph5, +90), caldel(d33, +in33) & caldel(d43, -in43) & caldel(d53, +in53))
     F4PH(calph(ph6, +90), caldel(d34, +in34) & caldel(d44, -in44))
exit


ph1=0
ph2=1
ph3=0
ph4=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph5=0 2
ph6=0 0 2 2
ph7=0 0 0 0 2 2 2 2
ph8=2
ph9=3 3 3 3 1 1 1 1
ph10=3
ph31=0 2 2 0 2 0 0 2 2 0 0 2 0 2 2 0


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl16: f3 channel - power level for CPD/BB decoupling
;sp3 : f2 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (Ca off resonance)
;sp27: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;sp28: f1 channel - shaped pulse 180 degree  (Ca on resonance)
;                   sp28 requires higher selectivity than sp24
;sp29: f1 channel - shaped pulse 180 degree  (Cali off resonance
;p3 : f2 channel -  90 degree high power pulse
;p4 : f2 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p25: f1 channel - 180 degree shaped pulse (Ca, sp28)
;p44: f2 channel - 180 degree shaped pulse for refocussing
;                      Bip720,50,20.1            (200us at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d3 : 1/(6J(HCa))                                      [1.1 msec]
;d4 : 1/(4J(HCa))                                      [1.8 msec]
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d22: 1/(4J(COCa))                                     [4.5 msec]
;d23: 1/(4J'(NCa)) and 1/(2J(CaCb))                    [13.505 msec]
;d24: 1/(4J(NCa))                                      [23.505 msec]
;d27: 1/(4J(NCO))                                      [14.5 msec]
;d31: incremented delay (F1 in 5D)                     [3 usec]
;d32: incremented delay (F2 in 5D)                     [3 usec]
;d33: incremented delay (F3 in 5D)                     [3 usec]
;d34: incremented delay (F4 in 5D)                     [3 usec]
;d41: decremented delay (F1 in 5D) = d22-p12/2-4u
;d42: decremented delay (F2 in 5D) = d27-p12+p22+d52-4u
;d43: decremented delay (F3 in 5D) = d24+p12/2+d53
;d44: decremented delay (F4 in 5D) = d23-p12-4u
;d51: incremented delay (F1 in 5D)                     [3 usec]
;d52: incremented delay (F2 in 5D)                     [3 usec]
;d53: incremented delay (F3 in 5D)                     [3 usec]
;cnst21: CO chemical shift (offset, in ppm)
;cnst22: Calpha chemical shift (offset, in ppm)
;cnst23: Caliphatic chemical shift (offset, in ppm)
;o1p: CO chemical shift (cnst21)
;l0: flag to switch between inphase and antiphase
;inf1: 1/SW(Ca) = 2 * DW(Ca)
;inf2: 1/SW(CO) = 2 * DW(CO)
;inf3: 1/SW(N) = 2 * DW(N)
;inf4: 1/SW(Ca) = 2 * DW(Ca)
;in31: 1/(2 * SW(Ca)) =  DW(Ca)
;nd31: 2
;in32: 1/(2 * SW(CO)) =  DW(CO)
;nd32: 2
;in33: 1/(2 * SW(N)) =  DW(N)
;nd33: 2
;in34: 1/(2 * SW(Ca)) =  DW(Ca)
;nd34: 2
;in41: = k1 * in31
;in42: = k2 * in32
;in43: = k3 * in33
;in44: = in34
;in51: = (1 - k1) * in31
;in52: = (1 - k2) * in32
;in53: = (1 - k3) * in33
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;        (or number of experiments in F1 * 2 with LABEL_F1)
;td2: number of experiments in F2
;        (or number of experiments in F2 * 2 with LABEL_F2)
;td3: number of experiments in F3
;        (or number of experiments in F3 * 2 with LABEL_F3)
;td4: number of experiments in F4 * 2
;        (or number of experiments in F4     with LABEL_F1 or LABEL_F2 or LABEL_F3)
;        td4 max = n * d44 / in44 (n = 4 or = 2 with LABEL_F1 or LABEL_F2 or LABEL_F3)
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: States-TPPI (or TPPI) in F2
;FnMODE: States-TPPI (or TPPI) in F3
;FnMODE: States-TPPI (or TPPI) in F4
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1:  2%
;gpz2:  2%
;gpz3: 40%
;gpz4: 30%
;gpz5: 10%
;gpz6:  5%


;use gradient files:
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100





                                           ;preprocessor-flags-start
;LABEL_F1: to do ipap in F1 start experiment with
;             option -DLABEL_F1 (eda: ZGOPTNS)
;LABEL_F2: to do ipap in F2 start experiment with
;             option -DLABEL_F2 (eda: ZGOPTNS)
;LABEL_F3: to do ipap in F3 start experiment with
;             option -DLABEL_F3 (eda: ZGOPTNS)
                                           ;preprocessor-flags-end



;use AU-program splitcomb [ipap 2] (F4 or Fn with LABEL_Fn) to process data



