						;end FLOPSY16

  p16:gp2
  d16 pl1:f1
  4u BLKGRAD
  (p11:sp23 ph5)

  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20))
