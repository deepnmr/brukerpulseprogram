;c_ccflopsy16_ct
;avance-version (21/09/15)
;CC-TOCSY
;2D sequence with
;   homonuclear Hartman-Hahn transfer using FLOPSY16 
;      sequence for mixing
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using constant time in t1
;(use parameterset C_CCFLOPSY16_CT)
;
;A. Eletsky, O.Moreira, H. Kovacs & K. Pervushin, 
;   J. Biomol. NMR 26, 167-179 (2003)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"d11=30m"
"d12=20u"

"d27=13.3m"


"d0=3u"
"d20=d27+d0-4u"

"in0=inf1/2"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"FACTOR1=(d9/(p6*188.448))"
"l1=FACTOR1"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*(cnst21/1000000)-o1"


1 ze 
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 pl1:f1
  50u UNBLKGRAD
  d12 cpd2:f2 cpd3:f3

  (p11:sp23 ph3)
  d0
  (p12:sp26 ph1)
  d27
  (p12:sp24 ph1)
  d20
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph4)

  4u do:f2 do:f3
  p16:gp1
  d16 pl10:f1
						;begin FLOPSY16
4 p6*0.511 ph11
  p6*1.067 ph12
  p6*1.822 ph13
  p6*1.767 ph14
  p6*1.444 ph15
  p6*1.767 ph14
  p6*1.822 ph13
