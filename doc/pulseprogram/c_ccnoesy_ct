;c_ccnoesy_ct
;avance-version (21/09/15)
;CC-NOESY
;2D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange
;on/off resonance 13C pulses using shaped pulses
;phase sensitive (t1)
;using constant time in t1
;(use parameterset C_CCNOESY_CT)
;
;W. Bermel, I. Bertini, I.C. Felli, R. Kuemmerle &
;   R. Pierattelli, J. Am. Chem. Soc. 125, 16423-16429 (2003)
;I. Bertini, I.C. Felli, R. Kuemmerle, D. Moskau &
;   R. Pierattelli, J. Am. Chem. Soc. 126, 464-465 (2004)
;
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


prosol relations=<triple_c>


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"d11=30m"
"d12=20u"

"d27=13.3m"


"d0=3u"
"d20=d27+d0-4u"

"in0=inf1/2"

"in20=in0"

"td1=tdmax(td1,d20*2,in20)"


"TAU=d8-p16-d16-4u"


"spoffs23=0"
"spoffs24=0"
"spoffs25=0"
"spoffs26=bf1*(cnst21/1000000)-o1"


1 ze 
  d11 pl12:f2 pl16:f3
2 d11 do:f2 do:f3
3 d1 pl1:f1
  50u UNBLKGRAD
  d12 cpd2:f2 cpd3:f3

  (p11:sp23 ph3)
  d0
  (p12:sp26 ph1)
  d27
  (p12:sp24 ph1)
  d20
  (p12:sp26 ph1)
  4u
  (p11:sp25 ph4)

  4u do:f2 do:f3
  TAU
  p16:gp1
  d16
  4u BLKGRAD

  (p11:sp23 ph5)

  go=2 ph31 cpd2:f2 cpd3:f3
  d11 do:f2 do:f3 mc #0 to 2 
     F1PH(calph(ph3, +90), caldel(d0, +in0) & caldel(d20, -in20))
exit 

  
ph1=0
ph3=0 2
ph4=0 0 0 0 0 0 0 0 2 2 2 2 2 2 2 2
ph5=0 0 2 2 1 1 3 3
ph31=0 2 2 0 1 3 3 1 2 0 0 2 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;pl16: f3 channel - power level for CPD/BB decoupling
;sp23: f1 channel - shaped pulse  90 degree  (on resonance)
;sp24: f1 channel - shaped pulse 180 degree  (on resonance)
;sp25: f1 channel - shaped pulse  90 degree  (on resonance)
;                   for time reversed pulse
;sp26: f1 channel - shaped pulse 180 degree  (C=O off resonance)
;p11: f1 channel -  90 degree shaped pulse
;p12: f1 channel - 180 degree shaped pulse
;p16: homospoil/gradient pulse                         [1 msec]
;d0 : incremented delay (F1 in 2D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                               [30 msec]
;d12: delay for power switching                        [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: decremented delay (F1 in 2D) = d27+d0-4u
;d27: 1/(2J(CaCb)                                      [13.3 msec]
;cnst21: CO chemical shift (offset, in ppm)
;o1p: Caliphatic chemical shift (cnst23)
;inf1: 1/SW(Cali) = 2 * DW(Cali)
;in0: 1/(2 * SW(Cali)) =  DW(Cali)
;nd0: 2
;in20: = in0
;ns: 16 * n
;ds: >= 32
;td1: number of experiments in F1
;FnMODE: States-TPPI (or TPPI) in F1   td1 max = 2 * d20 / in20
;cpd2: decoupling according to sequence defined by cpdprg2
;cpd3: decoupling according to sequence defined by cpdprg3
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence
;pcpd3: f3 channel - 90 degree pulse for decoupling sequence


;use gradient ratio:    gp 1
;                         80

;for z-only gradients:
;gpz1: 80%

;use gradient files:
;gpnam1: SMSQ10.100



