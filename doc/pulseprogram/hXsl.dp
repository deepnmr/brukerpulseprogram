;hXsl.dp
;avance-version (08/16/24)
;JOS

;version: 1.0/ TS4..4.0 06/16/2024

;$COMMENT= single pulse excitation, acquisition without decoupling
;$CLASS=SolidsIcon
;$DIM=1D
;$TYPE=direct polarization
;$SUBTYPE= spinlock experiment

prosol relations=<solids_ICON>
#include <Delay.incl>
#include <trigg.incl>
		; definition of external trigger output$
"plw11=plw31*pow((cnst14/10000),2)"
"cnst21=o1"
#ifdef Dec
#include <Decoup_Solids.incl>
#endif

"acqt0=-0.1u"

Prepare, ze

#ifdef Dec
Start, 10m  do:f2
  d1 do:f2
#else     
Start, 10m  
  d1
#endif
#ifndef lacq
#include <acq_prot.incl>
        ;Max. 50 ms acquisition time
#endif
 trigg
#ifdef Dec
     0.5u pl12:f2
    (p1 pl1 ph1):f1 (1u cpds2):f2
    (p15 pl11 ph2 fq=cnst22(bf ppm)):f1
(0.1u fq=cnst21(bf hz)):f1
go=Start ph31 finally do:f2
	1m do:f2
#else
 (p1 pl1 ph1):f1 
 (p15 pl11 ph2 fq=cnst22(bf ppm)):f1
 (0.1u fq=cnst21(bf hz)):f1
go=Start ph31  
#endif
  10m mc #0 to Start F0(zd)
  
HaltAcqu, 1m
Exit, exit


ph1= 0 2 1 3		; C hard pulse
ph2= 3 1 0 2

ph31=0 2 1 3		; receiver




;Avance NEO / III version
;parameters:
;p1  : X 90 at pl1
;pl1 : X pulse power
;pl12: H dec power
;cnst31 : MAS rate in Hz 
;cnst14 : spinlockfield in Hz
;cnst52  : 1H heteronuclear decoupling field in Hz for pl12 decoupling
;d1  : recycle delay
;pcpd2   : not used, instead p31 is H dec pulse cpdprg2 (calculated)
;cpdprg2 : Decoupling file cw, tppm (at pl12)
;ZGOPTNS : -DDec  if decoupling is desired
;ns: 4 (full:4)

;$Id: hXsl.dp,v 1.0  Exp $
