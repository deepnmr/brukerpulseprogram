;hsqcdietgpsisp3d.2
;avance-version (20/03/03)
;HSQC-TOCSY
;3D H-1/C-13 correlation via double inept transfer
;   using sensitivity improvement and DIPSI2
;   for homonuclear Hartman-Hahn mixing
;phase sensitive using Echo/Antiecho-TPPI gradient selection (t1)
;phase sensitive using Echo/Antiecho-TPPI gradient selection (t2)
;with decoupling during acquisition - using f2
;using trim pulses in inept transfer
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>


define list<gradient> EA1 = { 1.000 -1.000}
define list<gradient> EA2 = { 1.000 -1.000}


"p2=p1*2"
"d11=30m"
"d4=1s/(cnst2*4)"


"d0=3u"
"d10=3u"

"in0=inf1/2"
"in10=inf2/2"


"FACTOR1=(d9/(p6*115.112))/2"
"l1=FACTOR1*2"


"DELTA=p16+d16+p2+d0*2-4u"
"DELTA1=p16+d16-p1*0.78+de+8u"
"DELTA2=d4-p14/2"
"DELTA3=p16+d16+d10"
"DELTA4=d10"
"DELTA5=d24-cnst17*p24/2-4u"


"acqt0=0"
baseopt_echo


aqseq 312


1 ze
  d11 pl12:f2
2 d1 do:f2
  10u pl0:f2

3 (p1 ph1)
  DELTA2
  4u
  (center (p2 ph1) (p14:sp3 ph6):f2 )
  4u
  DELTA2 pl2:f2 UNBLKGRAD

#   ifdef TRIMP
  (p28 ph1)
#   endif /* TRIMP */

  (p1 ph2) 

  (p3 ph3+ph13):f2
  d0 
  (p2 ph7)
  d0
  p16:gp1*EA1
  d16
  (p24:sp7 ph4):f2
  4u
  DELTA pl2:f2
  (center (p1 ph1) (p3 ph4):f2 )
  4u
  DELTA5
  (center (p2 ph1) (p24:sp7 ph1):f2 )
  4u
  DELTA5 pl2:f2
  (center (p1 ph2) (p3 ph5+ph15):f2 )
  DELTA2 pl0:f2
  (center (p2 ph1) (p14:sp3 ph1):f2 )
  DELTA2 

  (p1 ph8)
  DELTA3
  (p14:sp3 ph1):f2
  DELTA4
  (p2 ph1)
  d10
  (p14:sp3 ph7):f2
  d10
  p16:gp2*EA2
  d16
  (p1 ph9)
  4u pl10:f1

						;begin DIPSI2
4 p6*3.556 ph22
  p6*4.556 ph24
  p6*3.222 ph22
  p6*3.167 ph24
  p6*0.333 ph22
  p6*2.722 ph24
  p6*4.167 ph22
  p6*2.944 ph24
  p6*4.111 ph22
  
  p6*3.556 ph24
  p6*4.556 ph22
  p6*3.222 ph24
  p6*3.167 ph22
  p6*0.333 ph24
  p6*2.722 ph22
  p6*4.167 ph24
  p6*2.944 ph22
  p6*4.111 ph24

  p6*3.556 ph24
  p6*4.556 ph22
  p6*3.222 ph24
  p6*3.167 ph22
  p6*0.333 ph24
  p6*2.722 ph22
  p6*4.167 ph24
  p6*2.944 ph22
  p6*4.111 ph24

  p6*3.556 ph22
  p6*4.556 ph24
  p6*3.222 ph22
  p6*3.167 ph24
  p6*0.333 ph22
  p6*2.722 ph24
  p6*4.167 ph22
  p6*2.944 ph24
  p6*4.111 ph22
  lo to 4 times l1
						;end DIPSI2

  4u pl1:f1
  (p1 ph10)
  DELTA1
  (p2 ph1)
  4u
  p16:gp3
  d16 pl12:f2
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d1 do:f2 mc #0 to 2 
     F1EA(calgrad(EA1) & calph(ph5, +180), caldel(d0, +in0) & calph(ph3, +180) & calph(ph6, +180) & calph(ph31, +180))
     F2EA(calgrad(EA2) & calph(ph9, +180) & calph(ph13, +180) & calph(ph15, +180), caldel(d10, +in10))
exit
   

ph1=0 
ph2=1
ph3=0 2
ph4=0 0 0 0 2 2 2 2
ph5=1 1 1 1 3 3 3 3
ph6=0
ph7=0 0 0 0 2 2 2 2
ph8=2
ph9=2 2 0 0
ph10=0 0 2 2
ph13=0
ph15=0
ph22=3
ph24=1
ph31=0 2 0 2 2 0 2 0
  

;pl0 : 0W
;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl10: f1 channel - power level for TOCSY-spinlock
;pl12: f2 channel - power level for CPD/BB decoupling
;sp3: f2 channel - shaped pulse (180degree inversion)
;spnam3: Crp60,0.5,20.1
;sp7: f2 channel - shaped pulse (180degree refocussing)
;spnam7: Crp60comp.4
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p6 : f1 channel -  90 degree low power pulse
;p14: f2 channel - 180 degree shaped pulse for inversion
;     = 500usec for Crp60,0.5,20.1
;p16: homospoil/gradient pulse                         [1 msec]
;p24: f2 channel - 180 degree shaped pulse for refocussing
;     = 2msec for Crp60comp.4
;p28: f1 channel - trim pulse                          [1 msec]
;d0 : incremented delay (F1 in 3D)                     [3 usec]
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d9 : TOCSY mixing time
;d10: incremented delay (F2 in 3D)                     [3 usec]
;d11: delay for disk I/O                               [30 msec]
;d16: delay for homospoil/gradient recovery
;d24: 1/(8J)CH for all multiplicities
;     1/(4J)CH for CH
;cnst2: = J(CH)
;cnst17: = -0.5 for Crp60comp.4
;l1: loop for DIPSI cycle: ((p6*115.112) * l1) = mixing time
;inf1: 1/SW(C) = 2 * DW(C)
;inf2: 1/SW(H) = 2 * DW(H)
;in0: 1/(2 * SW(C)) = DW(C)
;nd0: 2
;in10: 1/(2 * SW(H)) = DW(H)
;nd10: 2
;ns: 2 * n
;ds: >= 32
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: echo-antiecho in F1
;FnMODE: echo-antiecho in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence


;for z-only gradients:
;gpz1: 80%
;gpz2: 30%
;gpz3: 50.1%

;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100


                                          ;preprocessor-flags-start
;TRIMP: to use trimpulse p28@pl1 start experiment with
;          option -DTRIMP (eda: ZGOPTNS)
                                          ;preprocessor-flags-end



;$Id:$
