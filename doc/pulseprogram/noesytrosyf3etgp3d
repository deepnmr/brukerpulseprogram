;noesytrosyf3etgp3d
;avance-version (24/03/20)
;NOESY-(N15)TROSY
;3D sequence with
;   homonuclear correlation via dipolar coupling
;   dipolar coupling may be due to noe or chemical exchange.
;   1H/15N correlation via TROSY
;      using sensitivity improvement
;optional 13C decoupling (use ZGOPTNS -DLABEL_CN for 13C/15N labeled samples) 
;using weak presaturation (@pl32) and watergate for water suppression
;adjust SPW1,PHCOR1 and PHCOR3 to optimize water suppression
;the center of the NOESY dimension (F1) is set by cnst20
;(use parameterset NOESYTROSYF3ETGP3D)
;
;(M. Czisch & R. Boelens, J. Magn. Reson. 134, 158-160 (1998) )
;(K. Pervushin, G. Wider & K. Wuethrich, J. Biomol. NMR 12,
;   345-348 (1998) )
;(A. Meissner, T. Schulte-Herbrueggen, J. Briand & O.W. Sorensen, Mol. Phys. 96,
;   1137-1142 (1998) )
;(J. Weigelt, J. Am. Chem. Soc. 120, 10778-10779 (1998) )
;(M. Rance, J.P. Loria & A.G. Palmer III, J. Magn. Reson. 136, 91-101 (1999) )
;(G. Zhu, X.M. Kong & K.H. Sze, J. Biomol. NMR 13, 77-81 (1999) )
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

prosol relations=<triple>

#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>


"p2=p1*2"
"p22=p21*2"
"d11=30m"

"d26=1s/(cnst4*4)"

"p30=250u"

"in0=inf1"
"in10=inf2"
"d0=in0/2-p1*4/PI"
"d10=in10/2"

"DELTA3=d26-p11-p19-d16-p56/2-4u"
"DELTA4=d26-p11-p30-d16-p57/2-4u"
"DELTA5=d26-p16-d16-larger((p11*2+p2+8u),p57)/2"
"DELTA6=d26-p16-d16-larger((p11*2+p2+8u),p57)/2-4u-de-p1*2/PI"

#   ifdef LABEL_CN
"TAU1=larger((larger(p35,p56)-d0-2*p1)/2,0)"
#   else
"TAU1=larger((p56-d0-2*p1)/2,0)"
#   endif

"TAU=d8-p16-d16-2u-TAU1"
"l0=0"

"spoffs41=bf2*(cnst26/1000000)-o2"
"o1_F1=bf1*(cnst20/1000000)"

"acqt0=0"
baseopt_echo

aqseq 312

1 ze
2 d11
  3u pl32:f1
  d1 cw:f1 ph29
  4u do:f1
  20u pl1:f1 
  50u UNBLKGRAD fq=cnst20 (bf ppm):f1

#   ifdef LABEL_CN
  (
   refalign (TAU1 p1 ph1 d0 p1 ph9 TAU1):f1
   center (p35:sp41 ph1):f2
   center (p56:sp39 ph1):f3
  )
#   else
  (
   refalign (TAU1 p1 ph1 d0 p1 ph9 TAU1):f1
   center (p56:sp39 ph1):f3
  )
#   endif

  TAU 
  p16:gp6
  d16 fq=0:f1

  (p1 ph1):f1
  4u
  (p11:sp1 ph3:r):f1
  p19:gp1
  d16 pl1:f1
  DELTA3
  (center (p2 ph2):f1 (p56:sp39 ph1):f3) 
  DELTA3
  p19:gp1
  d16
  (p11:sp1 ph4:r):f1
  4u pl1:f1 pl3:f3
  (p1 ph4):f1

  p19:gp2
  d16

#   ifdef LABEL_CN

  "TAU3=larger((d10/2-p35/2),0)"

  if "l0 %2 == 1"
     {
     (ralign (p35:sp41 ph1 TAU3):f2 (p21 ph5 d10):f3)
     }
  else
     {
     (ralign (p35:sp41 ph1 TAU3):f2 (p21 ph6 d10):f3)
     }

#   else

  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     d10
     }
  else
     {
     (p21 ph6):f3
     d10
     }

#   endif /*LABEL_CN*/

  (p1 ph7):f1
  4u
  (p11:sp1 ph17:r):f1
  p30:gp3
  d16 pl1:f1
  DELTA4
  (center(p2 ph1):f1 (p57:sp40 ph1):f3)
  DELTA4
  p30:gp3
  d16
  (p11:sp1 ph1:r):f1  
  4u pl1:f1 pl3:f3
  (lalign (p1 ph1):f1 (p21 ph7):f3)
  DELTA5
  p16:gp4
  d16
  (center (p11:sp1 ph3:r 4u pl1 p2 ph1 4u p11:sp1 ph3:r):f1 (p57:sp40 ph1):f3)
  p16:gp4
  d16 pl3:f3
  4u BLKGRAD
  DELTA6
  (p21 ph1):f3
  go=2 ph31 
  d11 mc #0 to 2 
     F1PH(calph(ph9, -90), caldel(d0, +in0))
     F2EA(calph(ph7, +180) & calph(ph17, +180) & calclc(l0, 1), caldel(d10, +in10) & calph(ph5, +180) & calph(ph6, +180) & calph(ph31, +180))
exit


ph1=0
ph2=1
ph3=2
ph4=3
ph5=1 2 1 2 3 0 3 0
ph6=1 0 1 0 3 2 3 2
ph7=1
ph9=0 0 2 2
ph17=3
ph29=0
ph31=1 2 3 0 3 0 1 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl32: f1 channel - power level for low power presaturation
;sp1: f1 channel - shaped pulse
;sp11: f1 channel - shaped pulse  90 degree  (H2O on resonance)
;sp39: f3 channel - shaped pulse 180 degree (Bip720,50,20.1)
;sp40: f3 channel - shaped pulse 180 degree (Reburp.1000)
;sp41: f2 channel - shaped pulse 180 degree (Bip720,100,10.1)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse
;p19: gradient pulse 2                                 [600 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p30: gradient pulse 3                                 [250 usec]
;p35: f2 channel - 180 degree shaped pulse
;p56: f3 channel - 180 degree shaped pulse for inversion
;                      Bip720,50,20.1            (500us at 600.13 MHz)
;p57: f3 channel - 180 degree shaped pulse for refocussing
;                      Reburp.1000               (1.6ms at 600.13 MHz)
;d1 : relaxation delay; 1-5 * T1
;d8 : mixing time
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d26: 1/(4J)YH
;d0: incremented delay (F1 in 3D) = in0/2-p1*4/PI
;d10: incremented delay (F2 in 3D) = in10/2
;cnst4: = J(NH)
;cnst20: Center of F1 (1H NOESY) dimension (in ppm) [~5]
;cnst26: Call chemical shift (offset, in ppm)          [101 ppm]
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(N) = 2 * DW(N)
;in0: 1/(SW(H)) = 2 * DW(H)
;in10: 1/(2 * SW(N)) = DW(N)
;nd0: 1
;nd10: 1
;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI (or TPPI) in F1
;FnMODE: echo-antiecho in F2


;for z-only gradients:
;gpz1: 19%
;gpz2: 47% 
;gpz3: 65% 
;gpz4: 80% 
;gpz6: 71%

;use gradient files:
;gpnam1: SMSQ10.50
;gpnam2: SMSQ10.50
;gpnam3: SMSQ10.32
;gpnam4: SMSQ10.100
;gpnam6: SMSQ10.100



;Processing F1 and F2

;PHC0(F1): 90
;PHC1(F1): -180
;FCOR(F1): 1

;PHC0(F2): 90
;PHC1(F2): -180
;FCOR(F2): 1


                                          ;preprocessor-flags-start
;LABEL_CN: for 13C and 15N labeled samples start experiment with 
;             option -DLABEL_CN (eda: ZGOPTNS)
                                          ;preprocessor-flags-end

