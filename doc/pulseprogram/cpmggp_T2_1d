;cpmggp_T2_1d
;avance-version (17/03/20)
;for single scan T2
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <Grad.incl>
#include <De.incl>


define loopcounter lcount
define loopcounter td_val


"p2=p1*2"
"d12=20u"


"if ( de > 20u ) { DELTA = 20u; } else { DELTA = de; }"

"DELTA1=d20-p2/2-p1*2/PI-DELTA-d16-de-10.25u"
"DELTA2=d20-p2/2-dw-DELTA-d16-12.15u"
"DELTA3=d20-p2/2-dw-DELTA-d16-10.1u"

"TAU1=dw-0.05u"
"TAU2=dw"


"lcount = td/2-1"
"td_val=(l20+grpdly)*2"


1 ze
  d12 pl1:f1
2 30m BLKGRAD
  20u ip30+cnst30
  d1
  50u UNBLKGRAD
  (p1 ph1)
  ACQ_START(ph30,ph31)
  0.05u DWELL_HOLD
  0.1u START_NEXT_SCAN

  DELTA1 gron0
  10u groff
  d16
  0.1u REC_BLK
  DELTA
  (p2 ph2):f1
  DELTA
  0.1u REC_UNBLK
  DELTA3 gron0
  10u groff
  d16
  0.05u DWELL_RELEASE
  TAU1

  TAU2
  0.05u DWELL_HOLD


4 2u
  DELTA2 gron0
  10u groff
  d16
  0.1u REC_BLK
  DELTA
  (p2 ph2):f1
  DELTA
  0.1u REC_UNBLK
  DELTA3 gron0
  10u groff
  d16
  0.05u DWELL_RELEASE
  TAU1

  TAU2
  0.05u DWELL_HOLD
  lo to 4 times lcount

  0.1u REC_BLK
  0.05u DWELL_RELEASE
  rcyc = 2
  wr #0
  4u BLKGRAD
exit

ph1=0 0 2 2 1 1 3 3 
ph2=1 3 1 3 0 2 0 2
ph31=0 0 2 2 1 1 3 3
ph30=(360) 0


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                                    [20 usec]
;d16: delay for homospoil/gradient recovery
;d20: fixed echo time to allow elimination of J-mod. effects
;        d20 should be << 1/J ,but > (50 * p2)                     [1-2 msec]
;cnst30: additional receiver phase setting to have intensity in real channel
;l20: number of echos
;ns: 1 * n, total number of scans: NS * TD0
;td: number of echos


;gpz0: 1%



