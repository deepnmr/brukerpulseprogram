;noesyhsqcetgpsp3d
;avance-version (26/10/24)
;NOESY-13C HSQC
;phase sensitive using Echo/Antiecho-TPPI gradient selection
;3D sequence 
;   for recording an HCH-NOESY spectrum 
;   1H/13C correlation via double inept transfer
;   using cnst22 as center of spectrum (1H, F1 dimension)
;optimized for large 13C bandwidth (broadband shaped pulses for all purposes on 13C)
;using delayed sampling in F1 dimension
;use ZGOPTNS LABEL_CN for 15N/13C labeled samples
;use ZGOPTNS SetF2Center to allow for aliasing of aromatic signals into aliphatic spectral region, 
;    while keeping the transmitter frequecy in the center of both regions (~75 ppm). The center of 
;    the 13C dimension is then set by cnst23.
;(use parameterset NOESYHSQCETGPSP3D)
;
; S. Asami, W. Kallies, J.C. Guenther, M. Stavropoulou, S.J. Glaser & M. Sattler,
;   Angew. Chem. Int. Ed. Engl. 57(44), 14498-14502 (2018)
;
;$CLASS=HighRes
;$DIM=3D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

prosol relations=<triple>

#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

require "TopSpin 4.1.0"

"p2=p1*2"
"d4=1s/(cnst2*4)"
"d11=30m"
"d12=20u"

"p13=30u"
"spnam2='Ram-COOP1_100.300'"
"if ( (p3*totrot2)/(p13*90.0*integfac2) > 1 ) { spw2 = plw2; p13 = (p3*totrot2)/(90*integfac2); } else { spw2=plw2*pow((p3*totrot2)/(p13*90.0*integfac2),2);}"
"spoffs2=0"
"spoal2=1"
"spnam8='Ram-COOP2_100.300'"
"spw8=spw2"
"spoffs8=0"
"spoal8=0"

"p35=192u"
"spnam41='Bip1382,250,15.1000'"
"if ( (p3*totrot41)/(p35*90.0*integfac41) > 1 ) { spw41 = plw2; p35 = (p3*totrot41)/(90*integfac41); } else { spw41=plw2*pow((p3*totrot41)/(p35*90.0*integfac41),2);}"
"spoal41=0.5"

"spoffs30=0"
"spoffs39=0"
"spoffs41=0"

"in0=inf1/2"
"in10=inf2/2"
"d10=1u"

"if ( td1 == 1 ) { d0 = 4u; } else { d0=in0/2-p1*2/PI-6u; }"

"o1_F1=bf1*cnst22/1000000"

#   ifdef SetF2Center
"cnst63=(bf2*cnst23-(o2*1000000))*(inf2/1000000)*360.0"
"cnst61=cnst63+180"
"o1_F2=bf2*cnst23/1000000"
#   else
"cnst61=180"
#   endif /*SetF2Center*/

"DELTA=p16+d16-2*d10-0.529*p13*2"
"DELTA1=d4-p1*2/PI"
"DELTA2=d4-p16-d16-de-4u"

#   ifdef LABEL_CN
"DELTA3=larger(p44/2+d10-p13*0.471,0)"
"DELTA4=p44"
"TAU1=larger(p35,p56)/2-p1-d0/2"
#   else
"DELTA3=larger(p44/2+d10-p13*0.471,0)"
"TAU1=larger(p35/2-p1-d0/2,0)"
#   endif /*LABEL_CN*/

"TAU=(d8-p16-d16-TAU1*2-12u)/2"

"acqt0=0"
baseopt_echo

aqseq 321

1 ze
  d11 pl1:f1 pl12:f2
2 d11 do:f2
  d1 fq=cnst22 (bf ppm):f1

  50u UNBLKGRAD
 
  (p13:sp2 ph1):f2
  
  p16:gp1
  d16

#ifdef LABEL_CN
  (center (TAU1 p1 ph5 d0 gron0 6u groff d0 gron0*-1 6u groff p1 ph8 TAU1 gron0):f1 (p35:sp41 ph1):f2 (p56:sp39 ph1):f3)
#else
  (center (TAU1 p1 ph5 d0 gron0 6u groff d0 gron0*-1 6u groff p1 ph8 TAU1 gron0):f1 (p35:sp41 ph1):f2)
#endif /*LABEL_CN*/
  
  TAU 
  6u groff
  TAU gron0*-1
  TAU1
  6u groff
  p16:gp2
  d16 fq=0:f1  

 (p1 ph1)
  d4
  (center (p2 ph1) (p35:sp41 ph6):f2)
  d4
  (p1 ph2) 
  p16:gp3
  d16

#ifdef LABEL_CN
   (lalign (DELTA3 p13:sp2 ph4 d10 d10 DELTA ):f2 (d10 p44:sp30 ph7):f1 (DELTA4 d10 p56:sp39 ph1):f3)
#else
   (lalign (DELTA3 p13:sp2 ph4 d10 d10 DELTA ):f2 (d10 p44:sp30 ph7):f1)
#endif /*LABEL_CN*/

  (p35:sp41 ph1):f2
  p16:gp4*EA*-1 
  d16 pl1:f1
  (p35:sp41 ph3):f2
  (p13:sp8 ph9):f2

  (p1 ph1)
  DELTA1
  (center (p2 ph1) (p35:sp41 ph1):f2 )
  DELTA2 pl12:f2
  p16:gp5
  d16
  4u BLKGRAD
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 
     F1PH(calph(ph8, -90), caldel(d0, +in0)) 
     F2EA(calgrad(EA), caldel(d10, +in10) & calph(ph4, +cnst61) & calph(ph6, +180) & calph(ph31, +180))
exit
   

ph1=0 
ph2=1
ph3=2
ph4=0 0 2 2
ph5=0 2
ph6=0
ph7=0 0 0 0 2 2 2 2
ph8=(8) 1 
ph9=0 
ph31=2 0 0 2


;pl1 : f1 channel - power level for pulse (default)
;pl2 : f2 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;sp14: f2 channel - short pulse for bi-level adiabatic decoupling 
;sp31: f2 channel - long pulse for bi-level adiabatic decoupling 
;sp30: f1 channel - shaped pulse 180 degree 
;sp39: f3 channel - shaped pulse 180 degree
;sp41: f2 channel - shaped pulse 180 degree
;spnam41: Bip1382
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p3 : f2 channel -  90 degree high power pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p35: f2 channel - 180 degree shaped pulse
;p44: f1 channel - 180 degree shaped pulse
;p56: f3 channel - 180 degree shaped pulse
;p63: f2 channel - pulse for bi-level adiabatic decoupling 
;d0 : incremented delay (F1 in 3D) = in0/2-p1*4/PI-6u
;d1 : relaxation delay; 1-5 * T1
;d4 : 1/(4J(CH))
;d8 : NOESY mixing time
;d10: incremented delay (F2 in 3D) = 1 usec
;d11: delay for disk I/O                             [30 msec]
;d12: delay for power switching                      [20 usec]
;d16: delay for homospoil/gradient recovery
;cnst2: = J(CH) (in Hz, ~150)
;cnst22: Center for indirect proton dimension (F1) 
;cnst23: Center for carbon dimension (F2) 
;cnst61: phase shift to change center of F2 dimension relative to 13C carrier
;inf1: 1/SW(H) = 2 * DW(H)
;inf2: 1/SW(C) = 2 * DW(C)
;in0: 1/2*SW(H) = DW(H)
;in10: 1/2*SW(C) = DW(C)
;ns: 4 * n
;ds: >= 64
;td1: number of experiments in F1
;td2: number of experiments in F2
;FnMODE: States-TPPI in F1
;FnMODE: echo-antiecho in F2
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence



;for z-only gradients:
;gpz0: 1%
;gpz1: -5%
;gpz2:  15%
;gpz3: -40.5%
;gpz4: 80%
;gpz5: 20.1%


;use gradient files:   
;gpnam1: SMSQ10.100
;gpnam2: SMSQ10.100
;gpnam3: SMSQ10.100
;gpnam4: SMSQ10.100
;gpnam5: SMSQ10.100

                                          ;preprocessor-flags-start

;the following options are available (eda: ZGOPTNS)
;LABEL_CN: to enable 15N decoupling for 15N/13C labeled molecules use option -DLABEL_CN
;SetF2Center: to set center of 13C (F2) dimension independent of 13C carrier use option -DSetF2Center,
;             center of 13C dimension is then set by cnst23.PHC0(F2) needs to be set to cnst61 in this case.

                                          ;preprocessor-flags-end

;Processing

;PHC0(F1): 135
;PHC1(F1): -180
;FCOR(F1): 1


