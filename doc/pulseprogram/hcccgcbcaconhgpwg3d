"in29=in10"
"in30=in10"

"td2=tdmax(td2,d30*2,in30)"


"DELTA=d0*2+p14+4u"
"DELTA1=d25/2-p19-d16"
"DELTA2=d24/2-p14-d25/2"
"DELTA3=d24/2-p14-p19-d16-4u"
